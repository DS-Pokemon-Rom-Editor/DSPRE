<Project>
  <!-- Lets .editorconfig's no-var rule fail the build, not only the IDE. -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- Antivirus heuristics distrust binaries with no publisher in their version resource. -->
  <PropertyGroup>
    <Company>DS-Pokemon-Rom-Editor</Company>
    <Product>DSPRE Reloaded</Product>
    <Authors>DS-Pokemon-Rom-Editor</Authors>
    <Copyright>Copyright © DS-Pokemon-Rom-Editor contributors</Copyright>
  </PropertyGroup>
  <!-- Bans the APIs that skip DSPRE's own paths; BannedSymbols.txt says what to use instead. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'DSPRE.Tests'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
