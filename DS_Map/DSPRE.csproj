<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DSPRE</AssemblyName>
    <RootNamespace>DSPRE</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Windows-only app — suppress platform-compatibility warnings -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Avalonia views intentionally have no parameterless constructor (require ViewModel) -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- Pre-existing transitional NuGet packages (WinForms bridge phase) -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- Pre-existing code warnings in legacy/generated files -->
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169;CS0168;CS0197;CS0109;CS8981;CA2200</NoWarn>
    <!-- BinaryFormatter in WinForms .resx — pre-existing, will be removed with WinForms -->
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
  </PropertyGroup>

  <!-- ============================================================
       NuGet Packages
       NOTE: ScintillaNET and WindowsAPICodePack are kept for now
       during the WinForms bridge phase; they will be removed once
       the Avalonia port of ScriptEditor and file dialogs is done.
       Newtonsoft.Json is required by SettingsManager.cs.
       ============================================================ -->
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.0.4" />
    <PackageReference Include="jacobslusser.ScintillaNET" Version="3.6.3" />
    <PackageReference Include="Microsoft.WindowsAPICodePack-Core" Version="1.1.0.2" />
    <PackageReference Include="Microsoft.WindowsAPICodePack-Shell" Version="1.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Collections.Specialized" Version="4.3.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.7" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <PackageReference Include="LibGit2Sharp" Version="0.31.0" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
  </ItemGroup>

  <!-- Avalonia image assets (embedded resources, referenced via avares://DSPRE/Avalonia/Assets/...) -->
  <ItemGroup>
    <AvaloniaResource Include="Avalonia\Assets\**" />
  </ItemGroup>

  <!-- ============================================================
       Project references — Ekona image library and Images plugin
       ============================================================ -->
  <ItemGroup>
    <ProjectReference Include="..\Ekona\Ekona.csproj" />
    <ProjectReference Include="..\Images\Images\Images.csproj" />
  </ItemGroup>

  <!-- ============================================================
       Runtime tools: copy to output on every build.
       These native executables are invoked by DSUtils at runtime.
       charmap.json is loaded by TextConverter.
       ============================================================ -->
  <ItemGroup>
    <Content Include="Tools\apicula.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\blz.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\ndstool.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\dsrom.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\chatot.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\pokefatcs.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\charmap.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
