<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="DSPRE.AvaloniaApp"
			 RequestedThemeVariant="Dark">

	<!-- Theme-aware editor chrome brushes (toolbars, status bars, separators, subtle text).
	     Defined per ThemeVariant so editors stay readable in both Dark and Light, and the app
	     can be switched at runtime via Application.RequestedThemeVariant (see ThemeManager). -->
	<Application.Resources>
		<ResourceDictionary>
			<!-- DSPRE SoftDark palette + control-colour mapping (vendored from WPFDarkTheme, MIT). -->
			<ResourceDictionary.MergedDictionaries>
				<MergeResourceInclude Source="Themes/Colours/SoftDark.axaml"/>
				<MergeResourceInclude Source="Themes/ControlColours.axaml"/>
			</ResourceDictionary.MergedDictionaries>
			<!-- Compatibility aliases: a few views (and the old DataGrid theme) reference Fluent
			     "SystemControl*" resource keys that SimpleTheme doesn't define. Map them to the
			     SoftDark palette so StaticResource lookups don't throw KeyNotFoundException. -->
			<SolidColorBrush x:Key="SystemControlTransparentBrush"             Color="Transparent"/>
			<SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"    Color="#A8A8A8"/>
			<SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="#555555"/>
			<SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush"     Color="#3C3C3C"/>

			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="Editor.ToolbarBg"  Color="#F5F5F5"/>
					<SolidColorBrush x:Key="Editor.PanelBg"    Color="#FAFAFA"/>
					<SolidColorBrush x:Key="Editor.StatusBg"   Color="#F0F0F0"/>
					<SolidColorBrush x:Key="Editor.Border"     Color="#DDDDDD"/>
					<SolidColorBrush x:Key="Editor.Separator"  Color="#CCCCCC"/>
					<SolidColorBrush x:Key="Editor.Text"       Color="#202020"/>
					<SolidColorBrush x:Key="Editor.Subtle"     Color="#666666"/>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<!-- Aligned to the Fusion palette so editor chrome matches the controls -->
					<SolidColorBrush x:Key="Editor.ToolbarBg"  Color="#353535"/>
					<SolidColorBrush x:Key="Editor.PanelBg"    Color="#3C3C3C"/>
					<SolidColorBrush x:Key="Editor.StatusBg"   Color="#2E2E2E"/>
					<SolidColorBrush x:Key="Editor.Border"     Color="#262626"/>
					<SolidColorBrush x:Key="Editor.Separator"  Color="#2E2E2E"/>
					<SolidColorBrush x:Key="Editor.Text"       Color="#E6E6E6"/>
					<SolidColorBrush x:Key="Editor.Subtle"     Color="#A8A8A8"/>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<!-- DSPRE SoftDark control themes (vendored from WPFDarkTheme, MIT) over Avalonia SimpleTheme. -->
		<SimpleTheme/>
		<StyleInclude Source="Themes/Controls.axaml"/>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml"/>
		<!-- Pair AvaloniaEdit's SIMPLE theme with the app's SimpleTheme. Its Fluent theme aliases Fluent-only keys
		     (ControlContentThemeFontSize, ContentControlThemeFontFamily, ToolTip*…) that SimpleTheme doesn't define,
		     so a TextEditor's SearchPanel threw KeyNotFoundException on template apply. The Simple theme references
		     SimpleTheme keys (FontSizeNormal, Theme*Brush) that ARE present. -->
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml"/>

		<!-- ── Crisp, consistent control sizing across every editor (from feature/avalonia) ── -->
		<Style Selector="Button">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="ToggleButton">
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="ComboBox">
			<Setter Property="MinHeight" Value="28"/>
		</Style>
		<Style Selector="TextBox">
			<Setter Property="MinHeight" Value="28"/>
		</Style>
		<!-- Numeric spinners: wide enough to read, tall enough to match buttons -->
		<Style Selector="NumericUpDown">
			<Setter Property="MinWidth" Value="84"/>
			<Setter Property="MinHeight" Value="28"/>
		</Style>

		<!-- ── Wrapping toolbars: a WrapPanel marked Classes="toolbar" reflows its controls onto a new
		     line when the window is narrow, instead of letting buttons run off-screen. The child margin
		     replaces StackPanel Spacing, and everything is vertically centred for a tidy single baseline. -->
		<Style Selector="WrapPanel.toolbar > :is(Control)">
			<Setter Property="Margin" Value="0,2,6,2"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- DSPRE-local rounding + tweaks (last so its setters win over the vendored themes). -->
		<StyleInclude Source="Themes/DspreTweaks.axaml"/>
	</Application.Styles>

</Application>
