<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.TrainerClassesView"
        x:DataType="vm:TrainerClassesViewModel"
        Title="Trainer Classes"
        Width="520" Height="480"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:TrainerClassesViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="220,*">
      <ListBox Grid.Column="0" Margin="4"
               ItemsSource="{Binding ClassNames}"
               SelectedIndex="{Binding SelectedClassIndex}"/>

      <StackPanel Grid.Column="1" Margin="8" Spacing="10">
        <StackPanel Spacing="2">
          <TextBlock Text="Class name"/>
          <TextBox Text="{Binding ClassName}"/>
        </StackPanel>

        <StackPanel Spacing="2" IsEnabled="{Binding MusicEnabled}">
          <TextBlock Text="Eye contact music [Main]"
                     ToolTip.Tip="The SSEQ that plays when a trainer of this class spots the player. Not every class has one — disabled means this class never initiates eye-contact battle music."/>
          <NumericUpDown Minimum="0" Maximum="65535" Increment="1" Value="{Binding MusicMain}"/>
        </StackPanel>

        <StackPanel Spacing="2" IsVisible="{Binding MusicAltEnabled}">
          <TextBlock Text="Eye contact music [Alt]" ToolTip.Tip="HGSS only: a second eye-contact music slot for this class."/>
          <NumericUpDown Minimum="0" Maximum="65535" Increment="1" Value="{Binding MusicAlt}"/>
        </StackPanel>

        <Button Content="Save trainer class" Click="Save_Click" HorizontalAlignment="Left"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
