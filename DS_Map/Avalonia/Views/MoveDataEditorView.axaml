<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
		x:Class="DSPRE.Avalonia.Views.MoveDataEditorView"
		x:DataType="vm:MoveDataEditorViewModel"
		Title="{Binding Title}"
		Width="820" Height="620"
		MinWidth="700" MinHeight="520"
		WindowStartupLocation="CenterScreen">

  <Window.Styles>
	<Style Selector="TextBlock.label">
	  <Setter Property="VerticalAlignment" Value="Center"/>
	  <Setter Property="Margin" Value="0,0,6,0"/>
	</Style>
	<Style Selector="ComboBox">
	  <Setter Property="MinWidth" Value="160"/>
	</Style>
	<Style Selector="NumericUpDown">
	  <Setter Property="MinWidth" Value="90"/>
	</Style>
  </Window.Styles>

  <DockPanel LastChildFill="True" Margin="10">

	<!-- Move selector bar -->
	<Border DockPanel.Dock="Top" Margin="0,0,0,8">
	  <StackPanel Orientation="Horizontal" Spacing="8">
		<TextBlock Text="Move:" Classes="label" FontWeight="SemiBold"/>
		<ComboBox ItemsSource="{Binding MoveNames}"
				  SelectedIndex="{Binding SelectedMoveIndex}"
				  MinWidth="260"/>
	  </StackPanel>
	</Border>

	<!-- Bottom toolbar -->
	<Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
	  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
		<Button Content="Export CSV"   Click="Export_Click"  Width="110"/>
		<Button Content="Import CSV"   Click="Import_Click"  Width="110"/>
		<Button Content="Save Move"    Click="Save_Click"    Width="110" IsDefault="True"/>
	  </StackPanel>
	</Border>

	<!-- Main editing area -->
	<Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,8,Auto,8,Auto,*">

	  <!-- ── Left column ── -->

	  <!-- Type / Split / Range -->
	  <GroupBox Grid.Row="0" Grid.Column="0" Header="Move Properties">
		<Grid RowDefinitions="Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:"   Classes="label"/>
		  <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TypeNames}"
					 SelectedIndex="{Binding TypeIndex}"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Split:"  Classes="label"/>
		  <ComboBox  Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SplitNames}"
					 SelectedIndex="{Binding SplitIndex}"/>

		  <TextBlock Grid.Row="4" Grid.Column="0" Text="Range:"  Classes="label"/>
		  <ComboBox  Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RangeItems}"
					 SelectedIndex="{Binding RangeIndex}" MinWidth="220"/>
		</Grid>
	  </GroupBox>

	  <!-- Battle sequence -->
	  <GroupBox Grid.Row="2" Grid.Column="0" Header="Battle Sequence (Effect)">
		<ComboBox ItemsSource="{Binding BattleSeqItems}"
				  SelectedIndex="{Binding BattleSeqIndex}"
				  HorizontalAlignment="Stretch" MinWidth="0"/>
	  </GroupBox>

	  <!-- Description -->
	  <GroupBox Grid.Row="4" Grid.Column="0" Header="Description">
		<TextBox Text="{Binding Description}" IsReadOnly="True"
				 TextWrapping="Wrap" MinHeight="70" AcceptsReturn="True"/>
	  </GroupBox>

	  <!-- ── Right column ── -->

	  <!-- Numeric stats -->
	  <GroupBox Grid.Row="0" Grid.Column="2" Header="Stats">
		<Grid RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Power:"           Classes="label"/>
		  <NumericUpDown Grid.Row="0" Grid.Column="1"
						 Value="{Binding Power}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Accuracy:"        Classes="label"/>
		  <NumericUpDown Grid.Row="2" Grid.Column="1"
						 Value="{Binding Accuracy}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="4" Grid.Column="0" Text="PP:"              Classes="label"/>
		  <NumericUpDown Grid.Row="4" Grid.Column="1"
						 Value="{Binding PP}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="6" Grid.Column="0" Text="Priority:"        Classes="label"/>
		  <NumericUpDown Grid.Row="6" Grid.Column="1"
						 Value="{Binding Priority}" Minimum="-128" Maximum="127" Increment="1"/>

		  <TextBlock Grid.Row="8" Grid.Column="0" Text="Effect %:"        Classes="label"/>
		  <NumericUpDown Grid.Row="8" Grid.Column="1"
						 Value="{Binding SideEffectPct}" Minimum="0" Maximum="255" Increment="1"/>
		</Grid>
	  </GroupBox>

	  <!-- Contest -->
	  <GroupBox Grid.Row="2" Grid.Column="2" Header="Contest">
		<Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Condition:" Classes="label"/>
		  <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ContestNames}"
					 SelectedIndex="{Binding ContestIndex}"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Appeal:"    Classes="label"/>
		  <NumericUpDown Grid.Row="2" Grid.Column="1"
						 Value="{Binding ContestAppeal}" Minimum="0" Maximum="255" Increment="1"/>
		</Grid>
	  </GroupBox>

	  <!-- Flags -->
	  <GroupBox Grid.Row="4" Grid.Column="2" Grid.RowSpan="2" Header="Flags">
		<ScrollViewer>
		  <ItemsControl ItemsSource="{Binding Flags}">
			<ItemsControl.ItemTemplate>
			  <DataTemplate>
				<CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet}" Margin="2"/>
			  </DataTemplate>
			</ItemsControl.ItemTemplate>
		  </ItemsControl>
		</ScrollViewer>
	  </GroupBox>

	</Grid>
  </DockPanel>
</Window>
