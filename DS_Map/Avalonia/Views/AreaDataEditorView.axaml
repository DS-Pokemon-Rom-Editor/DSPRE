<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.AreaDataEditorView"
        x:DataType="vm:AreaDataEditorViewModel">

  <Design.DataContext>
    <vm:AreaDataEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Area data:" VerticalAlignment="Center"/>
        <ComboBox Width="160" ItemsSource="{Binding AreaNames}" SelectedIndex="{Binding SelectedIndex}"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="↶ Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)"/>
        <Button Content="↷ Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)"/>
        <Button Content="💾 Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <StackPanel Margin="14" Spacing="8" MaxWidth="380" HorizontalAlignment="Left">
      <TextBlock Text="These pick the NSBTX packs the map/event 3D views use." FontSize="12" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Map tileset (NSBTX)" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="65535" Value="{Binding MapTileset}" Margin="2"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Buildings tileset (NSBTX)" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="65535" Value="{Binding BuildingsTileset}" Margin="2"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Dynamic texture type" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="65535" Value="{Binding DynamicTextureType}" Margin="2"/>
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Light type" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="65535" Value="{Binding LightType}" Margin="2"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Area type (HGSS)" VerticalAlignment="Center" IsVisible="{Binding IsHGSS}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AreaTypes}" SelectedIndex="{Binding AreaTypeIndex}" IsVisible="{Binding IsHGSS}" Margin="2"/>
      </Grid>
    </StackPanel>
  </DockPanel>
</UserControl>
