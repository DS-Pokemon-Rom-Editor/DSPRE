<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.WildEditorHGSSView"
        x:DataType="vm:WildEditorHGSSViewModel">
  <Design.DataContext>
    <vm:WildEditorHGSSViewModel/>
  </Design.DataContext>

  <UserControl.Resources>
    <DataTemplate x:Key="PokemonEncounterCellTemplate" x:DataType="vm:WildEncounterRow">
      <Grid ColumnDefinitions="32,*" ColumnSpacing="6">
        <Image Source="{Binding PokemonIcon}" Width="32" Height="32" Stretch="Uniform"/>
        <controls:FusionAutoCompleteBox Grid.Column="1"
                  ItemsSource="{Binding PokemonNames}"
                  SelectedIndex="{Binding PokemonIndex}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="FormatString" Value="0"/>
      <Setter Property="Increment" Value="1"/>
    </Style>
    <Style Selector="controls|FusionAutoCompleteBox">
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
  </UserControl.Styles>
  <DockPanel LastChildFill="True" Margin="10">
    <Border DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Encounter File:" Classes="lbl" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <controls:FusionAutoCompleteBox ItemsSource="{Binding EncounterNames}" SelectedIndex="{Binding SelectedEncounterIndex}" MinWidth="300"/>
        <Button Content="＋ Add"     Click="AddFile_Click"/>
        <Button Content="🗑 Rem last" Click="RemFile_Click"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="📥 Import" Click="ImportFile_Click"/>
        <Button Content="📤 Export" Click="ExportFile_Click"/>
        <Button Content="🛠 Repair all" Click="RepairAll_Click" ToolTip.Tip="Reset corrupted fields in every encounter file to defaults"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="↶ Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)"/>
        <Button Content="↷ Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)"/>
        <Button Content="Save" Click="Save_Click" Width="100" IsDefault="True"/>
      </StackPanel>
    </Border>
    <TabControl>
      <!-- Walking Morning -->
      <TabItem Header="Morning">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
            <TextBlock Text="Walk Rate:" Classes="lbl"/>
            <NumericUpDown Value="{Binding WalkingRate}" Minimum="0" Maximum="255" Width="100"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding MorningRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Chance" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
              <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
              <DataGridTemplateColumn Header="Level" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate><NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="100"/></DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <!-- Walking Day -->
      <TabItem Header="Day">
        <DataGrid Margin="8" ItemsSource="{Binding DayRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Chance" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
            <DataGridTemplateColumn Header="Level" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="100"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <!-- Walking Night -->
      <TabItem Header="Night">
        <DataGrid Margin="8" ItemsSource="{Binding NightRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Chance" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
            <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
            <DataGridTemplateColumn Header="Level" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate><NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="100"/></DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <!-- Special -->
      <TabItem Header="Special">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="8">
            <GroupBox Header="Swarm">
              <DataGrid ItemsSource="{Binding SwarmRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="Hoenn Radio">
              <DataGrid ItemsSource="{Binding HoennRadioRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="Sinnoh Radio">
              <DataGrid ItemsSource="{Binding SinnohRadioRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="Rock Smash">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Rock Smash Rate:" Classes="lbl"/>
                  <NumericUpDown Value="{Binding RockSmashRate}" Minimum="0" Maximum="255" Width="100"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding RockSmashRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="100" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Water -->
      <TabItem Header="Water">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
            <TextBlock Text="Surf Rate:"      Classes="lbl"/>
            <NumericUpDown Value="{Binding SurfRate}"     Minimum="0" Maximum="255" Width="100"/>
            <TextBlock Text="Old Rod Rate:"   Classes="lbl"/>
            <NumericUpDown Value="{Binding OldRodRate}"   Minimum="0" Maximum="255" Width="100"/>
            <TextBlock Text="Good Rod Rate:"  Classes="lbl"/>
            <NumericUpDown Value="{Binding GoodRodRate}"  Minimum="0" Maximum="255" Width="100"/>
            <TextBlock Text="Super Rod Rate:" Classes="lbl"/>
            <NumericUpDown Value="{Binding SuperRodRate}" Minimum="0" Maximum="255" Width="100"/>
          </StackPanel>
          <ScrollViewer>
            <StackPanel Spacing="8">
              <GroupBox Header="Surf">
                <DataGrid ItemsSource="{Binding SurfRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
              <GroupBox Header="Old Rod">
                <DataGrid ItemsSource="{Binding OldRodRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
              <GroupBox Header="Good Rod">
                <DataGrid ItemsSource="{Binding GoodRodRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
              <GroupBox Header="Super Rod">
                <DataGrid ItemsSource="{Binding SuperRodRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
