<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        xmlns:models="clr-namespace:DSPRE.Avalonia.Models"
        x:Class="DSPRE.Avalonia.Views.TrainerFlagBulkEditorView"
        x:DataType="vm:TrainerFlagBulkEditorViewModel">

  <Design.DataContext>
    <vm:TrainerFlagBulkEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="6">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <ToggleButton Content="By Trainer" IsChecked="{Binding IsByTrainerMode, Mode=OneWay}" Click="ByTrainerMode_Click"/>
        <ToggleButton Content="By Flag" IsChecked="{Binding IsByFlagMode, Mode=OneWay}" Click="ByFlagMode_Click"/>

        <TextBlock Text="Flag:" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsByFlagMode}"/>
        <ComboBox ItemsSource="{Binding FlagNamesList}"
                  SelectedIndex="{Binding CurrentFlagIndex}" Width="220" IsVisible="{Binding IsByFlagMode}"/>

        <Button Content="Save All" Click="SaveAll_Click" Margin="12,0,0,0"/>

        <Button Content="{Binding SelectAllLabel}" Click="SelectAll_Click" Margin="12,0,0,0"/>
        <Button Content="{Binding SelectNoneLabel}" Click="SelectNone_Click"/>

        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <TextBox Text="{Binding FilterText}" Width="200" PlaceholderText="trainer name…"/>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="480,*">
      <TreeView Grid.Column="0" Margin="4" ItemsSource="{Binding Tree}">
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="models:TrainerFlagGroupNode" ItemsSource="{Binding Children}">
            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}"/>
          </TreeDataTemplate>
          <DataTemplate DataType="models:TrainerFlagLeafNode">
            <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}"/>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>

      <Grid Grid.Column="1">
        <ScrollViewer IsVisible="{Binding IsByTrainerMode}">
          <ItemsControl Margin="16" ItemsSource="{Binding FlagChecklist}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:FlagChecklistItem">
                <CheckBox Content="{Binding Name}" IsThreeState="True" IsChecked="{Binding IsChecked, Mode=OneWay}"
                          Click="FlagCheckBox_Click" Margin="0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock IsVisible="{Binding IsByFlagMode}" Margin="16" TextWrapping="Wrap"
                   Text="Check or uncheck a trainer (or a whole trainer class) on the left to enable or disable the flag selected above for it."/>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
