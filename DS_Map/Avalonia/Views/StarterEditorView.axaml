<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
		x:Class="DSPRE.Avalonia.Views.StarterEditorView"
		x:DataType="vm:StarterEditorViewModel"
		Title="{Binding Title}"
		Width="420" Height="320"
		WindowStartupLocation="CenterOwner"
		CanResize="False">
  <Design.DataContext>
    <vm:StarterEditorViewModel/>
  </Design.DataContext>

  <DockPanel Margin="12" LastChildFill="True">

	<!-- Undo / Save -->
	<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6"
				HorizontalAlignment="Right" Margin="0,12,0,0">
	  <TextBlock Text="{Binding BusyText}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,6,0"/>
	  <Button Content="↶ Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)"/>
	  <Button Content="↷ Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)"/>
	  <Button Content="Save" Click="Save_Click"/>
	</StackPanel>

	<Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="10">
	  <StackPanel Spacing="8">
		<TextBlock Text="Starter Pokémon" FontWeight="Bold"/>
		<TextBlock TextWrapping="Wrap" Opacity="0.8"
				   Text="Also updates the DP/Pt selection-scene graphics, the rival's early team, tag-battle partners, HGSS starter cries, and the professor/rival dialogue naming the species."/>

		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,8,0,0">
		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Starter 1:" VerticalAlignment="Center"/>
		  <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding Starter1}" HorizontalAlignment="Stretch"/>

		  <TextBlock Grid.Row="1" Grid.Column="0" Text="Starter 2:" VerticalAlignment="Center"/>
		  <ComboBox  Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding Starter2}" HorizontalAlignment="Stretch"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Starter 3:" VerticalAlignment="Center"/>
		  <ComboBox  Grid.Row="2" Grid.Column="1" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding Starter3}" HorizontalAlignment="Stretch"/>

		  <TextBlock Grid.Row="3" Grid.Column="0" Text="Held Item:" VerticalAlignment="Center" IsVisible="{Binding IsHeldItemSupported}"/>
		  <ComboBox  Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ItemNames}" SelectedIndex="{Binding HeldItem}"
					 HorizontalAlignment="Stretch" IsVisible="{Binding IsHeldItemSupported}"/>
		</Grid>
	  </StackPanel>
	</Border>
  </DockPanel>
</Window>
