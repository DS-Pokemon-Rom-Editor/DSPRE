<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.CompileRomView"
        x:DataType="vm:CompileRomViewModel"
        Title="Compile ROM"
        Width="760" Height="540"
        WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:CompileRomViewModel/>
  </Design.DataContext>

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,10" TextWrapping="Wrap"
               Text="Running hg-engine's full build (make): data domains, ASM hooks, and the final repack into test.nds."/>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="8">
      <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" FontWeight="Bold"
                 Foreground="{Binding ResultBrush}"
                 IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <TextBlock Text="Building…" VerticalAlignment="Center" IsVisible="{Binding IsRunning}"/>
        <Button Content="Close" Click="Close_Click" IsEnabled="{Binding CanClose}"/>
      </StackPanel>
    </StackPanel>

    <Border Background="Black" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
      <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="Consolas,Menlo,monospace" FontSize="12" Foreground="Gainsboro"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
