<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.TextEditorView"
        x:DataType="vm:TextEditorViewModel">

  <Design.DataContext>
    <vm:TextEditorViewModel/>
  </Design.DataContext>

  <DockPanel>

    <!-- ── Toolbar ─────────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel Classes="toolbar">
        <TextBlock Text="Archive:" VerticalAlignment="Center"/>
        <ComboBox Width="160" ItemsSource="{Binding ArchiveNames}"
                  SelectedIndex="{Binding SelectedArchiveIndex}"/>
        <Button Content="Add"    Click="AddArchive_Click"    ToolTip.Tip="Add a new text archive"/>
        <Button Content="Remove" Click="RemoveArchive_Click" ToolTip.Tip="Delete the last text archive"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="2,2"/>
        <Button Content="Save"    Click="Save_Click"   IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Import…" Click="Import_Click"/>
        <Button Content="Export…" Click="Export_Click"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="2,2"/>
        <CheckBox Content="Hex line numbers" IsChecked="{Binding HexNumbering}" VerticalAlignment="Center"/>
      </WrapPanel>
    </Border>

    <!-- ── Status bar ──────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}"
                 VerticalAlignment="Center"/>
    </Border>

    <!-- ── Search / replace panel ──────────────────────────────────────────── -->
    <Border DockPanel.Dock="Right" Width="300" Background="{DynamicResource Editor.PanelBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1,0,0,0" Padding="8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="Search &amp; Replace" FontWeight="Bold"/>
          <TextBox Text="{Binding SearchText}"  PlaceholderText="Search text"  KeyDown="Search_KeyDown"/>
          <TextBox Text="{Binding ReplaceText}" PlaceholderText="Replace with"/>
          <CheckBox Content="Case sensitive"          IsChecked="{Binding CaseSensitive}"/>
          <CheckBox Content="Search all archives"     IsChecked="{Binding SearchAllArchives}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Search"  Click="Search_Click"  Width="90"/>
            <Button Content="Replace" Click="Replace_Click" Width="90"/>
          </StackPanel>
          <TextBlock Text="Results (double-click to go):" Margin="0,6,0,0"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding SearchResults}"
                 DoubleTapped="SearchResult_DoubleTapped"
                 x:Name="SearchResultsList"/>
      </DockPanel>
    </Border>

    <!-- ── Message grid + line controls ────────────────────────────────────── -->
    <DockPanel>
      <Border DockPanel.Dock="Bottom" Padding="4" Background="{DynamicResource Editor.ToolbarBg}"
              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Add String"    Click="AddString_Click"/>
          <Button Content="Remove String" Click="RemoveString_Click"/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="2,2"/>
          <Button Content="Move Up"   Click="MoveUp_Click"   IsEnabled="{Binding CanMoveUp}"/>
          <Button Content="Move Down" Click="MoveDown_Click" IsEnabled="{Binding CanMoveDown}"/>
        </StackPanel>
      </Border>

      <DataGrid x:Name="LinesGrid"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding SelectedLineIndex}"
                AutoGenerateColumns="False"
                IsReadOnly="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                Margin="4">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="70"/>
          <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

  </DockPanel>
</UserControl>
