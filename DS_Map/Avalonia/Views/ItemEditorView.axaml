<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.ItemEditorView"
        x:DataType="vm:ItemEditorViewModel"
        Title="Item Data Editor"
        Width="900" Height="700"
        MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:ItemEditorViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- ── Top: Item Selector ── -->
        <Border DockPanel.Dock="Top" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock VerticalAlignment="Center">Item:</TextBlock>
                <controls:FusionAutoCompleteBox ItemsSource="{Binding ItemNames}"
                                                SelectedIndex="{Binding SelectedItemIndex}"
                                                Width="240" MaxDropDownHeight="300"/>
                <TextBlock VerticalAlignment="Center">ID:</TextBlock>
                <NumericUpDown Value="{Binding SelectedItemIndex}"
                               Minimum="0" Maximum="{Binding MaxItemIndex}"
                               Width="100" FormatString="0"/>
                <Separator Width="12"/>
                <Button Content="↶ Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)"/>
                <Button Content="↷ Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)"/>
                <Separator Width="12"/>
                <Button x:Name="SaveAllButton">💾 Save All</Button>
                <Button x:Name="ExportButton" Click="Export_Click">📤 Export…</Button>
                <Button x:Name="AddItemButton" Content="+ Add New Item…" IsVisible="{Binding ShowHgEngineBanner}"
                        ToolTip.Tip="Mint a brand new item in the linked hg-engine checkout"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="8,3" Background="#2D6A4F" IsVisible="{Binding ShowHgEngineBanner}">
            <TextBlock Text="{Binding HgEngineBanner}" Foreground="White" FontSize="12"/>
        </Border>

        <!-- ── Main Content ── -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6" Spacing="6">

                <!-- Row 1: Icon + Table Entry | Hold + Pocket | Checks + Price -->
                <Grid ColumnDefinitions="200,*,*" ColumnSpacing="6">

                    <!-- Left: Icon preview + Table Entry -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                Width="64" Height="64" HorizontalAlignment="Left"
                                CornerRadius="4">
                            <Panel>
                                <Image Source="{Binding ItemIcon}" Width="32" Height="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="None"/>
                                <TextBlock Text="n/a" FontSize="10" Opacity="0.6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding IconUnavailable}"
                                           ToolTip.Tip="No icon graphics found for this item at its expected slot in the loaded ROM — likely a brand-new custom item that hasn't been compiled into a ROM yet"/>
                            </Panel>
                        </Border>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Item Table Entry</TextBlock>

                                <TextBlock>Icon Image:</TextBlock>
                                <ComboBox ItemsSource="{Binding IconImages}"
                                          SelectedItem="{Binding SelectedIconImage}"
                                          HorizontalAlignment="Stretch"/>

                                <TextBlock>Icon Palette:</TextBlock>
                                <ComboBox ItemsSource="{Binding IconPalettes}"
                                          SelectedItem="{Binding SelectedIconPalette}"
                                          HorizontalAlignment="Stretch"/>

                                <TextBlock>Item Data File ID:</TextBlock>
                                <NumericUpDown Value="{Binding ItemDataId}"
                                               Minimum="0" Maximum="{Binding MaxItemDataId}"
                                               FormatString="0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Middle: Hold Effect + Pocket -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <!-- Hold Effect -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Hold Effect</TextBlock>
                                <ComboBox ItemsSource="{Binding HoldEffectNames}"
                                          SelectedIndex="{Binding HoldEffectIndex}"
                                          HorizontalAlignment="Stretch" MaxDropDownHeight="200"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center">Parameter:</TextBlock>
                                    <NumericUpDown Grid.Column="1" Value="{Binding HoldEffectParam}"
                                                   Minimum="0" Maximum="255" FormatString="0" Width="100"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Pocket -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Pocket</TextBlock>
                                <TextBlock>Field Pocket:</TextBlock>
                                <ComboBox ItemsSource="{Binding FieldPocketNames}"
                                          SelectedIndex="{Binding FieldPocketIndex}"
                                          HorizontalAlignment="Stretch"/>
                                <TextBlock Margin="0,4,0,0">Battle Pockets:</TextBlock>
                                <WrapPanel>
                                    <CheckBox IsChecked="{Binding PokeBallsBattlePocket}"   Margin="0,0,8,2">Poké Balls</CheckBox>
                                    <CheckBox IsChecked="{Binding BattleItemsBattlePocket}" Margin="0,0,8,2">Battle Items</CheckBox>
                                    <CheckBox IsChecked="{Binding HpRestoreBattlePocket}"   Margin="0,0,8,2">HP Restore</CheckBox>
                                    <CheckBox IsChecked="{Binding StatusHealersBattlePocket}" Margin="0,0,8,2">Status Healers</CheckBox>
                                    <CheckBox IsChecked="{Binding PpRestoreBattlePocket}"   Margin="0,0,8,2">PP Restore</CheckBox>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Checks + Price + Functions -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <!-- Checks -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Usage Checks</TextBlock>
                                <CheckBox IsChecked="{Binding PreventToss}">Prevent Toss</CheckBox>
                                <CheckBox IsChecked="{Binding Selectable}">Selectable (SELECT)</CheckBox>
                                <CheckBox IsChecked="{Binding PartyUse}">Party Use (enables params below)</CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Price -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Price</TextBlock>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center">Buy Price:</TextBlock>
                                    <NumericUpDown Grid.Column="1" Value="{Binding Price}"
                                                   Minimum="0" Maximum="65535" FormatString="0" Width="100"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Functions -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="6">
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Usage Functions</TextBlock>
                                <TextBlock>Field Function:</TextBlock>
                                <ComboBox ItemsSource="{Binding FieldUseFuncNames}"
                                          SelectedIndex="{Binding FieldUseFuncIndex}"
                                          HorizontalAlignment="Stretch" MaxDropDownHeight="200"/>
                                <TextBlock>Battle Function:</TextBlock>
                                <ComboBox ItemsSource="{Binding BattleUseFuncNames}"
                                          SelectedIndex="{Binding BattleUseFuncIndex}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Move Related (full width) -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Move Related</TextBlock>
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">Natural Gift Type:</TextBlock>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding NaturalGiftTypeNames}"
                                      SelectedIndex="{Binding NaturalGiftTypeIndex}" MaxDropDownHeight="200"/>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">Power:</TextBlock>
                            <NumericUpDown Grid.Column="3" Value="{Binding NaturalGiftPower}"
                                           Minimum="0" Maximum="255" FormatString="0" Width="90"/>
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="12,0,4,0">Fling Effect:</TextBlock>
                            <NumericUpDown Grid.Column="5" Value="{Binding FlingEffect}"
                                           Minimum="0" Maximum="255" FormatString="0" Width="90"/>
                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Margin="8,0,4,0">Fling Power:</TextBlock>
                            <NumericUpDown Grid.Column="7" Value="{Binding FlingPower}"
                                           Minimum="0" Maximum="255" FormatString="0" Width="90"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">Pluck Effect:</TextBlock>
                            <NumericUpDown Grid.Column="1" Value="{Binding PluckEffect}"
                                           Minimum="0" Maximum="255" FormatString="0" Width="90"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Row 3: Party Params TabControl -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6"
                        IsEnabled="{Binding PartyParamsEnabled}">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,2">Party Use Parameters
                            <Run Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                 FontWeight="Normal"> (enabled when Party Use is checked)</Run>
                        </TextBlock>
                        <TabControl>
                            <!-- Status Heals tab -->
                            <TabItem Header="Status Heals">
                                <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                                      Margin="4" ColumnSpacing="16" RowSpacing="4">
                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding SlpHeal}">Sleep Heal</CheckBox>
                                    <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding PsnHeal}">Poison Heal</CheckBox>
                                    <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding BrnHeal}">Burn Heal</CheckBox>
                                    <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding FrzHeal}">Freeze Heal</CheckBox>

                                    <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding PrzHeal}">Paralysis Heal</CheckBox>
                                    <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding CfsHeal}">Confusion Heal</CheckBox>
                                    <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding InfHeal}">Infatuation Heal</CheckBox>
                                    <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding GuardSpec}">Guard Spec (Mist)</CheckBox>

                                    <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding Revive}">Revive (50% HP)</CheckBox>
                                    <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding ReviveAll}">Revive All</CheckBox>
                                    <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding LevelUp}">Level Up</CheckBox>
                                    <CheckBox Grid.Row="3" Grid.Column="2" IsChecked="{Binding Evolve}">Evolve</CheckBox>
                                </Grid>
                            </TabItem>

                            <!-- Stat Stages tab -->
                            <TabItem Header="Stat Stages">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      Margin="4" ColumnSpacing="8" RowSpacing="4">
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">Attack:</TextBlock>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding AtkStages}" Minimum="-6" Maximum="6" Width="90"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">Defense:</TextBlock>
                                    <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding DefStages}" Minimum="-6" Maximum="6" Width="90"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Sp. Attack:</TextBlock>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SpAtkStages}" Minimum="-6" Maximum="6" Width="90"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">Sp. Defense:</TextBlock>
                                    <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding SpDefStages}" Minimum="-6" Maximum="6" Width="90"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Speed:</TextBlock>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SpeedStages}" Minimum="-6" Maximum="6" Width="90"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">Accuracy:</TextBlock>
                                    <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding AccuracyStages}" Minimum="-6" Maximum="6" Width="90"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Crit Rate:</TextBlock>
                                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding CritRateStages}" Minimum="0" Maximum="3" Width="90"/>
                                </Grid>
                            </TabItem>

                            <!-- Restore tab -->
                            <TabItem Header="Restore">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      Margin="4" ColumnSpacing="8" RowSpacing="4">
                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding HpRestore}">HP Restore</CheckBox>
                                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">Amount (0=%):</TextBlock>
                                    <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding HpRestoreParam}" Minimum="0" Maximum="255" Width="90"/>

                                    <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding PpRestore}">PP Restore</CheckBox>
                                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">Amount:</TextBlock>
                                    <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding PpRestoreParam}" Minimum="0" Maximum="255" Width="90"/>

                                    <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding PpUps}">PP Ups</CheckBox>
                                    <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding PpMax}">PP Max</CheckBox>
                                    <CheckBox Grid.Row="4" Grid.Column="0" IsChecked="{Binding PpRestoreAll}">PP Restore All Moves</CheckBox>
                                </Grid>
                            </TabItem>

                            <!-- EVs tab -->
                            <TabItem Header="EVs">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      Margin="4" ColumnSpacing="6" RowSpacing="4">
                                    <!-- Header row -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" FontWeight="SemiBold">Enable</TextBlock>
                                    <TextBlock Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" FontWeight="SemiBold">Value</TextBlock>
                                    <TextBlock Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" FontWeight="SemiBold">Enable</TextBlock>
                                    <TextBlock Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center" FontWeight="SemiBold">Value</TextBlock>

                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">HP:</TextBlock>
                                    <CheckBox  Grid.Row="1" Grid.Column="1" IsChecked="{Binding EVHp}" HorizontalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding EVHpValue}" Minimum="-128" Maximum="127" Width="90"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Attack:</TextBlock>
                                    <CheckBox  Grid.Row="2" Grid.Column="1" IsChecked="{Binding EVAtk}" HorizontalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding EVAtkValue}" Minimum="-128" Maximum="127" Width="90"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">Defense:</TextBlock>
                                    <CheckBox  Grid.Row="3" Grid.Column="1" IsChecked="{Binding EVDef}" HorizontalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding EVDefValue}" Minimum="-128" Maximum="127" Width="90"/>

                                    <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">Speed:</TextBlock>
                                    <CheckBox  Grid.Row="1" Grid.Column="4" IsChecked="{Binding EVSpeed}" HorizontalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="5" Value="{Binding EVSpeedValue}" Minimum="-128" Maximum="127" Width="90"/>

                                    <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">Sp. Attack:</TextBlock>
                                    <CheckBox  Grid.Row="2" Grid.Column="4" IsChecked="{Binding EVSpAtk}" HorizontalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="5" Value="{Binding EVSpAtkValue}" Minimum="-128" Maximum="127" Width="90"/>

                                    <TextBlock Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">Sp. Defense:</TextBlock>
                                    <CheckBox  Grid.Row="3" Grid.Column="4" IsChecked="{Binding EVSpDef}" HorizontalAlignment="Center"/>
                                    <NumericUpDown Grid.Row="3" Grid.Column="5" Value="{Binding EVSpDefValue}" Minimum="-128" Maximum="127" Width="90"/>
                                </Grid>
                            </TabItem>

                            <!-- Friendship tab -->
                            <TabItem Header="Friendship">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                                      Margin="4" ColumnSpacing="8" RowSpacing="4">
                                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" FontWeight="SemiBold">Enable</TextBlock>
                                    <TextBlock Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" FontWeight="SemiBold">Value</TextBlock>

                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">Low Friendship:</TextBlock>
                                    <CheckBox  Grid.Row="1" Grid.Column="1" IsChecked="{Binding FriendshipLow}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">Change:</TextBlock>
                                    <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding FriendshipLowValue}" Minimum="-128" Maximum="127" Width="90"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Mid Friendship:</TextBlock>
                                    <CheckBox  Grid.Row="2" Grid.Column="1" IsChecked="{Binding FriendshipMid}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">Change:</TextBlock>
                                    <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding FriendshipMidValue}" Minimum="-128" Maximum="127" Width="90"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center">High Friendship:</TextBlock>
                                    <CheckBox  Grid.Row="3" Grid.Column="1" IsChecked="{Binding FriendshipHigh}" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">Change:</TextBlock>
                                    <NumericUpDown Grid.Row="3" Grid.Column="3" Value="{Binding FriendshipHighValue}" Minimum="-128" Maximum="127" Width="90"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
