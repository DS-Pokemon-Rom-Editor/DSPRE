<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        xmlns:views="clr-namespace:DSPRE.Avalonia.Views"
        x:Class="DSPRE.Avalonia.Views.MainWindowView"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1440" Height="860" MinWidth="1080" MinHeight="640"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:MainWindowViewModel/>
  </Design.DataContext>

  <Panel>
  <DockPanel>

    <!-- ── Menu bar ───────────────────────────────────────────────────────── -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File" x:Name="FileMenu">
        <MenuItem Header="Open ROM…" Click="OpenRom_Click"/>
        <MenuItem Header="Open extracted folder…" Click="OpenFolder_Click"/>
        <MenuItem Header="Open _Recent" x:Name="RecentMenu">
          <MenuItem Header="(no recent projects)" IsEnabled="False"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Save ROM…" Click="SaveRom_Click" IsEnabled="{Binding IsRomLoaded}"/>
        <MenuItem Header="Convert to ds-rom format…" Click="ConvertDsRom_Click" IsEnabled="{Binding IsRomLoaded}"/>
        <Separator/>
        <MenuItem Header="Close" Click="Close_Click"/>
      </MenuItem>

      <MenuItem Header="_Pokémon" x:Name="PokemonMenu" IsEnabled="{Binding IsRomLoaded}">
        <MenuItem Header="Pokémon Editor…"   Click="PokemonEditor_Click"/>
        <MenuItem Header="Move Data Editor…" Click="MoveDataEditor_Click"/>
        <MenuItem Header="TM Editor…"        Click="TMEditor_Click"/>
        <MenuItem Header="Egg Move Editor…"  Click="EggMoveEditor_Click"/>
        <Separator/>
        <MenuItem Header="Item Editor…"       Click="ItemEditor_Click"/>
        <MenuItem Header="Item Table Editor…" Click="ItemTableEditor_Click"/>
        <MenuItem Header="Trade Editor…"      Click="TradeEditor_Click"/>
        <Separator/>
        <MenuItem Header="Trainer Editor…"    Click="TrainerEditor_Click"/>
      </MenuItem>

      <MenuItem Header="Te_xt" x:Name="TextMenu" IsEnabled="{Binding IsRomLoaded}">
        <MenuItem Header="Text Editor…" Click="TextEditor_Click"/>
        <MenuItem Header="Script Editor…" Click="ScriptEditor_Click"/>
        <MenuItem Header="Level Script Editor…" Click="LevelScriptEditor_Click"/>
      </MenuItem>

      <MenuItem Header="Ta_bles" IsEnabled="{Binding IsRomLoaded}">
        <MenuItem Header="Table Editor…" Click="TableEditor_Click"/>
        <MenuItem Header="Hidden Items Editor… (HGSS)" Click="HiddenItemsEditor_Click"/>
        <MenuItem Header="Pickup Table Editor…" Click="PickupTableEditor_Click"/>
      </MenuItem>

      <MenuItem Header="_World" x:Name="WorldMenu" IsEnabled="{Binding IsRomLoaded}">
        <MenuItem Header="Header Editor…"          Click="HeaderEditor_Click"/>
        <MenuItem Header="Camera Editor…"          Click="CameraEditor_Click"/>
        <MenuItem Header="Map Editor…"             Click="MapEditor_Click"/>
        <MenuItem Header="Building Editor…"        Click="BuildingEditor_Click"/>
        <MenuItem Header="Matrix Editor…"          Click="MatrixEditor_Click"/>
        <MenuItem Header="Event Editor…"           Click="EventEditor_Click"/>
        <MenuItem Header="Fly / Warp Editor…"      Click="FlyWarpEditor_Click"/>
        <MenuItem Header="Overlay Editor…"         Click="OverlayEditor_Click"/>
        <MenuItem Header="Overworld Sprites (BTX)…" Click="OverworldEditor_Click"/>
        <MenuItem Header="NSBTX Texture Editor…"   Click="NsbtxEditor_Click"/>
        <MenuItem Header="Area Data Editor…"       Click="AreaDataEditor_Click"/>
        <MenuItem Header="Wild Pokémon Editor…"    Click="WildEditor_Click"/>
        <MenuItem Header="Spawn Point Editor…"     Click="SpawnEditor_Click"/>
        <MenuItem Header="Advanced Header Search…" Click="HeaderSearch_Click"/>
        <MenuItem Header="Special Encounters…"     Click="EncountersEditor_Click"/>
        <MenuItem Header="Headbutt Editor… (HGSS)" Click="HeadbuttEditor_Click"/>
      </MenuItem>

      <MenuItem Header="_Tools" x:Name="ToolsMenu">
        <MenuItem Header="Go to… (Ctrl+P)" Click="CommandPalette_Click" InputGesture="Ctrl+P"
                  ToolTip.Tip="Quick-open: jump to any editor by name"/>
        <Separator/>
        <MenuItem Header="Address Helper…"  Click="AddressHelper_Click"  IsEnabled="{Binding IsRomLoaded}"/>
        <MenuItem Header="Research Helper…" Click="ResearchHelper_Click" IsEnabled="{Binding IsRomLoaded}"/>
        <MenuItem Header="Char Map Manager…" Click="CharMapManager_Click" IsEnabled="{Binding IsRomLoaded}"/>
        <MenuItem Header="Validation &amp; Where-Used…" Click="ProjectChecks_Click" IsEnabled="{Binding IsRomLoaded}"
                  ToolTip.Tip="Scan headers for broken references, and look up which headers use a matrix/event/script/…"/>
        <MenuItem Header="Edit Dropdown Labels…" Click="LabelEditor_Click" IsEnabled="{Binding IsRomLoaded}"
                  ToolTip.Tip="Rename or add entries for hardcoded dropdowns (e.g. evolution methods), per project or global"/>
        <MenuItem Header="ROM Patch Toolbox…" Click="PatchToolbox_Click" IsEnabled="{Binding IsRomLoaded}"
                  ToolTip.Tip="ARM9 expansion, matrix/header/trainer-name expansion, BDHCam, script-command repoint, item standardization and other ROM patches"/>
        <MenuItem Header="Custom Script Command Manager…" Click="CustomCommandManager_Click" IsEnabled="{Binding IsRomLoaded}"
                  ToolTip.Tip="Manage custom script-command databases (.scrcmd)"/>
        <Separator/>
        <MenuItem Header="Export Docs…" Click="ExportDocs_Click" IsEnabled="{Binding IsRomLoaded}"
                  ToolTip.Tip="Export Pokémon/learnset/evolution/trainer/move/TM/egg-move/header/encounter data as CSV, TXT and JSON"/>
        <MenuItem Header="Generate Trainer Usage CSV…" Click="TrainerUsageCsv_Click" IsEnabled="{Binding IsRomLoaded}"
                  ToolTip.Tip="Which Pokémon each trainer class uses, with counts"/>
        <Separator/>
        <MenuItem Header="NARC Utility">
          <MenuItem Header="Unpack NARC to Folder…" Click="NarcUnpack_Click"/>
          <MenuItem Header="Pack Folder to NARC…" Click="NarcPack_Click"/>
        </MenuItem>
        <MenuItem Header="NSBMD Utility">
          <MenuItem Header="Add/Replace NSBMD textures…" Click="NsbmdAddTex_Click"/>
          <MenuItem Header="Remove textures from NSBMD…" Click="NsbmdRemoveTex_Click"/>
          <MenuItem Header="Save textures from NSBMD…" Click="NsbmdSaveTex_Click"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="Toggle theme (Light / Dark)" Click="ToggleTheme_Click"/>
        <MenuItem Header="3D Model Viewer…" Click="GlTest_Click"/>
        <MenuItem Header="Welcome &amp; Tutorial…" Click="Welcome_Click"/>
        <MenuItem Header="Guided Tour" Click="GuidedTour_Click"
                  ToolTip.Tip="Replay the walkthrough of the main window and editor menus"/>
        <MenuItem Header="Settings…" Click="Settings_Click"/>
      </MenuItem>
    </Menu>

    <!-- ── Status bar ─────────────────────────────────────────────────────── -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock FontSize="11" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"
                 Text="{Binding StatusText}"/>
    </Border>

    <!-- ── Main editing surface: the Maps workspace (other editors open from the menu),
         with a busy overlay while a ROM is being opened/unpacked. ── -->
    <Panel>
      <views:MapsWorkspaceView x:Name="Maps" DataContext="{Binding HeaderVM}"/>

      <!-- Pre-ROM empty state: quick actions instead of a dead grey workspace
           (matters when the Welcome window is disabled). -->
      <Border IsVisible="{Binding !IsRomLoaded}" Background="{DynamicResource Editor.PanelBg}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="440">
          <TextBlock Text="No ROM loaded" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Open a game to start editing. Your edits go to a project folder next to the ROM; the original file is never touched."
                     TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="Open ROM (.nds)…" Click="OpenRom_Click"/>
            <Button Content="Open extracted folder…" Click="OpenFolder_Click"/>
          </StackPanel>
          <StackPanel IsVisible="{Binding HasRecents}" Spacing="2">
            <TextBlock Text="Recent projects" FontWeight="SemiBold" Margin="0,10,0,2"/>
            <ItemsControl ItemsSource="{Binding RecentProjects}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <!-- TextBlock content so "_" in paths isn't eaten as an access-key marker -->
                  <Button Click="RecentQuick_Click" Margin="0,2,0,0"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          ToolTip.Tip="{Binding}">
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <TextBlock Text="Tip: press Ctrl+P anytime to jump to any editor by name."
                     FontSize="12" Opacity="0.6" TextAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding IsLoadingRom}"
              Background="#A0000000" ZIndex="100">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="320">
          <TextBlock Text="{Binding BusyText}" FontSize="18" HorizontalAlignment="Center"/>
          <ProgressBar IsIndeterminate="True"/>
          <TextBlock Text="{Binding BusyHint}"
                     FontSize="12" Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
      </Border>
    </Panel>

  </DockPanel>

  <!-- ── Guided-tour layer: covers the whole window (menu bar included) so the tour can
       spotlight any control. Populated and shown by GuidedTour; empty and hidden otherwise. ── -->
  <Canvas x:Name="TourLayer" IsVisible="False" ZIndex="200" Background="{x:Null}"/>
  </Panel>
</Window>
