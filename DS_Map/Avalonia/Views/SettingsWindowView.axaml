<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
		x:Class="DSPRE.Avalonia.Views.SettingsWindowView"
		x:DataType="vm:SettingsWindowViewModel"
		Title="Settings"
		Width="880" Height="600"
		CanResize="False"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:SettingsWindowViewModel/>
  </Design.DataContext>


  <StackPanel Margin="12" Spacing="10">

	<!-- Version label -->
	<TextBlock Text="{Binding VersionLabel}" FontWeight="Bold"/>

	<!-- ROM Export Path -->
	<Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="8">
	  <StackPanel Spacing="4">
		<TextBlock Text="ROM Export Path" FontWeight="SemiBold"/>
		<Grid ColumnDefinitions="*,Auto,Auto">
		  <TextBox Grid.Column="0" Text="{Binding ExportPath}" IsReadOnly="True"/>
		  <Button Grid.Column="1" Content="Change Path" Margin="4,0,0,0" Click="ChangeExportPath_Click"/>
		  <Button Grid.Column="2" Content="Clear"        Margin="4,0,0,0" Click="ClearExportPath_Click"/>
		</Grid>
	  </StackPanel>
	</Border>

	<!-- Initial Map Import Path -->
	<Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="8">
	  <StackPanel Spacing="4">
		<TextBlock Text="Initial Map Import Path" FontWeight="SemiBold"/>
		<Grid ColumnDefinitions="*,Auto,Auto">
		  <TextBox Grid.Column="0" Text="{Binding MapImportPath}" IsReadOnly="True"/>
		  <Button Grid.Column="1" Content="Change Path" Margin="4,0,0,0" Click="ChangeMapImportPath_Click"/>
		  <Button Grid.Column="2" Content="Clear"        Margin="4,0,0,0" Click="ClearMapImportPath_Click"/>
		</Grid>
	  </StackPanel>
	</Border>

	<!-- Open Default ROM -->
	<Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="8">
	  <StackPanel Spacing="4">
		<TextBlock Text="Open Default ROM" FontWeight="SemiBold"/>
		<Grid ColumnDefinitions="*,Auto,Auto">
		  <TextBox Grid.Column="0" Text="{Binding OpenDefaultRom}" IsReadOnly="True"/>
		  <Button Grid.Column="1" Content="Change Path" Margin="4,0,0,0" Click="ChangeOpenDefaultRom_Click"/>
		  <Button Grid.Column="2" Content="Clear"        Margin="4,0,0,0" Click="ClearOpenDefaultRom_Click"/>
		</Grid>
	  </StackPanel>
	</Border>

	<!-- Checkboxes -->
	<StackPanel Orientation="Horizontal" Spacing="24">
	  <CheckBox Content="Open without asking"          IsChecked="{Binding NeverAskForOpening}"/>
	  <CheckBox Content="Check App Updates Automatically" IsChecked="{Binding AutoCheckUpdates}"/>
	  <CheckBox Content="Update Databases Automatically"  IsChecked="{Binding AutoUpdateDBs}"/>
	</StackPanel>

	<!-- Avalonia scale override -->
	<Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="8">
	  <Grid ColumnDefinitions="Auto,110,*">
		<TextBlock Grid.Column="0" Text="UI scale factor" VerticalAlignment="Center" Margin="0,0,8,0"/>
		<NumericUpDown Grid.Column="1" Value="{Binding UiScale}" Minimum="0" Maximum="8" Increment="0.05" FormatString="0.00"/>
		<TextBlock Grid.Column="2" Text="0 = automatic; restart required" VerticalAlignment="Center" Margin="8,0,0,0"
		           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
	  </Grid>
	</Border>

	<!-- Onboarding -->
	<StackPanel Orientation="Horizontal" Spacing="24">
	  <CheckBox Content="Show Welcome at startup"       IsChecked="{Binding ShowWelcomeOnStartup}"/>
	  <CheckBox Content="Show guided tour after the next ROM load" IsChecked="{Binding ShowGuidedTourNextLoad}"
	            ToolTip.Tip="The tour can also be replayed anytime from Tools > Guided Tour"/>
	  <Button Content="Open Welcome &amp; Tutorial…" Click="ShowWelcome_Click"/>
	</StackPanel>

	<!-- 3D View camera (mouse) -->
	<Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="8">
	  <StackPanel Spacing="6">
		<TextBlock Text="3D View Camera (mouse)" FontWeight="SemiBold"/>
		<Grid ColumnDefinitions="Auto,110,28,Auto,110,28,Auto,110" RowDefinitions="Auto">
		  <TextBlock Grid.Column="0" Text="Pan speed"    VerticalAlignment="Center" Margin="0,0,6,0"/>
		  <NumericUpDown Grid.Column="1" Value="{Binding CamPanSpeed}"   Minimum="0.1" Maximum="5" Increment="0.1" FormatString="0.0"/>
		  <TextBlock Grid.Column="3" Text="Rotate speed" VerticalAlignment="Center" Margin="0,0,6,0"/>
		  <NumericUpDown Grid.Column="4" Value="{Binding CamOrbitSpeed}" Minimum="0.1" Maximum="5" Increment="0.1" FormatString="0.0"/>
		  <TextBlock Grid.Column="6" Text="Zoom speed"   VerticalAlignment="Center" Margin="0,0,6,0"/>
		  <NumericUpDown Grid.Column="7" Value="{Binding CamZoomSpeed}"  Minimum="0.1" Maximum="5" Increment="0.1" FormatString="0.0"/>
		</Grid>
		<WrapPanel>
		  <CheckBox Content="Invert pan X"    IsChecked="{Binding CamInvertPanX}"   Margin="0,0,18,0"/>
		  <CheckBox Content="Invert pan Y"    IsChecked="{Binding CamInvertPanY}"   Margin="0,0,18,0"/>
		  <CheckBox Content="Invert rotate X" IsChecked="{Binding CamInvertOrbitX}" Margin="0,0,18,0"/>
		  <CheckBox Content="Invert rotate Y" IsChecked="{Binding CamInvertOrbitY}" Margin="0,0,18,0"/>
		  <CheckBox Content="Invert zoom"     IsChecked="{Binding CamInvertZoom}"/>
		</WrapPanel>
		<TextBlock Text="In the 3D views: left-drag pans, right-drag rotates, mouse wheel zooms. Changes take effect after you click Save."
				   FontSize="12" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" TextWrapping="Wrap"/>
	  </StackPanel>
	</Border>

	<!-- Buttons row -->
	<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
	  <Button Content="Check App updates"      Click="CheckForUpdates_Click"/>
	  <Button Content="Check Database updates" Click="CheckDBUpdates_Click"/>
	  <Button Content="Save" Click="Save_Click"/>
	</StackPanel>

  </StackPanel>
</Window>
