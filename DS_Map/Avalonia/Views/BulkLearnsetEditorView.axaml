<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.BulkLearnsetEditorView"
        x:DataType="vm:BulkLearnsetEditorViewModel"
        Title="Bulk Learnset Editor"
        Width="720" Height="640"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:BulkLearnsetEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel Classes="toolbar">
        <TextBlock Text="Filter:" VerticalAlignment="Center"/>
        <ComboBox Width="200" ItemsSource="{Binding SpeciesFilter}" SelectedIndex="{Binding FilterIndex}"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="💾 Save all" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="＋ Add row"  Click="Add_Click"/>
        <Button Content="🗑 Remove"   Click="Remove_Click"/>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <DataGrid Margin="4" ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedRow}"
              CanUserResizeColumns="True" GridLinesVisibility="Horizontal" IsReadOnly="False">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Species" Width="280">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BulkLearnsetRow">
              <ComboBox ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding SpeciesIndex}" HorizontalAlignment="Stretch" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Level" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BulkLearnsetRow">
              <NumericUpDown Minimum="0" Maximum="100" Value="{Binding Level}" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Move" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BulkLearnsetRow">
              <ComboBox ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding MoveIndex}" HorizontalAlignment="Stretch" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
