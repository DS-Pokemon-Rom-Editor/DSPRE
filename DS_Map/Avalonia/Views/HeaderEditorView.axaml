<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.HeaderEditorView"
        x:DataType="vm:HeaderEditorViewModel">

  <Design.DataContext>
    <vm:HeaderEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Vertical" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="💾  Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
          <Button Content="↺  Reset" Click="Reset_Click" ToolTip.Tip="Revert to the saved header"/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
          <Button Content="⧉  Copy"  Click="Copy_Click"/>
          <Button Content="📋  Paste" Click="Paste_Click"/>
          <Button Content="📥  Import" Click="Import_Click"/>
          <Button Content="📤  Export" Click="Export_Click"/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
          <Button Content="＋  Add"    Click="AddHeader_Click"    IsEnabled="{Binding CanAddRemove}"/>
          <Button Content="🗑  Remove" Click="RemoveHeader_Click" IsEnabled="{Binding CanAddRemove}"/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
          <TextBlock Text="Go to #" VerticalAlignment="Center"/>
          <NumericUpDown Width="100" Minimum="0" Maximum="65535" Value="{Binding GoToValue}"/>
          <Button Content="Go" Click="GoTo_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Open linked:" VerticalAlignment="Center" Foreground="{DynamicResource Editor.Subtle}"/>
          <Button Content="🔗 Matrix"        Click="OpenMatrix_Click"/>
          <Button Content="🔗 Events"        Click="OpenEvents_Click"/>
          <Button Content="🔗 Scripts"       Click="OpenScripts_Click"/>
          <Button Content="🔗 Level Scripts" Click="OpenLevelScripts_Click"/>
          <Button Content="🔗 Texts"         Click="OpenTexts_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="280,*">
      <!-- Header list -->
      <ListBox Grid.Column="0" Margin="4"
               ItemsSource="{Binding HeaderItems}"
               SelectedIndex="{Binding SelectedHeaderIndex}"/>

      <!-- Detail form -->
      <ScrollViewer Grid.Column="1" Padding="8">
        <StackPanel Spacing="8">

          <!-- Internal name -->
          <StackPanel Spacing="2">
            <TextBlock Text="Internal name" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Width="200" Text="{Binding InternalName}"/>
              <TextBlock Text="{Binding InternalNameLen}" Foreground="{Binding InternalNameColor}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>

          <!-- File / ID fields -->
          <HeaderedContentControl Header="IDs">
            <Grid ColumnDefinitions="120,140,120,140" RowDefinitions="Auto,Auto,Auto,Auto" >
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Matrix" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="65535" Value="{Binding MatrixId}" Margin="2"/>
              <TextBlock Grid.Row="0" Grid.Column="2" Text="Area Data" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="0" Maximum="255" Value="{Binding AreaDataId}" Margin="2"/>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Script" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="65535" Value="{Binding ScriptFileId}" Margin="2"/>
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Level Script" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="65535" Value="{Binding LevelScriptId}" Margin="2"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Event" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="65535" Value="{Binding EventFileId}" Margin="2"/>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Text" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="65535" Value="{Binding TextArchiveId}" Margin="2"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Wild Pokémon" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="{Binding WildPokeMax}" Value="{Binding WildPokemon}" Margin="2"/>
              <TextBlock Grid.Row="3" Grid.Column="2" Text="Battle BG" VerticalAlignment="Center"/>
              <NumericUpDown Grid.Row="3" Grid.Column="3" Minimum="0" Maximum="255" Value="{Binding BattleBackground}" Margin="2"/>
            </Grid>
          </HeaderedContentControl>

          <!-- Location / area -->
          <HeaderedContentControl Header="Location &amp; Area">
            <StackPanel Spacing="4">
              <TextBlock Text="Location name"/>
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LocationNames}" SelectedIndex="{Binding LocationNameIndex}"/>
              <TextBlock Text="Area settings"/>
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AreaSettingsItems}" SelectedIndex="{Binding AreaSettingsIndex}"/>
              <StackPanel IsVisible="{Binding ShowAreaIcon}" Spacing="4">
                <TextBlock Text="Area icon"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox Width="260" ItemsSource="{Binding AreaIconItems}" SelectedIndex="{Binding AreaIconIndex}"/>
                  <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Width="48" Height="48">
                    <Image Source="{Binding AreaIconImage}" Stretch="Uniform"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>

          <!-- Music -->
          <HeaderedContentControl Header="Music">
            <Grid ColumnDefinitions="60,*,90" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Day" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2" ItemsSource="{Binding MusicDay.Names}" SelectedIndex="{Binding MusicDayComboIndex}"/>
              <NumericUpDown Grid.Row="0" Grid.Column="2" Minimum="0" Maximum="65535" Margin="2" Value="{Binding MusicDayValue}"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Night" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="2" ItemsSource="{Binding MusicNight.Names}" SelectedIndex="{Binding MusicNightComboIndex}"/>
              <NumericUpDown Grid.Row="1" Grid.Column="2" Minimum="0" Maximum="65535" Margin="2" Value="{Binding MusicNightValue}"/>
            </Grid>
          </HeaderedContentControl>

          <!-- Weather + Camera -->
          <Grid ColumnDefinitions="*,*">
            <HeaderedContentControl Grid.Column="0" Header="Weather" Margin="0,0,4,0">
              <StackPanel Spacing="4">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Weather.Names}" SelectedIndex="{Binding WeatherComboIndex}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Width="100" Minimum="0" Maximum="255" Value="{Binding WeatherValue}"/>
                  <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Width="80" Height="48">
                    <Image Source="{Binding WeatherImage}" Stretch="Uniform"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Column="1" Header="Camera" Margin="4,0,0,0">
              <StackPanel Spacing="4">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Camera.Names}" SelectedIndex="{Binding CameraComboIndex}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <NumericUpDown Width="100" Minimum="0" Maximum="255" Value="{Binding CameraValue}"/>
                  <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Width="80" Height="48">
                    <Image Source="{Binding CameraImage}" Stretch="Uniform"/>
                  </Border>
                </StackPanel>
              </StackPanel>
            </HeaderedContentControl>
          </Grid>

          <!-- Map setting flags (names match WinForms; flags 4-6 HGSS-only) -->
          <HeaderedContentControl Header="Map settings (flags)">
            <WrapPanel>
              <CheckBox Content="Bicycle"   IsChecked="{Binding Flag0}" Margin="0,0,12,0"/>
              <CheckBox Content="Esc. Rope" IsChecked="{Binding Flag1}" Margin="0,0,12,0"/>
              <CheckBox Content="Fly"       IsChecked="{Binding Flag2}" Margin="0,0,12,0"/>
              <CheckBox Content="Run"       IsChecked="{Binding Flag3}" Margin="0,0,12,0"/>
              <CheckBox Content="Flag 4" IsChecked="{Binding Flag4}" IsVisible="{Binding ShowHgssOnly}" Margin="0,0,12,0"/>
              <CheckBox Content="Flag 5" IsChecked="{Binding Flag5}" IsVisible="{Binding ShowHgssOnly}" Margin="0,0,12,0"/>
              <CheckBox Content="Flag 6" IsChecked="{Binding Flag6}" IsVisible="{Binding ShowHgssOnly}" Margin="0,0,12,0"/>
            </WrapPanel>
          </HeaderedContentControl>

          <!-- HGSS-only -->
          <HeaderedContentControl Header="HGSS settings" IsVisible="{Binding ShowHgssOnly}">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="World map X" VerticalAlignment="Center"/>
                <NumericUpDown Width="100" Minimum="0" Maximum="63" Value="{Binding WorldmapX}"/>
                <TextBlock Text="Y" VerticalAlignment="Center"/>
                <NumericUpDown Width="100" Minimum="0" Maximum="63" Value="{Binding WorldmapY}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Follow mode" VerticalAlignment="Center"/>
                <ComboBox Width="140" ItemsSource="{Binding FollowModeItems}" SelectedIndex="{Binding FollowModeIndex}"/>
                <RadioButton Content="Johto" GroupName="region" IsChecked="{Binding JohtoFlag}"/>
                <RadioButton Content="Kanto" GroupName="region" IsChecked="{Binding KantoFlag}"/>
              </StackPanel>
            </StackPanel>
          </HeaderedContentControl>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
