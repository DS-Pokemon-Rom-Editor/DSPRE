<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.HgEngineFormEditorView"
        x:DataType="vm:HgEngineFormEditorViewModel"
        Title="Form Editor (hg-engine)"
        Width="620" Height="640"
        MinWidth="480" MinHeight="400">

  <Design.DataContext>
    <vm:HgEngineFormEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <!-- ── Top: species selector ── -->
    <Border DockPanel.Dock="Top" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock VerticalAlignment="Center">Species:</TextBlock>
        <controls:FusionAutoCompleteBox ItemsSource="{Binding PokemonNames}"
                                        SelectedIndex="{Binding SelectedSpeciesIndex}"
                                        Width="260" MaxDropDownHeight="300"/>
        <Separator Width="12"/>
        <Button x:Name="SaveButton" Content="💾 Save"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Top" Padding="8,3" Background="#2D6A4F">
      <TextBlock Text="{Binding HgEngineBanner}" Foreground="White" FontSize="12"/>
    </Border>
    <Border DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <TextBlock TextWrapping="Wrap" FontSize="12"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                 Text="Which form species exist for the selected base Pokémon (Mega, regional, Gmax, etc.), from data/PokeFormDataTbl.c. A form's own stats/types/abilities are edited in the Pokémon Editor; this only manages which form entries exist. &quot;Needs Reversion&quot; marks a form that reverts to base under specific conditions (Mega Evolution, Primal Reversion, and a few late-gen forms)."/>
    </Border>

    <!-- ── Bottom: status + add ── -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Column="1" x:Name="AddSlotButton" Content="+ Add Form"/>
      </Grid>
    </Border>

    <!-- ── Main: slot list ── -->
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Slots}" Margin="8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    CornerRadius="4" Padding="8" Margin="0,0,0,6">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <controls:FusionAutoCompleteBox Grid.Column="0"
                    ItemsSource="{Binding $parent[ItemsControl].((vm:HgEngineFormEditorViewModel)DataContext).PokemonNames}"
                    SelectedIndex="{Binding PokemonIndex}" MaxDropDownHeight="260"/>
                <CheckBox Grid.Column="1" Content="Needs Reversion" IsChecked="{Binding NeedsReversion}" Margin="12,0"/>
                <Button Grid.Column="2" Content="✕" Click="RemoveSlot_Click" ToolTip.Tip="Remove this form"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
