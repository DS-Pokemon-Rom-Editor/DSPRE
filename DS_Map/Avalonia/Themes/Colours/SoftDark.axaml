            <Color x:Key="AColour.Tone5.Background.Static">#454545</Color>
            <Color x:Key="AColour.Tone5.Border.Static">#525252</Color>
            <Color x:Key="AColour.Tone5.Background.MouseOver">#525252</Color>
            <Color x:Key="AColour.Tone5.Border.MouseOver">#5E5E5E</Color>
            <Color x:Key="AColour.Tone5.Background.MouseDown">#3A3A3A</Color>
            <Color x:Key="AColour.Tone5.Border.MouseDown">#444444</Color>
            <Color x:Key="AColour.Tone5.Background.Selected">#3E3E3E</Color>
            <Color x:Key="AColour.Tone5.Background.Selected.Inactive">#363636</Color>
            <Color x:Key="AColour.Tone5.Border.Selected">#444444</Color>
            <Color x:Key="AColour.Tone5.Border.Selected.Inactive">#404040</Color>
            <Color x:Key="AColour.Tone5.Background.Disabled">#5D5D5D</Color>
            <Color x:Key="AColour.Tone5.Border.Disabled">#696969</Color>

            <Color x:Key="AColour.Tone6.Background.Static">#505050</Color>
            <Color x:Key="AColour.Tone6.Border.Static">#5C5C5C</Color>
            <Color x:Key="AColour.Tone6.Background.MouseOver">#484848</Color>
            <Color x:Key="AColour.Tone6.Border.MouseOver">#5C5C5C</Color>
            <Color x:Key="AColour.Tone6.Background.MouseDown">#424242</Color>
            <Color x:Key="AColour.Tone6.Border.MouseDown">#4C4C4C</Color>
            <Color x:Key="AColour.Tone6.Background.Selected">#464646</Color>
            <Color x:Key="AColour.Tone6.Background.Selected.Inactive">#3E3E3E</Color>
            <Color x:Key="AColour.Tone6.Border.Selected">#4C4C4C</Color>
            <Color x:Key="AColour.Tone6.Border.Selected.Inactive">#484848</Color>
            <Color x:Key="AColour.Tone6.Background.Disabled">#696969</Color>
            <Color x:Key="AColour.Tone6.Border.Disabled">#767676</Color>

            <Color x:Key="AColour.Tone7.Background.Static">#3C3C3C</Color>
            <Color x:Key="AColour.Tone7.Border.Static">#464646</Color>
            <Color x:Key="AColour.Tone7.Background.MouseOver">#545454</Color>
            <Color x:Key="AColour.Tone7.Border.MouseOver">#5E5E5E</Color>
            <Color x:Key="AColour.Tone7.Background.MouseDown">#4A4A4A</Color>
            <Color x:Key="AColour.Tone7.Border.MouseDown">#545454</Color>
            <Color x:Key="AColour.Tone7.Background.Selected">#4F4F4F</Color>
            <Color x:Key="AColour.Tone7.Background.Selected.Inactive">#474747</Color>
            <Color x:Key="AColour.Tone7.Border.Selected">#555555</Color>
            <Color x:Key="AColour.Tone7.Border.Selected.Inactive">#515151</Color>
            <Color x:Key="AColour.Tone7.Background.Disabled">#737373</Color>
            <Color x:Key="AColour.Tone7.Border.Disabled">#828282</Color>
            <Color x:Key="AColour.Tone8.Background.Static">#505050</Color>
            <Color x:Key="AColour.Tone8.Border.Static">#5F5F5F</Color>
            <Color x:Key="AColour.Tone8.Background.MouseOver">#5F5F5F</Color>
            <Color x:Key="AColour.Tone8.Border.MouseOver">#6E6E6E</Color>
            <Color x:Key="AColour.Tone8.Background.MouseDown">#555555</Color>
            <Color x:Key="AColour.Tone8.Border.MouseDown">#616161</Color>
            <Color x:Key="AColour.Tone8.Background.Selected">#5A5A5A</Color>
            <Color x:Key="AColour.Tone8.Background.Selected.Inactive">#545454</Color>
            <Color x:Key="AColour.Tone8.Border.Selected">#646464</Color>
            <Color x:Key="AColour.Tone8.Border.Selected.Inactive">#636363</Color>
            <Color x:Key="AColour.Tone8.Background.Disabled">#8A8A8A</Color>
            <Color x:Key="AColour.Tone8.Border.Disabled">#9B9B9B</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="AColour.Foreground.Static">#202020</Color>
            <Color x:Key="AColour.Foreground.Deeper">#3A3A3A</Color>
            <Color x:Key="AColour.Foreground.Disabled">#9E9E9E</Color>
            <Color x:Key="AColour.Glyph.Static">#3A3A3A</Color>
            <Color x:Key="AColour.Glyph.Disabled">#B0B0B0</Color>
            <Color x:Key="AColour.Glyph.MouseOver">#101010</Color>
            <Color x:Key="AColour.Glyph.MouseDown">#000000</Color>
            <Color x:Key="AColour.Glyph.Selected">#FFFFFF</Color>
            <Color x:Key="AColour.Glyph.Selected.Inactive">#303030</Color>
            <Color x:Key="AColour.ColourfulGlyph.Static">#2A82DA</Color>
            <Color x:Key="AColour.ColourfulGlyph.Disabled">#9FC3E0</Color>
            <Color x:Key="AColour.ColourfulGlyph.MouseOver">#2D7DD7</Color>
            <Color x:Key="AColour.ColourfulGlyph.MouseDown">#3287C8</Color>
            <Color x:Key="AColour.ColourfulGlyph.Selected">#3273B9</Color>
            <Color x:Key="AColour.ColourfulGlyph.Selected.Inactive">#3778C8</Color>

            <Color x:Key="AColour.AccentTone1.Background.Static">#5587AF</Color>
            <Color x:Key="AColour.AccentTone1.Border.Static">#4182CD</Color>
            <Color x:Key="AColour.AccentTone2.Background.Static">#2A82DA</Color>
            <Color x:Key="AColour.AccentTone2.Border.Static">#2F82C8</Color>
            <Color x:Key="AColour.AccentTone3.Background.Static">#2D7DD7</Color>
            <Color x:Key="AColour.AccentTone3.Border.Static">#3287C8</Color>

            <!-- Mirrored elevation ramp: Tone0 = brightest/most-recessed canvas, Tone8 = most
                 raised/prominent surface, same roles as the Dark ramp above just built from
                 light grays. Selected states get a light-blue tint instead of a darker gray. -->
            <Color x:Key="AColour.Tone0.Background.Static">#FFFFFF</Color>
            <Color x:Key="AColour.Tone0.Border.Static">#E4E4E4</Color>
            <Color x:Key="AColour.Tone1.Background.Static">#FAFAFA</Color>
            <Color x:Key="AColour.Tone1.Border.Static">#E0E0E0</Color>
            <Color x:Key="AColour.Tone2.Background.Static">#F3F3F3</Color>
            <Color x:Key="AColour.Tone2.Border.Static">#DCDCDC</Color>
            <Color x:Key="AColour.Tone3.Background.Static">#ECECEC</Color>
            <Color x:Key="AColour.Tone3.Border.Static">#D6D6D6</Color>

            <Color x:Key="AColour.Tone4.Background.Static">#FFFFFF</Color>
            <Color x:Key="AColour.Tone4.Border.Static">#C9C9C9</Color>
            <Color x:Key="AColour.Tone4.Background.MouseOver">#F5F5F5</Color>
            <Color x:Key="AColour.Tone4.Border.MouseOver">#BEBEBE</Color>
            <Color x:Key="AColour.Tone4.Background.MouseDown">#E8E8E8</Color>
            <Color x:Key="AColour.Tone4.Border.MouseDown">#B0B0B0</Color>
            <Color x:Key="AColour.Tone4.Background.Selected">#D6E8FB</Color>
            <Color x:Key="AColour.Tone4.Background.Selected.Inactive">#E4E4E4</Color>
            <Color x:Key="AColour.Tone4.Border.Selected">#A9CDF3</Color>
            <Color x:Key="AColour.Tone4.Border.Selected.Inactive">#CFCFCF</Color>
            <Color x:Key="AColour.Tone4.Background.Disabled">#EFEFEF</Color>
            <Color x:Key="AColour.Tone4.Border.Disabled">#D8D8D8</Color>

            <Color x:Key="AColour.Tone5.Background.Static">#ECECEC</Color>
            <Color x:Key="AColour.Tone5.Border.Static">#D2D2D2</Color>
            <Color x:Key="AColour.Tone5.Background.MouseOver">#E0E0E0</Color>
            <Color x:Key="AColour.Tone5.Border.MouseOver">#C4C4C4</Color>
            <Color x:Key="AColour.Tone5.Background.MouseDown">#D2D2D2</Color>
            <Color x:Key="AColour.Tone5.Border.MouseDown">#B6B6B6</Color>
            <Color x:Key="AColour.Tone5.Background.Selected">#CFE4FA</Color>
            <Color x:Key="AColour.Tone5.Background.Selected.Inactive">#E2E2E2</Color>
            <Color x:Key="AColour.Tone5.Border.Selected">#A6CBF2</Color>
            <Color x:Key="AColour.Tone5.Border.Selected.Inactive">#CACACA</Color>
            <Color x:Key="AColour.Tone5.Background.Disabled">#F2F2F2</Color>
            <Color x:Key="AColour.Tone5.Border.Disabled">#DEDEDE</Color>

            <Color x:Key="AColour.Tone6.Background.Static">#E2E2E2</Color>
            <Color x:Key="AColour.Tone6.Border.Static">#CBCBCB</Color>
            <Color x:Key="AColour.Tone6.Background.MouseOver">#D6D6D6</Color>
            <Color x:Key="AColour.Tone6.Border.MouseOver">#BEBEBE</Color>
            <Color x:Key="AColour.Tone6.Background.MouseDown">#C8C8C8</Color>
            <Color x:Key="AColour.Tone6.Border.MouseDown">#B0B0B0</Color>
            <Color x:Key="AColour.Tone6.Background.Selected">#C7DEF8</Color>
            <Color x:Key="AColour.Tone6.Background.Selected.Inactive">#D8D8D8</Color>
            <Color x:Key="AColour.Tone6.Border.Selected">#9BC3EF</Color>
            <Color x:Key="AColour.Tone6.Border.Selected.Inactive">#C2C2C2</Color>
            <Color x:Key="AColour.Tone6.Background.Disabled">#B8B8B8</Color>
            <Color x:Key="AColour.Tone6.Border.Disabled">#A8A8A8</Color>

            <Color x:Key="AColour.Tone7.Background.Static">#D8D8D8</Color>
            <Color x:Key="AColour.Tone7.Border.Static">#C0C0C0</Color>
            <Color x:Key="AColour.Tone7.Background.MouseOver">#CACACA</Color>
            <Color x:Key="AColour.Tone7.Border.MouseOver">#B2B2B2</Color>
            <Color x:Key="AColour.Tone7.Background.MouseDown">#BCBCBC</Color>
            <Color x:Key="AColour.Tone7.Border.MouseDown">#A4A4A4</Color>
            <Color x:Key="AColour.Tone7.Background.Selected">#BBD6F5</Color>
            <Color x:Key="AColour.Tone7.Background.Selected.Inactive">#CCCCCC</Color>
            <Color x:Key="AColour.Tone7.Border.Selected">#8FB9EA</Color>
            <Color x:Key="AColour.Tone7.Border.Selected.Inactive">#B8B8B8</Color>
            <Color x:Key="AColour.Tone7.Background.Disabled">#A0A0A0</Color>
            <Color x:Key="AColour.Tone7.Border.Disabled">#909090</Color>
            <Color x:Key="AColour.Tone8.Background.Static">#CCCCCC</Color>
            <Color x:Key="AColour.Tone8.Border.Static">#B4B4B4</Color>
            <Color x:Key="AColour.Tone8.Background.MouseOver">#BEBEBE</Color>
            <Color x:Key="AColour.Tone8.Border.MouseOver">#A6A6A6</Color>
            <Color x:Key="AColour.Tone8.Background.MouseDown">#B0B0B0</Color>
            <Color x:Key="AColour.Tone8.Border.MouseDown">#989898</Color>
            <Color x:Key="AColour.Tone8.Background.Selected">#AFCCF0</Color>
            <Color x:Key="AColour.Tone8.Background.Selected.Inactive">#BEBEBE</Color>
            <Color x:Key="AColour.Tone8.Border.Selected">#82AEE3</Color>
            <Color x:Key="AColour.Tone8.Border.Selected.Inactive">#AEAEAE</Color>
            <Color x:Key="AColour.Tone8.Background.Disabled">#8C8C8C</Color>
            <Color x:Key="AColour.Tone8.Border.Disabled">#7C7C7C</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Primary.4 would be containers, aka control that have a deep background (that sinks into the view) -->
    <!-- Primary.5 would be regular controls, aka control that are obvious and normal (they stick out)-->
    <!-- Primary.6 is like Primary.5 but it's more obvious, it sticks out a bit more -->
    <!-- Primary.7 is like Primary.6 but it's very obvious, it sticks out more (useful for popups maybe, possibly with shadows as well) -->

    <!-- DynamicResource (not StaticResource): these must re-resolve when the AColour tokens
         above change with the theme variant, or switching Light/Dark at runtime would leave
         every ABrush frozen at whatever colour was active when it was first used. -->
    <SolidColorBrush x:Key="ABrush.AccentTone1.Background.Static" Color="{DynamicResource AColour.AccentTone1.Background.Static}"/>
    <SolidColorBrush x:Key="ABrush.AccentTone1.Border.Static" Color="{DynamicResource AColour.AccentTone1.Border.Static}"/>
    <SolidColorBrush x:Key="ABrush.AccentTone2.Background.Static" Color="{DynamicResource AColour.AccentTone2.Background.Static}"/>
    <SolidColorBrush x:Key="ABrush.AccentTone2.Border.Static" Color="{DynamicResource AColour.AccentTone2.Border.Static}"/>
    <SolidColorBrush x:Key="ABrush.AccentTone3.Background.Static" Color="{DynamicResource AColour.AccentTone3.Background.Static}"/>
    <SolidColorBrush x:Key="ABrush.AccentTone3.Border.Static" Color="{DynamicResource AColour.AccentTone3.Border.Static}"/>
    <SolidColorBrush x:Key="ABrush.Foreground.Static" Color="{DynamicResource AColour.Foreground.Static}"/>
    <SolidColorBrush x:Key="ABrush.Foreground.Deeper" Color="{DynamicResource AColour.Foreground.Deeper}"/>
    <SolidColorBrush x:Key="ABrush.Foreground.Disabled" Color="{DynamicResource AColour.Foreground.Disabled}"/>
    <SolidColorBrush x:Key="ABrush.Glyph.Static" Color="{DynamicResource AColour.Glyph.Static}"/>
    <SolidColorBrush x:Key="ABrush.Glyph.Disabled" Color="{DynamicResource AColour.Glyph.Disabled}"/>
    <SolidColorBrush x:Key="ABrush.Glyph.MouseOver" Color="{DynamicResource AColour.Glyph.MouseOver}"/>
    <SolidColorBrush x:Key="ABrush.Glyph.MouseDown" Color="{DynamicResource AColour.Glyph.MouseDown}"/>
    <SolidColorBrush x:Key="ABrush.Glyph.Selected" Color="{DynamicResource AColour.Glyph.Selected}"/>
    <SolidColorBrush x:Key="ABrush.Glyph.Selected.Inactive" Color="{DynamicResource AColour.Glyph.Selected.Inactive}"/>
    <SolidColorBrush x:Key="ABrush.ColourfulGlyph.Static" Color="{DynamicResource AColour.ColourfulGlyph.Static}"/>
    <SolidColorBrush x:Key="ABrush.ColourfulGlyph.Disabled" Color="{DynamicResource AColour.ColourfulGlyph.Disabled}"/>
    <SolidColorBrush x:Key="ABrush.ColourfulGlyph.MouseOver" Color="{DynamicResource AColour.ColourfulGlyph.MouseOver}"/>
    <SolidColorBrush x:Key="ABrush.ColourfulGlyph.MouseDown" Color="{DynamicResource AColour.ColourfulGlyph.MouseDown}"/>
    <SolidColorBrush x:Key="ABrush.ColourfulGlyph.Selected" Color="{DynamicResource AColour.ColourfulGlyph.Selected}"/>
    <SolidColorBrush x:Key="ABrush.ColourfulGlyph.Selected.Inactive" Color="{DynamicResource AColour.ColourfulGlyph.Selected.Inactive}"/>
    <SolidColorBrush x:Key="ABrush.Tone0.Background.Static" Color="{DynamicResource AColour.Tone0.Background.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone0.Border.Static" Color="{DynamicResource AColour.Tone0.Border.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone1.Background.Static" Color="{DynamicResource AColour.Tone1.Background.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone1.Border.Static" Color="{DynamicResource AColour.Tone1.Border.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone2.Background.Static" Color="{DynamicResource AColour.Tone2.Background.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone2.Border.Static" Color="{DynamicResource AColour.Tone2.Border.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone3.Background.Static" Color="{DynamicResource AColour.Tone3.Background.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone3.Border.Static" Color="{DynamicResource AColour.Tone3.Border.Static}"/>
    <SolidColorBrush x:Key="ABrush.Tone4.Background.Static" Color="{DynamicResource AColour.Tone4.Background.Static}"/>
