<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- #################################################################################### -->
    <!-- The letter A is in front of the colours themselves, because it's annoying  -->
    <!-- having to scroll down in visual studio's designer to "Colour" or "Brush" -->
    <!-- #################################################################################### -->

    <!-- Colour tokens are theme-variant-aware: Dark is the original hand-tuned SoftDark ramp;
         Light is a mirrored "elevation" ramp (higher Tone = more raised, same as Dark, just
         built from light grays instead of dark ones) so every control template below keeps
         working unmodified in both themes via DynamicResource. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AColour.Foreground.Static">#F0F0F0</Color>
            <Color x:Key="AColour.Foreground.Deeper">#D2D2D2</Color>
            <Color x:Key="AColour.Foreground.Disabled">#BABABA</Color>
            <Color x:Key="AColour.Glyph.Static">#DCDCDC</Color>
            <Color x:Key="AColour.Glyph.Disabled">#B4B4B4</Color>
            <Color x:Key="AColour.Glyph.MouseOver">#FAFAFA</Color>
            <Color x:Key="AColour.Glyph.MouseDown">#EBEBEB</Color>
            <Color x:Key="AColour.Glyph.Selected">#E4E4E4</Color>
            <Color x:Key="AColour.Glyph.Selected.Inactive">#DADADA</Color>
            <Color x:Key="AColour.ColourfulGlyph.Static">#2A82DA</Color>
            <Color x:Key="AColour.ColourfulGlyph.Disabled">#5587AF</Color>
            <Color x:Key="AColour.ColourfulGlyph.MouseOver">#2D7DD7</Color>
            <Color x:Key="AColour.ColourfulGlyph.MouseDown">#3287C8</Color>
            <Color x:Key="AColour.ColourfulGlyph.Selected">#3273B9</Color>
            <Color x:Key="AColour.ColourfulGlyph.Selected.Inactive">#3778C8</Color>

            <Color x:Key="AColour.AccentTone1.Background.Static">#5587AF</Color>
            <Color x:Key="AColour.AccentTone1.Border.Static">#4182CD</Color>
            <Color x:Key="AColour.AccentTone2.Background.Static">#2A82DA</Color>
            <Color x:Key="AColour.AccentTone2.Border.Static">#2F82C8</Color>
            <Color x:Key="AColour.AccentTone3.Background.Static">#2D7DD7</Color>
            <Color x:Key="AColour.AccentTone3.Border.Static">#3287C8</Color>

            <Color x:Key="AColour.Tone0.Background.Static">#141414</Color>
            <Color x:Key="AColour.Tone0.Border.Static">#000000</Color>
            <Color x:Key="AColour.Tone1.Background.Static">#181818</Color>
            <Color x:Key="AColour.Tone1.Border.Static">#141414</Color>
            <Color x:Key="AColour.Tone2.Background.Static">#1C1C1C</Color>
            <Color x:Key="AColour.Tone2.Border.Static">#262626</Color>
            <Color x:Key="AColour.Tone3.Background.Static">#353535</Color>
            <Color x:Key="AColour.Tone3.Border.Static">#454545</Color>

            <Color x:Key="AColour.Tone4.Background.Static">#3C3C3C</Color>
            <Color x:Key="AColour.Tone4.Border.Static">#474747</Color>
            <Color x:Key="AColour.Tone4.Background.MouseOver">#454545</Color>
            <Color x:Key="AColour.Tone4.Border.MouseOver">#505050</Color>
            <Color x:Key="AColour.Tone4.Background.MouseDown">#303030</Color>
            <Color x:Key="AColour.Tone4.Border.MouseDown">#3A3A3A</Color>
            <Color x:Key="AColour.Tone4.Background.Selected">#343434</Color>
            <Color x:Key="AColour.Tone4.Background.Selected.Inactive">#2C2C2C</Color>
