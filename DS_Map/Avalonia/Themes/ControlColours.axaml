<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- This file contains shared colours and brushes -->

    <!-- If you fancy going the JetBrains GUI way, where the main UI is just crammed with a single 1px border, then you can use these -->
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{DynamicResource AColour.Tone1.Border.Static}"/>
    <SolidColorBrush x:Key="PanelBackground0" Color="{DynamicResource AColour.Tone0.Background.Static}"/>
    <SolidColorBrush x:Key="PanelBackground1" Color="{DynamicResource AColour.Tone1.Background.Static}"/>
    <SolidColorBrush x:Key="PanelBackground2" Color="{DynamicResource AColour.Tone2.Background.Static}"/>
    <SolidColorBrush x:Key="PanelBackground3" Color="{DynamicResource AColour.Tone3.Background.Static}"/>

    <!-- DSPRE: faces/edges as subtle vertical gradients (Fusion-style "volume") instead of flat
         fills. Top lighter + bottom darker = raised; pressed states invert it. Hand-tuned hex
         (not palette-linked) — retune here if the SoftDark ramp changes. -->
    <!-- Qt Fusion button (faithful port of qfusionstyle.cpp PE_PanelButtonCommand):
         gradient face (≈ buttonColor.lighter(124)→lighter(102)), a DARK outer outline
         (≈ window.darker(140)), and a bright inner contrast line (white @30 alpha) drawn one
         pixel inside the outline. Pressed = flat darker fill, contrast line removed. 2px corners. -->
    <LinearGradientBrush x:Key="Button.Static.Background" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#4E4E4E"/>
        <GradientStop Offset="1" Color="#424242"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#242424"/>
    <LinearGradientBrush x:Key="Button.MouseOver.Background" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#565656"/>
        <GradientStop Offset="1" Color="#4A4A4A"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#242424"/>
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#242424"/>
    <!-- Fusion innerContrastLine() = QColor(255,255,255,30) -->
    <SolidColorBrush x:Key="Button.InnerContrast" Color="#1EFFFFFF"/>
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="{DynamicResource AColour.Tone5.Border.Disabled}"/>
    <SolidColorBrush x:Key="Button.Static.Foreground" Color="{DynamicResource AColour.Foreground.Static}"/>
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="{DynamicResource AColour.Foreground.Disabled}"/>
    <SolidColorBrush x:Key="Button.Defaulted.Background" Color="{DynamicResource AColour.ColourfulGlyph.Static}"/>
    <SolidColorBrush x:Key="Button.Defaulted.Border" Color="{DynamicResource AColour.ColourfulGlyph.Disabled}"/>
    <SolidColorBrush x:Key="ButtonSpinner.Error.Border" Color="Red"/>
    <SolidColorBrush x:Key="ToggleButton.IsChecked.Background" Color="{DynamicResource AColour.AccentTone2.Background.Static}"/>
    <SolidColorBrush x:Key="ToggleButton.IsChecked.Border" Color="{DynamicResource AColour.AccentTone2.Border.Static}"/>
    <SolidColorBrush x:Key="ToggleButton.Pressed.IsChecked.Background" Color="{DynamicResource AColour.Tone6.Border.Selected}"/>
    <SolidColorBrush x:Key="ToggleButton.Pressed.IsChecked.Border" Color="{DynamicResource AColour.Tone6.Border.Selected}"/>
    <SolidColorBrush x:Key="ToggleButton.MouseOver.IsChecked.Background" Color="{DynamicResource AColour.AccentTone1.Background.Static}"/>
    <SolidColorBrush x:Key="ToggleButton.MouseOver.IsChecked.Border" Color="{DynamicResource AColour.AccentTone1.Border.Static}"/>

    <!-- Static (non-editable) ComboBox = ONE contiguous raised button (Fusion CC_ComboBox draws the
         whole combo as a button), not a sunken field. Same face/outline as Button; the arrow blends in. -->
    <LinearGradientBrush x:Key="ComboBox.Static.Background" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#4E4E4E"/>
        <GradientStop Offset="1" Color="#424242"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#242424"/>
    <SolidColorBrush x:Key="ComboBox.Static.Foreground" Color="{DynamicResource AColour.Foreground.Static}"/>
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="{DynamicResource AColour.Tone4.Background.Static}"/>
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="{DynamicResource AColour.Tone4.Border.Static}"/>
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="Transparent"/>
    <!-- Arrow blends into the one-piece button face (just a faint separator from the template) -->
    <SolidColorBrush x:Key="ComboBox.Button.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.Button.Static.Border" Color="{DynamicResource AColour.Tone6.Border.Static}"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Glyph" Color="{DynamicResource AColour.Glyph.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Background" Color="{DynamicResource AColour.Tone4.Background.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Border" Color="{DynamicResource AColour.Tone4.Border.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Background" Color="{DynamicResource AColour.Tone4.Background.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Border" Color="{DynamicResource AColour.Tone4.Border.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.MouseOver.Editable.Button.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Glyph" Color="{DynamicResource AColour.Glyph.MouseDown}"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Background" Color="{DynamicResource AColour.Tone4.Background.MouseDown}"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Border" Color="{DynamicResource AColour.Tone4.Border.MouseDown}"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Background" Color="{DynamicResource AColour.Tone4.Background.MouseDown}"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Border" Color="{DynamicResource AColour.Tone4.Border.MouseDown}"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.Pressed.Editable.Button.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Glyph" Color="{DynamicResource AColour.Glyph.Disabled}"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Background" Color="{DynamicResource AColour.Tone4.Background.Disabled}"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Border" Color="{DynamicResource AColour.Tone4.Border.Disabled}"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Background" Color="{DynamicResource AColour.Tone4.Background.Disabled}"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Border" Color="{DynamicResource AColour.Tone4.Border.Disabled}"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.Disabled.Editable.Button.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="ComboBox.Static.Glyph" Color="{DynamicResource AColour.Glyph.Static}"/>

    <SolidColorBrush x:Key="ComboBoxItem.ItemView.Hover.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.Hover.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.Selected.Background" Color="{DynamicResource AColour.Tone5.Background.Selected}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.Selected.Border" Color="{DynamicResource AColour.Tone5.Border.Selected}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.SelectedHover.Background" Color="{DynamicResource AColour.Tone5.Background.Selected}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.SelectedHover.Border" Color="{DynamicResource AColour.Tone5.Border.Selected}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.SelectedNoFocus.Background" Color="{DynamicResource AColour.Tone5.Background.Selected.Inactive}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.SelectedNoFocus.Border" Color="{DynamicResource AColour.Tone5.Border.Selected.Inactive}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.Focus.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.HoverFocus.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="ComboBoxItem.ItemView.HoverFocus.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>

    <!-- DSPRE: Fusion line edit (PE_FrameLineEdit) — sunken: fill sits a tone below the panel,
         DARK outline (≈ window.darker(140)), and a topShadow() line along the inner top edge.
         No bright inner ring — that's buttons only. -->
    <SolidColorBrush x:Key="TextBox.Static.Background" Color="#191919"/>
    <SolidColorBrush x:Key="TextBox.Static.Border" Color="#242424"/>
    <SolidColorBrush x:Key="TextBox.MouseOver.Border" Color="#242424"/>
    <SolidColorBrush x:Key="TextBox.Focus.Border" Color="{DynamicResource AColour.ColourfulGlyph.Static}"/>
    <SolidColorBrush x:Key="TextBox.Selection.Inactive" Color="{DynamicResource AColour.ColourfulGlyph.Selected.Inactive}"/>
    <SolidColorBrush x:Key="TextBox.Selection" Color="{DynamicResource AColour.ColourfulGlyph.Selected}"/>
    <SolidColorBrush x:Key="TextBox.Error.Border" Color="Red"/>
    <!-- Fusion topShadow() = QColor(0,0,0,18) -->
    <SolidColorBrush x:Key="TextBox.TopShadow" Color="#12000000"/>

    <SolidColorBrush x:Key="ListBox.Static.Background" Color="{DynamicResource AColour.Tone4.Background.Static}"/>
    <SolidColorBrush x:Key="ListBox.Static.Border" Color="{DynamicResource AColour.Tone4.Border.Static}"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="{DynamicResource AColour.Tone4.Background.Disabled}"/>
    <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="{DynamicResource AColour.Tone4.Border.Disabled}"/>
    <SolidColorBrush x:Key="Item.MouseOver.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="Item.MouseOver.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="{DynamicResource AColour.Tone5.Background.Selected.Inactive}"/>
    <SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="{DynamicResource AColour.Tone5.Border.Selected.Inactive}"/>
    <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="{DynamicResource AColour.Tone5.Background.Selected}"/>
    <SolidColorBrush x:Key="Item.SelectedActive.Border" Color="{DynamicResource AColour.Tone5.Border.Selected}"/>

    <SolidColorBrush x:Key="ListView.Static.Background" Color="{DynamicResource AColour.Tone4.Background.Static}"/>
    <SolidColorBrush x:Key="ListView.Static.Border" Color="{DynamicResource AColour.Tone4.Border.Static}"/>
    <SolidColorBrush x:Key="ListView.Disabled.Background" Color="{DynamicResource AColour.Tone4.Background.Disabled}"/>
    <SolidColorBrush x:Key="ListView.Disabled.Border" Color="{DynamicResource AColour.Tone4.Border.Disabled}"/>
    <SolidColorBrush x:Key="ListView.MouseOver.Background" Color="{DynamicResource AColour.Tone4.Background.MouseOver}"/>
    <SolidColorBrush x:Key="ListView.MouseOver.Border" Color="{DynamicResource AColour.Tone4.Border.MouseOver}"/>
    <SolidColorBrush x:Key="ListView.MouseDown.Background" Color="{DynamicResource AColour.Tone4.Background.MouseDown}"/>
    <SolidColorBrush x:Key="ListView.MouseDown.Border" Color="{DynamicResource AColour.Tone4.Border.MouseDown}"/>
    <SolidColorBrush x:Key="ListView.GridView.Static.Background" Color="{DynamicResource AColour.Tone4.Background.Static}"/>
    <SolidColorBrush x:Key="ListView.GridView.Static.Border" Color="{DynamicResource AColour.Tone4.Border.Static}"/>
    <SolidColorBrush x:Key="ListView.GridView.Grip.Background" Color="{DynamicResource AColour.Tone4.Border.Static}"/>
    <SolidColorBrush x:Key="ListView.GridView.HeaderItem.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>

    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#191919"/>
    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="OptionMark.Disabled.Background" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="OptionMark.Disabled.Border" Color="{DynamicResource AColour.Tone5.Border.Disabled}"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Background" Color="{DynamicResource AColour.Tone5.Background.MouseDown}"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Border" Color="{DynamicResource AColour.Tone5.Border.MouseDown}"/>
    <SolidColorBrush x:Key="OptionMark.Static.Glyph" Color="{DynamicResource AColour.Glyph.Static}"/>
    <SolidColorBrush x:Key="OptionMark.Pressed.Glyph" Color="{DynamicResource AColour.Glyph.MouseDown}"/>
    <SolidColorBrush x:Key="OptionMark.MouseOver.Glyph" Color="{DynamicResource AColour.Glyph.MouseOver}"/>
    <SolidColorBrush x:Key="OptionMark.Disabled.Glyph" Color="{DynamicResource AColour.Glyph.Disabled}"/>

    <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="ScrollBarButton.Static.Background" Color="{DynamicResource AColour.Tone6.Background.Static}"/>
    <SolidColorBrush x:Key="ScrollBarButton.Static.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph" Color="{DynamicResource AColour.Glyph.MouseDown}"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="{DynamicResource AColour.Glyph.MouseOver}"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph" Color="{DynamicResource AColour.Glyph.Disabled}"/>
    <SolidColorBrush x:Key="ScrollBar.Static.Glyph" Color="{DynamicResource AColour.Glyph.Static}"/>
    <SolidColorBrush x:Key="ScrollBarSink.MouseOver.Background" Color="{DynamicResource AColour.Tone1.Background.Static}"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="ScrollBar.MouseOver.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="{DynamicResource AColour.Tone5.Background.MouseDown}"/>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="{DynamicResource AColour.Tone5.Border.MouseDown}"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Background" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="ScrollBar.Disabled.Border" Color="{DynamicResource AColour.Tone5.Border.Disabled}"/>
    <!-- Hover feedback: perpendicular gradient (bright left -> dark right), unlike the vertical
         button face. Only applied on :pointerover (not while dragging) — "you found the bar". -->
    <LinearGradientBrush x:Key="ScrollBar.MouseOver.Thumb" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#5C5C5C"/>
        <GradientStop Offset="1" Color="#444444"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#525252"/>
    <LinearGradientBrush x:Key="ScrollBar.Static.Thumb" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#4D4D4D"/>
        <GradientStop Offset="1" Color="#474747"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#191919"/>
    <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#232323"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Background" Color="{DynamicResource AColour.Tone5.Background.MouseDown}"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Border" Color="{DynamicResource AColour.Tone5.Border.MouseDown}"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Background" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Border" Color="{DynamicResource AColour.Tone5.Border.Disabled}"/>
    <SolidColorBrush x:Key="RadioButton.Static.Glyph" Color="{DynamicResource AColour.Glyph.Static}"/>
    <SolidColorBrush x:Key="RadioButton.MouseOver.Glyph" Color="{DynamicResource AColour.Glyph.MouseOver}"/>
    <SolidColorBrush x:Key="RadioButton.Pressed.Glyph" Color="{DynamicResource AColour.Glyph.MouseDown}"/>
    <SolidColorBrush x:Key="RadioButton.Disabled.Glyph" Color="{DynamicResource AColour.Glyph.Disabled}"/>

    <!-- Selected tab = the content-frame colour (Tone4 #3C) so it "connects" seamlessly to the panel
         below it (Fusion tabFrameColor). Top a touch lighter (lighter(104)). -->
    <LinearGradientBrush x:Key="TabItem.Selected.Background" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#414141"/>
        <GradientStop Offset="1" Color="#3C3C3C"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Selected.Border" Color="{DynamicResource AColour.Tone5.Border.Selected}"/>
    <LinearGradientBrush x:Key="TabItem.Static.Background" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#373737"/>
        <GradientStop Offset="1" Color="#333333"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Static.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Background" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="TabItem.MouseOver.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="TabItem.Disabled.Border" Color="{DynamicResource AColour.Tone5.Border.Disabled}"/>

    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Fill" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Circle.Stroke" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Fill" Color="{DynamicResource AColour.Tone5.Background.MouseDown}"/>
    <SolidColorBrush x:Key="Expander.Pressed.Circle.Stroke" Color="{DynamicResource AColour.Tone5.Border.MouseDown}"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Fill" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="Expander.Disabled.Circle.Stroke" Color="{DynamicResource AColour.Tone5.Border.Disabled}"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Fill" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="Expander.Static.Circle.Stroke" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="Expander.Static.Arrow.Stroke" Color="{DynamicResource AColour.Glyph.Static}"/>
    <SolidColorBrush x:Key="Expander.MouseOver.Arrow.Stroke" Color="{DynamicResource AColour.Glyph.MouseOver}"/>
    <SolidColorBrush x:Key="Expander.Pressed.Arrow.Stroke" Color="{DynamicResource AColour.Glyph.MouseDown}"/>
    <SolidColorBrush x:Key="Expander.Disabled.Arrow.Stroke" Color="{DynamicResource AColour.Glyph.Disabled}"/>

    <SolidColorBrush x:Key="GridSplitter.Static.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>

    <SolidColorBrush x:Key="GroupBox.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="GroupBox.Static.Border" Color="{DynamicResource AColour.Tone6.Border.Static}"/>
    <LinearGradientBrush x:Key="GroupBox.Header.Static.Background" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#444444"/>
        <GradientStop Offset="1" Color="#3D3D3D"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GroupBox.Header.Static.Border" Color="{DynamicResource AColour.Tone6.Border.Static}"/>
    <SolidColorBrush x:Key="GroupBox.Header.Foreground" Color="{DynamicResource AColour.Foreground.Static}"/>
    <SolidColorBrush x:Key="GroupBox.Header.Background.Disabled" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="GroupBox.Header.Static.Border.Disabled" Color="{DynamicResource AColour.Tone6.Border.Disabled}"/>
    <SolidColorBrush x:Key="GroupBox.Header.Foreground.Disabled" Color="{DynamicResource AColour.Foreground.Disabled}"/>

    <SolidColorBrush x:Key="Menu.Static.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="MenuItem.Static.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="MenuItem.IconBar.Static.Background" Color="{DynamicResource AColour.Tone6.Background.Static}"/>
    <SolidColorBrush x:Key="MenuItem.IconBar.Static.Border" Color="{DynamicResource AColour.Tone6.Border.Static}"/>
    <SolidColorBrush x:Key="MenuItem.Square.Static.Background" Color="{DynamicResource AColour.Tone6.Background.Static}"/>
    <SolidColorBrush x:Key="MenuItem.Square.Static.Border" Color="{DynamicResource AColour.Tone8.Border.Static}"/>
    <SolidColorBrush x:Key="MenuItem.MouseOver.Background" Color="{DynamicResource AColour.AccentTone2.Background.Static}"/>
    <SolidColorBrush x:Key="MenuItem.MouseOver.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="MenuItem.Disabled.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="Popup.Static.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="Popup.Static.Border" Color="{DynamicResource AColour.Tone7.Border.Static}"/>
    <SolidColorBrush x:Key="Popup.Static.Foreground" Color="{DynamicResource AColour.Foreground.Static}"/>
    <SolidColorBrush x:Key="Popup.Disabled.Background" Color="{DynamicResource AColour.Tone4.Background.Disabled}"/>
    <SolidColorBrush x:Key="Popup.Disabled.Border" Color="{DynamicResource AColour.Tone4.Border.Disabled}"/>
    <SolidColorBrush x:Key="Popup.Disabled.Foreground" Color="{DynamicResource AColour.Foreground.Disabled}"/>
    <SolidColorBrush x:Key="MenuItem.Static.Glyph" Color="{DynamicResource AColour.Glyph.Static}"/>
    <SolidColorBrush x:Key="MenuItem.Disabled.Glyph" Color="{DynamicResource AColour.Glyph.Disabled}"/>

    <SolidColorBrush x:Key="SliderThumb.MouseOver.Background" Color="{DynamicResource AColour.Tone5.Background.MouseOver}"/>
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Border" Color="{DynamicResource AColour.Tone5.Border.MouseOver}"/>
    <SolidColorBrush x:Key="SliderThumb.Pressed.Background" Color="{DynamicResource AColour.Tone5.Background.MouseDown}"/>
    <SolidColorBrush x:Key="SliderThumb.Pressed.Border" Color="{DynamicResource AColour.Tone5.Border.MouseDown}"/>
    <SolidColorBrush x:Key="SliderThumb.Disabled.Background" Color="{DynamicResource AColour.Tone5.Background.Disabled}"/>
    <SolidColorBrush x:Key="SliderThumb.Disabled.Border" Color="{DynamicResource AColour.Tone5.Border.Disabled}"/>
    <SolidColorBrush x:Key="SliderThumb.Static.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="SliderThumb.Static.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="SliderThumb.Static.Foreground" Color="{DynamicResource AColour.Glyph.Disabled}"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Progress.Background" Color="{DynamicResource AColour.ColourfulGlyph.Static}"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Progress.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>

    <SolidColorBrush x:Key="ProgressBar.Progress" Color="{DynamicResource AColour.ColourfulGlyph.Static}"/>
    <SolidColorBrush x:Key="ProgressBar.Background" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="ProgressBar.Border" Color="{DynamicResource AColour.Tone5.Border.Static}"/>

    <SolidColorBrush x:Key="StatusBar.Static.Background" Color="{DynamicResource AColour.Tone4.Background.Static}"/>
    <SolidColorBrush x:Key="StatusBar.Static.Border" Color="{DynamicResource AColour.Tone4.Border.Static}"/>

    <SolidColorBrush x:Key="ToolBarTrayBackground" Color="{DynamicResource AColour.Tone2.Background.Static}"/>
    <SolidColorBrush x:Key="ToolBarHorizontalBackground" Color="{DynamicResource AColour.Tone5.Background.Static}"/>
    <SolidColorBrush x:Key="ToolBarHorizontalBorder" Color="{DynamicResource AColour.Tone5.Border.Static}"/>
    <SolidColorBrush x:Key="ToolBarToggleButtonHorizontalBackground" Color="{DynamicResource AColour.Tone6.Background.Static}"/>
    <SolidColorBrush x:Key="ToolBarToggleButtonHorizontalBorder" Color="{DynamicResource AColour.Tone6.Border.Static}"/>
