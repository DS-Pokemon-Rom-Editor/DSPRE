root = true

# Explicit types instead of var (AGENTS.md). Anonymous types are exempt by the analyzer.
[{DSPRE.Core,DSPRE.Avalonia,DSPRE.Tests}/**.cs]
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0008.severity = error

# Banned APIs (BannedSymbols.txt) fail the build.
[*.cs]
dotnet_diagnostic.RS0030.severity = error

# The write paths themselves.
[{DSPRE.Core/DSUtils/DSUtils.cs,DSPRE.Core/ArchiveMembers.cs,DSPRE.Core/PlainFiles.cs}]
dotnet_diagnostic.RS0030.severity = none

