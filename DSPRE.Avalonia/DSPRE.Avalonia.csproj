<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform Avalonia shell: the entire Avalonia UI layer + a thin Main. Runs on any
       desktop OS. The Windows DSPRE exe references this project and hosts the same UI alongside
       the legacy WinForms shell during the transition. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- The -Linux configurations (IDE dropdown) build this exe against the linux-x64 runtime.
         For distributable output use `dotnet publish` with the profiles in Properties\PublishProfiles. -->
    <Configurations>Debug;Release;Debug-Linux;Release-Linux</Configurations>
    <AssemblyName>DSPRE.Avalonia</AssemblyName>
    <RootNamespace>DSPRE</RootNamespace>
    <ApplicationIcon>../app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Keep in sync with DS_Map\Properties\AssemblyInfo.cs (AppInfo.GetDSPREVersion shows this). -->
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- Avalonia views intentionally have no parameterless constructor (require ViewModel) -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- Pre-existing code warnings in legacy files (same set DS_Map suppresses) -->
    <NoWarn>$(NoWarn);CS0649;CS0414;CS0169;CS0168;CS0197;CS0109;CS8981;CA2200</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.EndsWith('-Linux'))">
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release-Linux'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Views and view models are filed under the menu each editor opens from, and each folder is
       its own namespace. Consumers see them as one surface, so the sections are global usings
       rather than a using line in every file. -->
  <ItemGroup>
    <Using Include="DSPRE.Avalonia.ViewModels.Audio" />
    <Using Include="DSPRE.Avalonia.ViewModels.Battle" />
    <Using Include="DSPRE.Avalonia.ViewModels.Controls" />
    <Using Include="DSPRE.Avalonia.ViewModels.Graphics" />
    <Using Include="DSPRE.Avalonia.ViewModels.Items" />
    <Using Include="DSPRE.Avalonia.ViewModels.Pokemon" />
    <Using Include="DSPRE.Avalonia.ViewModels.Shell" />
    <Using Include="DSPRE.Avalonia.ViewModels.Text" />
    <Using Include="DSPRE.Avalonia.ViewModels.Tools" />
    <Using Include="DSPRE.Avalonia.ViewModels.Trainers" />
    <Using Include="DSPRE.Avalonia.ViewModels.World" />
    <Using Include="DSPRE.Avalonia.Views.Audio" />
    <Using Include="DSPRE.Avalonia.Views.Battle" />
    <Using Include="DSPRE.Avalonia.Views.Controls" />
    <Using Include="DSPRE.Avalonia.Views.Graphics" />
    <Using Include="DSPRE.Avalonia.Views.Items" />
    <Using Include="DSPRE.Avalonia.Views.Pokemon" />
    <Using Include="DSPRE.Avalonia.Views.Shell" />
    <Using Include="DSPRE.Avalonia.Views.Text" />
    <Using Include="DSPRE.Avalonia.Views.Tools" />
    <Using Include="DSPRE.Avalonia.Views.Trainers" />
    <Using Include="DSPRE.Avalonia.Views.World" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Avalonia\Assets\**" />
    <!-- Also embedded via DS_Map\Properties\Resources.resx for the legacy WinForms shell; shared, not moved. -->
    <AvaloniaResource Include="..\DS_Map\Resources\Graphics\**" Link="Resources\Graphics\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Windows DSPRE exe (and tests) still reach into UI-layer internals from the one-project era. -->
    <InternalsVisibleTo Include="DSPRE" />
    <InternalsVisibleTo Include="DSPRE.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSPRE.Core\DSPRE.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="Avalonia.Labs.Gif" Version="12.0.2" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
    <!-- Real sound-effect playback (NAudioOutput). Its actual output device is Windows-only, guarded at
         runtime via OperatingSystem.IsWindows() so a Linux build/run just stays silent instead of throwing. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script editor grammar; flows to referencing projects' output too. -->
    <Content Include="Avalonia\TextMate\rotom.tmLanguage.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <!-- Native tools (Windows builds; swap per-OS binaries in later). -->
    <Content Include="../Tools/**" LinkBase="Tools">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
