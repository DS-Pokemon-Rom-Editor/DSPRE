<Application xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="DSPRE.AvaloniaApp"
			 RequestedThemeVariant="Dark">

	<!-- Theme-aware editor chrome brushes (toolbars, status bars, separators, subtle text).
	     Defined per ThemeVariant so editors follow the internal Qt Fusion palette. -->
	<Application.Resources>
		<ResourceDictionary>
			<!-- Internal Qt Fusion palette + control-colour mapping. -->
			<ResourceDictionary.MergedDictionaries>
				<MergeResourceInclude Source="Themes/Colours/Fusion.axaml"/>
				<MergeResourceInclude Source="Themes/ControlColours.axaml"/>
			</ResourceDictionary.MergedDictionaries>
			<!-- Compatibility aliases: a few views (and the old DataGrid theme) reference Fluent
			     "SystemControl*" resource keys that SimpleTheme doesn't define. Map them to the
			     Fusion palette so StaticResource lookups don't throw KeyNotFoundException. -->
			<SolidColorBrush x:Key="SystemControlTransparentBrush"             Color="Transparent"/>
			<SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"    Color="{DynamicResource AColour.Foreground.Disabled}"/>
			<SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush" Color="{DynamicResource AColour.Tone2.Border.Static}"/>
			<SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush"     Color="{DynamicResource AColour.Tone4.Background.Static}"/>
			<x:Double x:Key="ControlContentThemeFontSize">12</x:Double>

			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="Editor.ToolbarBg"  Color="#EFEFEF"/>
					<SolidColorBrush x:Key="Editor.PanelBg"    Color="#FAFAFA"/>
					<SolidColorBrush x:Key="Editor.StatusBg"   Color="#EFEFEF"/>
					<SolidColorBrush x:Key="Editor.Border"     Color="#ABABAB"/>
					<SolidColorBrush x:Key="Editor.Separator"  Color="#B8B8B8"/>
					<SolidColorBrush x:Key="Editor.MenuSeparator" Color="#C4C4C4"/>
					<SolidColorBrush x:Key="Editor.Text"       Color="#000000"/>
					<SolidColorBrush x:Key="Editor.Subtle"     Color="#767676"/>
					<SolidColorBrush x:Key="Editor.Good"       Color="#1B7F2E"/>
					<SolidColorBrush x:Key="Editor.Warn"       Color="#A65B00"/>
					<SolidColorBrush x:Key="Editor.Bad"        Color="#C22323"/>
					<!-- A nature's raised and lowered stat, as the summary screen colours them. -->
					<SolidColorBrush x:Key="Stat.Up"           Color="#C22323"/>
					<SolidColorBrush x:Key="Stat.Down"         Color="#1F5FBF"/>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="Editor.ToolbarBg"  Color="#323232"/>
					<SolidColorBrush x:Key="Editor.PanelBg"    Color="#323232"/>
					<SolidColorBrush x:Key="Editor.StatusBg"   Color="#262626"/>
					<SolidColorBrush x:Key="Editor.Border"     Color="#242424"/>
					<SolidColorBrush x:Key="Editor.Separator"  Color="#212121"/>
					<SolidColorBrush x:Key="Editor.MenuSeparator" Color="#4A4A4A"/>
					<SolidColorBrush x:Key="Editor.Text"       Color="#F0F0F0"/>
					<SolidColorBrush x:Key="Editor.Subtle"     Color="#828282"/>
					<SolidColorBrush x:Key="Editor.Good"       Color="#5FD07A"/>
					<SolidColorBrush x:Key="Editor.Warn"       Color="#F0A250"/>
					<SolidColorBrush x:Key="Editor.Bad"        Color="#FF7B72"/>
					<SolidColorBrush x:Key="Stat.Up"           Color="#FF7B72"/>
					<SolidColorBrush x:Key="Stat.Down"         Color="#6CA8FF"/>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<!-- DSPRE Qt Fusion control themes over Avalonia SimpleTheme. -->
		<SimpleTheme/>
		<StyleInclude Source="Themes/Controls.axaml"/>
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml"/>
		<StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml"/>

		<!-- Control sizes and corners live in Themes/DspreTweaks.axaml. -->
		<Style Selector=":disabled Image.icon">
			<Setter Property="Opacity" Value="0.4"/>
		</Style>
		<Style Selector="ComboBox">
			<!-- Typing in a combo box jumps to the matching item; Avalonia leaves this off. -->
			<Setter Property="IsTextSearchEnabled" Value="True"/>
		</Style>
		<!-- Spin boxes show whole numbers; the decimal ones set their own FormatString. -->
		<Style Selector="NumericUpDown">
			<Setter Property="MinWidth" Value="84"/>
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="FormatString" Value="0"/>
		</Style>

		<!-- A WrapPanel with Classes="toolbar" wraps its buttons onto a new line when the window is narrow. -->
		<Style Selector="WrapPanel.toolbar > :is(Control)">
			<Setter Property="Margin" Value="0,2,6,2"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<!-- Menu dividers get their own colour; the plain one looks like a gap in dark mode. -->
		<Style Selector="MenuItem Separator, ContextMenu Separator, Menu Separator">
			<Setter Property="Background" Value="{DynamicResource Editor.MenuSeparator}"/>
			<Setter Property="Margin" Value="6,4"/>
		</Style>

		<!-- Rows of flag check boxes get room between wrapped lines, not only between boxes. -->
		<Style Selector="WrapPanel.flags > CheckBox">
			<Setter Property="Margin" Value="0,3,16,5"/>
		</Style>

		<!-- Check boxes show data names (SPECIES_X, F_PRIORITIZE_...); an access key would hide their first "_".
		     Every check box gives its label as text so this one template draws it. -->
		<Style Selector="CheckBox">
			<Setter Property="ContentTemplate">
				<DataTemplate x:DataType="x:String">
					<TextBlock Text="{Binding}"/>
				</DataTemplate>
			</Setter>
		</Style>

		<!-- Long tooltips wrap at roughly 100 characters instead of running across the screen. -->
		<Style Selector="ToolTip /template/ ContentPresenter">
			<Setter Property="MaxWidth" Value="620"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
		</Style>

		<!-- A disabled control's tooltip is usually the reason it is disabled, and Avalonia hides it unless asked. -->
		<Style Selector=":is(Control)">
			<Setter Property="ToolTip.ShowOnDisabled" Value="True"/>
		</Style>
		<!-- DSPRE-local rounding + tweaks (last so its setters win over the base Fusion themes). -->
		<StyleInclude Source="Themes/DspreTweaks.axaml"/>
	</Application.Styles>

</Application>
