<Window MinWidth="760" MinHeight="520" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Audio"
        xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Controls"
        x:Class="DSPRE.Avalonia.Views.Audio.AudioEditorView"
        x:DataType="vm:AudioEditorViewModel"
        Title="Audio Editor"
        Width="860" Height="700"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:AudioEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel Classes="toolbar">
        <StackPanel x:Name="SaveButtons" Orientation="Horizontal" Spacing="6">
          <Button Content="Save" Click="Save_Click"
                  IsEnabled="{Binding HasUnsavedChanges}" ToolTip.Tip="Write what was imported."/>
          <Button Content="Discard" Click="Discard_Click"
                  IsEnabled="{Binding HasUnsavedChanges}" ToolTip.Tip="Forget what was imported."/>
        </StackPanel>
        <TextBox PlaceholderText="Search every tab by name or number" x:Name="SearchBox"
                 Text="{Binding Search}" FontSize="13" Width="280" Margin="12,2,6,2">
          <TextBox.InnerRightContent>
            <Button Content="✕" Click="ClearSearch_Click" Padding="8,2" Margin="0,0,2,0"
                    Background="Transparent" BorderThickness="0"
                    ToolTip.Tip="Empty the search box"
                    IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </TextBox.InnerRightContent>
        </TextBox>
        <StackPanel x:Name="AudioActions" Orientation="Horizontal" Spacing="6">
          <Button Content="Export WAV" Click="Export_Click" IsEnabled="{Binding CanPlay}"
                  ToolTip.Tip="Save this as a WAV. A cry is saved as its own sample; everything else is saved as it sounds when played."/>
          <Button Content="Export MIDI" Click="ExportMidi_Click" IsEnabled="{Binding CanSaveMidi}"
                  ToolTip.Tip="{Binding SaveMidiHelp}"/>
          <Button Content="Export SoundFont" Click="ExportSoundFont_Click"
                  IsEnabled="{Binding CanSaveSoundFont}" ToolTip.Tip="{Binding SaveSoundFontHelp}"/>
          <Button Content="Import" Click="Import_Click" IsEnabled="{Binding CanImport}"
                  ToolTip.Tip="{Binding ImportHelp}"/>
        </StackPanel>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource Editor.StatusBg}">
      <StackPanel Spacing="6">

        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                Background="{DynamicResource Editor.PanelBg}" Height="118">
          <views:NoteTrackView x:Name="Notes"
                               PointerPressed="Notes_PointerPressed"
                               ToolTip.Tip="The notes the sequence plays, time across and pitch up, one colour per track. Click anywhere to play from there."/>
        </Border>

        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                Background="{DynamicResource Editor.PanelBg}" Height="88">
          <views:WaveformView x:Name="Wave"
                              WaveBrush="{DynamicResource Editor.Subtle}"
                              PointerPressed="Wave_PointerPressed"
                              ToolTip.Tip="The two channels, loudest to quietest. Click anywhere to play from there."/>
        </Border>

        <Grid x:Name="PlayBar" ColumnDefinitions="Auto,6,Auto,10,Auto,12,Auto,*">
          <Button Grid.Column="0" Content="▶  Play" Click="Play_Click" Width="86" IsEnabled="{Binding CanPlay}"/>
          <Button Grid.Column="2" x:Name="StopButton" Content="■  Stop" Click="Stop_Click" Width="86" IsEnabled="False"/>
          <CheckBox Grid.Column="4" x:Name="LoopBox" Content="Loop"
                    ToolTip.Tip="Keep playing it round until you press Stop."/>
          <TextBlock Grid.Column="6" x:Name="TimeText" Text="0:00.0 / 0:00.0" VerticalAlignment="Center"
                     FontFamily="Consolas,monospace" FontSize="12"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Grid.Column="7" Margin="14,0,0,0" Text="{Binding SelectedDescription}"
                     VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="{Binding FoundSummary}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource Editor.Subtle}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl Margin="6" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Cries">
        <ListBox ItemsSource="{Binding Cries}" SelectedItem="{Binding SelectedCry}"
                 DoubleTapped="List_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="13"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="Music">
        <ListBox ItemsSource="{Binding Music}" SelectedItem="{Binding SelectedMusic}"
                 DoubleTapped="List_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="13"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="Fanfares">
        <ListBox ItemsSource="{Binding Fanfares}" SelectedItem="{Binding SelectedFanfare}"
                 DoubleTapped="List_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="13"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="Sound effects">
        <ListBox ItemsSource="{Binding Effects}" SelectedItem="{Binding SelectedEffect}"
                 DoubleTapped="List_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="13"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="Sounds"
               ToolTip.Tip="The sounds the music and the sound effects are made of. Each one can be heard, saved and replaced.">
        <ListBox ItemsSource="{Binding Sounds}" SelectedItem="{Binding SelectedSound}"
                 DoubleTapped="List_DoubleTapped">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="13"/></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
