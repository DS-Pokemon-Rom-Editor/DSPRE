<Window MinWidth="620" MinHeight="420" xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Tools"
		xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		x:Class="DSPRE.Avalonia.Views.Tools.OverlayEditorView"
		x:DataType="vm:OverlayEditorViewModel"
		Title="{Binding Title}"
		Width="620" Height="500"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:OverlayEditorViewModel/>
  </Design.DataContext>


  <DockPanel LastChildFill="True">

	<Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
			BorderThickness="0,0,0,1" Padding="6,4">
	  <StackPanel Orientation="Horizontal" Spacing="6">
		<Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<Button Content="Discard" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<controls:UndoRedoButtons/>
		<Button Content="Decompress All" IsEnabled="{Binding IsNotDsRomProject}" Click="DecompressAll_Click" Margin="12,0,0,0"/>
		<Button Content="Toggle Marked"  IsEnabled="{Binding IsNotDsRomProject}" Click="ToggleMarked_Click"/>
	  </StackPanel>
	</Border>

	<!-- ds-rom projects: read only -->
	<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,0" IsVisible="{Binding IsDsRomProject}">
	  <TextBlock Text="Read only: ds-rom handles the compression" FontWeight="SemiBold" VerticalAlignment="Center"/>
	  <controls:HelpTip Text="Overlays sit uncompressed on disk so they can be edited. Compressed marks the ones compressed again on Save ROM, a choice that lives in overlays.yaml."/>
	</StackPanel>

	<DataGrid ItemsSource="{Binding Overlays}" Margin="10"
			  IsReadOnly="{Binding IsDsRomProject}"
			  CanUserReorderColumns="False"
			  CanUserResizeColumns="False"
			  CanUserSortColumns="False"
			  GridLinesVisibility="All"
			  SelectionMode="Single">
	  <DataGrid.Columns>
		<DataGridTextColumn   Header="Overlay ID"           Binding="{Binding Number}"              IsReadOnly="True"  Width="80"/>
		<DataGridTemplateColumn Header="Compressed"         Width="90">
		  <DataGridTemplateColumn.CellTemplate>
			<DataTemplate x:DataType="vm:OverlayRow">
			  <Border Background="{Binding MismatchBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<CheckBox IsChecked="{Binding IsCompressed}" HorizontalAlignment="Center" VerticalAlignment="Center"
						  IsEnabled="{Binding $parent[Window].((vm:OverlayEditorViewModel)DataContext).IsNotDsRomProject}"/>
			  </Border>
			</DataTemplate>
		  </DataGridTemplateColumn.CellTemplate>
		</DataGridTemplateColumn>
		<DataGridTemplateColumn Header="Marked Compressed"  Width="130">
		  <DataGridTemplateColumn.CellTemplate>
			<DataTemplate x:DataType="vm:OverlayRow">
			  <Border Background="{Binding MismatchBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
				<CheckBox IsChecked="{Binding IsMarkedCompressed}" HorizontalAlignment="Center" VerticalAlignment="Center"
						  IsEnabled="{Binding $parent[Window].((vm:OverlayEditorViewModel)DataContext).IsNotDsRomProject}"/>
			  </Border>
			</DataTemplate>
		  </DataGridTemplateColumn.CellTemplate>
		</DataGridTemplateColumn>
		<DataGridTextColumn   Header="RAM Address"          Binding="{Binding RAMAddressHex}"       IsReadOnly="True"  Width="110"/>
		<DataGridTextColumn   Header="Uncompressed Size"    Binding="{Binding UncompressedSize}"    IsReadOnly="True"  Width="130"/>
	  </DataGrid.Columns>
	</DataGrid>

  </DockPanel>
</Window>
