<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Tools"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.Tools.PatchToolboxView"
        x:DataType="vm:PatchToolboxViewModel"
        Title="ROM patch toolbox"
        Width="1280" Height="760" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:PatchToolboxViewModel/>
  </Design.DataContext>

  <DockPanel Margin="0">

    <!-- ── Caution banner ─────────────────────────────────────────────── -->
    <Border x:Name="CautionBanner" DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Generate credits" Click="GenerateCredits_Click"
                IsEnabled="{Binding CanGenerateCredits}"/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBox Width="220" PlaceholderText="Find a patch" Text="{Binding Search}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding HeaderNote}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <controls:HelpTip Text="These patches change the game's code, overlays and data archives directly."/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Patch list, one tab per area ───────────────────────────────── -->
    <TabControl ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PatchTabViewModel">
          <TextBlock Text="{Binding Header}"/>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:PatchTabViewModel">
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}" Margin="4" VerticalAlignment="Top">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PatchRowViewModel">
            <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="4">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="3">
                  <!-- Authors sit under the title: beside it, a long credit ran under the Apply button. -->
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AuthorText}" IsVisible="{Binding HasAuthor}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource Editor.Subtle}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource Editor.Subtle}"/>
                  <ItemsControl ItemsSource="{Binding Parts}" IsVisible="{Binding HasParts}" Margin="10,4,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PatchPartViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                          <TextBlock Text="{Binding Title}" FontSize="12" Width="170"/>
                          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowStatusText}"
                             Foreground="{Binding StatusBrush}" Margin="0,2,0,0"/>
                  <Button Content="{Binding RequiresText}" IsVisible="{Binding HasRequires}" Click="Requires_Click"
                          Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold"
                          Foreground="{Binding StatusBrush}" Cursor="Hand" ToolTip.Tip="Opens the tab with the patch this one needs"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button Content="{Binding ButtonText}" MinWidth="96" Height="32" HorizontalAlignment="Stretch"
                          IsVisible="{Binding ShowApply}" IsEnabled="{Binding CanApply}" Click="Apply_Click"/>
                  <Button Content="Open page" controls:Icon.Key="OpenLink" Height="32" HorizontalAlignment="Stretch"
                          IsVisible="{Binding HasLink}" ToolTip.Tip="{Binding Link}" Click="OpenLink_Click"/>
                  <Button Content="Notes" MinWidth="96" HorizontalAlignment="Stretch" Click="Notes_Click"/>
                  <Button Content="Guide" controls:Icon.Key="OpenLink" MinWidth="96" HorizontalAlignment="Stretch"
                          IsVisible="{Binding HasGuide}" ToolTip.Tip="{Binding Guide}" Click="Guide_Click"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>

  </DockPanel>
</Window>
