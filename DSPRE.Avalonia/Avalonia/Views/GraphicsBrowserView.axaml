<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.GraphicsBrowserView"
        x:DataType="vm:GraphicsBrowserViewModel"
        Title="Graphics"
        Width="980" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:GraphicsBrowserViewModel/>
  </Design.DataContext>

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource Editor.StatusBg}">
      <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Grid.Column="0" PlaceholderText="Search by name or number, like trainer or icon"
                 Text="{Binding Search}" FontSize="13"/>
        <Button Grid.Column="2" Content="Close" Click="Close_Click" Width="66"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource Editor.StatusBg}">
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding FoundSummary}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Editor.Subtle}"/>
        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource Editor.Subtle}"/>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="300,6,*" Margin="6">

      <DockPanel Grid.Column="0">
        <!-- One tab per kind of graphic. The list runs to thousands of entries, so landing on a kind
             first is quicker than typing at all of them. -->
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                 Background="Transparent" BorderThickness="0" Margin="0,0,0,6" MaxHeight="170"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,3"/>
              <Setter Property="Margin" Value="0,0,3,3"/>
              <Setter Property="CornerRadius" Value="3"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GraphicsBrowserViewModel+CategoryTab">
              <TextBlock Text="{Binding Header}" FontSize="12" ToolTip.Tip="{Binding What}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ListBox ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GraphicsBrowserViewModel+Item">
              <TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="13"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent"/>

      <DockPanel Grid.Column="2">

        <Border DockPanel.Dock="Top" Padding="0,0,0,8">
          <StackPanel Spacing="6">
            <!-- The files that make up the thing picked. A Pokemon's battle sprites are six files and a
                 trainer is five, so they are grouped into one row and offered here instead. -->
            <ListBox ItemsSource="{Binding Parts}" SelectedIndex="{Binding PartIndex, Mode=TwoWay}"
                     IsVisible="{Binding HasParts}" Background="Transparent" BorderThickness="0"
                     MaxHeight="72" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="8,3"/>
                  <Setter Property="Margin" Value="0,0,3,3"/>
                  <Setter Property="CornerRadius" Value="3"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GraphicsBrowserViewModel+Part">
                  <TextBlock Text="{Binding Label}" FontSize="12"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding Details}" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DeepEditorHint}" IsVisible="{Binding HasDeepEditor}"
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>
            <WrapPanel Classes="toolbar" Orientation="Horizontal">
              <Button Content="Save picture" Click="SavePicture_Click"
                      IsEnabled="{Binding CanSavePicture}"
                      ToolTip.Tip="{Binding SavePictureHelp}"/>
              <Button Content="Save file as it is" Click="SaveRaw_Click"
                      ToolTip.Tip="Save the whole entry exactly as it sits in the ROM. Always possible, and the only way to keep everything about an entry that is not a picture."/>
              <Button Content="Put a picture in" Click="Replace_Click"
                      IsEnabled="{Binding CanReplace}"
                      ToolTip.Tip="{Binding ReplaceHelp}"/>
              <CheckBox Content="Shiny" IsChecked="{Binding ShowShiny, Mode=TwoWay}"
                        IsEnabled="{Binding CanShowShiny}" VerticalAlignment="Center"
                        Margin="10,0,4,0" FontSize="12" ToolTip.Tip="{Binding ShinyHelp}"/>
              <Button Content="{Binding OwningEditorLabel}" Click="OpenOwner_Click"
                      IsEnabled="{Binding HasOwningEditor}"
                      ToolTip.Tip="{Binding OwningEditorHelp}"/>
              <Button Content="Paint this" Click="Paint_Click"
                      IsEnabled="{Binding CanReplace}"
                      ToolTip.Tip="{Binding ReplaceHelp}"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource Editor.PanelBg}"
                BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
          <Panel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding HasPicture}">
              <!-- Most of these are small, some only sixteen pixels across, so they are blown up to a
                   readable size with square pixels rather than shown actual size in a large empty panel. -->
              <Image Source="{Binding Picture}" Stretch="Uniform"
                     Width="{Binding ShownWidth}" Height="{Binding ShownHeight}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     RenderOptions.BitmapInterpolationMode="None" Margin="12"/>
            </ScrollViewer>

            <TextBlock Text="{Binding Whynot}" IsVisible="{Binding HasNoPicture}"
                       TextWrapping="Wrap" MaxWidth="420" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Margin="24"
                       Foreground="{DynamicResource Editor.Subtle}"/>
          </Panel>
        </Border>

      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
