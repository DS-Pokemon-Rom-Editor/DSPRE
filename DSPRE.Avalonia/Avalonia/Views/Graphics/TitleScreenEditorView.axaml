<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
		xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		x:Class="DSPRE.Avalonia.Views.Graphics.TitleScreenEditorView"
		x:DataType="vm:TitleScreenEditorViewModel">
  <Design.DataContext>
    <vm:TitleScreenEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Bad}" VerticalAlignment="Center"/>
    </Border>

    <controls:EditorToolbar x:Name="SaveButtons">
      <TextBlock Text="Version" VerticalAlignment="Center" Margin="0,0,6,0" controls:EditorToolbar.Slot="Picker"/>
      <ComboBox Width="140" SelectedIndex="{Binding SelectedTabIndex}" controls:EditorToolbar.Slot="Picker">
        <ComboBoxItem Content="HeartGold"/>
        <ComboBoxItem Content="SoulSilver"/>
      </ComboBox>
      <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasChanges}"/>
      <Button Content="Discard" controls:Icon.Key="resetIcon" Click="RevertChanges_Click" IsEnabled="{Binding HasChanges}"/>
      <controls:UndoRedoButtons/>
    </controls:EditorToolbar>

    <!-- The pieces -->
    <Border DockPanel.Dock="Left" Classes="screenList" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Pieces" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ListBox x:Name="PieceList" ItemsSource="{Binding Pieces}" SelectedIndex="{Binding PieceIndex}"/>
      </DockPanel>
    </Border>

    <!-- What is picked -->
    <Border DockPanel.Dock="Right" Classes="screenPanel" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1,0,0,0">
      <StackPanel Margin="8" Spacing="8">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding PieceName}" FontWeight="SemiBold"/>
          <controls:HelpTip Text="Rebuilt when you import the logo or background" IsVisible="{Binding PieceIsColours}"/>
        </StackPanel>
        <Border Background="#181818" HorizontalAlignment="Left" IsVisible="{Binding PieceIsImage}">
          <Image Source="{Binding PiecePreview}" Width="256" Height="192" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding PieceIsImage}">
          <Button Content="Import PNG…" controls:Icon.Key="import" Click="ImportPiece_Click"/>
          <Button Content="Export PNG…" controls:Icon.Key="export" Click="ExportPiece_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding PieceIsColours}">
          <Button Content="Import colours…" controls:Icon.Key="import" Click="ImportPalette_Click"/>
          <Button Content="Export colours…" controls:Icon.Key="export" Click="ExportPalette_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The screen as the game shows it -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="Top screen" Classes="screenCaption"/>
        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Background="#181818" ClipToBounds="True">
          <Grid Width="512" Height="384">
            <Image Source="{Binding BackgroundPreview}" Width="512" Height="384" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
            <Image x:Name="LogoOverlay" Source="{Binding LogoPreview}" Width="512" Height="384" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="None">
              <Image.RenderTransform>
                <TranslateTransform/>
              </Image.RenderTransform>
            </Image>
            <Image Source="{Binding CopyrightPreview}" Width="512" Height="384" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
          </Grid>
        </Border>
        <Button Content="Play intro" controls:Icon.Key="play" Click="PlayIntro_Click" HorizontalAlignment="Center"
                ToolTip.Tip="Plays the logo's entrance"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
