<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
        x:Class="DSPRE.Avalonia.Views.Graphics.CellAnimationEditorView"
        x:DataType="vm:CellAnimationEditorViewModel"
        Title="Cell Animation"
        Width="1180" Height="760" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:CellAnimationEditorViewModel/>
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" Classes="hint" VerticalAlignment="Center"/>
    </Border>

    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}"/>
          <Button Content="Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}"/>
          <Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding FileNote}" Classes="hint" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Sequences. A file can hold hundreds, so there is a way to go straight to one. -->
    <Border DockPanel.Dock="Left" Width="270" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <TextBlock Text="Go to" Classes="label"/>
          <NumericUpDown Value="{Binding JumpTo}" Minimum="0" Increment="1" Width="110" FormatString="0"
                         ToolTip.Tip="Jump straight to a sequence by its number"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <Button Content="Add on the end" Click="AddSequence_Click" FontSize="11" Padding="7,2"/>
          <Button Content="Remove the last" Click="RemoveSequence_Click" FontSize="11" Padding="7,2"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Sequences}" SelectedIndex="{Binding SelectedSequence}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CellSequenceRow">
              <StackPanel>
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Editor.Subtle}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The frames of the chosen sequence -->
    <Border DockPanel.Dock="Right" Width="330" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="1,0,0,0">
      <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <TextBlock Text="This sequence" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Plays" Classes="label" Width="56"/>
            <ComboBox ItemsSource="{Binding PlayModes}" SelectedIndex="{Binding PlayModeIndex}" Width="150"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanLoop}">
            <TextBlock Text="Back to" Classes="label" Width="56"/>
            <NumericUpDown Value="{Binding LoopStart}" Minimum="1" Maximum="{Binding FrameCount}"
                           Increment="1" Width="110" FormatString="0"
                           ToolTip.Tip="The frame it returns to. Earlier frames play once on the way in."/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Draws" Classes="label" Width="56"/>
            <ComboBox ItemsSource="{Binding AnimationTypes}" SelectedIndex="{Binding AnimationTypeIndex}"
                      Width="150"/>
          </StackPanel>
          <TextBlock Text="{Binding AnimationTypeWarning}" Classes="hint"
                     IsVisible="{Binding HasAnimationTypeWarning}"/>

          <TextBlock Text="Frames" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <CheckBox Content="Change a shared drawing everywhere"
                    IsChecked="{Binding ChangeEverywhere}"
                    ToolTip.Tip="Off, a change gives this frame its own copy and leaves the others alone"/>
        </StackPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Frames}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CellFrameRow">
                <Border Margin="0,0,0,6" Padding="8" CornerRadius="4"
                        Background="{DynamicResource Editor.PanelBg}"
                        BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Drawing" Classes="label" Width="56"/>
                      <NumericUpDown Value="{Binding Cell}" Minimum="0" Increment="1"
                                     Width="110" FormatString="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Hold" Classes="label" Width="56"/>
                      <NumericUpDown Value="{Binding Delay}" Minimum="0" Increment="1"
                                     Width="110" FormatString="0"
                                     ToolTip.Tip="In sixtieths of a second. A hold of none is passed straight over."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanTurn}">
                      <TextBlock Text="Turn" Classes="label" Width="56"/>
                      <NumericUpDown Value="{Binding Turn}" Minimum="-360" Maximum="360" Increment="5"
                                     Width="110" FormatString="0.#"
                                     ToolTip.Tip="In degrees"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanTurn}">
                      <TextBlock Text="Stretch" Classes="label" Width="56"/>
                      <NumericUpDown Value="{Binding StretchAcross}" Minimum="-8" Maximum="8" Increment="0.1"
                                     Width="74" FormatString="0.00"/>
                      <NumericUpDown Value="{Binding StretchDown}" Minimum="-8" Maximum="8" Increment="0.1"
                                     Width="74" FormatString="0.00"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CanShift}">
                      <TextBlock Text="Move" Classes="label" Width="56"/>
                      <NumericUpDown Value="{Binding ShiftAcross}" Minimum="-512" Maximum="512" Increment="1"
                                     Width="74" FormatString="0"/>
                      <NumericUpDown Value="{Binding ShiftDown}" Minimum="-512" Maximum="512" Increment="1"
                                     Width="74" FormatString="0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SharedNote}" Classes="hint"
                               IsVisible="{Binding IsShared}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                      <Button Content="Add after" Click="AddFrame_Click" Tag="{Binding Number}"
                              FontSize="11" Padding="7,2"/>
                      <Button Content="Remove" Click="RemoveFrame_Click" Tag="{Binding Number}"
                              FontSize="11" Padding="7,2"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- The animation itself -->
    <StackPanel Margin="12" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top">
      <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
        <Image Source="{Binding Preview}" Width="512" Height="384" Stretch="Uniform"
               RenderOptions.BitmapInterpolationMode="None"/>
      </Border>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button Content="{Binding PlayLabel}" Click="Play_Click" Width="90"/>
        <CheckBox Content="Inside the Pokétch" IsChecked="{Binding InCasing}"
                  IsVisible="{Binding InPoketch}" VerticalAlignment="Center"
                  ToolTip.Tip="Draw the sprite in the application's own screen, where a player sees it"/>
        <Button Content="{Binding PoketchAppName}" Click="BackToPoketch_Click"
                IsVisible="{Binding InPoketch}"
                ToolTip.Tip="Open the Bottom Screen editor on the application this belongs to"/>
      </StackPanel>
      <!-- Where the pieces of one drawing sit. The preview follows a move straight away. -->
      <Border IsVisible="{Binding CanMovePieces}" Padding="10" CornerRadius="4" MaxWidth="512"
              Background="{DynamicResource Editor.PanelBg}"
              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding PieceHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding PieceCell}" Minimum="0" Increment="1" Width="100" FormatString="0"
                           ToolTip.Tip="Which drawing's pieces to move"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Pieces}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CellPieceRow">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
                  <TextBlock Text="{Binding Title}" Classes="label" Width="132"/>
                  <TextBlock Text="Across" Classes="label"/>
                  <NumericUpDown Value="{Binding Across}" Minimum="-256" Maximum="255" Increment="1"
                                 Width="96" FormatString="0"/>
                  <TextBlock Text="Down" Classes="label"/>
                  <NumericUpDown Value="{Binding Down}" Minimum="-128" Maximum="127" Increment="1"
                                 Width="96" FormatString="0"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="hint" HorizontalAlignment="Center" MaxWidth="480"
                 Text="Sequences are reached by number in the games' own code, so they cannot be reordered."/>
    </StackPanel>

  </DockPanel>
</Window>
