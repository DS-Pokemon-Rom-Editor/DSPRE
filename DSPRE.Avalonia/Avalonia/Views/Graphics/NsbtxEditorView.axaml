<Window MinWidth="760" MinHeight="480" xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
        x:Class="DSPRE.Avalonia.Views.Graphics.NsbtxEditorView"
        x:DataType="vm:NsbtxEditorViewModel"
        Title="Map &amp; Building Textures"
        Width="800" Height="560"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:NsbtxEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel Classes="toolbar">
        <Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="2,2"/>
        <RadioButton Content="Map textures"      GroupName="tt" IsChecked="{Binding MapTextures}"/>
        <RadioButton Content="Building textures" GroupName="tt" IsChecked="{Binding BuildingTextures}"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="Add" controls:Icon.Key="addIcon"     Click="AddPack_Click"/>
        <Button Content="Remove last" controls:Icon.Key="deleteIcon" Click="RemPack_Click"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="Import" controls:Icon.Key="import" Click="Import_Click"/>
        <Button Content="Export" controls:Icon.Key="export" Click="Export_Click"/>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="170,170,170,*" Margin="4">
      <DockPanel Grid.Column="0" Margin="0,0,4,0">
        <TextBlock DockPanel.Dock="Top" Text="Texture packs" FontWeight="Bold" Margin="0,0,0,2"/>
        <ListBox x:Name="PackList" ItemsSource="{Binding PackNames}" SelectedIndex="{Binding PackIndex}"/>
      </DockPanel>
      <DockPanel Grid.Column="1" Margin="0,0,4,0">
        <TextBlock DockPanel.Dock="Top" Text="Textures" FontWeight="Bold" Margin="0,0,0,2"/>
        <ListBox x:Name="TextureList" ItemsSource="{Binding TextureNames}" SelectedIndex="{Binding TextureIndex}"/>
      </DockPanel>
      <DockPanel Grid.Column="2" Margin="0,0,4,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
          <TextBlock Text="Palettes" FontWeight="Bold"/>
          <TextBlock Text="Suggested from names; you can override it." FontSize="10"
                     Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteNames}" SelectedIndex="{Binding PaletteIndex}"/>
      </DockPanel>
      <Border x:Name="TexturePreview" Grid.Column="3" Background="#2A2A2E" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
        <Panel>
          <Image Source="{Binding Preview}" Stretch="Uniform" Margin="8"
                 RenderOptions.BitmapInterpolationMode="None"/>
          <TextBlock Text="{Binding PreviewReason}" IsVisible="{Binding HasPreviewReason}"
                     Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18"/>
        </Panel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
