<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
        xmlns:v="clr-namespace:DSPRE.Avalonia.Views.Controls"
        x:Class="DSPRE.Avalonia.Views.Graphics.GraphicPainterView"
        x:DataType="vm:GraphicPainterViewModel"
        Width="760" Height="640" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource Editor.StatusBg}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Measurements}" FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Explain}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource Editor.Subtle}"/>
        <WrapPanel x:Name="PainterButtons" Classes="toolbar" Orientation="Horizontal">
          <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click"
                  IsEnabled="{Binding CanPaint}"
                  ToolTip.Tip="Write this back into the ROM. Save the ROM afterwards to keep it."/>
          <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
          <Button Content="Change this colour" controls:Icon.Key="pencil" Click="ChangeColour_Click"
                  IsEnabled="{Binding CanChangeColour}"
                  ToolTip.Tip="{Binding ChangeColourHelp}"/>
          <Button Content="Undo" controls:Icon.Key="undo" Click="Undo_Click"
                  IsEnabled="{Binding CanUndo}"
                  ToolTip.Tip="{Binding UndoHelp}"/>
          <Button Content="Close" Click="Close_Click"/>
        </WrapPanel>
        <WrapPanel x:Name="ViewBar" Classes="toolbar" Orientation="Horizontal" IsVisible="{Binding CanPaint}">
          <TextBlock Text="Frame" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"
                     IsVisible="{Binding HasFrames}"/>
          <ComboBox ItemsSource="{Binding Frames}" SelectedIndex="{Binding FrameIndex, Mode=TwoWay}"
                    IsVisible="{Binding HasFrames}" MinWidth="120" FontSize="12" Margin="0,0,10,0"
                    ToolTip.Tip="Which picture in this file to paint.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GraphicPainterViewModel+Frame">
                <TextBlock Text="{Binding Name}"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Zoom out" Click="ZoomOut_Click"
                  IsEnabled="{Binding CanZoomOut}" ToolTip.Tip="{Binding ZoomOutHelp}"/>
          <Button Content="Zoom in" Click="ZoomIn_Click"
                  IsEnabled="{Binding CanZoomIn}" ToolTip.Tip="{Binding ZoomInHelp}"/>
          <CheckBox Content="Pixel grid" IsChecked="{Binding ShowGrid, Mode=TwoWay}"
                    VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"
                    ToolTip.Tip="{Binding GridHelp}"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource Editor.StatusBg}">
      <StackPanel Spacing="3">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Pointer}" FontSize="12"/>
          <TextBlock Text="{Binding InkDescription}" FontSize="12"/>
        </DockPanel>
        <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource Editor.Subtle}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,4" Background="{DynamicResource Editor.PanelBg}">
      <StackPanel Spacing="5">
        <controls:HelpTip HorizontalAlignment="Left" Text="Click a colour to paint with it. Change this colour edits it everywhere it is used."/>
        <ListBox x:Name="ColourList" ItemsSource="{Binding Colours}" SelectedItem="{Binding SelectedSwatch}"
                 MaxHeight="96" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <!-- The swatch fills its square, so the picked one is shown by the frame around it. -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="4"/>
              <Setter Property="Margin" Value="1"/>
              <Setter Property="CornerRadius" Value="4"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:GraphicPainterViewModel+Swatch">
              <Border Width="24" Height="24" BorderThickness="1"
                      BorderBrush="{DynamicResource Editor.Border}"
                      Background="{Binding Fill}"
                      ToolTip.Tip="{Binding Tip}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Panel>
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" IsVisible="{Binding CanPaint}">
      <!-- Pixel numbers stay on the edges while the drawing scrolls under them. -->
      <Border Width="24" Height="24" IsVisible="{Binding ShowGrid}"
              Background="{DynamicResource Editor.StatusBg}"/>
      <v:PixelRuler x:Name="TopRuler" Grid.Column="1" Height="24" Orientation="Horizontal"
                    Cell="{Binding Zoom}" Count="{Binding ViewWidth}" IsVisible="{Binding ShowGrid}"
                    Background="{DynamicResource Editor.StatusBg}" Foreground="{DynamicResource Editor.Text}"
                    Accent="{DynamicResource SystemControlHighlightAccentBrush}"/>
      <v:PixelRuler x:Name="LeftRuler" Grid.Row="1" Width="24" Orientation="Vertical"
                    Cell="{Binding Zoom}" Count="{Binding ViewHeight}" IsVisible="{Binding ShowGrid}"
                    Background="{DynamicResource Editor.StatusBg}" Foreground="{DynamicResource Editor.Text}"
                    Accent="{DynamicResource SystemControlHighlightAccentBrush}"/>
      <ScrollViewer x:Name="CanvasScroll" Grid.Row="1" Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    ScrollChanged="CanvasScroll_ScrollChanged">
        <!-- Sized from the zoom so each drawing pixel is whole screen pixels and the grid lines land on edges. -->
        <Panel x:Name="CanvasHost"
               Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" Margin="16"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               PointerPressed="Canvas_PointerPressed"
               PointerMoved="Canvas_PointerMoved"
               PointerExited="Canvas_PointerExited"
               LayoutUpdated="CanvasHost_LayoutUpdated"
               PointerWheelChanged="Canvas_PointerWheelChanged">
          <Image x:Name="Canvas" Source="{Binding Picture}" Stretch="Fill"
                 RenderOptions.BitmapInterpolationMode="None"/>
          <v:PixelGrid Cell="{Binding Zoom}" IsVisible="{Binding GridOn}" IsHitTestVisible="False"/>
        </Panel>
      </ScrollViewer>
      </Grid>

      <TextBlock Text="{Binding Trouble}" IsVisible="{Binding HasTrouble}"
                 TextWrapping="Wrap" MaxWidth="420" FontSize="13" TextAlignment="Center"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                 Foreground="{DynamicResource Editor.Subtle}"/>
    </Panel>

  </DockPanel>
</Window>
