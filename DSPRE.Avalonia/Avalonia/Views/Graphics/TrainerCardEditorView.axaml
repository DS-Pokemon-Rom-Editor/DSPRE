<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
		x:Class="DSPRE.Avalonia.Views.Graphics.TrainerCardEditorView"
		x:DataType="vm:TrainerCardEditorViewModel"
		Title="Trainer Card Editor"
		Width="900" Height="820" MinWidth="500" MinHeight="380"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:TrainerCardEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
	<Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
			BorderThickness="0,0,0,1" Padding="6,4">
	  <WrapPanel Classes="toolbar">
		<StackPanel x:Name="SaveButtons" Orientation="Horizontal" Spacing="6">
		  <Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		  <Button Content="Discard" Click="RevertChanges_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		</StackPanel>
		<StackPanel x:Name="RankBar" Orientation="Horizontal" Spacing="6" Margin="12,2,6,2">
		  <TextBlock Text="Rank:" VerticalAlignment="Center"/>
		  <ComboBox ItemsSource="{Binding RankNames}" SelectedIndex="{Binding SelectedRankIndex}" Width="140"/>
		  <Button Content="Open in Graphics…" Click="OpenInGraphics_Click"
		          ToolTip.Tip="Open the card in the Graphics window, where its drawing, its two arrangements and every rank's colours sit together."/>
		</StackPanel>
		<TextBlock Text="{Binding StatusText}" Foreground="OrangeRed" Margin="12,2,6,2"/>
	  </WrapPanel>
	</Border>

  <!-- No sideways scrolling, so the panels wrap to the window instead of running off the edge. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="12" Spacing="12">

	<!-- Card design: shared tile/screen art, coloured by the selected rank's palette -->
	<Border x:Name="CardDesign" BorderBrush="Gray" BorderThickness="1" Padding="10">
	  <StackPanel Spacing="8">
		<TextBlock Text="Card Design" FontWeight="Bold"/>

		<WrapPanel Orientation="Horizontal">

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280" Margin="0,0,12,12">
			<StackPanel Spacing="8">
			  <TextBlock Text="Front" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding CardFrontPreview}" Width="256" Height="192" Stretch="Uniform"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportCardFront_Click"/>
				<Button Content="Export PNG…" Click="ExportCardFront_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280" Margin="0,0,12,12">
			<StackPanel Spacing="8">
			  <TextBlock Text="Back" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding CardBackPreview}" Width="256" Height="192" Stretch="Uniform"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportCardBack_Click"/>
				<Button Content="Export PNG…" Click="ExportCardBack_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280" Margin="0,0,12,12">
			<StackPanel Spacing="8">
			  <TextBlock Text="Colours (advanced)" FontWeight="Bold"/>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import colours…" Click="ImportRankPalette_Click"/>
				<Button Content="Export colours…" Click="ExportRankPalette_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		</WrapPanel>
	  </StackPanel>
	</Border>

	<!-- Trainer pose: shared between genders, always coloured by the Normal rank's palette -->
	<Border x:Name="TrainerPose" BorderBrush="Gray" BorderThickness="1" Padding="10">
	  <StackPanel Spacing="8">
		<TextBlock Text="Trainer Pose" FontWeight="Bold"/>

		<WrapPanel Orientation="Horizontal">

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="536" Margin="0,0,12,12">
			<StackPanel Spacing="8">
			  <TextBlock Text="Male" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding TrainerMalePreview}" Width="512" Height="384" Stretch="Uniform"
				       RenderOptions.BitmapInterpolationMode="None"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportTrainerMale_Click"/>
				<Button Content="Export PNG…" Click="ExportTrainerMale_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="536" Margin="0,0,12,12">
			<StackPanel Spacing="8">
			  <TextBlock Text="Female" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding TrainerFemalePreview}" Width="512" Height="384" Stretch="Uniform"
				       RenderOptions.BitmapInterpolationMode="None"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportTrainerFemale_Click"/>
				<Button Content="Export PNG…" Click="ExportTrainerFemale_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		</WrapPanel>
	  </StackPanel>
	</Border>

  </StackPanel>
  </ScrollViewer>
  </DockPanel>
</Window>
