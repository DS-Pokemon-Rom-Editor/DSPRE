<UserControl xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
		x:Class="DSPRE.Avalonia.Views.Graphics.TrainerCardEditorView"
		x:DataType="vm:TrainerCardEditorViewModel">
  <Design.DataContext>
    <vm:TrainerCardEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Bad}" VerticalAlignment="Center"/>
    </Border>

    <controls:EditorToolbar x:Name="SaveButtons">
      <TextBlock Text="Rank" VerticalAlignment="Center" Margin="0,0,6,0" controls:EditorToolbar.Slot="Picker"/>
      <ComboBox x:Name="RankBar" ItemsSource="{Binding RankNames}" SelectedIndex="{Binding SelectedRankIndex}" Width="140"
                controls:EditorToolbar.Slot="Picker"/>
      <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
      <Button Content="Discard" controls:Icon.Key="resetIcon" Click="RevertChanges_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
      <controls:UndoRedoButtons/>
      <Button Content="Open in All graphics" controls:Icon.Key="OpenLink" Click="OpenInGraphics_Click"/>
    </controls:EditorToolbar>

    <!-- The pieces -->
    <Border DockPanel.Dock="Left" Classes="screenList" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Pieces" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <ListBox x:Name="PieceList" ItemsSource="{Binding Pieces}" SelectedIndex="{Binding PieceIndex}"/>
      </DockPanel>
    </Border>

    <!-- What is picked -->
    <Border DockPanel.Dock="Right" Classes="screenPanel" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1,0,0,0">
      <StackPanel Margin="8" Spacing="8">
        <TextBlock Text="{Binding PieceName}" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding PieceIsImage}">
          <Button Content="Import PNG…" controls:Icon.Key="import" Click="ImportPiece_Click"/>
          <Button Content="Export PNG…" controls:Icon.Key="export" Click="ExportPiece_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding PieceIsColours}">
          <Button Content="Import colours…" controls:Icon.Key="import" Click="ImportRankPalette_Click"/>
          <Button Content="Export colours…" controls:Icon.Key="export" Click="ExportRankPalette_Click"/>
        </StackPanel>
        <StackPanel Spacing="4" IsVisible="{Binding PieceIsCard}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Ranks to recolour" FontWeight="SemiBold"/>
            <controls:HelpTip Text="An imported design recolours only these ranks"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding ImportRanks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TrainerCardEditorViewModel+RankChoice">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The screen with the picked piece -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="12" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="{Binding ScreenCaption}" Classes="screenCaption"/>
        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Background="#181818">
          <Panel Width="512" Height="384">
            <!-- A pose is shown on the card front, where the game puts it. -->
            <Image Source="{Binding CardFrontPreview}" IsVisible="{Binding PieceIsPose}" Width="512" Height="384" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="None"/>
            <Image Source="{Binding PiecePreview}" Width="512" Height="384" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
          </Panel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
