<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
        xmlns:gl="clr-namespace:DSPRE.Avalonia.Gl"
        x:Class="DSPRE.Avalonia.Views.Graphics.ModelBrowserView"
        x:DataType="vm:ModelBrowserViewModel"
        Title="Models and textures"
        Width="980" Height="720" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:ModelBrowserViewModel/>
  </Design.DataContext>

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="8,6" Background="{DynamicResource Editor.StatusBg}">
      <!-- The button beside the box empties the box. Closing the window lives at the bottom, away from
           what you are typing in. -->
      <TextBox PlaceholderText="Search by name or number, like building or map" x:Name="SearchBox"
               Text="{Binding Search}" FontSize="13">
        <TextBox.InnerRightContent>
          <Button Content="✕" Click="ClearSearch_Click" Padding="8,2" Margin="0,0,2,0"
                  Background="Transparent" BorderThickness="0"
                  ToolTip.Tip="Empty the search box"
                  IsVisible="{Binding Search, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource Editor.StatusBg}">
      <Grid ColumnDefinitions="*,8,Auto">
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding FoundSummary}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource Editor.Subtle}"/>
        </StackPanel>
        <Button Grid.Column="2" Content="Close" Click="Close_Click" Width="66"
                VerticalAlignment="Bottom"/>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="280,6,*,6,300" Margin="6">

      <DockPanel Grid.Column="0">
        <!-- One tab per kind of 3D thing, so the models are not mixed in with the picture sets and the
             animations when you are only after one of them. -->
        <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                 Background="Transparent" BorderThickness="0" Margin="0,0,0,6" MaxHeight="120"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,3"/>
              <Setter Property="Margin" Value="0,0,3,3"/>
              <Setter Property="CornerRadius" Value="3"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModelBrowserViewModel+CategoryTab">
              <TextBlock Text="{Binding Header}" FontSize="12" ToolTip.Tip="{Binding What}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ListBox ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModelBrowserViewModel+Item">
              <TextBlock Text="{Binding Label}" FontFamily="Consolas,monospace" FontSize="13"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent"/>

      <Border Grid.Column="2" x:Name="GlHost" Background="{DynamicResource Editor.PanelBg}"
              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
        <Panel>
          <gl:NsbmdGlControl x:Name="GlView" IsVisible="{Binding HasModel}"/>
          <TextBlock Text="{Binding Whynot}" IsVisible="{Binding HasNoModel}"
                     TextWrapping="Wrap" MaxWidth="420" FontSize="13" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                     Foreground="{DynamicResource Editor.Subtle}"/>
        </Panel>
      </Border>

      <GridSplitter Grid.Column="3" Width="6" Background="Transparent"/>

      <ScrollViewer Grid.Column="4" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8" Margin="2,0,0,0">

          <!-- An overworld person is a model, its pictures and its movement filed one after another.
               They are one row now, with the pieces offered here. -->
          <ListBox ItemsSource="{Binding Parts}" SelectedIndex="{Binding PartIndex, Mode=TwoWay}"
                   IsVisible="{Binding HasParts}" Background="Transparent" BorderThickness="0"
                   MaxHeight="72" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="0,0,3,3"/>
                <Setter Property="CornerRadius" Value="3"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelBrowserViewModel+Part">
                <TextBlock Text="{Binding Label}" FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

            <StackPanel Spacing="2" IsVisible="{Binding HasTextureChoice}">
              <TextBlock Text="Pictures" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <ComboBox ItemsSource="{Binding TextureChoices}" SelectedIndex="{Binding TextureChoice, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" FontSize="12"
                        ToolTip.Tip="Buildings and map scenery take their pictures from a set shared by a whole map, so the model does not say which one. Pick the set you want to see it in."/>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding HasAnimationChoice}">
              <TextBlock Text="Movement" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <ComboBox ItemsSource="{Binding AnimationChoices}" SelectedIndex="{Binding AnimationIndex, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" FontSize="12"
                        ToolTip.Tip="Which movement to put on this model. Buildings keep their movements in a separate archive and do not say which one is theirs, so this is a choice."/>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding HasSlideChoice}">
              <TextBlock Text="Sliding picture" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <ComboBox ItemsSource="{Binding SlideChoices}" SelectedItem="{Binding SlideChoiceName, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" FontSize="12"
                        ToolTip.Tip="A picture that slides, turns or stretches across the model, like flowing water."/>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding HasSwapChoice}">
              <TextBlock Text="Swapped picture" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <ComboBox ItemsSource="{Binding SwapChoices}" SelectedItem="{Binding SwapChoiceName, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" FontSize="12"
                        ToolTip.Tip="A picture swapped for another as it goes, like a flickering sign."/>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding HasColourChoice}">
              <TextBlock Text="Colour" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <ComboBox ItemsSource="{Binding ColourChoices}" SelectedItem="{Binding ColourChoiceName, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" FontSize="12"
                        ToolTip.Tip="A material fading or changing colour over time."/>
            </StackPanel>

            <StackPanel Spacing="2" IsVisible="{Binding HasShowingChoice}">
              <TextBlock Text="Hidden parts" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <ComboBox ItemsSource="{Binding ShowingChoices}" SelectedItem="{Binding ShowingChoiceName, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" FontSize="12"
                        ToolTip.Tip="Parts of the model being hidden and shown again. Drawn see-through here, which looks the same."/>
            </StackPanel>

          <WrapPanel Classes="toolbar" Orientation="Horizontal">
            <Button Content="{Binding PlayLabel}" Click="Play_Click"
                    IsEnabled="{Binding CanPlay}" ToolTip.Tip="{Binding PlayHelp}"/>
            <TextBlock Text="{Binding FrameSummary}" VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
          </WrapPanel>
          <!-- Drag to a frame rather than waiting for it to come round again. -->
          <Slider Minimum="0" Maximum="{Binding FrameCount}" Value="{Binding Frame, Mode=TwoWay}"
                  IsVisible="{Binding CanPlay}" TickFrequency="1" IsSnapToTickEnabled="True"
                  ToolTip.Tip="Which frame to show."/>

          <Separator/>

          <TextBlock Text="{Binding Details}" FontSize="13" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding CompanionSummary}" IsVisible="{Binding HasCompanionSummary}"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="{Binding CompanionNote}" IsVisible="{Binding HasCompanionNote}"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="{Binding AnimationDetails}" IsVisible="{Binding HasAnimationDetails}"
                     FontSize="12" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding AnimationOwner}" IsVisible="{Binding HasAnimationDetails}"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="{Binding MovementNote}" IsVisible="{Binding HasMovementNote}"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="{Binding DeepEditorHint}" IsVisible="{Binding HasDeepEditor}"
                     FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>

          <Separator/>

          <StackPanel Spacing="4">
            <Button Content="Save as a 3D file" Click="SaveDae_Click" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanSaveModel}" ToolTip.Tip="{Binding SaveModelHelp}"/>
            <Button Content="Save as glTF" Click="SaveGlb_Click" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanSaveModel}" ToolTip.Tip="{Binding SaveModelHelp}"/>
            <Button Content="Put a file in" Click="PutIn_Click" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanPutFileIn}" ToolTip.Tip="{Binding PutFileInHelp}"/>
            <Button Content="Save file as it is" Click="SaveRaw_Click" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding HasSelection}"
                    ToolTip.Tip="Save the whole entry exactly as it sits in the ROM. Always possible, and the only way to keep everything about an entry that is not a model."/>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </DockPanel>
</Window>
