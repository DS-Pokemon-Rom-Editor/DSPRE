<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
        x:Class="DSPRE.Avalonia.Views.Graphics.CellAnimationPickerView"
        x:DataType="vm:CellAnimationPickerViewModel"
        Title="Cell Animations"
        Width="620" Height="620" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:CellAnimationPickerViewModel/>
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="10">

    <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Open" Click="Open_Click" Width="90"/>
        <TextBlock Text="{Binding StatusText}" Classes="hint" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Summary}" Classes="hint"/>
      <TextBox Text="{Binding Search}" Watermark="Search by archive or file number"/>
      <CheckBox Content="Only the ones with art to draw them" IsChecked="{Binding DrawableOnly}"
                ToolTip.Tip="An animation needs a layout and a sheet of tiles before anything can be shown"/>
    </StackPanel>

    <ListBox ItemsSource="{Binding Found}" SelectedIndex="{Binding SelectedIndex}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             DoubleTapped="List_DoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CellAnimationFound">
          <StackPanel>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Editor.Subtle}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</Window>
