<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
             xmlns:local="clr-namespace:DSPRE.Avalonia.Views.Graphics"
             x:Class="DSPRE.Avalonia.Views.Graphics.ScreenCursorView"
             x:DataType="vm:ICursorEditor"
             Focusable="True">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding CursorStatus}" FontSize="12" Foreground="{DynamicResource Editor.Bad}" VerticalAlignment="Center"/>
    </Border>

    <controls:EditorToolbar>
      <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
      <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
      <controls:UndoRedoButtons/>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
        <TextBlock Text="{Binding CursorSetLabel}" VerticalAlignment="Center"/>
        <ComboBox Width="210" ItemsSource="{Binding CursorSets}" SelectedIndex="{Binding CursorSetIndex}"/>
      </StackPanel>
    </controls:EditorToolbar>

    <Border DockPanel.Dock="Left" Width="660" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,1,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8" Spacing="4">
          <Grid ColumnDefinitions="18,*,120,120,120,120" ColumnSpacing="6" Margin="0,0,16,2">
            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="Stops" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Up" Foreground="{DynamicResource Editor.Subtle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="Down" Foreground="{DynamicResource Editor.Subtle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="Left" Foreground="{DynamicResource Editor.Subtle}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="Right" Foreground="{DynamicResource Editor.Subtle}" HorizontalAlignment="Center"/>
          </Grid>
          <ListBox x:Name="StopList" ItemsSource="{Binding CursorStops}" SelectedItem="{Binding SelectedStop}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CursorStopRow">
                <Grid ColumnDefinitions="18,*,120,120,120,120" ColumnSpacing="6" Margin="0,0,8,0">
                  <Border Width="12" Height="12" Background="{Binding Colour}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedIndex="{Binding Up}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding UpOpen}" ToolTip.Tip="{Binding UpFixed}" ToolTip.ShowOnDisabled="True"/>
                  <ComboBox Grid.Column="3" ItemsSource="{Binding Choices}" SelectedIndex="{Binding Down}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding DownOpen}" ToolTip.Tip="{Binding DownFixed}" ToolTip.ShowOnDisabled="True"/>
                  <ComboBox Grid.Column="4" ItemsSource="{Binding Choices}" SelectedIndex="{Binding Left}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding LeftOpen}" ToolTip.Tip="{Binding LeftFixed}" ToolTip.ShowOnDisabled="True"/>
                  <ComboBox Grid.Column="5" ItemsSource="{Binding Choices}" SelectedIndex="{Binding Right}" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding RightOpen}" ToolTip.Tip="{Binding RightFixed}" ToolTip.ShowOnDisabled="True"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="{Binding BackRowsLabel}" FontWeight="SemiBold" Margin="0,12,0,2" ToolTip.Tip="{Binding BackRowsTip}"
                     IsVisible="{Binding HasBackRows}"/>
          <ItemsControl x:Name="BackList" ItemsSource="{Binding BackRows}" IsVisible="{Binding HasBackRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CursorBackRow">
                <Grid ColumnDefinitions="140,*" Margin="0,2">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CursorBackSlot">
                        <ComboBox Width="{Binding Width}" ItemsSource="{Binding Choices}" SelectedIndex="{Binding Slot}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Viewbox Stretch="Uniform" VerticalAlignment="Top" Margin="16">
        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Background="Black">
          <Panel x:Name="Board" Width="512" Height="384" ClipToBounds="True" Background="Black" PointerPressed="Board_Pressed">
            <Image Source="{Binding CursorPicture}" Width="512" Height="384" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
            <local:CursorArrows x:Name="Arrows" IsHitTestVisible="False"/>
          </Panel>
        </Border>
      </Viewbox>
    </ScrollViewer>
  </DockPanel>
</UserControl>
