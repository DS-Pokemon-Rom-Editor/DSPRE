<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Graphics"
             xmlns:data="clr-namespace:DSPRE.Avalonia.Data"
             x:Class="DSPRE.Avalonia.Views.Graphics.ScreenPagesView"
             x:DataType="vm:ScreenPagesEditorViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" Classes="hint" VerticalAlignment="Center"/>
    </Border>

    <controls:EditorToolbar>
      <TextBlock Text="Page" VerticalAlignment="Center"/>
      <ComboBox Width="220" ItemsSource="{Binding PageNames}" SelectedIndex="{Binding PageIndex}"/>
      <TextBlock Text="State" VerticalAlignment="Center" IsVisible="{Binding HasVariants}"/>
      <ComboBox Width="170" ItemsSource="{Binding VariantNames}" SelectedIndex="{Binding VariantIndex}"
                IsVisible="{Binding HasVariants}"/>
      <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
      <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
      <Button Content="Undo" controls:Icon.Key="undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}"/>
      <Button Content="Redo" controls:Icon.Key="redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}"/>
    </controls:EditorToolbar>

    <!-- The layers, front first -->
    <Border x:Name="LeftColumn" DockPanel.Dock="Left" Classes="screenList" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,1,0">
      <DockPanel>
      <!-- Text boxes and bars the game places in its code, laid out the way the HP bar editor lists its parts -->
      <DockPanel x:Name="BoxPanel" DockPanel.Dock="Bottom" Margin="8" IsVisible="{Binding HasLayout}">
        <TextBlock DockPanel.Dock="Top" Text="Text boxes and bars" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Button DockPanel.Dock="Top" Content="Open in ROM patch toolbox" controls:Icon.Key="OpenLink" Margin="0,0,0,6" Click="FontPatch_Click"
                IsVisible="{Binding OffersFontPatch}" ToolTip.Tip="The &quot;Summary screen fonts&quot; patch lets each text box use another font."/>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding BoxRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScreenBoxRow">
                <StackPanel Margin="0,2" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="12" Height="12" Background="{Binding Colour}" BorderBrush="{Binding Colour}" BorderThickness="2"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" Width="120" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}"/>
                    <NumericUpDown Value="{Binding Across}" Minimum="0" Maximum="31" Increment="1" FormatString="0" Width="64"
                                   ToolTip.Tip="Across"/>
                    <NumericUpDown Value="{Binding Down}" Minimum="0" Maximum="23" Increment="1" FormatString="0" Width="64"
                                   ToolTip.Tip="Down"/>
                  </StackPanel>
                  <ComboBox Margin="18,0,0,0" Width="180" ItemsSource="{Binding FontNames}" SelectedIndex="{Binding FontIndex}"
                            IsVisible="{Binding CanPickFont}" ToolTip.Tip="Font"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <TextBlock x:Name="LayerHeading" DockPanel.Dock="Top" Text="Pieces" FontWeight="SemiBold" Margin="6,6,6,0"/>
      <ListBox x:Name="LayerList" Margin="6" ItemsSource="{Binding Layers}" SelectedIndex="{Binding LayerIndex}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScreenLayerRow">
            <StackPanel>
              <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding WhereShown}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      </DockPanel>
    </Border>

    <!-- The files the picked layer is made from -->
    <Border x:Name="PartPanel" DockPanel.Dock="Right" Classes="screenPanel" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1,0,0,0">
      <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding LayerName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Content="Paint" controls:Icon.Key="brush" Click="Paint_Click" IsEnabled="{Binding CanPaintPart}"/>
          <Button Content="Export…" controls:Icon.Key="export" Click="Export_Click" IsEnabled="{Binding CanEditPart}" ToolTip.Tip="PNG image"/>
          <Button Content="Import…" controls:Icon.Key="import" Click="Import_Click" IsEnabled="{Binding CanEditPart}" ToolTip.Tip="PNG image"/>
        </StackPanel>
        <ItemsControl DockPanel.Dock="Bottom" Margin="0,8,0,0" ItemsSource="{Binding Swatches}" IsVisible="{Binding HasSwatches}"
                      HorizontalAlignment="Left" ToolTip.Tip="Everything using these colours changes too">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GraphicPainterViewModel+Swatch">
              <Button Width="28" Height="28" Margin="1" Padding="0" Tag="{Binding Number}"
                      Click="Colour_Click" ToolTip.Tip="{Binding Tip}">
                <Border Width="24" Height="24" BorderThickness="1"
                        BorderBrush="{DynamicResource Editor.Border}" Background="{Binding Fill}"/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ListBox ItemsSource="{Binding Parts}" SelectedIndex="{Binding PartIndex}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ScreenPartRow">
              <StackPanel>
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Both screens, the top one first; a click picks the layer in front at that point -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Screens" Margin="12" Spacing="6" HorizontalAlignment="Center">
        <TextBlock Text="Top screen" Classes="screenCaption"/>
        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
          <Panel>
            <Image x:Name="TopScreen" Source="{Binding TopImage}" Width="512" Height="384" Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="None" PointerPressed="Screen_Pressed" PointerMoved="Screen_Moved"
                   PointerReleased="Screen_Released" Cursor="Hand"/>
            <ItemsControl x:Name="TopBoxes" ItemsSource="{Binding TopBoxes}" IsHitTestVisible="False" IsVisible="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:ScreenBoxRow">
                  <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                  <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScreenBoxRow">
                  <Border Width="{Binding Width}" Height="{Binding Height}" BorderBrush="{Binding Colour}" BorderThickness="2" Background="#22FFFFFF">
                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="3,1" Foreground="{Binding Colour}" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>
        <TextBlock Text="Bottom screen" Classes="screenCaption"/>
        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
          <Panel>
            <Image x:Name="BottomScreen" Source="{Binding BottomImage}" Width="512" Height="384" Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="None" PointerPressed="Screen_Pressed" PointerMoved="Screen_Moved"
                   PointerReleased="Screen_Released" Cursor="Hand"/>
            <ItemsControl x:Name="BottomBoxes" ItemsSource="{Binding BottomBoxes}" IsHitTestVisible="False" IsVisible="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.Styles>
                <Style Selector="ContentPresenter" x:DataType="vm:ScreenBoxRow">
                  <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                  <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScreenBoxRow">
                  <Border Width="{Binding Width}" Height="{Binding Height}" BorderBrush="{Binding Colour}" BorderThickness="2" Background="#22FFFFFF">
                    <TextBlock Text="{Binding Name}" FontSize="11" Margin="3,1" Foreground="{Binding Colour}" FontWeight="SemiBold"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>
      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</UserControl>
