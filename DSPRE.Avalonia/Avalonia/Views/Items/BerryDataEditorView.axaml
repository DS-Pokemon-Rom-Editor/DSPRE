<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Items"
             x:Class="DSPRE.Avalonia.Views.Items.BerryDataEditorView"
             x:DataType="vm:BerryDataEditorViewModel">
  <Design.DataContext>
    <vm:BerryDataEditorViewModel/>
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Width" Value="110"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FormatString" Value="0"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Margin="8,4"
               Foreground="{DynamicResource Editor.Bad}" TextWrapping="Wrap"/>

    <Grid ColumnDefinitions="200,*" Margin="8">
      <ListBox Grid.Column="0" ItemsSource="{Binding BerryNames}" SelectedIndex="{Binding SelectedBerry}" Margin="0,0,10,0"/>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <GroupBox Header="Growth">
          <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,6,Auto,6,Auto" Margin="4">
            <TextBlock Grid.Row="0" Classes="label" Text="Hours per stage"/>
            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding HoursPerStage}" Minimum="1" Maximum="255"/>
            <TextBlock Grid.Row="2" Classes="label" Text="Soil drying"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Drain}" Minimum="0" Maximum="255"
                           ToolTip.Tip="How fast the soil dries; higher dries faster"/>
            <TextBlock Grid.Row="4" Classes="label" Text="Yield"/>
            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Yield}" Minimum="1" Maximum="255"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Look and taste">
          <StackPanel Spacing="6" Margin="4">
            <TextBlock Text="HeartGold may not read these." IsVisible="{Binding LooksUnread}"
                       Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto" RowDefinitions="Auto,6,Auto,6,Auto,6,Auto">
              <TextBlock Grid.Row="0" Classes="label" Text="Size (mm)"/>
              <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding SizeMm}" Minimum="0" Maximum="65535"/>
              <TextBlock Grid.Row="0" Grid.Column="3" Classes="label" Text="Firmness"/>
              <ComboBox Grid.Row="0" Grid.Column="4" ItemsSource="{Binding FirmnessNames}" SelectedIndex="{Binding FirmnessIndex}" Width="130"/>

              <TextBlock Grid.Row="2" Classes="label" Text="Spicy"/>
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Spicy}" Minimum="0" Maximum="255"/>
              <TextBlock Grid.Row="2" Grid.Column="3" Classes="label" Text="Dry"/>
              <NumericUpDown Grid.Row="2" Grid.Column="4" Value="{Binding Dry}" Minimum="0" Maximum="255"/>

              <TextBlock Grid.Row="4" Classes="label" Text="Sweet"/>
              <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Sweet}" Minimum="0" Maximum="255"/>
              <TextBlock Grid.Row="4" Grid.Column="3" Classes="label" Text="Bitter"/>
              <NumericUpDown Grid.Row="4" Grid.Column="4" Value="{Binding Bitter}" Minimum="0" Maximum="255"/>

              <TextBlock Grid.Row="6" Classes="label" Text="Sour"/>
              <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding Sour}" Minimum="0" Maximum="255"/>
              <TextBlock Grid.Row="6" Grid.Column="3" Classes="label" Text="Smoothness"/>
              <NumericUpDown Grid.Row="6" Grid.Column="4" Value="{Binding Smoothness}" Minimum="0" Maximum="255"/>
            </Grid>
          </StackPanel>
        </GroupBox>
      </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
