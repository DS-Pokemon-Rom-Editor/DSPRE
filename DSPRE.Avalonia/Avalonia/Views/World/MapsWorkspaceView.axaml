<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:views="clr-namespace:DSPRE.Avalonia.Views.World"
        xmlns:viewstext="clr-namespace:DSPRE.Avalonia.Views.Text"
        xmlns:ava="clr-namespace:DSPRE.Avalonia"
        x:Class="DSPRE.Avalonia.Views.World.MapsWorkspaceView"
        x:DataType="vm:HeaderEditorViewModel"
        x:Name="MapsRoot">
  <!-- Porymap-like Maps workspace over a HeaderEditorViewModel: the shared header sidebar drives a
       context strip + map-bound tabs. Every tab is embedded and follows the selected header's linked
       file id (see code-behind's RetargetXxx methods). -->
  <Design.DataContext>
    <vm:HeaderEditorViewModel/>
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="Border.chip">
      <Setter Property="BorderBrush" Value="{DynamicResource Editor.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{DynamicResource Editor.PanelBg}"/>
    </Style>
    <Style Selector="Border.chip TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
    </Style>
    <Style Selector="Button.chip">
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Button.chip TextBlock.k">
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
    </Style>
    <Style Selector="StackPanel.placeholder">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Spacing" Value="12"/>
      <Setter Property="MaxWidth" Value="460"/>
    </Style>
    <Style Selector="StackPanel.placeholder > TextBlock.title">
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="230,*">
      <views:HeaderSidebarView Grid.Column="0" Margin="4" x:Name="Sidebar"/>

      <DockPanel Grid.Column="1" Margin="0,4,4,4">
        <!-- Context strip: selected header identity + Save/Reset + linked-file id chips.
             x:Name is a guided-tour spotlight target. -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}"
                BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="3"
                Padding="10,7" Margin="0,0,0,4" x:Name="ContextStrip">
          <StackPanel Spacing="7">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" x:Name="SaveResetPanel">
                <Button Content="Save ROM…" controls:Icon.Key="save_rom" Click="SaveRom_Click"
                        ToolTip.Tip="Build a playable .nds from everything saved so far in this project."/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <controls:IconImage Key="pin"/>
                <TextBlock Text="{Binding SelectedHeaderTitle}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedHeaderSubtitle}" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
            <WrapPanel>
              <Button Classes="chip" Tag="Events" Click="Chip_Click" ToolTip.Tip="NPCs, warps, triggers and hidden items placed on this map."><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="k" Text="Events"/><TextBlock Text="{Binding EventFileId, StringFormat={}{0:0}}"/></StackPanel></Button>
              <Button Classes="chip" Tag="Matrix" Click="Chip_Click" ToolTip.Tip="The grid that joins this header's maps into the world."><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="k" Text="Matrix"/><TextBlock Text="{Binding MatrixId, StringFormat={}{0:0}}"/></StackPanel></Button>
              <Button Classes="chip" Tag="Area Data" Click="Chip_Click" ToolTip.Tip="The texture packs, lighting and global texture animation this area uses."><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="k" Text="Area data"/><TextBlock Text="{Binding AreaDataId, StringFormat={}{0:0}}"/></StackPanel></Button>
              <Button Classes="chip" Tag="Encounters" Click="Chip_Click" ToolTip.Tip="The wild Pokémon that appear here."><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="k" Text="Encounters"/><TextBlock Text="{Binding WildPokemon, StringFormat={}{0:0}}"/></StackPanel></Button>
              <Button Classes="chip" Tag="Scripts" Click="Chip_Click" ToolTip.Tip="What happens when you talk to people or step on triggers here."><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="k" Text="Scripts"/><TextBlock Text="{Binding ScriptFileId, StringFormat={}{0:0}}"/></StackPanel></Button>
              <Button Classes="chip" Tag="Level Scripts" Click="Chip_Click" ToolTip.Tip="Scripts that run by themselves when the map loads."><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="k" Text="Level scripts"/><TextBlock Text="{Binding LevelScriptId, StringFormat={}{0:0}}"/></StackPanel></Button>
              <Button Classes="chip" Tag="Text" Click="Chip_Click" ToolTip.Tip="The dialogue and signs shown here."><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Classes="k" Text="Text"/><TextBlock Text="{Binding TextArchiveId, StringFormat={}{0:0}}"/></StackPanel></Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Panel>
        <TabControl x:Name="MapTabs">
          <TabItem ToolTip.Tip="The header is this location's settings record: music, weather, camera, flags and which files it uses." AutomationProperties.Name="Header">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.Header}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Header" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <DockPanel>
              <views:HeaderToolbarView/>
              <views:HeaderFieldsView x:Name="HeaderEmbed"/>
            </DockPanel>
          </TabItem>
          <TabItem ToolTip.Tip="The 3D terrain and buildings of the selected map." AutomationProperties.Name="Map">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.Map}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Map" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <views:MapEditorView x:Name="MapEmbed" DataContext="{Binding #MapsRoot.MapVM}"/>
          </TabItem>
          <!-- Embedded Event editor; follows the selected header's event file (see code-behind). -->
          <TabItem ToolTip.Tip="NPCs, warps, triggers and hidden items placed on this map." AutomationProperties.Name="Events">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.Events}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Events" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <views:EventEditorView x:Name="EventsEmbed" DataContext="{Binding #MapsRoot.EventVM}"/>
          </TabItem>
          <TabItem ToolTip.Tip="The grid that joins this header's maps into the world." AutomationProperties.Name="Matrix">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.Matrix}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Matrix" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <views:MatrixEditorView x:Name="MatrixEmbed" DataContext="{Binding #MapsRoot.MatrixVM}"/>
          </TabItem>
          <TabItem ToolTip.Tip="The texture packs, lighting and global texture animation this area uses." AutomationProperties.Name="Area Data">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.AreaData}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Area data" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <views:AreaDataEditorView x:Name="AreaDataEmbed" DataContext="{Binding #MapsRoot.AreaDataVM}"/>
          </TabItem>
          <TabItem x:Name="EncountersTab" ToolTip.Tip="The wild Pokémon that appear here." AutomationProperties.Name="Encounters">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.Encounters}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Encounters" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
          </TabItem>
          <TabItem ToolTip.Tip="What happens when you talk to people or step on triggers here." AutomationProperties.Name="Scripts">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.Scripts}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Scripts" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <viewstext:ScriptEditorView x:Name="ScriptsEmbed" DataContext="{Binding #MapsRoot.ScriptsVM}"/>
          </TabItem>
          <TabItem ToolTip.Tip="Scripts that run by themselves when the map loads." AutomationProperties.Name="Level Scripts">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.LevelScripts}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Level scripts" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <viewstext:LevelScriptEditorView x:Name="LevelScriptsEmbed" DataContext="{Binding #MapsRoot.LevelScriptsVM}"/>
          </TabItem>
          <TabItem ToolTip.Tip="The dialogue and signs shown here." AutomationProperties.Name="Text">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal" Spacing="5">
                <Image Source="{x:Static ava:EditorIcons.Text}" Width="16" Height="16"
                       RenderOptions.BitmapInterpolationMode="HighQuality" VerticalAlignment="Center"/>
                <TextBlock Text="Text" VerticalAlignment="Center"/>
              </StackPanel>
            </TabItem.Header>
            <viewstext:TextEditorView x:Name="TextEmbed" DataContext="{Binding #MapsRoot.TextVM}"/>
          </TabItem>
        </TabControl>
        <!-- Rides at the end of the tab strip and names the tab it opens, since it acts on that tab only. -->
        <Button x:Name="PopOutButton" Classes="small" controls:Icon.Key="popout" Click="PopOut_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
