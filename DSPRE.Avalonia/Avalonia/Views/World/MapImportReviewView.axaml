<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:check="clr-namespace:DSPRE.ROMFiles;assembly=DSPRE.Core"
        x:Class="DSPRE.Avalonia.Views.World.MapImportReviewView"
        x:DataType="vm:MapImportReviewViewModel"
        Title="{Binding Title}"
        Width="900" Height="600" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8"/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Content="Close" Click="Close_Click" MinWidth="80"/>
    </StackPanel>

    <TabControl SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{Binding TexturesHeader}" IsVisible="{Binding HasTextures}">
        <Grid ColumnDefinitions="*,10,320" Margin="0,6,0,0">
          <DataGrid Grid.Column="0" ItemsSource="{Binding Textures}" IsReadOnly="True"
                    GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Column="2">
            <Button DockPanel.Dock="Top" Content="Find packs that have them" Click="FindPacks_Click" IsEnabled="{Binding CanSearch}"
                    HorizontalAlignment="Stretch"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding PackNote}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource Editor.Subtle}"
                       IsVisible="{Binding PackNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <ScrollViewer Margin="0,6,0,0">
              <ItemsControl ItemsSource="{Binding Packs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MapImportReviewViewModel+PackRow">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" Margin="8,0"
                                 Foreground="{DynamicResource Editor.Subtle}"/>
                      <Button Grid.Column="2" Content="Use" Tag="{Binding}" Click="UsePack_Click"
                              IsEnabled="{Binding $parent[Window].((vm:MapImportReviewViewModel)DataContext).CanUsePack}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="{Binding BuildingsHeader}" IsVisible="{Binding HasBuildings}">
        <DataGrid ItemsSource="{Binding Buildings}" IsReadOnly="True" Margin="0,6,0,0"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" CanUserResizeColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="80"/>
            <DataGridTextColumn Header="Placed" Binding="{Binding Count}" Width="70"/>
            <DataGridTextColumn Header="Problem" Binding="{Binding Problem}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="{Binding EventsHeader}" IsVisible="{Binding HasEvents}">
        <DockPanel Margin="0,6,0,0">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
            <CheckBox Grid.Column="0" Content="Select all" IsChecked="{Binding AllEventsTicked}" IsThreeState="True"/>
            <TextBlock Grid.Column="1" Text="{Binding EventsNote}" VerticalAlignment="Center" Margin="12,0" FontSize="12"
                       Foreground="{DynamicResource Editor.Subtle}"/>
            <Button Grid.Column="2" Content="Fix selected" Click="FixSelected_Click" IsEnabled="{Binding AnyEventTicked}"
                    ToolTip.Tip="Move the selected events to the nearest open square; put back the selected warp and edge squares"/>
          </Grid>
          <DataGrid ItemsSource="{Binding Events}" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                    CanUserResizeColumns="True" RowHeight="26">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="36">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MapEditorViewModel+EventClash">
                    <CheckBox IsChecked="{Binding Move}" HorizontalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Event" Binding="{Binding Who}" Width="150" IsReadOnly="True"/>
              <DataGridTextColumn Header="File" Binding="{Binding FileText}" Width="60" IsReadOnly="True"/>
              <DataGridTextColumn Header="Square" Binding="{Binding Where}" Width="70" IsReadOnly="True"/>
              <DataGridTemplateColumn Header="Now" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MapEditorViewModel+EventClash">
                    <TextBlock Text="{Binding Why}" ToolTip.Tip="{Binding Why}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="6,0"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Fix" Width="220">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:MapEditorViewModel+EventClash">
                    <TextBlock Text="{Binding Result}" ToolTip.Tip="{Binding Result}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="6,0"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
