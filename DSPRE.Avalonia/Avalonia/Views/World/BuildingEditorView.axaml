<Window MinWidth="700" MinHeight="460" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:gl="clr-namespace:DSPRE.Avalonia.Gl"
        x:Class="DSPRE.Avalonia.Views.World.BuildingEditorView"
        x:DataType="vm:BuildingEditorViewModel"
        Title="Building editor"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:BuildingEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <controls:EditorToolbar>
        <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <TextBlock Text="Texture pack" VerticalAlignment="Center"/>
        <ComboBox Width="150" ItemsSource="{Binding Textures}" SelectedIndex="{Binding SelectedTextureIndex}"/>
        <Button controls:EditorToolbar.Slot="Import" Content="Import…" controls:Icon.Key="import" Click="Import_Click"
                ToolTip.Tip="An NSBMD model, or an OBJ mesh turned into one"/>
        <Button controls:EditorToolbar.Slot="Export" Content="Export" controls:Icon.Key="export">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="NSBMD…" Tag="Nsbmd" Click="Export_Click"/>
              <MenuItem Header="DAE…" Tag="Dae" Click="Export_Click"/>
              <MenuItem Header="glTF…" Tag="Glb" Click="Export_Click"/>
              <Separator/>
              <MenuItem Header="All as NSBMD…" Tag="Nsbmd" Click="ExportAll_Click"/>
              <MenuItem Header="All as DAE…" Tag="Dae" Click="ExportAll_Click"/>
              <MenuItem Header="All as glTF…" Tag="Glb" Click="ExportAll_Click"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>
    </controls:EditorToolbar>

    <TabStrip DockPanel.Dock="Top" SelectedIndex="{Binding ArchiveTab}" IsVisible="{Binding IsHGSS}" Margin="4,2,4,0">
      <TabStripItem Content="Exterior"/>
      <TabStripItem Content="Interior"/>
    </TabStrip>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="220,*" Margin="4">
      <ListBox Grid.Column="0" Margin="0,0,6,0" ItemsSource="{Binding Buildings}" SelectedIndex="{Binding SelectedBuildingIndex}"/>
      <Border Grid.Column="1" x:Name="GlHost" Background="#1F1F23" BorderBrush="#444" BorderThickness="1">
        <gl:NsbmdGlControl x:Name="GlView"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
