<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:models="clr-namespace:DSPRE.Avalonia.Models"
        x:Class="DSPRE.Avalonia.Views.World.HeaderSidebarView"
        x:DataType="vm:HeaderEditorViewModel">
  <!-- The location-grouped header tree. Shared by the standalone Header editor and the Maps workspace
       (binds to a HeaderEditorViewModel: TreeFolders / SelectedTreeNode / TreeFilterText). -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
      <TextBox PlaceholderText="Search headers…" Text="{Binding TreeFilterText, Mode=TwoWay}"/>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Click="ExpandAll_Click" Width="28" Height="28" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Expand all folders">
          <Path Width="16" Height="16" Data="M 3,6 L 8,1 L 13,6 M 3,10 L 8,15 L 13,10"
                Stroke="{DynamicResource ABrush.Glyph.Static}" StrokeThickness="1.75"
                StrokeLineCap="Round" StrokeJoin="Round"/>
        </Button>
        <Button Click="CollapseAll_Click" Width="28" Height="28" Padding="0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Collapse all folders">
          <Path Width="16" Height="16" Data="M 3,1 L 8,6 L 13,1 M 3,15 L 8,10 L 13,15"
                Stroke="{DynamicResource ABrush.Glyph.Static}" StrokeThickness="1.75"
                StrokeLineCap="Round" StrokeJoin="Round"/>
        </Button>
        <CheckBox Content="Fuzzy" IsChecked="{Binding FuzzySearch}" VerticalAlignment="Center" Margin="4,0,0,0"
                  ToolTip.Tip="Also match approximate spellings (typo-tolerant)"/>
      </StackPanel>
    </StackPanel>

    <TreeView ItemsSource="{Binding TreeFolders}"
              SelectedItem="{Binding SelectedTreeNode, Mode=TwoWay}">
      <!-- TreeView doesn't bind a node's IsExpanded to its container by default; this is what
           lets the ViewModel drive Expand/Collapse All, search, and initial selection. -->
      <TreeView.Styles>
        <Style Selector="TreeViewItem">
          <Setter Property="IsVisible" Value="{ReflectionBinding IsVisible, Mode=OneWay}"/>
          <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}"/>
        </Style>
      </TreeView.Styles>
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="models:HeaderTreeFolder" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Count}" Foreground="{DynamicResource Editor.Subtle}"/>
          </StackPanel>
        </TreeDataTemplate>
        <DataTemplate DataType="models:HeaderTreeLeaf">
          <TextBlock Text="{Binding DisplayName}" Background="Transparent">
            <TextBlock.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Open Map Editor"      Click="CtxOpenMap_Click"/>
                <MenuItem Header="Open Events"          Click="CtxOpenEvents_Click"/>
                <MenuItem Header="Open Scripts"         Click="CtxOpenScripts_Click"/>
                <MenuItem Header="Open Text"            Click="CtxOpenTexts_Click"/>
                <MenuItem Header="Open Wild Encounters" Click="CtxOpenEncounters_Click"/>
                <MenuItem Header="Open Matrix"          Click="CtxOpenMatrix_Click"/>
              </ContextMenu>
            </TextBlock.ContextMenu>
          </TextBlock>
        </DataTemplate>
      </TreeView.DataTemplates>
    </TreeView>
  </DockPanel>
</UserControl>
