<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vc="clr-namespace:DSPRE.Avalonia.Views.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        x:Class="DSPRE.Avalonia.Views.World.HeaderFieldsView"
        x:DataType="vm:HeaderEditorViewModel">
  <!-- The header detail form. Shared by the standalone Header editor and the Maps workspace's Header tab.
       Mirrors the WinForms layout: a dense two-column form of framed group boxes on the left,
       a prominent preview rail (area icon / weather / camera) on the right. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBlock.inlinelabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </UserControl.Styles>

  <!-- Auto, not Disabled: the form is two columns wide and at a narrow window the right hand one,
       Area Data, Level Script, Text and Battle BG, was cut off with no way to reach it. -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="*,Auto" Margin="10">

      <!-- ── Left: the form ── -->
      <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,10,0">

        <!-- Location & area -->
        <GroupBox x:Name="LocationGroup" Header="Location &amp; Area">
          <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Internal name"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox Width="180" Text="{Binding InternalName}"/>
                <TextBlock Text="{Binding InternalNameLen}" Foreground="{Binding InternalNameColor}" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Location name"/>
              <controls:FusionAutoCompleteBox HorizontalAlignment="Stretch" ItemsSource="{Binding LocationNames}" SelectedIndex="{Binding LocationNameIndex}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Map type"/>
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AreaSettingsItems}" SelectedIndex="{Binding AreaSettingsIndex}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2" IsVisible="{Binding ShowAreaIcon}">
              <TextBlock Classes="fieldlabel" Text="Area icon"/>
              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AreaIconItems}" SelectedIndex="{Binding AreaIconIndex}"/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <!-- Appearance & sound: fixed-width numeric + readable combo, no full-width dropdowns -->
        <GroupBox x:Name="SoundGroup" Header="Appearance &amp; Sound">
          <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Music (Day)"/>
              <Grid ColumnDefinitions="90,6,*">
                <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding MusicDayValue}"/>
                <controls:FusionAutoCompleteBox Grid.Column="2" ItemsSource="{Binding MusicDay.Names}" SelectedIndex="{Binding MusicDayComboIndex}"/>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Music (Night)"/>
              <Grid ColumnDefinitions="90,6,*">
                <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding MusicNightValue}"/>
                <controls:FusionAutoCompleteBox Grid.Column="2" ItemsSource="{Binding MusicNight.Names}" SelectedIndex="{Binding MusicNightComboIndex}"/>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Weather"/>
              <Grid ColumnDefinitions="90,6,*,4,Auto">
                <NumericUpDown Width="90" Minimum="0" Maximum="{Binding WeatherMax}" Value="{Binding WeatherValue}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Weather.Names}" SelectedIndex="{Binding WeatherComboIndex}"/>
                <Button Grid.Column="4" Classes="small" controls:Icon.Key="questionMark" ToolTip.Tip="Weather and map memory"
                        IsVisible="{Binding WeatherRoomChecked}">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                      <StackPanel Spacing="6" Width="300">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Large weather backgrounds share memory with the area's buildings and textures. Arriving by door, Fly or a loaded save with too little left shows a black screen. Walking in from the next map is fine."/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"
                                   Text="Estimated from the area data. Platinum only."/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding WeatherRoomDetail}" IsVisible="{Binding WeatherRoomDetail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasWeatherRoomWarning}" ToolTip.Tip="{Binding WeatherRoomDetail}">
                <controls:IconImage Key="warning"/>
                <TextBlock Text="{Binding WeatherRoomWarning}" Foreground="{DynamicResource Editor.Warn}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Camera angle"/>
              <Grid ColumnDefinitions="90,6,*">
                <NumericUpDown Width="90" Minimum="0" Maximum="{Binding CameraMax}" Value="{Binding CameraValue}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding Camera.Names}" SelectedIndex="{Binding CameraComboIndex}"/>
              </Grid>
            </StackPanel>
          </Grid>
        </GroupBox>

        <!-- Linked files. The "🔗 Open" buttons jump to the referenced file in its editor. -->
        <GroupBox x:Name="LinkedFilesGroup" Header="Linked Files">
          <Grid ColumnDefinitions="Auto,Auto,28,Auto,Auto" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="inlinelabel" Text="Matrix"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding MatrixId}"/>
              <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenMatrix_Click" Padding="8,2" ToolTip.Tip="Open the linked Matrix"/>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="3" Classes="inlinelabel" Text="Area Data"/>
            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="255" Value="{Binding AreaDataId}"/>
              <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenAreaData_Click" Padding="8,2" ToolTip.Tip="Open the linked Area Data"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="inlinelabel" Text="Script"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding ScriptFileId}"/>
              <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenScripts_Click" Padding="8,2" ToolTip.Tip="Open the linked Script"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="3" Classes="inlinelabel" Text="Level Script"/>
            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding LevelScriptId}"/>
              <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenLevelScripts_Click" Padding="8,2" ToolTip.Tip="Open the linked Level Script"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Classes="inlinelabel" Text="Event"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding EventFileId}"/>
              <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenEvents_Click" Padding="8,2" ToolTip.Tip="Open the linked Events"/>
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.Column="3" Classes="inlinelabel" Text="Text"/>
            <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding TextArchiveId}"/>
              <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenTexts_Click" Padding="8,2" ToolTip.Tip="Open the linked Text archive"/>
            </StackPanel>

            <TextBlock Grid.Row="6" Grid.Column="0" Classes="inlinelabel" Text="Wild Pokémon"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="{Binding WildPokeMax}" Value="{Binding WildPokemon}"/>
              <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenEncounters_Click" IsEnabled="{Binding CanOpenEncounters}" Padding="8,2" ToolTip.Tip="Open the linked wild encounters"/>
            </StackPanel>
            <TextBlock Grid.Row="6" Grid.Column="3" Classes="inlinelabel" Text="Battle BG"/>
            <StackPanel Grid.Row="6" Grid.Column="4" Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="{Binding BattleBackgroundMax}" Value="{Binding BattleBackground}"/>
              <Button x:Name="OpenBattleSceneryButton" Content="Open" controls:Icon.Key="OpenLink" Click="OpenBattleScenery_Click" Padding="8,2"
                      ToolTip.Tip="Show this scenery and every place that fights on it"/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <!-- Map setting flags (names match WinForms; flags 4-6 HGSS-only) -->
        <GroupBox x:Name="MapSettingsGroup" Header="Map Settings">
          <WrapPanel>
            <CheckBox Content="Bicycle"   IsChecked="{Binding Flag0}" Margin="0,0,16,0"/>
            <CheckBox Content="Run"       IsChecked="{Binding Flag1}" Margin="0,0,16,0"/>
            <CheckBox Content="Esc. Rope" IsChecked="{Binding Flag2}" Margin="0,0,16,0"/>
            <CheckBox Content="Fly"       IsChecked="{Binding Flag3}" Margin="0,0,16,0"/>
            <CheckBox Content="Out Calls" IsChecked="{Binding Flag4}" IsVisible="{Binding ShowHgssOnly}" Margin="0,0,16,0" ToolTip.Tip="Whether the player can make outgoing Pokegear phone calls on this map."/>
            <CheckBox Content="In Calls" IsChecked="{Binding Flag5}" IsVisible="{Binding ShowHgssOnly}" Margin="0,0,16,0" ToolTip.Tip="Whether the player can receive incoming Pokegear phone calls on this map."/>
            <CheckBox Content="Radio" IsChecked="{Binding Flag6}" IsVisible="{Binding ShowHgssOnly}" Margin="0,0,16,0" ToolTip.Tip="Whether the player can pick up Pokegear radio signal on this map."/>
          </WrapPanel>
        </GroupBox>

        <!-- HGSS-only -->
        <GroupBox x:Name="HgssGroup" Header="HGSS Settings" IsVisible="{Binding ShowHgssOnly}">
          <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto,8,Auto">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="World map coordinates"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="inlinelabel" Text="X" Margin="0,0,2,0"/>
                <NumericUpDown Width="90" Minimum="0" Maximum="63" Value="{Binding WorldmapX}"/>
                <TextBlock Classes="inlinelabel" Text="Y" Margin="8,0,2,0"/>
                <NumericUpDown Width="90" Minimum="0" Maximum="63" Value="{Binding WorldmapY}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Follow mode"/>
              <ComboBox HorizontalAlignment="Left" Width="160" ItemsSource="{Binding FollowModeItems}" SelectedIndex="{Binding FollowModeIndex}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Mom's Call" ToolTip.Tip="Which intro line Mom uses when called from this map (offset added to her base call message)."/>
              <NumericUpDown Width="90" HorizontalAlignment="Left" Minimum="0" Maximum="15" Value="{Binding MomCallIntroParam}"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Region"/>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Content="Johto" GroupName="region" IsChecked="{Binding JohtoFlag}"/>
                <RadioButton Content="Kanto" GroupName="region" IsChecked="{Binding KantoFlag}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </GroupBox>

      </StackPanel>

      <!-- ── Right: preview rail. The area icon is a ~130x37 pixel banner, so it gets a big fixed frame. ── -->
      <StackPanel x:Name="PreviewRail" Grid.Column="1" Width="290" Spacing="10">
        <GroupBox Header="Area Icon" IsVisible="{Binding ShowAreaIcon}">
          <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}"
                  BorderThickness="1" Height="56" Padding="3">
            <Image Source="{Binding AreaIconImage}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
          </Border>
        </GroupBox>
        <!-- The header's camera and weather at the top screen's own size, 256 by 192. -->
        <GroupBox Header="Field View">
          <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}"
                  BorderThickness="1" Width="258" Height="194" HorizontalAlignment="Center">
            <vc:CameraPreview x:Name="CameraPreviewBox"/>
          </Border>
        </GroupBox>
      </StackPanel>

    </Grid>
  </ScrollViewer>
</UserControl>
