<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vc="clr-namespace:DSPRE.Avalonia.Views.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        x:Class="DSPRE.Avalonia.Views.World.HeaderFieldsView"
        x:DataType="vm:HeaderEditorViewModel">
  <!-- The header detail form. Shared by the standalone Header editor and the Maps workspace's Header tab.
       Each preview sits in the group whose fields it shows: the area icon with the location, the field view
       with the weather and camera. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.fieldlabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBlock.inlinelabel">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </UserControl.Styles>

  <!-- Auto, not Disabled: at a narrow window the right hand column was cut off with no way to reach it. -->
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <StackPanel Spacing="10" Margin="10">

      <!-- Location and area, with the area icon it picks -->
      <GroupBox x:Name="LocationGroup" Header="Location and area">
        <Grid ColumnDefinitions="*,16,*,16,Auto" RowDefinitions="Auto,8,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Internal name"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Width="180" Text="{Binding InternalName}"/>
              <TextBlock Text="{Binding InternalNameLen}" Foreground="{Binding InternalNameColor}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Location name"/>
            <controls:FusionAutoCompleteBox HorizontalAlignment="Stretch" ItemsSource="{Binding LocationNames}" SelectedIndex="{Binding LocationNameIndex}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Map type"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AreaSettingsItems}" SelectedIndex="{Binding AreaSettingsIndex}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2" IsVisible="{Binding ShowAreaIcon}">
            <TextBlock Classes="fieldlabel" Text="Area icon"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AreaIconItems}" SelectedIndex="{Binding AreaIconIndex}"/>
          </StackPanel>
          <!-- The area icon is a ~130x37 pixel banner, so it gets a fixed frame. -->
          <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="4" Width="260" Height="56" VerticalAlignment="Center" IsVisible="{Binding ShowAreaIcon}"
                  Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Padding="3"
>
            <Image Source="{Binding AreaIconImage}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
          </Border>
        </Grid>
      </GroupBox>

      <!-- Appearance and sound, with the field view it sets -->
      <GroupBox x:Name="SoundGroup" Header="Appearance and sound">
        <Grid ColumnDefinitions="*,16,*,16,Auto" RowDefinitions="Auto,8,Auto,8,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Music (day)"/>
            <Grid ColumnDefinitions="*,4,Auto">
              <controls:IdNameSelector Value="{Binding MusicDayValue}" Names="{Binding MusicDay.Names}" Keys="{Binding MusicDay.Keys}"/>
              <Button Grid.Column="2" Classes="small" controls:Icon.Key="play" Click="PlayDayMusic_Click" ToolTip.Tip="Play or stop"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Music (night)"/>
            <Grid ColumnDefinitions="*,4,Auto">
              <controls:IdNameSelector Value="{Binding MusicNightValue}" Names="{Binding MusicNight.Names}" Keys="{Binding MusicNight.Keys}"/>
              <Button Grid.Column="2" Classes="small" controls:Icon.Key="play" Click="PlayNightMusic_Click" ToolTip.Tip="Play or stop"/>
            </Grid>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Weather"/>
            <Grid ColumnDefinitions="*,4,Auto">
              <controls:IdNameSelector Maximum="{Binding WeatherMax}" Value="{Binding WeatherValue}" Names="{Binding Weather.Names}" Keys="{Binding Weather.Keys}"/>
              <Button Grid.Column="2" Classes="small" controls:Icon.Key="questionMark" ToolTip.Tip="Weather and map memory"
                      IsVisible="{Binding WeatherRoomChecked}">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Spacing="6" Width="300">
                      <TextBlock TextWrapping="Wrap"
                                 Text="Large weather backgrounds share memory with the area's buildings and textures. Arriving by door, Fly or a loaded save with too little left shows a black screen. Walking in from the next map is fine."/>
                      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"
                                 Text="Estimated from the area data. Platinum only."/>
                      <TextBlock TextWrapping="Wrap" Text="{Binding WeatherRoomDetail}" IsVisible="{Binding WeatherRoomDetail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasWeatherRoomWarning}" ToolTip.Tip="{Binding WeatherRoomDetail}">
              <controls:IconImage Key="warning"/>
              <TextBlock Text="{Binding WeatherRoomWarning}" Foreground="{DynamicResource Editor.Warn}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Camera angle"/>
            <controls:IdNameSelector Maximum="{Binding CameraMax}" Value="{Binding CameraValue}" Names="{Binding Camera.Names}" Keys="{Binding Camera.Keys}"/>
          </StackPanel>
          <!-- A battle background is graphics picked by number, not a linked file, so it sits with the other looks. -->
          <StackPanel Grid.Row="4" Grid.Column="0" Spacing="2">
            <TextBlock Classes="fieldlabel" Text="Battle background"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <NumericUpDown Width="90" Minimum="0" Maximum="{Binding BattleBackgroundMax}" Value="{Binding BattleBackground}"/>
              <Button x:Name="OpenBattleSceneryButton" Content="Open" controls:Icon.Key="OpenLink" Click="OpenBattleScenery_Click" Padding="8,2"
                      ToolTip.Tip="Show this scenery and every place that fights on it"/>
            </StackPanel>
          </StackPanel>
          <!-- The header's camera and weather at the top screen's own size, 256 by 192. -->
          <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="4" Width="258" Height="194" VerticalAlignment="Top"
                  Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
>
            <vc:CameraPreview x:Name="CameraPreviewBox"/>
          </Border>
        </Grid>
      </GroupBox>

      <!-- Linked files. The Open buttons go to the referenced file in its editor. -->
      <GroupBox x:Name="LinkedFilesGroup" Header="Linked files">
        <Grid ColumnDefinitions="Auto,Auto,28,Auto,Auto" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="inlinelabel" Text="Matrix"/>
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding MatrixId}"/>
            <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenMatrix_Click" Padding="8,2" ToolTip.Tip="{Binding OpenTips[Matrix]}"/>
          </StackPanel>
          <TextBlock Grid.Row="0" Grid.Column="3" Classes="inlinelabel" Text="Area data"/>
          <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="90" Minimum="0" Maximum="255" Value="{Binding AreaDataId}"/>
            <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenAreaData_Click" Padding="8,2" ToolTip.Tip="{Binding OpenTips[AreaData]}"/>
          </StackPanel>

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="inlinelabel" Text="Script file"/>
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding ScriptFileId}"/>
            <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenScripts_Click" Padding="8,2" ToolTip.Tip="{Binding OpenTips[Script]}"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Grid.Column="3" Classes="inlinelabel" Text="Level script file"/>
          <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding LevelScriptId}"/>
            <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenLevelScripts_Click" Padding="8,2" ToolTip.Tip="{Binding OpenTips[LevelScript]}"/>
          </StackPanel>

          <TextBlock Grid.Row="4" Grid.Column="0" Classes="inlinelabel" Text="Event file"/>
          <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding EventFileId}"/>
            <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenEvents_Click" Padding="8,2" ToolTip.Tip="{Binding OpenTips[Event]}"/>
          </StackPanel>
          <TextBlock Grid.Row="4" Grid.Column="3" Classes="inlinelabel" Text="Text archive"/>
          <StackPanel Grid.Row="4" Grid.Column="4" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="90" Minimum="0" Maximum="65535" Value="{Binding TextArchiveId}"/>
            <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenTexts_Click" Padding="8,2" ToolTip.Tip="{Binding OpenTips[Text]}"/>
          </StackPanel>

          <TextBlock Grid.Row="6" Grid.Column="0" Classes="inlinelabel" Text="Encounters"/>
          <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <NumericUpDown Width="90" Minimum="0" Maximum="{Binding WildPokeMax}" Value="{Binding WildPokemon}"/>
            <Button Content="Open" controls:Icon.Key="OpenLink" Click="OpenEncounters_Click" IsEnabled="{Binding CanOpenEncounters}" Padding="8,2" ToolTip.Tip="{Binding OpenTips[Encounters]}"/>
          </StackPanel>
        </Grid>
      </GroupBox>

      <!-- Map settings: the flags, and on HeartGold and SoulSilver the region, town map and Pokégear fields. -->
      <GroupBox x:Name="MapSettingsGroup" Header="Map settings">
        <StackPanel Spacing="10">
          <WrapPanel Classes="flags">
            <CheckBox Content="Bicycle"     IsChecked="{Binding Flag0}"/>
            <CheckBox Content="Run"         IsChecked="{Binding Flag1}"/>
            <CheckBox Content="Escape rope" IsChecked="{Binding Flag2}"/>
            <CheckBox Content="Fly"         IsChecked="{Binding Flag3}"/>
            <CheckBox Content="Outgoing calls" IsChecked="{Binding Flag4}" IsVisible="{Binding ShowHgssOnly}" ToolTip.Tip="Whether the player can make outgoing Pokégear phone calls on this map."/>
            <CheckBox Content="Incoming calls" IsChecked="{Binding Flag5}" IsVisible="{Binding ShowHgssOnly}" ToolTip.Tip="Whether the player can receive incoming Pokégear phone calls on this map."/>
            <CheckBox Content="Radio" IsChecked="{Binding Flag6}" IsVisible="{Binding ShowHgssOnly}" ToolTip.Tip="Whether the player can pick up Pokégear radio signal on this map."/>
          </WrapPanel>
          <Grid x:Name="HgssGroup" ColumnDefinitions="*,16,*" RowDefinitions="Auto,8,Auto" IsVisible="{Binding ShowHgssOnly}">
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Town map position"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="inlinelabel" Text="X" Margin="0,0,2,0"/>
                <NumericUpDown Width="90" Minimum="0" Maximum="63" Value="{Binding WorldmapX}"/>
                <TextBlock Classes="inlinelabel" Text="Y" Margin="8,0,2,0"/>
                <NumericUpDown Width="90" Minimum="0" Maximum="63" Value="{Binding WorldmapY}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Follow mode"/>
              <ComboBox HorizontalAlignment="Left" Width="160" ItemsSource="{Binding FollowModeItems}" SelectedIndex="{Binding FollowModeIndex}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Mom's call" ToolTip.Tip="Which line Mom opens with when called from this map."/>
              <NumericUpDown Width="90" HorizontalAlignment="Left" Minimum="0" Maximum="15" Value="{Binding MomCallIntroParam}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Spacing="2">
              <TextBlock Classes="fieldlabel" Text="Region"/>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Content="Johto" GroupName="region" IsChecked="{Binding JohtoFlag}"/>
                <RadioButton Content="Kanto" GroupName="region" IsChecked="{Binding KantoFlag}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </GroupBox>

    </StackPanel>
  </ScrollViewer>
</UserControl>
