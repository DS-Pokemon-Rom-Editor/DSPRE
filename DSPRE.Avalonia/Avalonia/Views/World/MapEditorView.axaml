<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:world="clr-namespace:DSPRE.Avalonia.Views.World"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:gl="clr-namespace:DSPRE.Avalonia.Gl"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.World.MapEditorView"
        x:DataType="vm:MapEditorViewModel">

  <Design.DataContext>
    <vm:MapEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <controls:EditorToolbar>
          <TextBlock Text="View" VerticalAlignment="Center"/>
          <ComboBox x:Name="ViewModeBox" Width="110" ItemsSource="{Binding ViewModes}" SelectedIndex="{Binding ViewModeIndex}"/>
          <TextBlock Text="Map" VerticalAlignment="Center" IsVisible="{Binding IsSingleMap}"/>
          <controls:FusionAutoCompleteBox Width="140" ItemsSource="{Binding MapNames}" SelectedIndex="{Binding SelectedMapIndex}" IsVisible="{Binding IsSingleMap}"/>
          <controls:HeadersButton controls:EditorToolbar.Slot="Picker" Source="Map" FileId="{Binding SelectedMapIndex}" IsVisible="{Binding IsSingleMap}"/>
          <TextBlock Text="Matrix" VerticalAlignment="Center" IsVisible="{Binding IsMatrixView}"/>
          <controls:FusionAutoCompleteBox Width="140" ItemsSource="{Binding Matrices}" SelectedIndex="{Binding SelectedMatrixIndex}" IsVisible="{Binding IsMatrixView}"/>
          <TextBlock controls:EditorToolbar.Slot="Picker" Text="{Binding MatrixInfo}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" IsVisible="{Binding IsMatrixView}"/>
          <TextBlock Text="Header" VerticalAlignment="Center" IsVisible="{Binding IsHeaderView}"/>
          <controls:FusionAutoCompleteBox Width="220" ItemsSource="{Binding HeaderNames}" SelectedIndex="{Binding SelectedHeaderIndex}" IsVisible="{Binding IsHeaderView}"
                                          ToolTip.Tip="Which header's maps to show."/>
          <TextBlock Text="Map" VerticalAlignment="Center" IsVisible="{Binding IsHeaderView}"/>
          <controls:FusionAutoCompleteBox x:Name="MapPicker" Width="110" ItemsSource="{Binding HeaderMapNames}" SelectedIndex="{Binding SelectedHeaderMapIndex}" IsVisible="{Binding IsHeaderView}"
                    ToolTip.Tip="The map to edit. Picking a building or painting a square picks its map."/>
          <Button controls:EditorToolbar.Slot="Extra" Content="Screenshot" controls:Icon.Key="cameraIcon" Click="Screenshot_Click"/>
          <Button controls:EditorToolbar.Slot="Extra" Content="Animate" controls:Icon.Key="play" Click="AnimatedPreview_Click" IsVisible="{Binding ShowBetaFeatures}"
                  ToolTip.Tip="Plays the map, with its water moving as it does in game."/>
          <Button x:Name="EditModelButton" Content="Modify map model" controls:Icon.Key="pencil" Click="EditModel_Click" IsEnabled="{Binding CanEditModel}"
                  ToolTip.Tip="Build, edit or import this map's model"/>
          <Button x:Name="SaveButton" Content="Save" controls:Icon.Key="saveButton"     Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
          <controls:UndoRedoButtons/>
          <Button Content="Import…" controls:Icon.Key="import"   Click="Import_Click" IsVisible="{Binding IsSingleMap}"
                  ToolTip.Tip="A map .bin replaces the whole map; an .nsbmd replaces the model only"/>
          <Button Content="Export…" controls:Icon.Key="export"   Click="Export_Click" IsVisible="{Binding IsSingleMap}"/>
          <Button Content="Add" controls:Icon.Key="addIcon"  Click="AddMap_Click" IsVisible="{Binding IsSingleMap}"/>
          <Button Content="Remove last" controls:Icon.Key="deleteIcon" Click="RemMap_Click" IsVisible="{Binding IsSingleMap}"/>
    </controls:EditorToolbar>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Vertical">
        <TextBlock Text="{Binding NoHeaderNote}" TextWrapping="Wrap" Margin="8,2" Foreground="{DynamicResource Editor.Warn}"
                   IsVisible="{Binding NoHeaderNote, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        <!-- Row 2: textures + overlay -->
        <WrapPanel Classes="toolbar">
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding NoHeaderNote, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Area data" VerticalAlignment="Center"/>
            <NumericUpDown Width="110" Minimum="0" Maximum="{Binding MaxPreviewArea}" Increment="1" FormatString="0" Value="{Binding PreviewArea}"
                           ToolTip.Tip="Preview only"/>
          </StackPanel>
          <TextBlock Text="Map textures" VerticalAlignment="Center"/>
          <ComboBox Width="130" ItemsSource="{Binding MapTilesets}" SelectedIndex="{Binding MapTilesetIndex}" IsEnabled="{Binding HasArea}"
                    ToolTip.Tip="{Binding AreaLabel, StringFormat='Saved to {0}, with the map'}"/>
          <TextBlock Text="Building textures" VerticalAlignment="Center"/>
          <ComboBox Width="130" ItemsSource="{Binding BuildingTilesets}" SelectedIndex="{Binding BuildingTilesetIndex}" IsEnabled="{Binding HasArea}"
                    ToolTip.Tip="{Binding AreaLabel, StringFormat='Saved to {0}, with the map'}"/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Show" VerticalAlignment="Center"/>
            <ComboBox Width="110" ItemsSource="{Binding OverlayModes}" SelectedIndex="{Binding OverlayModeIndex}"/>
          </StackPanel>
          <CheckBox Content="Mesh" IsChecked="{Binding OverlayAsMesh}" IsEnabled="{Binding MeshToggleEnabled}" VerticalAlignment="Center"
                    ToolTip.Tip="Paint on the map surface instead of a flat plane."/>
          <TextBlock Text="Opacity" VerticalAlignment="Center" IsVisible="{Binding ShowOverlayOpacity}"/>
          <Slider Width="100" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding OverlayOpacity}"
                  VerticalAlignment="Center" IsVisible="{Binding ShowOverlayOpacity}"
                  ToolTip.Tip="{Binding OverlayOpacity, StringFormat='{}{0}%'}"/>
          <TextBlock Text="Height" VerticalAlignment="Center" IsVisible="{Binding ShowOverlayHeight}"/>
          <Slider Width="120" Minimum="-5" Maximum="20" SmallChange="0.25" LargeChange="1"
                  Value="{Binding OverlayHeight}" VerticalAlignment="Center" IsVisible="{Binding ShowOverlayHeight}"
                  ToolTip.Tip="Lift the flat permission plane off the map surface (in tiles)"/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
          <CheckBox Content="Textured" IsChecked="{Binding ShowTextures}" VerticalAlignment="Center"
                    ToolTip.Tip="Show real textures. Off shows a flat colour per material."/>
          <CheckBox Content="Gizmos" IsChecked="False" VerticalAlignment="Center" IsVisible="{Binding ShowBetaFeatures}"
                    IsCheckedChanged="Gizmos_Toggled"
                    ToolTip.Tip="Cyan marks the 32×32 tile cell, yellow the map model's real extent."/>
          <CheckBox Content="Grid layout" IsChecked="{Binding StitchGrid}" IsEnabled="{Binding IsStitchedView}" VerticalAlignment="Center"
                    ToolTip.Tip="Place maps on the game's 32-tile grid."/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
          <ToggleButton Content="Move buildings" controls:Icon.Key="move" IsChecked="{Binding EditMode3D}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"
                        ToolTip.Tip="Click a building, then drag its handles or use the arrow keys."/>
          <ToggleButton Content="Paint" controls:Icon.Key="brush" IsChecked="{Binding PaintMode}" IsEnabled="{Binding CanEdit}" VerticalAlignment="Center"
                        ToolTip.Tip="Click or drag on the map to paint tiles."/>
          <CheckBox Content="Snap to tile" IsChecked="{Binding SnapToTile}" VerticalAlignment="Center"
                    ToolTip.Tip="Snap dragged buildings to whole tiles"/>
          <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="View" VerticalAlignment="Center"/>
            <ToggleButton Content="2D" IsChecked="{Binding Flat2D}" VerticalAlignment="Center" Padding="6,2"
                          ToolTip.Tip="Flat top-down view, easier to paint accurately."/>
            <Button Content="Top" Click="CamTop_Click" VerticalAlignment="Center" Padding="6,2" ToolTip.Tip="Top-down camera" IsEnabled="{Binding !Flat2D}"/>
            <Button Content="Iso" Click="CamIso_Click" VerticalAlignment="Center" Padding="6,2" ToolTip.Tip="Isometric (3/4) camera" IsEnabled="{Binding !Flat2D}"/>
            <Button Content="Front" Click="CamFront_Click" VerticalAlignment="Center" Padding="6,2" ToolTip.Tip="Front camera" IsEnabled="{Binding !Flat2D}"/>
            <Button Content="Side" Click="CamSide_Click" VerticalAlignment="Center" Padding="6,2" ToolTip.Tip="Side camera" IsEnabled="{Binding !Flat2D}"/>
            <Button controls:Icon.Key="resetIcon" Click="CamReset_Click" VerticalAlignment="Center" Padding="6,2" ToolTip.Tip="Reset camera"/>
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid x:Name="SplitGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="300"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="480" MinWidth="380"/>
      </Grid.ColumnDefinitions>
      <!-- 3D preview (geometry; textures deferred) -->
      <Border x:Name="GlHost" Grid.Column="0" Background="Transparent" Margin="4">
        <gl:NsbmdGlControl x:Name="GlView"/>
      </Border>

      <!-- Editing panels (single map + "This header" view; Full matrix is render-only) -->
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent"/>
      <TabControl x:Name="MapTabs" Grid.Column="2" Margin="0,4,4,4" IsEnabled="{Binding CanEdit}">
        <TabItem Header="Permissions">
          <ScrollViewer>
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Spacing="4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Collision painter" FontWeight="Bold"/>
                <controls:HelpTip Text="Click or drag to paint, middle-click to fill, right-click to pick."/>
              </StackPanel>
              <controls:IdNameSelector Maximum="255" Value="{Binding CollisionValue}" Names="{Binding CollisionNames}" Keys="{Binding CollisionKeys}"
                                       ToolTip.Tip="A number with no name is painted as it is"/>
              <TextBlock Text="Type painter" FontWeight="Bold" Margin="0,4,0,0"/>
              <controls:IdNameSelector Maximum="255" Value="{Binding TypeValue}" Names="{Binding TypeNames}" Keys="{Binding TypeKeys}"
                                       ToolTip.Tip="A number with no name is painted as it is"/>
              <StackPanel Spacing="4" Margin="0,4,0,4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Scan used types" controls:Icon.Key="lens" Click="ScanTypes_Click"/>
                  <Button Content="Clear layer" controls:Icon.Key="deleteIcon" Click="ClearLayer_Click" IsVisible="{Binding IsSingleMap}"
                          ToolTip.Tip="Sets every square of the layer shown below to 0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="4" Margin="0,0,14,0" IsVisible="{Binding IsSingleMap}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <RadioButton GroupName="PermissionLayer" IsChecked="{Binding PermissionShowsCollision}">
                  <StackPanel Spacing="2">
                    <gl:PermissionGridControl x:Name="CollisionThumb" Width="64" Height="64" IsHitTestVisible="False"/>
                    <TextBlock Text="Collision" HorizontalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="PermissionLayer" IsChecked="{Binding PermissionShowsType}">
                  <StackPanel Spacing="2">
                    <gl:PermissionGridControl x:Name="TypeThumb" Width="64" Height="64" IsHitTestVisible="False"/>
                    <TextBlock Text="Type" HorizontalAlignment="Center"/>
                  </StackPanel>
                </RadioButton>
              </StackPanel>
              <gl:PermissionGridControl x:Name="PermGrid" MinHeight="180"/>
              <TextBlock TextWrapping="Wrap" MinHeight="16"
                         Foreground="{DynamicResource Editor.Subtle}" Text="{Binding PermissionHover}"/>
            </StackPanel>
          </DockPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Buildings">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
              <Button Content="Add" controls:Icon.Key="addIcon"    Click="AddBuilding_Click"/>
              <Button Content="Remove" controls:Icon.Key="deleteIcon" Click="RemoveBuilding_Click" IsEnabled="{Binding HasBuildingSelected}"/>
              <Button Content="Duplicate" controls:Icon.Key="copy" Click="DupBuilding_Click" IsEnabled="{Binding HasBuildingSelected}"/>
              <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
              <Button Content="Import…" controls:Icon.Key="import" Click="ImportBuildings_Click" IsEnabled="{Binding IsSingleMap}"
                      ToolTip.Tip="Replace this map's building list."/>
              <Button Content="Export…" controls:Icon.Key="export" Click="ExportBuildings_Click" IsEnabled="{Binding IsSingleMap}"/>
              <TextBlock Text="{Binding BuildingLimitWarning}" IsVisible="{Binding HasBuildingLimitWarning}"
                         Foreground="{DynamicResource Editor.Warn}" VerticalAlignment="Center" Margin="6,0,0,0"
                         ToolTip.Tip="The game loads only 32 per map"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,200">
              <ListBox Grid.Column="0" ItemsSource="{Binding Buildings}" SelectedIndex="{Binding SelectedBuildingIndex}"/>
              <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="6" IsVisible="{Binding HasBuildingSelected}">
                <StackPanel Spacing="2">
                  <TextBlock Text="Model ID" FontSize="10" Foreground="{DynamicResource Editor.Subtle}"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <NumericUpDown HorizontalAlignment="Stretch" Minimum="0" Maximum="65535" Increment="1" Value="{Binding BModelId}"/>
                    <Button Grid.Column="1" Content="Choose…" Margin="4,0,0,0" Click="ChooseModel_Click"
                            ToolTip.Tip="Pick the model from a list with a preview"/>
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Position (tiles · fine)" FontSize="10" Foreground="{DynamicResource Editor.Subtle}"/>
                  <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,2" Minimum="-32768" Maximum="32767" Increment="0.0625" FormatString="0.####" Value="{Binding BX}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,2" Minimum="-32768" Maximum="32767" Increment="0.0625" FormatString="0.####" Value="{Binding BY}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="-32768" Maximum="32767" Increment="0.0625" FormatString="0.####" Value="{Binding BZ}"/>
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="Rotation (°)" FontSize="10" Foreground="{DynamicResource Editor.Subtle}"/>
                  <TextBlock Text="Requires the building rotation patch (patch toolbox)" FontSize="9" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding !BuildingRotationEnabled}"/>
                  <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,4,*" Margin="0,0,0,2">
                      <NumericUpDown HorizontalAlignment="Stretch" Minimum="0" Maximum="359.99" Increment="1" FormatString="0.##" Value="{Binding BRotX}" IsEnabled="{Binding BuildingRotationEnabled}" ToolTip.Tip="Degrees"/>
                      <NumericUpDown Grid.Column="2" HorizontalAlignment="Stretch" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding BRawX}" IsEnabled="{Binding BuildingRotationEnabled}" ToolTip.Tip="Stored value (65536 is a full turn)"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,4,*" Margin="0,0,0,2">
                      <NumericUpDown HorizontalAlignment="Stretch" Minimum="0" Maximum="359.99" Increment="1" FormatString="0.##" Value="{Binding BRotY}" IsEnabled="{Binding BuildingRotationEnabled}" ToolTip.Tip="Degrees"/>
                      <NumericUpDown Grid.Column="2" HorizontalAlignment="Stretch" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding BRawY}" IsEnabled="{Binding BuildingRotationEnabled}" ToolTip.Tip="Stored value (65536 is a full turn)"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,4,*">
                      <NumericUpDown HorizontalAlignment="Stretch" Minimum="0" Maximum="359.99" Increment="1" FormatString="0.##" Value="{Binding BRotZ}" IsEnabled="{Binding BuildingRotationEnabled}" ToolTip.Tip="Degrees"/>
                      <NumericUpDown Grid.Column="2" HorizontalAlignment="Stretch" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding BRawZ}" IsEnabled="{Binding BuildingRotationEnabled}" ToolTip.Tip="Stored value (65536 is a full turn)"/>
                    </Grid>
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Scale" FontSize="10" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
                    <controls:HelpTip Text="1 is the model's normal size. Each step is 1/16."/>
                  </StackPanel>
                  <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,2" Minimum="0.0625" Maximum="4095.9375" Increment="0.0625" FormatString="0.####" Value="{Binding BScaleX}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,2" Minimum="0.0625" Maximum="4095.9375" Increment="0.0625" FormatString="0.####" Value="{Binding BScaleY}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0.0625" Maximum="4095.9375" Increment="0.0625" FormatString="0.####" Value="{Binding BScaleZ}"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Grid>
          </DockPanel>
        </TabItem>

        <TabItem Header="Area" IsEnabled="{Binding HasArea}">
          <ScrollViewer>
            <StackPanel Margin="8" Spacing="8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding AreaLabel}" FontWeight="SemiBold"/>
                <controls:HelpTip Text="Every header using this area shares its textures, animation and light."/>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,6,Auto,6,Auto">
                <TextBlock Grid.Row="0" Text="Global NSBTA" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="{Binding IsHgssGame}"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding AreaGroundAnimation}" Minimum="0" Maximum="65535" FormatString="0"
                               Width="120" HorizontalAlignment="Left" IsVisible="{Binding IsHgssGame}"
                               ToolTip.Tip="Area-wide texture animation, like moving water. 65535 is none."/>
                <TextBlock Grid.Row="2" Text="Light type" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <controls:IdNameSelector Grid.Row="2" Grid.Column="1" Value="{Binding AreaLightType}" Names="{Binding AreaLightNames}" Width="260"
                                         HorizontalAlignment="Left" ToolTip.Tip="{Binding AreaLightNote}"/>
                <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Indoors" IsChecked="{Binding AreaIndoor}" IsVisible="{Binding IsHgssGame}"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Files / I/O" IsEnabled="{Binding IsSingleMap}">
          <ScrollViewer>
            <StackPanel Margin="8" Spacing="10">
              <Button Content="Show map file" controls:Icon.Key="folder" Click="ShowMapFile_Click" HorizontalAlignment="Left"
                      ToolTip.Tip="The map as last saved"/>
              <GroupBox Header="3D model">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Export model…" controls:Icon.Key="export" Click="ExportNsbmd_Click"/>
                  <Button Content="Export textured…" controls:Icon.Key="export" Click="ExportTexturedNsbmd_Click"
                          ToolTip.Tip="With the Map textures pack's textures inside the model"/>
                  <Button Content="Export DAE…" controls:Icon.Key="export"   Click="ExportDae_Click"/>
                  <Button Content="Export GLB…" controls:Icon.Key="export"   Click="ExportGlb_Click"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Terrain">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Import…" controls:Icon.Key="import" Click="ImportTerrain_Click"/>
                  <Button Content="Export…" controls:Icon.Key="export" Click="ExportTerrain_Click"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Sound plates">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Import…" controls:Icon.Key="import" Click="ImportSound_Click"/>
                  <Button Content="Export…" controls:Icon.Key="export" Click="ExportSound_Click"/>
                  <Button Content="Blank" controls:Icon.Key="blank"  Click="BlankSound_Click"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Movement permissions">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Import…" controls:Icon.Key="import" Click="ImportPerms_Click"/>
                  <Button Content="Export…" controls:Icon.Key="export" Click="ExportPerms_Click"/>
                </StackPanel>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
