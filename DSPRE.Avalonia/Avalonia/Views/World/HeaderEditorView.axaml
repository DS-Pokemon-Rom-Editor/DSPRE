<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:views="clr-namespace:DSPRE.Avalonia.Views.World"
        x:Class="DSPRE.Avalonia.Views.World.HeaderEditorView"
        x:DataType="vm:HeaderEditorViewModel">

  <Design.DataContext>
    <vm:HeaderEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <views:HeaderToolbarView/>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <!-- Sidebar tree + detail form (both shared with the Maps workspace) -->
    <Grid ColumnDefinitions="230,*">
      <views:HeaderSidebarView Grid.Column="0" Margin="4"/>
      <views:HeaderFieldsView  Grid.Column="1"/>
    </Grid>
  </DockPanel>
</UserControl>
