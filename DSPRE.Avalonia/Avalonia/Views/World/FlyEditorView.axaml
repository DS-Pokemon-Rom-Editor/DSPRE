<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:vmcontrols="clr-namespace:DSPRE.Avalonia.ViewModels.Controls"
		x:Class="DSPRE.Avalonia.Views.World.FlyEditorView"
		x:DataType="vm:FlyEditorViewModel"
		Width="760" Height="560" MinWidth="600" MinHeight="400"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:FlyEditorViewModel/>
  </Design.DataContext>


  <DockPanel LastChildFill="True">

	<controls:EditorToolbar>
		<Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<controls:UndoRedoButtons/>
		<TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{DynamicResource Editor.Bad}" Margin="12,0,0,0"/>
	</controls:EditorToolbar>

	<TabControl Margin="8">

	  <TabItem Header="Whiteout warps">
		<DataGrid ItemsSource="{Binding Rows}"
				  CanUserReorderColumns="False" CanUserResizeColumns="True"
				  CanUserSortColumns="False" GridLinesVisibility="All"
				  SelectionMode="Single" AutoGenerateColumns="False">
		  <DataGrid.Columns>

			<!-- Header combobox (shared for all game families) -->
			<DataGridTemplateColumn Header="Header (whiteout)" Width="*">
			  <DataGridTemplateColumn.CellTemplate>
				<DataTemplate x:DataType="vm:FlyRow">
				  <controls:FusionAutoCompleteBox ItemsSource="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).Headers}"
							SelectedIndex="{Binding HeaderIdGameOver}"
							HorizontalAlignment="Stretch"/>
				</DataTemplate>
			  </DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTextColumn Header="Local X" Binding="{Binding LocalX}" Width="70"/>
			<DataGridTextColumn Header="Local Y" Binding="{Binding LocalY}" Width="70"/>

		  </DataGrid.Columns>
		</DataGrid>
	  </TabItem>

	  <TabItem Header="Fly warps">
		<DataGrid ItemsSource="{Binding Rows}"
				  CanUserReorderColumns="False" CanUserResizeColumns="True"
				  CanUserSortColumns="False" GridLinesVisibility="All"
				  SelectionMode="Single" AutoGenerateColumns="False">
		  <DataGrid.Columns>

			<DataGridTemplateColumn Header="Header (Fly)" Width="*">
			  <DataGridTemplateColumn.CellTemplate>
				<DataTemplate x:DataType="vm:FlyRow">
				  <controls:FusionAutoCompleteBox ItemsSource="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).Headers}"
							SelectedIndex="{Binding HeaderIdFly}"
							HorizontalAlignment="Stretch"/>
				</DataTemplate>
			  </DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTextColumn Header="Global X" Binding="{Binding GlobalX}" Width="80"/>
			<DataGridTextColumn Header="Global Y" Binding="{Binding GlobalY}" Width="80"/>

		  </DataGrid.Columns>
		</DataGrid>
	  </TabItem>

	  <TabItem Header="Unlock settings">
		<DataGrid x:Name="UnlockGrid" ItemsSource="{Binding Rows}"
				  CanUserReorderColumns="False" CanUserResizeColumns="True"
				  CanUserSortColumns="False" GridLinesVisibility="All"
				  SelectionMode="Single" AutoGenerateColumns="False">
		  <DataGrid.Columns>

			<!-- DP / Plat columns -->
			<DataGridTemplateColumn Header="Teleport spot"
									Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsDpOrPlat, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}">
			  <DataGridTemplateColumn.CellTemplate>
				<DataTemplate x:DataType="vm:FlyRow">
				  <CheckBox IsChecked="{Binding IsTeleportPos}" HorizontalAlignment="Center"/>
				</DataTemplate>
			  </DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTemplateColumn Header="Unlock on map entry"
									Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsDpOrPlat, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}">
			  <DataGridTemplateColumn.CellTemplate>
				<DataTemplate x:DataType="vm:FlyRow">
				  <CheckBox IsChecked="{Binding UnlockOnMapEntry}" HorizontalAlignment="Center"/>
				</DataTemplate>
			  </DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTextColumn Header="Unlock ID" Binding="{Binding UnlockId}"
								Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsDpOrPlat, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}"/>

			<!-- HGSS columns -->
			<DataGridTemplateColumn Header="Header (unlock)"
									Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsHgss, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}">
			  <DataGridTemplateColumn.CellTemplate>
				<DataTemplate x:DataType="vm:FlyRow">
				  <controls:FusionAutoCompleteBox ItemsSource="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).Headers}"
							SelectedIndex="{Binding HeaderIdUnlockWarp}"
							HorizontalAlignment="Stretch"/>
				</DataTemplate>
			  </DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTextColumn Header="Global X (unlock)" Binding="{Binding GlobalXUnlock}"
								Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsHgss, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}"/>
			<DataGridTextColumn Header="Global Y (unlock)" Binding="{Binding GlobalYUnlock}"
								Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsHgss, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}"/>

			<DataGridTextColumn Header="Flag index" Binding="{Binding FlagIdx}"
								Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsHgss, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}"/>

			<DataGridTemplateColumn Header="Whiteout spot"
									Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsHgss, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}">
			  <DataGridTemplateColumn.CellTemplate>
				<DataTemplate x:DataType="vm:FlyRow">
				  <CheckBox IsChecked="{Binding IsBlackoutSpawn}" HorizontalAlignment="Center"/>
				</DataTemplate>
			  </DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

			<DataGridTemplateColumn Header="Fly spot"
									Width="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).IsHgss, Converter={x:Static vmcontrols:BoolToGridLengthConverter.Instance}}">
			  <DataGridTemplateColumn.CellTemplate>
				<DataTemplate x:DataType="vm:FlyRow">
				  <CheckBox IsChecked="{Binding IsFlyPoint}" HorizontalAlignment="Center"/>
				</DataTemplate>
			  </DataGridTemplateColumn.CellTemplate>
			</DataGridTemplateColumn>

		  </DataGrid.Columns>
		</DataGrid>
	  </TabItem>

	  <TabItem Header="Town map" IsVisible="{Binding HasSpots}">
		<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*">
		  <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,6" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"
					 Text="Drag a spot to move it" ToolTip.Tip="Dashed boxes are town areas"/>
		  <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
			<Panel x:Name="TownMapPanel" Width="752" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top">
			  <Image Source="{Binding TownMap}" Width="752" Height="320" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
			  <ItemsControl ItemsSource="{Binding Spots}" IsHitTestVisible="False">
				<ItemsControl.ItemsPanel>
				  <ItemsPanelTemplate><Panel/></ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
				  <DataTemplate x:DataType="vm:FlySpotRow">
					<Canvas IsVisible="{Binding HasArea}">
					  <Rectangle Canvas.Left="{Binding AreaLeft}" Canvas.Top="{Binding AreaTop}" Width="{Binding AreaWidth}" Height="{Binding AreaHeight}"
								 Stroke="{DynamicResource Editor.Good}" StrokeThickness="1" StrokeDashArray="3,2"/>
					</Canvas>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			  <ItemsControl ItemsSource="{Binding Spots}">
				<ItemsControl.ItemsPanel>
				  <ItemsPanelTemplate><Panel/></ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
				  <DataTemplate x:DataType="vm:FlySpotRow">
					<Canvas>
					  <Border Canvas.Left="{Binding Left}" Canvas.Top="{Binding Top}"
							  Width="{Binding BoxWidth}" Height="{Binding BoxHeight}" BorderThickness="2" Cursor="SizeAll"
							  BorderBrush="{DynamicResource Editor.Warn}" Background="Transparent"
							  ToolTip.Tip="{Binding Name}" Tag="{Binding}"
							  PointerPressed="Spot_PointerPressed" PointerMoved="Spot_PointerMoved" PointerReleased="Spot_PointerReleased"/>
					</Canvas>
				  </DataTemplate>
				</ItemsControl.ItemTemplate>
			  </ItemsControl>
			</Panel>
		  </ScrollViewer>
		  <DataGrid Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Spots}"
					CanUserReorderColumns="False" CanUserSortColumns="False" GridLinesVisibility="All">
			<DataGrid.Columns>
			  <DataGridTextColumn Header="Town" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
			  <DataGridTextColumn Header="X" Binding="{Binding X}" Width="50"/>
			  <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="50"/>
			  <DataGridTemplateColumn Header="Fly row" Width="2*">
				<DataGridTemplateColumn.CellTemplate>
				  <DataTemplate x:DataType="vm:FlySpotRow">
					<StackPanel Spacing="2">
					  <ComboBox ItemsSource="{Binding $parent[Window].((vm:FlyEditorViewModel)DataContext).FlyRowChoices}"
								SelectedIndex="{Binding FlyRow, Mode=OneWay}" HorizontalAlignment="Stretch"
								SelectionChanged="FlyRow_SelectionChanged" Tag="{Binding}"/>
					  <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap"
								 FontSize="12" Foreground="{DynamicResource Editor.Bad}"/>
					</StackPanel>
				  </DataTemplate>
				</DataGridTemplateColumn.CellTemplate>
			  </DataGridTemplateColumn>
			</DataGrid.Columns>
		  </DataGrid>
		</Grid>
	  </TabItem>

	</TabControl>
  </DockPanel>
</Window>
