<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.World"
        xmlns:gl="clr-namespace:DSPRE.Avalonia.Gl"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.World.EventEditorView"
        x:DataType="vm:EventEditorViewModel">

  <Design.DataContext>
    <vm:EventEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel Classes="toolbar">
        <TextBlock Text="Event file:" VerticalAlignment="Center"/>
        <controls:FusionAutoCompleteBox Width="150" ItemsSource="{Binding EventNames}" SelectedIndex="{Binding SelectedEventIndex}"/>
        <Button Content="＋ Add"     Click="AddFile_Click"/>
        <Button Content="🗑 Remove last" Click="RemFile_Click"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="💾 Save"   Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="📥 Import" Click="Import_Click"/>
        <Button Content="📤 Export" Click="Export_Click"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Border x:Name="Pegman" Background="Transparent" Cursor="Hand" Padding="2" IsVisible="{Binding ShowBetaFeatures}"
                PointerPressed="Pegman_PointerPressed"
                PointerMoved="Pegman_PointerMoved"
                PointerReleased="Pegman_PointerReleased"
                ToolTip.Tip="Drag me onto the map and let go, and the walk starts from there.">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Image x:Name="PegmanIcon" Width="26" Height="26"
                   RenderOptions.BitmapInterpolationMode="None"/>
            <TextBlock Text="Drag to walk" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <Button Content="▶ Step in here" Click="StepInHere_Click" IsVisible="{Binding ShowBetaFeatures}"
                ToolTip.Tip="Walk the map starting next to the selected event, so you can talk to them or set the trigger off straight away."/>
        <Button Content="▶ Animate" Click="AnimatedPreview_Click" IsVisible="{Binding ShowBetaFeatures}"
                ToolTip.Tip="Opens a look-only window that runs the map: the water moves and the people turn and wander the way their movement code says. Scripts are not run."/>
        <Button Content="📷 Screenshot" Click="Screenshot_Click"
                ToolTip.Tip="Saves what the map view is currently showing as a PNG."/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="🐞 Placement report…" Click="ExportDebug_Click"
                ToolTip.Tip="Saves where every map and event was placed, plus a picture of the view, to attach to a bug report."/>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="*,520">

      <!-- 3D map with event markers -->
      <DockPanel Grid.Column="0" Margin="4">
        <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Padding="6,4" Margin="0,0,0,4">
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding MapInfo}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <TextBlock Text="left-drag pan · right-drag orbit · wheel zoom" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
            </StackPanel>
            <WrapPanel Classes="toolbar">
              <TextBlock Text="Show:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <CheckBox Content="Overworlds" IsChecked="{Binding ShowOverworlds}" FontSize="12"/>
              <CheckBox Content="Warps"      IsChecked="{Binding ShowWarps}" FontSize="12"/>
              <CheckBox Content="Triggers"   IsChecked="{Binding ShowTriggers}" FontSize="12"/>
              <CheckBox Content="Spawnables" IsChecked="{Binding ShowSpawnables}" FontSize="12"/>
              <CheckBox Content="Grid"       IsChecked="{Binding ShowGrid}" IsEnabled="{Binding GridToggleEnabled}" FontSize="12"
                        ToolTip.Tip="Highlights each map's out-of-bounds tile boundary. Only available for a matrix of 4 cells or fewer (an expensive per-tile scan on larger ones)."/>
              <CheckBox Content="Gizmos" IsChecked="False" FontSize="12" IsVisible="{Binding ShowBetaFeatures}"
                        IsCheckedChanged="Gizmos_Toggled"
                        ToolTip.Tip="Show the expected 32×32 tile-cell boundary (cyan) vs the actual map model extent (yellow)"/>
              <CheckBox Content="Grid layout" IsChecked="{Binding StitchGrid}" FontSize="12"
                        ToolTip.Tip="Stitch as a DS-true fixed 32-tile grid (ON) vs continuous geometry-sized layout (OFF)"/>
              <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
              <ToggleButton Content="✋ Move" IsChecked="{Binding EditMode3D}" FontSize="12" Padding="6,2"
                            ToolTip.Tip="3D edit mode: click an event to select it, then drag the red/green/blue handles to move it (X=tile, Y=height, Z=tile). Arrow keys nudge one tile."/>
              <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
              <TextBlock Text="View:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <ToggleButton x:Name="Mode2DToggle" Content="2D" IsChecked="{Binding Flat2D}" FontSize="12" Padding="6,2"
                            ToolTip.Tip="Flat top-down view with no perspective, the way the old editor looked. Still shows every map in the header at once."/>
              <Button Content="Top" Click="CamTop_Click" FontSize="12" Padding="6,2" ToolTip.Tip="Top-down camera"
                      IsEnabled="{Binding !Flat2D}"/>
              <Button Content="Iso" Click="CamIso_Click" FontSize="12" Padding="6,2" ToolTip.Tip="Isometric camera"
                      IsEnabled="{Binding !Flat2D}"/>
              <Button Content="⟲" Click="CamReset_Click" FontSize="12" Padding="6,2" ToolTip.Tip="Reset camera"/>
              <Button Content="🎯 Centre" Click="CenterOnEvent_Click" FontSize="12" Padding="6,2"
                      ToolTip.Tip="Moves the camera onto the selected event."/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Panel>
          <Border x:Name="GlHost" Background="#1F1F23" BorderBrush="#444" BorderThickness="1">
            <gl:NsbmdGlControl x:Name="GlView"/>
          </Border>
          <Border IsVisible="{Binding IsCatchAllHeader}" Background="#1F1F23"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock Text="{Binding CatchAllNote}" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" FontSize="13"
                       Foreground="{DynamicResource Editor.Subtle}"/>
          </Border>
          <Canvas x:Name="DragOverlay" IsHitTestVisible="False">
            <Image x:Name="DragGhost" Width="44" Height="44" IsVisible="False"
                   RenderOptions.BitmapInterpolationMode="None"/>
            <Border x:Name="DropLabel" IsVisible="False" Background="#CC000000" Padding="5,2"
                    CornerRadius="3">
              <TextBlock x:Name="DropText" FontSize="12" Foreground="#FFF"/>
            </Border>
          </Canvas>
        </Panel>
      </DockPanel>

      <!-- Editing panels -->
      <TabControl Grid.Column="1" Margin="0,4,4,4">

        <!-- ── Overworlds (NPCs/trainers) ─────────────────────────────────────── -->
        <TabItem Header="Overworlds">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
              <Border Width="12" Height="12" Background="#3FF259" CornerRadius="2" VerticalAlignment="Center"/>
              <Button Content="Add" Click="AddOw_Click"/>
              <Button Content="Remove" Click="RemoveOw_Click" IsEnabled="{Binding HasOw}"/>
              <Button Content="Duplicate" Click="DupOw_Click" IsEnabled="{Binding HasOw}"/>
              <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
              <Button Content="Sort ↑" Click="SortAsc_Click" ToolTip.Tip="Sort overworlds by OW id (ascending)"/>
              <Button Content="Sort ↓" Click="SortDesc_Click" ToolTip.Tip="Sort overworlds by OW id (descending)"/>
            </StackPanel>
            <Grid ColumnDefinitions="180,*">
              <ListBox Grid.Column="0" ItemsSource="{Binding Overworlds}" SelectedIndex="{Binding SelectedOverworldIndex}"/>
              <ScrollViewer Grid.Column="1" Margin="6,0,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="3" IsVisible="{Binding HasOw}">
                  <TextBlock Text="Position" FontWeight="Bold"/>
                  <Grid ColumnDefinitions="72,*,72,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Map X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,6,3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding XMap}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Map Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding YMap}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,6,3">
                      <NumericUpDown Minimum="-32768" Maximum="2147483647" Increment="1" FormatString="0" Value="{Binding ZPos}"/>
                      <TextBlock Text="{Binding ZPosNote}" FontSize="11" Margin="2,1,0,0"
                                 TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding ZPosNoteTip}"
                                 Foreground="{DynamicResource Editor.Subtle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Matrix X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding XMatrix}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Matrix Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding YMatrix}"/>
                  </Grid>
                  <TextBlock Text="OW ID" FontWeight="Bold" Margin="0,4,0,0"/>
                  <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding OwId}"/>

                  <TextBlock Text="Sprite" FontWeight="Bold" Margin="0,4,0,0"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding OwSpriteEntries}" SelectedIndex="{Binding OwSpriteIndex}" HorizontalAlignment="Stretch"/>
                    <Border Grid.Column="1" Width="40" Height="40" Margin="6,0,0,0" Background="{DynamicResource Editor.PanelBg}"
                            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                      <Image Source="{Binding OwSpritePreview}" IsVisible="{Binding HasOwSpritePreview}" Stretch="Uniform" Margin="2"/>
                    </Border>
                  </Grid>

                  <TextBlock Text="Movement" FontWeight="Bold" Margin="0,4,0,0"/>
                  <ComboBox ItemsSource="{Binding OwMovementNames}" SelectedIndex="{Binding OwMovementIndex}" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="{Binding OwMovementUnknownNote}" FontSize="10" Foreground="Orange"
                             TextWrapping="Wrap" IsVisible="{Binding OwMovementUnknown}"/>

                  <TextBlock Text="Orientation" FontWeight="Bold" Margin="0,4,0,0"/>
                  <ComboBox ItemsSource="{Binding OwOrientationNames}" SelectedIndex="{Binding OwOrientationIndex}" HorizontalAlignment="Stretch"/>

                  <TextBlock Text="Type" FontWeight="Bold" Margin="0,4,0,0"/>
                  <ComboBox ItemsSource="{Binding OwEventTypes}" SelectedIndex="{Binding OwEventTypeIndex}"
                            HorizontalAlignment="Stretch"
                            ToolTip.Tip="Every type the game defines. The trainer variants all fight and see the player the same way; the type changes how the NPC turns or moves."/>
                  <TextBlock Text="{Binding OwTypeNote}" FontSize="10" Foreground="{DynamicResource Editor.Subtle}"
                             TextWrapping="Wrap" IsVisible="{Binding OwHasTypeNote}"/>
                  <TextBlock Text="{Binding OwTypeUnknownNote}" FontSize="10" Foreground="Orange"
                             TextWrapping="Wrap" IsVisible="{Binding OwTypeUnknown}"/>

                  <StackPanel Spacing="3" IsVisible="{Binding OwItemFieldsVisibleVanilla}" Margin="0,4,0,0">
                    <TextBlock Text="Item" FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <ComboBox Grid.Column="0" ItemsSource="{Binding OwItemEntries}" SelectedIndex="{Binding OwItemIndex}" HorizontalAlignment="Stretch"/>
                      <Button Grid.Column="1" Content="Manage…" Click="ManageGroundItems_Click" Margin="4,0,0,0"/>
                    </Grid>
                    <!-- No warning here: the dropdown itself shows whether the item resolved, and the
                         raw Script field appears below when it didn't. -->
                  </StackPanel>

                  <StackPanel Spacing="3" IsVisible="{Binding OwItemFieldsVisibleHGE}" Margin="0,4,0,0">
                    <TextBlock Text="Item ID" FontWeight="Bold"
                               ToolTip.Tip="HG Engine reads the item straight from this event's data (script is locked to 7000), instead of picking one of many per-item scripts."/>
                    <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding OwItemIdHGE}"/>
                  </StackPanel>

                  <StackPanel Spacing="3" IsVisible="{Binding OwTrainerFieldsVisible}" Margin="0,4,0,0">
                    <TextBlock Text="Trainer" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding OwTrainerEntries}" SelectedIndex="{Binding OwTrainerIndex}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Script number doesn't match a known trainer (edit Script below directly)"
                               FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding OwTrainerIndexOutOfRange}"/>
                    <TextBlock Text="Trainer 0 is the empty slot, not a real trainer. Pick another one or the battle has nobody in it."
                               FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding OwTrainerIsDummy}"/>
                    <CheckBox Content="Partner (double battle)" IsChecked="{Binding OwPartnerTrainer}"/>
                    <TextBlock Text="Sight range" FontWeight="Bold" Margin="0,4,0,0"
                               ToolTip.Tip="How many tiles ahead the trainer notices the player (the engine's param0)."/>
                    <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding OwSight}"/>
                  </StackPanel>

                  <StackPanel Spacing="3" IsVisible="{Binding OwIsApricornTree}" Margin="0,4,0,0">
                    <TextBlock Text="Apricorn bed" FontWeight="Bold"
                               ToolTip.Tip="Which apricorn bed this tree belongs to. The same field a trainer uses for sight range (the engine's param0)."/>
                    <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding OwSight}"/>
                    <TextBlock Text="{Binding OwApricornNote}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Editor.Subtle}"/>
                  </StackPanel>

                  <StackPanel Spacing="3" IsVisible="{Binding OwParam1Visible}" Margin="0,4,0,0">
                    <TextBlock Text="{Binding OwParam1Label}" FontWeight="Bold"
                               ToolTip.Tip="How long this trainer waits between turns (the engine's param1)."/>
                    <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding OwParam1}"/>
                  </StackPanel>

                  <StackPanel Spacing="3" IsVisible="{Binding OwScriptSectionVisible}">
                    <TextBlock Text="{Binding OwScriptSectionLabel}" FontWeight="Bold" Margin="0,4,0,0" ToolTip.Tip="Locked to the value derived from the Item/Trainer selection above, unless Type is Standard"/>
                    <TextBlock Text="This type runs the game's shared message script, so this number picks the message, not a script."
                               FontSize="10" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"
                               IsVisible="{Binding OwScriptIsMessageId}"/>
                    <ComboBox ItemsSource="{Binding AvailableScripts}" SelectedIndex="{Binding OwScriptIndex}" IsEnabled="{Binding OwScriptEnabled}" HorizontalAlignment="Stretch"
                              IsVisible="{Binding !OwScriptIsMessageId}"/>
                    <TextBlock Text="Script number doesn't match a script in this map's script file (edit the number below directly)"
                               FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding OwScriptGenericWarningVisible}"/>
                    <TextBlock Text="{Binding OwScriptCommonInfo}"
                               FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding OwScriptHasCommonInfo}"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <NumericUpDown Grid.Column="0" Minimum="0" Maximum="65535" Value="{Binding OwScript}" IsEnabled="{Binding OwScriptEnabled}"/>
                      <Button Grid.Column="1" Content="↪ Go to script" Margin="4,0,0,0" Click="GoToOwScript_Click"
                              ToolTip.Tip="Open this script in the Script Editor, following a common script to the file it really lives in."/>
                    </Grid>
                  </StackPanel>

                  <TextBlock Text="Flag" FontWeight="Bold" Margin="0,4,0,0"/>
                  <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding OwFlag}"/>
                  <TextBlock Text="Param 2" FontWeight="Bold" Margin="0,4,0,0"
                             ToolTip.Tip="Stored and preserved with the event, but nothing in the field code reads it."/>
                  <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding OwParam2}"/>

                  <TextBlock Text="Movement range" FontWeight="Bold" Margin="0,4,0,0"
                             ToolTip.Tip="How far the NPC may wander from its position (the engine's move_limit_x / move_limit_z)."/>
                  <Grid ColumnDefinitions="72,*,72,*">
                    <TextBlock Grid.Column="0" Text="X range" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Value="{Binding OwXRange}"/>
                    <TextBlock Grid.Column="2" Text="Y range" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="3" Minimum="0" Maximum="65535" Value="{Binding OwYRange}"/>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </TabItem>

        <!-- ── Warps ──────────────────────────────────────────────────────────── -->
        <TabItem Header="Warps">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
              <Border Width="12" Height="12" Background="#FF9E1A" CornerRadius="2" VerticalAlignment="Center"/>
              <Button Content="Add" Click="AddWarp_Click"/>
              <Button Content="Remove" Click="RemoveWarp_Click" IsEnabled="{Binding HasWarp}"/>
              <Button Content="Duplicate" Click="DupWarp_Click" IsEnabled="{Binding HasWarp}"/>
              <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
              <Button Content="🔗 Test warp" Click="TestWarp_Click" IsEnabled="{Binding HasWarp}"
                      ToolTip.Tip="Jump to the destination header's event file"/>
            </StackPanel>
            <Grid ColumnDefinitions="180,*">
              <ListBox Grid.Column="0" ItemsSource="{Binding Warps}" SelectedIndex="{Binding SelectedWarpIndex}"/>
              <ScrollViewer Grid.Column="1" Margin="6,0,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="3" IsVisible="{Binding HasWarp}">
                  <TextBlock Text="Position" FontWeight="Bold"/>
                  <Grid ColumnDefinitions="72,*,72,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Map X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,6,3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding XMap}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Map Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding YMap}"/>
                    <!-- No Z row: the warp record has no z field. Height below is the warp's elevation. -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Matrix X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding XMatrix}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Matrix Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="3" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding YMatrix}"/>
                  </Grid>
                  <TextBlock Text="Destination header" FontWeight="Bold" Margin="0,4,0,0"/>
                  <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding WarpHeader}"/>
                  <TextBlock Text="Anchor" FontWeight="Bold" Margin="0,4,0,0"/>
                  <NumericUpDown Minimum="0" Maximum="65535" Value="{Binding WarpAnchor}"/>
                  <TextBlock Text="Height" FontWeight="Bold" Margin="0,4,0,0"/>
                  <NumericUpDown Minimum="0" Maximum="4294967295" Value="{Binding WarpHeight}"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </TabItem>

        <!-- ── Triggers ───────────────────────────────────────────────────────── -->
        <TabItem Header="Triggers">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
              <Border Width="12" Height="12" Background="#F23FE5" CornerRadius="2" VerticalAlignment="Center"/>
              <Button Content="Add" Click="AddTrig_Click"/>
              <Button Content="Remove" Click="RemoveTrig_Click" IsEnabled="{Binding HasTrig}"/>
              <Button Content="Duplicate" Click="DupTrig_Click" IsEnabled="{Binding HasTrig}"/>
            </StackPanel>
            <Grid ColumnDefinitions="180,*">
              <ListBox Grid.Column="0" ItemsSource="{Binding Triggers}" SelectedIndex="{Binding SelectedTriggerIndex}"/>
              <ScrollViewer Grid.Column="1" Margin="6,0,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="3" IsVisible="{Binding HasTrig}">
                  <TextBlock Text="Position" FontWeight="Bold"/>
                  <Grid ColumnDefinitions="72,*,72,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Map X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,6,3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding XMap}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Map Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding YMap}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,6,3">
                      <NumericUpDown Minimum="-32768" Maximum="2147483647" Increment="1" FormatString="0" Value="{Binding ZPos}"/>
                      <TextBlock Text="{Binding ZPosNote}" FontSize="11" Margin="2,1,0,0"
                                 TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding ZPosNoteTip}"
                                 Foreground="{DynamicResource Editor.Subtle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Matrix X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding XMatrix}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Matrix Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding YMatrix}"/>
                  </Grid>
                  <TextBlock Text="Script" FontWeight="Bold" Margin="0,4,0,0"/>
                  <ComboBox ItemsSource="{Binding AvailableScripts}" SelectedIndex="{Binding TrScriptIndex}" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="Script number doesn't match a script in this map's script file (edit the number below directly)"
                             FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding TrScriptGenericWarningVisible}"/>
                  <TextBlock Text="{Binding TrScriptCommonInfo}"
                             FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding TrScriptHasCommonInfo}"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <NumericUpDown Grid.Column="0" Minimum="0" Maximum="65535" Value="{Binding TrScript}"/>
                    <Button Grid.Column="1" Content="↪ Go to script" Margin="4,0,0,0" Click="GoToTrScript_Click"
                            ToolTip.Tip="Open this script in the Script Editor, following a common script to the file it really lives in."/>
                  </Grid>
                  <TextBlock Text="Width / height" FontWeight="Bold" Margin="0,4,0,0"/>
                  <Grid ColumnDefinitions="72,*,72,*">
                    <TextBlock Grid.Column="0" Text="Width" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Value="{Binding TrWidth}"/>
                    <TextBlock Grid.Column="2" Text="Height" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="3" Minimum="0" Maximum="65535" Value="{Binding TrHeight}"/>
                  </Grid>
                  <TextBlock Text="Variable watched / expected value" FontWeight="Bold" Margin="0,4,0,0"/>
                  <Grid ColumnDefinitions="72,*,72,*">
                    <TextBlock Grid.Column="0" Text="Variable" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Value="{Binding TrVar}"
                                   IsVisible="{Binding TrDecimal}"/>
                    <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding TrVarHex}"
                             IsVisible="{Binding TrHex}"/>
                    <TextBlock Grid.Column="2" Text="Expected" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="3" Minimum="0" Maximum="65535" Value="{Binding TrVarValue}"
                                   IsVisible="{Binding TrDecimal}"/>
                    <TextBox Grid.Column="3" Text="{Binding TrVarValueHex}" IsVisible="{Binding TrHex}"/>
                  </Grid>
                  <ToggleButton Content="Hex" IsChecked="{Binding TrHex}" HorizontalAlignment="Left"
                                FontSize="12" Padding="8,2"
                                ToolTip.Tip="Type the variable and expected value in hex instead of decimal."/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </TabItem>

        <!-- ── Spawnables (signs / hidden items) ──────────────────────────────── -->
        <TabItem Header="Spawnables">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
              <Border Width="12" Height="12" Background="#33D9F2" CornerRadius="2" VerticalAlignment="Center"/>
              <Button Content="Add" Click="AddSpawn_Click"/>
              <Button Content="Remove" Click="RemoveSpawn_Click" IsEnabled="{Binding HasSpawn}"/>
              <Button Content="Duplicate" Click="DupSpawn_Click" IsEnabled="{Binding HasSpawn}"/>
            </StackPanel>
            <Grid ColumnDefinitions="180,*">
              <ListBox Grid.Column="0" ItemsSource="{Binding Spawnables}" SelectedIndex="{Binding SelectedSpawnableIndex}"/>
              <ScrollViewer Grid.Column="1" Margin="6,0,0,0" Padding="0,0,14,0">
                <StackPanel Spacing="3" IsVisible="{Binding HasSpawn}">
                  <TextBlock Text="Position" FontWeight="Bold"/>
                  <Grid ColumnDefinitions="72,*,72,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Map X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Margin="0,0,6,3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding XMap}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Map Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="3" Minimum="-32768" Maximum="32767" Increment="1" FormatString="0" Value="{Binding YMap}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Z" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,6,3">
                      <NumericUpDown Minimum="-32768" Maximum="2147483647" Increment="1" FormatString="0" Value="{Binding ZPos}"/>
                      <TextBlock Text="{Binding ZPosNote}" FontSize="11" Margin="2,1,0,0"
                                 TextWrapping="Wrap"
                                 ToolTip.Tip="{Binding ZPosNoteTip}"
                                 Foreground="{DynamicResource Editor.Subtle}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Matrix X" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding XMatrix}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Matrix Y" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="3" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Value="{Binding YMatrix}"/>
                  </Grid>
                  <TextBlock Text="Script" FontWeight="Bold" Margin="0,4,0,0"/>
                  <ComboBox ItemsSource="{Binding AvailableScripts}" SelectedIndex="{Binding SpScriptIndex}" HorizontalAlignment="Stretch"/>
                  <TextBlock Text="Script number doesn't match a script in this map's script file (edit the number below directly)"
                             FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding SpScriptGenericWarningVisible}"/>
                  <TextBlock Text="{Binding SpScriptCommonInfo}"
                             FontSize="10" Foreground="Orange" TextWrapping="Wrap" IsVisible="{Binding SpScriptHasCommonInfo}"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <NumericUpDown Grid.Column="0" Minimum="0" Maximum="65535" Value="{Binding SpScript}"/>
                    <Button Grid.Column="1" Content="↪ Go to script" Margin="4,0,0,0" Click="GoToSpScript_Click"
                            ToolTip.Tip="Open this script in the Script Editor, following a common script to the file it really lives in."/>
                  </Grid>
                  <TextBlock Text="Type / direction" FontWeight="Bold" Margin="0,4,0,0"/>
                  <Grid ColumnDefinitions="72,*,72,*">
                    <TextBlock Grid.Column="0" Text="Type" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Margin="0,0,6,0" Minimum="0" Maximum="65535" Value="{Binding SpType}"/>
                    <TextBlock Grid.Column="2" Text="Direction" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="3" Minimum="0" Maximum="65535" Value="{Binding SpDir}"/>
                  </Grid>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </TabItem>

      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
