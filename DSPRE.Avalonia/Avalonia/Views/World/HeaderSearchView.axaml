<Window MinWidth="520" MinHeight="400" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="using:DSPRE.Avalonia.ViewModels.World"
        x:Class="DSPRE.Avalonia.Views.World.HeaderSearchView"
        x:DataType="vm:HeaderSearchViewModel"
        Title="Advanced header search"
        Width="560" Height="480"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:HeaderSearchViewModel/>
  </Design.DataContext>

  <DockPanel>
    <controls:EditorToolbar x:Name="QueryPanel">
        <ComboBox Width="170" ItemsSource="{Binding Fields}" SelectedIndex="{Binding FieldIndex}"/>
        <ComboBox Width="150" ItemsSource="{Binding Operators}" SelectedIndex="{Binding OperatorIndex}"/>
        <TextBox x:Name="ValueBox" Width="180" Text="{Binding ValueText}" PlaceholderText="Value to search…"/>
        <CheckBox Content="Auto" IsChecked="{Binding AutoSearch}" ToolTip.Tip="Search as you type"/>
        <Button Content="Search" controls:Icon.Key="lens" Click="Search_Click"/>
    </controls:EditorToolbar>

  <DockPanel Margin="10">
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding StatusText}" TextWrapping="Wrap"/>
    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.7"
               Text="Double-click a result to open it in the header editor."/>

    <ListBox x:Name="ResultList" Margin="0,8,0,0"
             ItemsSource="{Binding Results}"
             SelectedIndex="{Binding SelectedResultIndex}"
             DoubleTapped="Result_DoubleTapped"/>
  </DockPanel>
  </DockPanel>
</Window>
