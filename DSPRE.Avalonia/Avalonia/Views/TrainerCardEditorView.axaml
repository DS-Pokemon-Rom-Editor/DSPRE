<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
		x:Class="DSPRE.Avalonia.Views.TrainerCardEditorView"
		x:DataType="vm:TrainerCardEditorViewModel"
		Title="Trainer Card Editor"
		Width="900" Height="820" MinWidth="500" MinHeight="380"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:TrainerCardEditorViewModel/>
  </Design.DataContext>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
  <StackPanel Margin="12" Spacing="12">

	<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
	  <TextBlock Grid.Column="0" Text="Rank:" VerticalAlignment="Center" Margin="0,0,6,0"/>
	  <ComboBox Grid.Column="1" ItemsSource="{Binding RankNames}" SelectedIndex="{Binding SelectedRankIndex}" Width="140"/>
	  <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="OrangeRed" VerticalAlignment="Center" Margin="12,0,0,0"/>
	  <Button Grid.Column="3" Content="Revert Changes" Click="RevertChanges_Click" IsEnabled="{Binding HasChanges}"/>
	  <Button Grid.Column="4" Content="Open in Graphics…" Click="OpenInGraphics_Click"
	          ToolTip.Tip="Open the card in the Graphics window, where its drawing, its two arrangements and every rank's colours sit together."/>
	</Grid>

	<!-- Card design: shared tile/screen art, coloured by the selected rank's palette -->
	<Border BorderBrush="Gray" BorderThickness="1" Padding="10">
	  <StackPanel Spacing="8">
		<TextBlock Text="Card Design" FontWeight="Bold"/>

		<StackPanel Orientation="Horizontal" Spacing="12">

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280">
			<StackPanel Spacing="8">
			  <TextBlock Text="Front" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding CardFrontPreview}" Width="256" Height="192" Stretch="Uniform"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportCardFront_Click"/>
				<Button Content="Export PNG…" Click="ExportCardFront_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280">
			<StackPanel Spacing="8">
			  <TextBlock Text="Back" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding CardBackPreview}" Width="256" Height="192" Stretch="Uniform"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportCardBack_Click"/>
				<Button Content="Export PNG…" Click="ExportCardBack_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280">
			<StackPanel Spacing="8">
			  <TextBlock Text="Palette (advanced)" FontWeight="Bold"/>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import NCLR…" Click="ImportRankPalette_Click"/>
				<Button Content="Export NCLR…" Click="ExportRankPalette_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		</StackPanel>
	  </StackPanel>
	</Border>

	<!-- Trainer pose: shared between genders, always coloured by the Normal rank's palette -->
	<Border BorderBrush="Gray" BorderThickness="1" Padding="10">
	  <StackPanel Spacing="8">
		<TextBlock Text="Trainer Pose" FontWeight="Bold"/>

		<StackPanel Orientation="Horizontal" Spacing="12">

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280">
			<StackPanel Spacing="8">
			  <TextBlock Text="Male" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding TrainerMalePreview}" Width="256" Height="192" Stretch="Uniform"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportTrainerMale_Click"/>
				<Button Content="Export PNG…" Click="ExportTrainerMale_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		  <Border BorderBrush="Gray" BorderThickness="1" Padding="10" Width="280">
			<StackPanel Spacing="8">
			  <TextBlock Text="Female" FontWeight="Bold"/>
			  <Border Background="#181818" HorizontalAlignment="Left">
				<Image Source="{Binding TrainerFemalePreview}" Width="256" Height="192" Stretch="Uniform"/>
			  </Border>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Import PNG…" Click="ImportTrainerFemale_Click"/>
				<Button Content="Export PNG…" Click="ExportTrainerFemale_Click"/>
			  </StackPanel>
			</StackPanel>
		  </Border>

		</StackPanel>
	  </StackPanel>
	</Border>

  </StackPanel>
  </ScrollViewer>
</Window>
