<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Text"
        x:Class="DSPRE.Avalonia.Views.Text.StrVarHelpView"
        x:DataType="vm:StrVarHelpViewModel"
        Title="{Binding Title}"
        Width="820" Height="700"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:StrVarHelpViewModel/>
  </Design.DataContext>

  <Window.DataTemplates>
    <DataTemplate x:DataType="vm:SpecialCode">
      <Border Padding="10" Margin="0,0,0,8" CornerRadius="4"
              Background="{DynamicResource Editor.PanelBg}"
              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
        <StackPanel Spacing="4">
          <SelectableTextBlock Text="{Binding Code}" FontFamily="{StaticResource CodeFont}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding What}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                     FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="From the game" IsVisible="{Binding HasExample}" FontSize="12" Margin="0,4,0,0"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <SelectableTextBlock Text="{Binding Example}" IsVisible="{Binding HasExample}"
                               FontFamily="{StaticResource CodeFont}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel Margin="12">
    <Button DockPanel.Dock="Bottom" Content="Close" Click="Close_Click"
            HorizontalAlignment="Right" Width="90" Margin="0,10,0,0"
            IsDefault="True" IsCancel="True"/>

    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
    </StackPanel>

    <TabControl>
      <TabItem Header="STRVAR">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="8" Margin="0,8,0,0">

        <ItemsControl ItemsSource="{Binding Sections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StrVarHelpSection">
              <StackPanel Spacing="8" Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>

                <Border IsVisible="{Binding HasCode}" Padding="10" CornerRadius="4"
                        Background="{DynamicResource Editor.PanelBg}"
                        BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                  <TextBlock Text="{Binding Code}" FontFamily="{StaticResource CodeFont}"
                             TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="{Binding Body}" IsVisible="{Binding HasBody}"
                           TextWrapping="Wrap" LineHeight="21"/>

                <ItemsControl ItemsSource="{Binding Examples}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StrVarHelpExample">
                      <Border Padding="10" Margin="0,0,0,8" CornerRadius="4"
                              Background="{DynamicResource Editor.PanelBg}"
                              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                          <TextBlock Text="Script" FontSize="12"
                                     Foreground="{DynamicResource Editor.Subtle}"/>
                          <TextBlock Text="{Binding Script}" FontFamily="{StaticResource CodeFont}"
                                     TextWrapping="Wrap"/>
                          <TextBlock Text="Message" FontSize="12" Margin="0,4,0,0"
                                     Foreground="{DynamicResource Editor.Subtle}"/>
                          <TextBlock Text="{Binding Message}" FontFamily="{StaticResource CodeFont}"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding TypeReferences}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StrVarTypeReference">
                      <Border Padding="10" Margin="0,0,0,8" CornerRadius="4"
                              Background="{DynamicResource Editor.PanelBg}"
                              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Pattern}" FontFamily="{StaticResource CodeFont}"
                                     FontWeight="SemiBold" TextWrapping="Wrap"/>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Type" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TypeLabel}" FontWeight="SemiBold"/>
                            <TextBlock Text="•"/>
                            <TextBlock Text="{Binding Description}"/>
                          </StackPanel>
                          <TextBlock Text="{Binding CommandsText}" TextWrapping="Wrap"
                                     FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
      </TabItem>
      <TabItem Header="Line and box">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding LineAndBox}" Margin="0,8,0,0"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Colour and size">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Look}" Margin="0,8,0,0"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Placement">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Placement}" Margin="0,8,0,0"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Timing and icons">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding TimingAndIcons}" Margin="0,8,0,0"/>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
