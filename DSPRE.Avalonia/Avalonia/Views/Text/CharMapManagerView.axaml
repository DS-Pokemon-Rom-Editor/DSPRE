<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Text"
		x:Class="DSPRE.Avalonia.Views.Text.CharMapManagerView"
		x:DataType="vm:CharMapManagerViewModel"
		Title="{Binding Title}"
		Width="680" Height="560" MinWidth="520" MinHeight="420"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:CharMapManagerViewModel/>
  </Design.DataContext>


  <DockPanel Margin="8" LastChildFill="True">

	<!-- Bottom action bar -->
	<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
				HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
	  <Button Content="Create Custom Map" Click="CreateMap_Click"/>
	  <Button Content="Delete Custom Map" IsEnabled="{Binding HasMap}" Click="DeleteMap_Click"/>
	  <Button Content="Reload"            Click="Reload_Click"/>
	  <Button Content="Open File"         IsEnabled="{Binding HasMap}" Click="OpenFile_Click"/>
	  <Button Content="Rebase"            IsEnabled="{Binding HasMap}" Click="Rebase_Click"/>
	  <Button Content="Save"              IsEnabled="{Binding HasMap}" Click="Save_Click"/>
	</StackPanel>

	<Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,*,Auto,Auto">

	  <!-- ── Left: Charmap list ──────────────────────────────────────────── -->
	  <TextBlock Grid.Row="0" Grid.Column="0" Text="Character Map" FontWeight="Bold" Margin="0,0,0,4"/>
	  <ListBox   Grid.Row="1" Grid.Column="0"
				 ItemsSource="{Binding CharMapItems}"
				 SelectedIndex="{Binding SelectedCharMapIndex}"
				 DoubleTapped="CharMapList_DoubleTapped"/>

	  <!-- Search row under charmap list -->
	  <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,6,0,0">
		<Button DockPanel.Dock="Right" Content="Search" Click="Search_Click" Margin="6,0,0,0"/>
		<TextBox Text="{Binding SearchText}" PlaceholderText="Search (0x... for hex code)"
				 KeyDown="Search_KeyDown"/>
	  </DockPanel>

	  <!-- ── Splitter ────────────────────────────────────────────────────── -->
	  <GridSplitter Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
					ResizeDirection="Columns" Width="4"/>

	  <!-- ── Right top: Alias list ──────────────────────────────────────── -->
	  <TextBlock Grid.Row="0" Grid.Column="2" Text="Aliases" FontWeight="Bold" Margin="0,0,0,4"/>
	  <ListBox   Grid.Row="1" Grid.Column="2"
				 ItemsSource="{Binding AliasItems}"
				 SelectedIndex="{Binding SelectedAliasIndex}"/>

	  <!-- Right bottom: Add alias controls -->
	  <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,6,0,0" Spacing="4">
		<TextBlock Text="Code to alias:"/>
		<ComboBox ItemsSource="{Binding CodeItems}"
				  SelectedIndex="{Binding SelectedCodeIndex}"
				  HorizontalAlignment="Stretch"/>
		<TextBox Text="{Binding NewAliasText}" PlaceholderText="New alias text"/>
		<StackPanel Orientation="Horizontal" Spacing="6">
		  <Button Content="Add Alias"    IsEnabled="{Binding HasMap}" Click="AddAlias_Click"/>
		  <Button Content="Remove Alias" IsEnabled="{Binding HasMap}" Click="RemoveAlias_Click"/>
		</StackPanel>
	  </StackPanel>

	</Grid>
  </DockPanel>
</Window>
