<UserControl xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Controls"
             xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Text"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:data="clr-namespace:DSPRE.Avalonia.Data"
        x:Class="DSPRE.Avalonia.Views.Text.TextEditorView"
        x:DataType="vm:TextEditorViewModel">

  <Design.DataContext>
    <vm:TextEditorViewModel/>
  </Design.DataContext>

  <DockPanel>

    <controls:EditorToolbar>
        <controls:FusionAutoCompleteBox x:Name="FilePicker" Width="160" ItemsSource="{Binding ArchiveNames}"
                                        SelectedIndex="{Binding SelectedArchiveIndex}"/>
        <controls:HeadersButton controls:EditorToolbar.Slot="Picker" Source="Text" FileId="{Binding SelectedArchiveIndex}"/>
        <Button Content="Add" controls:Icon.Key="addIcon"    Click="AddArchive_Click"    ToolTip.Tip="Add a new text archive"/>
        <Button Content="Remove last" controls:Icon.Key="deleteIcon" Click="RemoveArchive_Click" ToolTip.Tip="Delete the last text archive"/>
        <Button Content="Save" controls:Icon.Key="saveButton"    Click="Save_Click"   IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <Button Content="Import…" controls:Icon.Key="import" Click="Import_Click"/>
        <Button Content="Export…" controls:Icon.Key="export" Click="Export_Click"/>
        <Button Content="Show file" controls:Icon.Key="folder" Click="ShowArchiveFile_Click" ToolTip.Tip="The archive as last saved"/>
        <Button Content="Open file" controls:Icon.Key="OpenLink" Click="OpenArchiveFile_Click" ToolTip.Tip="Opens it in your system's default program"/>
        <CheckBox Content="Hex line numbers" IsChecked="{Binding HexNumbering}" VerticalAlignment="Center"/>
        <CheckBox Content="Message box" IsChecked="{Binding ShowPreview}" VerticalAlignment="Center"
                  ToolTip.Tip="Show the selected line in the game's message box."/>
        <Button Content="STRVAR help" Click="StrVarHelp_Click"
                ToolTip.Tip="How to put names and numbers into a message, with examples"/>
    </controls:EditorToolbar>

    <Border DockPanel.Dock="Top" IsVisible="{Binding HasHgEngineNote}"
            Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="8,4">
      <TextBlock Text="{Binding ManagedNote}" FontSize="11" TextWrapping="Wrap"
                 Foreground="{DynamicResource Editor.Subtle}"/>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"
                 VerticalAlignment="Center"/>
    </Border>

    <Border x:Name="ReplacePanel" DockPanel.Dock="Right" Width="300" Background="{DynamicResource Editor.PanelBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1,0,0,0" Padding="8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4">
          <TextBlock Text="Search &amp; replace" FontWeight="Bold"/>
          <TextBox x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="Search text"/>
          <TextBox Text="{Binding ReplaceText}" PlaceholderText="Replace with"/>
          <CheckBox Content="Case sensitive"          IsChecked="{Binding CaseSensitive}"/>
          <CheckBox Content="Search all archives"     IsChecked="{Binding SearchAllArchives}"/>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Search" controls:Icon.Key="lens"  Click="Search_Click"  MinWidth="90"/>
            <Button Content="Replace" Click="Replace_Click" Width="90" ToolTip.Tip="Replaces and saves at once"/>
          </StackPanel>
          <TextBlock Text="Results" Margin="0,6,0,0"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding SearchResults}"
                 DoubleTapped="SearchResult_DoubleTapped"
                 x:Name="SearchResultsList"/>
      </DockPanel>
    </Border>

    <DockPanel>
      <controls:EditorToolbar x:Name="LineButtons" DockPanel.Dock="Bottom">
          <Button Content="Add message" controls:Icon.Key="addIcon"    Click="AddString_Click"/>
          <Button Content="Remove message" controls:Icon.Key="deleteIcon" Click="RemoveString_Click"/>
          <Button Content="Move up" controls:Icon.Key="arrowup"   Click="MoveUp_Click"   IsEnabled="{Binding CanMoveUp}"/>
          <Button Content="Move down" controls:Icon.Key="arrowdown" Click="MoveDown_Click" IsEnabled="{Binding CanMoveDown}"/>
      </controls:EditorToolbar>

      <!-- What this line looks like in game -->
      <Border DockPanel.Dock="Bottom" IsVisible="{Binding ShowPreview}" Padding="6"
              Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="0,1,0,0">
        <Grid>
        <DockPanel IsVisible="{Binding HasScreenShots}">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,0"
                    IsVisible="{Binding ShotsHaveStops}">
          <TextBlock Text="{Binding PreviewStepText}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Editor.Subtle}"/>
          <Button Content="Next box" Click="PreviewNext_Click" IsVisible="{Binding ShotsWaitForPress}"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Center">
          <ItemsControl ItemsSource="{Binding ScreenShots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="data:TextScreenShot">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
                  <Button Padding="0" Background="Transparent" BorderThickness="0" Click="ShotLarger_Click"
                          ToolTip.Tip="View larger" Cursor="Hand">
                    <Image Source="{Binding Picture}" Width="256" Height="192" RenderOptions.BitmapInterpolationMode="None"/>
                  </Button>
                  <Button Content="{Binding OpenText}" Click="ShotOpen_Click" HorizontalAlignment="Left" IsVisible="{Binding HasEditor}"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        </DockPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding IsOnScreen}">
          <views:FieldMenuWindowView Grid.Column="0" FitToWindow="True" ShowCursor="False" Indent="0" RowOffset="0"
                                     Height="200" HorizontalAlignment="Stretch"
                                     Items="{Binding ScreenLines}" TileLeft="{Binding Screen.TileLeft}" TileTop="{Binding Screen.TileTop}"
                                     TilesWide="{Binding Screen.TilesWide}" TilesHigh="{Binding Screen.TilesHigh}"/>
          <TextBlock Grid.Column="1" Width="230" Text="{Binding ScreenName}" FontSize="12" TextWrapping="Wrap"
                     VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding ShowsMessageBox}">
          <views:FieldMessageBoxView Grid.Column="0" x:Name="PreviewBox" FitToFrame="True"
                                     Height="96" HorizontalAlignment="Stretch"
                                     Text="{Binding PreviewText}" HasMore="{Binding PreviewHasMore}"/>
          <StackPanel Grid.Column="1" Width="230" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding PreviewWaitText}" TextWrapping="Wrap" FontSize="12"/>
            <TextBlock Text="{Binding PreviewStepText}" FontSize="12"
                       Foreground="{DynamicResource Editor.Subtle}"/>
            <TextBlock Text="{Binding PreviewWarning}" IsVisible="{Binding HasPreviewWarning}"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Editor.Warn}"/>
            <TextBlock Text="{Binding PreviewFontNote}" IsVisible="{Binding HasPreviewFontNote}"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Border" VerticalAlignment="Center" FontSize="12"/>
              <ComboBox Width="110" ItemsSource="{Binding BorderNames}" SelectedIndex="{Binding BorderIndex}"
                        ToolTip.Tip="Which message box border to draw with."/>
            </StackPanel>
            <Button Content="Next box" Click="PreviewNext_Click" IsEnabled="{Binding HasMoreStops}"/>
          </StackPanel>
        </Grid>
        </Grid>
      </Border>

      <DataGrid x:Name="LinesGrid"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding SelectedLineIndex}"
                AutoGenerateColumns="False"
                IsReadOnly="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="All"
                HeadersVisibility="Column"
                Margin="4">
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="70"/>
          <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>

  </DockPanel>
</UserControl>
