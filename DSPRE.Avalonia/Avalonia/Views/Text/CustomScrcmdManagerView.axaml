<Window MinWidth="520" MinHeight="360" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="using:DSPRE.Avalonia.ViewModels.Text"
        x:Class="DSPRE.Avalonia.Views.Text.CustomScrcmdManagerView"
        x:DataType="vm:CustomScrcmdManagerViewModel"
        Title="Custom Script Command Manager"
        Width="520" Height="420"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:CustomScrcmdManagerViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel x:Name="DatabaseActions" Classes="toolbar">
        <Button Content="Import…" controls:Icon.Key="import" Click="Import_Click" IsEnabled="{Binding HasSelection}"/>
        <Button Content="Export…" controls:Icon.Key="export" Click="Export_Click" IsEnabled="{Binding HasSelection}"/>
        <Button Content="Open folder" controls:Icon.Key="folder" Click="OpenFolder_Click"/>
        <Button Content="Refresh" controls:Icon.Key="reload" Click="Refresh_Click"/>
      </WrapPanel>
    </Border>

  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Script command databases" FontWeight="SemiBold"/>
      <controls:HelpTip Text="Per-ROM script command databases (edited_databases). Import replaces the selected project's scrcmd_database.json; changes can be applied live by reparsing all scripts."/>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
    </Border>

    <ListBox ItemsSource="{Binding Folders}"
             SelectedIndex="{Binding SelectedIndex}"
             IsEnabled="{Binding IsIdle}"/>
  </DockPanel>
  </DockPanel>
</Window>
