<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Trainers"
        x:Class="DSPRE.Avalonia.Views.Trainers.TrainerClassesView"
        x:DataType="vm:TrainerClassesViewModel">

  <Design.DataContext>
    <vm:TrainerClassesViewModel/>
  </Design.DataContext>

  <DockPanel>
    <controls:EditorToolbar>
        <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" ToolTip.Tip="Save this trainer class"
                IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <Button Content="Add…" controls:Icon.Key="addIcon" Click="AddTrainerClass_Click"
                ToolTip.Tip="Platinum (English) or an hg-engine checkout."
                IsEnabled="{Binding CanOfferAddClass}" IsVisible="{Binding !ShowClassCopy}"/>
        <Button controls:EditorToolbar.Slot="Add" Content="Duplicate" controls:Icon.Key="copy" Click="CopyClass_Click" IsVisible="{Binding ShowClassCopy}"
                ToolTip.Tip="Add a copy of the selected class at the end"/>
        <Button Content="Remove last" controls:Icon.Key="deleteIcon" Click="RemoveLastClass_Click" IsVisible="{Binding ShowClassCopy}"/>
    </controls:EditorToolbar>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="220,*">
      <DockPanel Grid.Column="0" Margin="4">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBox Text="{Binding ClassList.Filter}" PlaceholderText="Search classes"
                   ToolTip.Tip="Name or number. Close spellings count when nothing matches exactly."/>
          <CheckBox Grid.Column="1" Content="Fuzzy" IsChecked="{Binding ClassList.Fuzzy}" Margin="6,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="Always include close spellings"/>
        </Grid>
        <ListBox x:Name="ClassList" ItemsSource="{Binding ClassList.Shown}" SelectedIndex="{Binding ClassList.ShownIndex}"/>
      </DockPanel>

      <ScrollViewer Grid.Column="1">
        <StackPanel Margin="8" Spacing="10">
          <Grid ColumnDefinitions="152,*">
            <StackPanel Grid.Column="0" Spacing="4">
              <Border Width="144" Height="144" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                      Background="{DynamicResource Editor.PanelBg}">
                <Image Source="{Binding SpritePreview}" Stretch="Uniform" IsVisible="{Binding HasSpritePreview}"/>
              </Border>
              <Button controls:Icon.Key="{Binding PlayButtonIcon}" controls:Icon.Text="{Binding PlayButtonText}" Click="TogglePlay_Click" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding CanPlayAnimation}" ToolTip.Tip="Play this class's real battle-intro animation."/>
              <Button Content="Edit sprite" controls:Icon.Key="pencil" Click="EditSprite_Click" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding CanEditSprite}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0" VerticalAlignment="Top">
              <TextBlock Text="Class name"/>
              <TextBox Text="{Binding ClassName}"/>
              <TextBlock Text="Name with article" Margin="0,6,0,0" IsVisible="{Binding ShowWithArticle}"/>
              <TextBox Text="{Binding WithArticle}" IsVisible="{Binding ShowWithArticle}" ToolTip.Tip="As in &quot;a Youngster&quot;"/>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="2" IsVisible="{Binding ShowGender}">
            <TextBlock Text="Gender" ToolTip.Tip="Used for DV/nature calculations."/>
            <ComboBox SelectedIndex="{Binding GenderIndex}" HorizontalAlignment="Stretch">
              <ComboBoxItem>Male</ComboBoxItem>
              <ComboBoxItem>Female</ComboBoxItem>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding ShowPrizeMul}">
            <TextBlock Text="Prize money multiplier" ToolTip.Tip="Prize money: last Pokémon's level × 4 × this, doubled in double battles and by Amulet Coin"/>
            <NumericUpDown Minimum="0" Maximum="255" Increment="1" Value="{Binding PrizeMultiplier}"/>
          </StackPanel>

          <StackPanel Spacing="2" IsEnabled="{Binding MusicEnabled}">
            <TextBlock Text="Eye-contact music"
                       ToolTip.Tip="Plays when a trainer of this class spots the player."/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:FusionAutoCompleteBox Width="260" ItemsSource="{Binding MusicNames.Names}" SelectedIndex="{Binding MusicMainIndex}" PlaceholderText="Unnamed track"/>
              <NumericUpDown Width="110" Minimum="0" Maximum="65535" Increment="1" Value="{Binding MusicMain}"/>
              <Button controls:Icon.Key="{Binding MainPlayIcon}" Click="PlayMain_Click" ToolTip.Tip="Play or stop"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding MusicAltEnabled}">
            <TextBlock Text="Second eye-contact music"/>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:FusionAutoCompleteBox Width="260" ItemsSource="{Binding MusicNames.Names}" SelectedIndex="{Binding MusicAltIndex}" PlaceholderText="Unnamed track"/>
              <NumericUpDown Width="110" Minimum="0" Maximum="65535" Increment="1" Value="{Binding MusicAlt}"/>
              <Button controls:Icon.Key="{Binding AltPlayIcon}" Click="PlayAlt_Click" ToolTip.Tip="Play or stop"/>
            </StackPanel>
          </StackPanel>

          <Button Content="Enable eye-contact music for this class" Click="EnableMusic_Click"
                  IsVisible="{Binding !MusicEnabled}" IsEnabled="{Binding CanEnableMusic}" HorizontalAlignment="Left"/>

          <StackPanel Spacing="8" IsVisible="{Binding ShowMetadata}">
            <StackPanel Spacing="2">
              <TextBlock Text="Battle music"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <controls:FusionAutoCompleteBox Width="260" ItemsSource="{Binding MusicNames.Names}" SelectedIndex="{Binding BattleMusicIndex}" PlaceholderText="Unnamed track"/>
                <NumericUpDown Width="110" Minimum="0" Maximum="65535" Increment="1" Value="{Binding BattleMusic}"/>
                <Button controls:Icon.Key="{Binding BattlePlayIcon}" Click="PlayBattle_Click" ToolTip.Tip="Play or stop"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="VS intro"/>
              <TextBlock Text="{Binding IntroSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                <Button Content="Edit intro" Click="EditIntro_Click"/>
                <Button Content="Patch notes" Click="PatchNotes_Click"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding ShowPtIntro}">
            <TextBlock Text="VS intro"/>
            <TextBlock Text="{Binding CiIntroSummary}" TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}"/>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
              <Button Content="Edit intro" Click="EditIntro_Click"/>
              <Button Content="Patch notes" Click="CiPatchNotes_Click"/>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding HasClassTrainers}">
            <TextBlock Text="Trainers in this class"/>
            <ListBox ItemsSource="{Binding ClassTrainers}" MaxHeight="240" DoubleTapped="ClassTrainer_DoubleTapped"
                     ToolTip.Tip="Double-click to open the trainer"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
