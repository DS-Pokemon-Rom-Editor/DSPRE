<Window MinWidth="900" MinHeight="600" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Trainers"
        xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Trainers"
        xmlns:data="clr-namespace:DSPRE.Avalonia.Data"
        x:Class="DSPRE.Avalonia.Views.Trainers.TrainerEditorView"
        x:DataType="vm:TrainerEditorViewModel"
        Title="Trainer editor"
        Width="980" Height="760"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:TrainerEditorViewModel/>
  </Design.DataContext>

  <TabControl x:Name="MainTabs">
    <TabItem Header="Trainers">
      <DockPanel>
        <controls:EditorToolbar x:Name="TrainerToolbar">
            <Button x:Name="SaveButton" Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
            <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
            <Button Content="Undo" controls:Icon.Key="undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" IsVisible="{Binding !IsHgeActive}" ToolTip.Tip="Undo (Ctrl+Z)"/>
            <Button Content="Redo" controls:Icon.Key="redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" IsVisible="{Binding !IsHgeActive}" ToolTip.Tip="Redo (Ctrl+Y)"/>
            <Button Content="Add" controls:Icon.Key="addIcon" Click="AddTrainer_Click" IsVisible="{Binding !IsHgeActive}" ToolTip.Tip="Append a new, blank trainer after the last one"/>
            <Button Content="Remove last" controls:Icon.Key="deleteIcon" Click="RemoveTrainer_Click" IsVisible="{Binding !IsHgeActive}" ToolTip.Tip="Remove the last trainer if nothing uses it"/>
            <Button Content="Search…" controls:Icon.Key="lens"        Click="Search_Click"/>
            <Button controls:EditorToolbar.Slot="Import" Content="Import" controls:Icon.Key="import" IsVisible="{Binding !IsHgeActive}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Trainer…" Click="ImportTrainer_Click" ToolTip.Tip="Load a .trf file into this trainer slot"/>
                  <MenuItem Header="Properties…" Click="ImportProperties_Click" ToolTip.Tip="Replace this trainer's properties from a .trp file"/>
                  <MenuItem Header="Party…" Click="ImportParty_Click" ToolTip.Tip="Replace this trainer's party from a .pdat file"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button controls:EditorToolbar.Slot="Export" Content="Export" controls:Icon.Key="export" IsVisible="{Binding !IsHgeActive}">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="Trainer…" Click="ExportTrainer_Click" ToolTip.Tip="Save this trainer (properties and party) to a .trf file"/>
                  <MenuItem Header="Properties…" Click="ExportProperties_Click" ToolTip.Tip="Save this trainer's properties to a .trp file"/>
                  <MenuItem Header="Party…" Click="ExportParty_Click" ToolTip.Tip="Save this trainer's party to a .pdat file"/>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
        </controls:EditorToolbar>
        <Border DockPanel.Dock="Top" Padding="8,3" Background="#2D6A4F" IsVisible="{Binding ShowHgEngineBanner}">
          <TextBlock Text="{Binding HgEngineBanner}" Foreground="White" FontSize="12"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
                BorderThickness="0,1,0,0" Padding="8,3">
          <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
        </Border>

        <Panel>
        <Grid ColumnDefinitions="240,*">
      <DockPanel Grid.Column="0" Margin="4">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBox Text="{Binding TrainerList.Filter}" PlaceholderText="Search trainers"
                   ToolTip.Tip="Name, class or number. Close spellings count when nothing matches exactly."/>
          <CheckBox Grid.Column="1" Content="Fuzzy" IsChecked="{Binding TrainerList.Fuzzy}" Margin="6,0,0,0" VerticalAlignment="Center"
                    ToolTip.Tip="Always include close spellings"/>
        </Grid>
        <ListBox x:Name="TrainerList" ItemsSource="{Binding TrainerList.Shown}" SelectedIndex="{Binding TrainerList.ShownIndex}"/>
      </DockPanel>

      <ScrollViewer x:Name="DetailScroll" Grid.Column="1" Padding="8,8,8,24">
        <StackPanel Spacing="8">

          <!-- Properties -->
          <GroupBox Header="Trainer">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,6,2"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TrainerName}" MaxLength="{Binding TrainerNameMaxLength}" Margin="0,0,8,2"/>
              <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Spacing="4">
                <Border Width="96" Height="96"
                        Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                  <Image Source="{Binding ClassImage}" Stretch="Uniform"/>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" IsVisible="{Binding HasClassSprite}">
                  <TextBlock Text="Frame" VerticalAlignment="Center"/>
                  <NumericUpDown Width="70" Minimum="0" Maximum="{Binding ClassFrameMax}" Increment="1" Value="{Binding ClassFrame}"
                                 ToolTip.Tip="Sprite frame shown here; not saved"/>
                  <Button controls:Icon.Key="{Binding PlayIcon}" Click="PlaySprite_Click" IsEnabled="{Binding CanPlay}" ToolTip.Tip="Play the sprite's animation"/>
                </StackPanel>
              </StackPanel>

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Class" VerticalAlignment="Center" Margin="0,0,6,2"/>
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,8,2">
                <controls:FusionAutoCompleteBox HorizontalAlignment="Stretch" ItemsSource="{Binding TrainerClassItems}" SelectedIndex="{Binding TrainerClassIndex}"/>
                <TextBlock Grid.Column="1" Text="{Binding ClassGender}" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource Editor.Subtle}" ToolTip.Tip="Class gender, used for the party's natures"/>
                <Button Grid.Column="2" controls:Icon.Key="goto" Margin="4,0,0,0" Click="TrainerClasses_Click" ToolTip.Tip="Open this class on the Classes tab"/>
              </Grid>

              <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" ItemSpacing="12" LineSpacing="4" Margin="0,4,8,0">
                <CheckBox Content="Double battle" IsChecked="{Binding DoubleBattle}" IsVisible="{Binding !IsHgeActive}"/>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !IsHgeActive}">
                  <TextBlock Text="Battle type" VerticalAlignment="Center"/>
                  <controls:IdNameSelector Value="{Binding BattleTypeValue}" Width="200" Maximum="4294967295"
                                           Names="{Binding BattleTypeNames}" Keys="{Binding BattleTypeKeys}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsHgeActive}">
                  <TextBlock Text="Battle type" VerticalAlignment="Center"/>
                  <ComboBox Width="180" ItemsSource="{Binding BattleTypeOptions}" SelectedIndex="{Binding BattleTypeIndex}"/>
                </StackPanel>
                <CheckBox Content="Custom moves"  IsChecked="{Binding ChooseMoves}" IsVisible="{Binding !IsHgeActive}"/>
                <CheckBox Content="Held items"    IsChecked="{Binding ChooseItems}" IsVisible="{Binding !IsHgeActive}"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Party size" VerticalAlignment="Center"/>
                  <NumericUpDown Width="90" Minimum="{Binding PartyCountMinimum}" Maximum="6" Increment="1" Value="{Binding PartyCount}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasPrize}" ToolTip.Tip="{Binding PrizeTip}">
                  <TextBlock Text="Prize" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                    <Border Width="{Binding PrizeSign.Size.Width}" Height="{Binding PrizeSign.Size.Height}" VerticalAlignment="Center"
                            Background="{DynamicResource Editor.Text}" IsVisible="{Binding HasPrizeSign}" Margin="0,2,0,0">
                      <Border.OpacityMask>
                        <ImageBrush Source="{Binding PrizeSign}"/>
                      </Border.OpacityMask>
                    </Border>
                    <TextBlock Text="{Binding PrizeText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </StackPanel>
                </StackPanel>
              </WrapPanel>
            </Grid>
          </GroupBox>

          <!-- Trainer data type (hg-engine only): the real TRAINER_DATA_TYPE_* flags, dynamically named
               from the linked checkout's include/trainer_data.h. Each one gates the matching party-mon
               field(s) below (see TrainerPartyMonViewModel's Hge*Enabled properties). -->
          <GroupBox Header="Trainer data type" IsVisible="{Binding IsHgeActive}">
            <ItemsControl ItemsSource="{Binding TrainerDataTypeFlags}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiFlagViewModel">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked}" Width="220" Margin="0,0,4,0"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>

          <!-- Held items -->
          <GroupBox Header="Trainer bag items">
            <ItemsControl ItemsSource="{Binding TrainerItems}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrainerItemSlotViewModel">
                  <controls:FusionAutoCompleteBox controls:EditorLink.To="Item" Width="200" Margin="2"
                            ItemsSource="{Binding ItemNames}" SelectedIndex="{Binding ItemIndex}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>

          <!-- AI flags: dynamically named from trainer_data.h's real F_* bits when hg-engine is active
               (repopulated in code, see TrainerEditorViewModel.SetupAsync); the same static, generic
               labels as before otherwise. -->
          <GroupBox Header="AI flags">
            <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="AI notes" controls:Icon.Key="OpenLink" Click="AiNotes_Click"
                    IsVisible="{Binding !IsHgeActive}" ToolTip.Tip="Lhea's notes on how the Gen 4 trainer AI picks moves"/>
            <ItemsControl ItemsSource="{Binding AiFlags}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AiFlagViewModel">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding Checked}" Width="220" Margin="0,0,4,0" ToolTip.Tip="{Binding Tip}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </DockPanel>
          </GroupBox>

          <!-- Party -->
          <GroupBox x:Name="PartyBox" Header="Party">
            <!-- Non-virtualizing panel: the default VirtualizingStackPanel mismeasures cards whose
                 Expander changes height. -->
            <ItemsControl ItemsSource="{Binding Party}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrainerPartyMonViewModel">
                  <Border IsVisible="{Binding IsVisible}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                          CornerRadius="3" Padding="6" Margin="0,0,0,6" Background="{DynamicResource Editor.PanelBg}">
                    <Grid ColumnDefinitions="74,*,*" RowDefinitions="Auto,Auto,Auto,Auto">
                      <StackPanel Grid.Column="0" Grid.RowSpan="3" Spacing="4" VerticalAlignment="Top">
                        <Border Width="66" Height="66"
                                Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                          <Image Source="{Binding PokemonIcon}" Width="64" Height="64" RenderOptions.BitmapInterpolationMode="None"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                          <Button controls:Icon.Key="arrowup" Padding="4,2" Click="MonUp_Click" ToolTip.Tip="{Binding MoveUpTip}"/>
                          <Button controls:Icon.Key="arrowdown" Padding="4,2" Click="MonDown_Click" ToolTip.Tip="{Binding MoveDownTip}"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- Row 0: species + level -->
                      <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,4,2">
                        <TextBlock Text="Species" FontSize="10"/>
                        <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding SpeciesIndex}"/>
                      </StackPanel>
                      <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,2">
                        <TextBlock Text="Level" FontSize="10"/>
                        <NumericUpDown Minimum="1" Maximum="100" Increment="1" Value="{Binding Level}"/>
                      </StackPanel>

                      <!-- Row 1: form/gender/ability/iv/ball -->
                      <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,2,0,2">
                        <StackPanel Width="140" Margin="0,0,6,0" IsVisible="{Binding ShowFormNames}">
                          <TextBlock Text="Form" FontSize="10"/>
                          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FormNames}" SelectedIndex="{Binding FormIndex}" IsEnabled="{Binding HasForms}"/>
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,6,0" IsVisible="{Binding ShowFormNumber}">
                          <TextBlock Text="Form" FontSize="10"/>
                          <NumericUpDown Minimum="0" Maximum="{Binding FormMaximum}" Increment="1" Value="{Binding FormId}"/>
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,6,0" IsVisible="{Binding GenderVisible}">
                          <TextBlock Text="Gender" FontSize="10"/>
                          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding GenderItems}" SelectedIndex="{Binding GenderIndex}" IsEnabled="{Binding GenderEnabled}"/>
                        </StackPanel>
                        <StackPanel Width="190" Margin="0,0,6,0">
                          <TextBlock Text="Ability" FontSize="10"/>
                          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding AbilityItems}" SelectedIndex="{Binding AbilityIndex}" IsEnabled="{Binding AbilityEnabled}"/>
                        </StackPanel>
                        <StackPanel Width="80" Margin="0,0,6,0">
                          <TextBlock Text="DV" FontSize="10" ToolTip.Tip="Sets every IV, and with the trainer and species, the nature"/>
                          <NumericUpDown Minimum="0" Maximum="255" Increment="1" Value="{Binding Difficulty}"/>
                        </StackPanel>
                        <StackPanel Width="40" Margin="0,0,6,0">
                          <TextBlock Text="IVs" FontSize="10"/>
                          <TextBlock Text="{Binding IvText}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Width="250" Margin="0,0,6,0" IsVisible="{Binding !HgeNatureEnabled}">
                          <TextBlock Text="Nature" FontSize="10"/>
                          <Grid ColumnDefinitions="*,Auto">
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding NatureChoices}" SelectedItem="{Binding SelectedNatureChoice}"
                                      PlaceholderText="{Binding NatureText}" MaxDropDownHeight="360" ToolTip.Tip="Picking one sets the highest DV that gives it"/>
                            <Button Grid.Column="1" Content="All…" Margin="4,0,0,0" Click="AllNatures_Click"
                                    ToolTip.Tip="Every DV with the IVs and nature it gives"/>
                          </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0" IsVisible="{Binding ShinyVisible}">
                          <TextBlock Text=" " FontSize="10"/>
                          <CheckBox Content="Shiny" IsEnabled="{Binding ShinyEnabled}" IsChecked="{Binding ForceShiny}"
                                    ToolTip.Tip="{Binding ShinyNote}" ToolTip.ShowOnDisabled="True"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding BallEnabled}">
                          <StackPanel Width="150">
                            <TextBlock Text="Ball Capsule" FontSize="10"/>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CapsuleNames}" SelectedIndex="{Binding CapsuleIndex}"
                                      MaxDropDownHeight="360"/>
                            <Button Content="Design" Click="DesignCapsule_Click" Margin="0,2,0,0" FontSize="11" Padding="6,1"
                                    ToolTip.Tip="Open in Ball Capsules" IsVisible="{Binding HasCapsule}"/>
                          </StackPanel>
                          <Border Width="64" Height="64" CornerRadius="32" Background="#2A7FA8C8" BorderBrush="#557FA8C8" BorderThickness="1"
                                  ClipToBounds="True" IsVisible="{Binding HasCapsule}">
                            <ItemsControl ItemsSource="{Binding CapsuleStickers}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="data:CapsuleSticker">
                                  <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                  <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                </Style>
                              </ItemsControl.Styles>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="data:CapsuleSticker">
                                  <Image Source="{Binding Sticker}" Width="17" Height="17" ToolTip.Tip="{Binding Name}"
                                         RenderOptions.BitmapInterpolationMode="None"/>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </StackPanel>
                      </WrapPanel>

                      <!-- Row 2: held item, then the moves on their own row -->
                      <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="6,2,0,0" Spacing="2">
                      <StackPanel Width="220" HorizontalAlignment="Left" IsVisible="{Binding ItemEnabled}">
                        <TextBlock Text="Held item" FontSize="10"/>
                        <controls:FusionAutoCompleteBox controls:EditorLink.To="Item" HorizontalAlignment="Stretch" ItemsSource="{Binding ItemNames}" SelectedIndex="{Binding ItemIndex}"/>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding ShowDefaultMoves}">
                        <TextBlock Text="Level-up moves" FontSize="10" ToolTip.Tip="The last four moves it learns by this level"/>
                        <ItemsControl ItemsSource="{Binding DefaultMoves}">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrainerPartyMonViewModel+DefaultMove">
                              <Border Width="260" Padding="6,4" Margin="0,0,0,4" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Editor.Border}">
                                <DockPanel>
                                  <controls:MoveBadges DockPanel.Dock="Left" Move="{Binding Move}" Margin="0,0,6,0"/>
                                  <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Editor.Subtle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <StackPanel IsVisible="{Binding MovesEnabled}">
                        <TextBlock Text="Moves" FontSize="10"/>
                        <WrapPanel>
                          <Border Width="260" Padding="4,2" Margin="0,0,6,4" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Editor.Border}">
                            <DockPanel>
                              <controls:MoveBadges DockPanel.Dock="Left" Move="{Binding Move1}" Margin="0,0,6,0"/>
                              <controls:FusionAutoCompleteBox controls:EditorLink.To="Move" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding Move1}"/>
                            </DockPanel>
                          </Border>
                          <Border Width="260" Padding="4,2" Margin="0,0,6,4" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Editor.Border}">
                            <DockPanel>
                              <controls:MoveBadges DockPanel.Dock="Left" Move="{Binding Move2}" Margin="0,0,6,0"/>
                              <controls:FusionAutoCompleteBox controls:EditorLink.To="Move" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding Move2}"/>
                            </DockPanel>
                          </Border>
                          <Border Width="260" Padding="4,2" Margin="0,0,6,4" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Editor.Border}">
                            <DockPanel>
                              <controls:MoveBadges DockPanel.Dock="Left" Move="{Binding Move3}" Margin="0,0,6,0"/>
                              <controls:FusionAutoCompleteBox controls:EditorLink.To="Move" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding Move3}"/>
                            </DockPanel>
                          </Border>
                          <Border Width="260" Padding="4,2" Margin="0,0,6,4" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Editor.Border}">
                            <DockPanel>
                              <controls:MoveBadges DockPanel.Dock="Left" Move="{Binding Move4}" Margin="0,0,6,0"/>
                              <controls:FusionAutoCompleteBox controls:EditorLink.To="Move" HorizontalAlignment="Stretch" ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding Move4}"/>
                            </DockPanel>
                          </Border>
                        </WrapPanel>
                      </StackPanel>
                      </StackPanel>

                      <Expander Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Header="Advanced"
                                IsVisible="{Binding HgeAdvancedVisible}" Margin="0,4,0,0" IsExpanded="False">
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                          <WrapPanel>
                            <StackPanel Width="180" Margin="0,0,6,0" IsEnabled="{Binding HgeExplicitAbilityEnabled}">
                              <TextBlock Text="Explicit ability" FontSize="10"/>
                              <controls:FusionAutoCompleteBox HorizontalAlignment="Stretch" ItemsSource="{Binding AllAbilityNames}" SelectedIndex="{Binding HgeExtras.AbilityId}"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,6,0" IsEnabled="{Binding HgeBallEnabled}">
                              <TextBlock Text="Catch ball" FontSize="10"/>
                              <controls:FusionAutoCompleteBox controls:EditorLink.To="Item" HorizontalAlignment="Stretch" ItemsSource="{Binding ItemNames}" SelectedIndex="{Binding HgeExtras.BallId}"/>
                            </StackPanel>
                            <StackPanel Width="180" Margin="0,0,6,0" IsEnabled="{Binding HgeNatureEnabled}">
                              <TextBlock Text="Nature" FontSize="10"/>
                              <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding HgeExtras.NatureNames}" SelectedIndex="{Binding HgeExtras.NatureIndex}"/>
                            </StackPanel>
                            <StackPanel Width="100" VerticalAlignment="Bottom" IsEnabled="{Binding HgeShinyLockEnabled}">
                              <CheckBox Content="Shiny lock" IsChecked="{Binding HgeExtras.ShinyLocked}"/>
                            </StackPanel>
                          </WrapPanel>

                          <StackPanel IsEnabled="{Binding HgeIvEvEnabled}">
                            <TextBlock Text="Explicit IVs" FontSize="10"/>
                            <WrapPanel>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="31" ToolTip.Tip="HP"      Value="{Binding HgeExtras.SetIvs.Hp}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="31" ToolTip.Tip="Attack"  Value="{Binding HgeExtras.SetIvs.Attack}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="31" ToolTip.Tip="Defense" Value="{Binding HgeExtras.SetIvs.Defense}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="31" ToolTip.Tip="Speed"   Value="{Binding HgeExtras.SetIvs.Speed}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="31" ToolTip.Tip="Sp. Atk" Value="{Binding HgeExtras.SetIvs.SpAttack}"/>
                              <NumericUpDown Width="70" Minimum="0" Maximum="31" ToolTip.Tip="Sp. Def" Value="{Binding HgeExtras.SetIvs.SpDefense}"/>
                            </WrapPanel>
                            <TextBlock Text="Explicit EVs" FontSize="10" Margin="0,4,0,0"/>
                            <WrapPanel>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="255" ToolTip.Tip="HP"      Value="{Binding HgeExtras.SetEvs.Hp}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="255" ToolTip.Tip="Attack"  Value="{Binding HgeExtras.SetEvs.Attack}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="255" ToolTip.Tip="Defense" Value="{Binding HgeExtras.SetEvs.Defense}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="255" ToolTip.Tip="Speed"   Value="{Binding HgeExtras.SetEvs.Speed}"/>
                              <NumericUpDown Width="70" Margin="0,0,4,0" Minimum="0" Maximum="255" ToolTip.Tip="Sp. Atk" Value="{Binding HgeExtras.SetEvs.SpAttack}"/>
                              <NumericUpDown Width="70" Minimum="0" Maximum="255" ToolTip.Tip="Sp. Def" Value="{Binding HgeExtras.SetEvs.SpDefense}"/>
                            </WrapPanel>
                          </StackPanel>

                          <StackPanel IsEnabled="{Binding HgeAdditionalFlagsEnabled}">
                            <TextBlock Text="Additional flags (each independently gates its own value)" FontSize="10"/>
                            <WrapPanel>
                              <StackPanel Width="110" Margin="0,0,6,0">
                                <CheckBox Content="Status" IsChecked="{Binding HgeExtras.ExtraStatusEnabled}"/>
                                <NumericUpDown Minimum="0" Maximum="255" IsEnabled="{Binding HgeExtras.ExtraStatusEnabled}" Value="{Binding HgeExtras.ExtraStatus}"/>
                              </StackPanel>
                              <StackPanel Width="110" Margin="0,0,6,0">
                                <CheckBox Content="HP" IsChecked="{Binding HgeExtras.ExtraHpEnabled}"/>
                                <NumericUpDown Minimum="0" Maximum="999" IsEnabled="{Binding HgeExtras.ExtraHpEnabled}" Value="{Binding HgeExtras.ExtraHp}"/>
                              </StackPanel>
                              <StackPanel Width="110" Margin="0,0,6,0">
                                <CheckBox Content="Attack" IsChecked="{Binding HgeExtras.ExtraAttackEnabled}"/>
                                <NumericUpDown Minimum="0" Maximum="999" IsEnabled="{Binding HgeExtras.ExtraAttackEnabled}" Value="{Binding HgeExtras.ExtraAttack}"/>
                              </StackPanel>
                              <StackPanel Width="110" Margin="0,0,6,0">
                                <CheckBox Content="Defense" IsChecked="{Binding HgeExtras.ExtraDefenseEnabled}"/>
                                <NumericUpDown Minimum="0" Maximum="999" IsEnabled="{Binding HgeExtras.ExtraDefenseEnabled}" Value="{Binding HgeExtras.ExtraDefense}"/>
                              </StackPanel>
                              <StackPanel Width="110" Margin="0,0,6,0">
                                <CheckBox Content="Speed" IsChecked="{Binding HgeExtras.ExtraSpeedEnabled}"/>
                                <NumericUpDown Minimum="0" Maximum="999" IsEnabled="{Binding HgeExtras.ExtraSpeedEnabled}" Value="{Binding HgeExtras.ExtraSpeed}"/>
                              </StackPanel>
                              <StackPanel Width="110" Margin="0,0,6,0">
                                <CheckBox Content="Sp. Atk" IsChecked="{Binding HgeExtras.ExtraSpAtkEnabled}"/>
                                <NumericUpDown Minimum="0" Maximum="999" IsEnabled="{Binding HgeExtras.ExtraSpAtkEnabled}" Value="{Binding HgeExtras.ExtraSpAtk}"/>
                              </StackPanel>
                              <StackPanel Width="110" Margin="0,0,6,0">
                                <CheckBox Content="Sp. Def" IsChecked="{Binding HgeExtras.ExtraSpDefEnabled}"/>
                                <NumericUpDown Minimum="0" Maximum="999" IsEnabled="{Binding HgeExtras.ExtraSpDefEnabled}" Value="{Binding HgeExtras.ExtraSpDef}"/>
                              </StackPanel>
                              <StackPanel Width="230" Margin="0,0,6,0">
                                <CheckBox Content="PP counts (move 1-4)" IsChecked="{Binding HgeExtras.ExtraPpCountsEnabled}"/>
                                <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding HgeExtras.ExtraPpCountsEnabled}">
                                  <NumericUpDown Width="54" Minimum="0" Maximum="40" Value="{Binding HgeExtras.ExtraPp1}"/>
                                  <NumericUpDown Width="54" Minimum="0" Maximum="40" Value="{Binding HgeExtras.ExtraPp2}"/>
                                  <NumericUpDown Width="54" Minimum="0" Maximum="40" Value="{Binding HgeExtras.ExtraPp3}"/>
                                  <NumericUpDown Width="54" Minimum="0" Maximum="40" Value="{Binding HgeExtras.ExtraPp4}"/>
                                </StackPanel>
                              </StackPanel>
                              <StackPanel Width="180">
                                <CheckBox Content="Nickname" IsChecked="{Binding HgeExtras.ExtraNicknameEnabled}"/>
                                <TextBox IsEnabled="{Binding HgeExtras.ExtraNicknameEnabled}" Text="{Binding HgeExtras.ExtraNickname}" MaxLength="10"/>
                              </StackPanel>
                            </WrapPanel>
                          </StackPanel>
                        </StackPanel>
                      </Expander>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>

          <GroupBox Header="Battle messages" IsVisible="{Binding !IsHgeActive}">
            <DockPanel>
              <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Edit" controls:Icon.Key="pencil" Click="BattleMessages_Click"
                      ToolTip.Tip="Open this trainer in the Battle Message editor"/>
              <ItemsControl ItemsSource="{Binding BattleLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrainerEditorViewModel+BattleLine">
                    <Grid ColumnDefinitions="230,*" Margin="0,2">
                      <TextBlock Text="{Binding When}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="8,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </GroupBox>

          <GroupBox Header="Used in" IsVisible="{Binding !IsHgeActive}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
                <Button Content="Find uses" controls:Icon.Key="lens" Click="FindUses_Click"
                        ToolTip.Tip="Scripts, events, battle messages, rematches and phone entries that use this trainer"/>
                <TextBlock Text="{Binding UsesStatus}" VerticalAlignment="Center" Foreground="{DynamicResource Editor.Subtle}"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Uses}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrainerEditorViewModel+TrainerUse">
                    <Grid ColumnDefinitions="140,220,*" Margin="0,2" Background="Transparent" DoubleTapped="Use_DoubleTapped"
                          ToolTip.Tip="Double-click a script or event to open it">
                      <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Editor.Subtle}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Location}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Column="2" Text="{Binding Places}" TextWrapping="Wrap" Margin="8,0,0,0"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </GroupBox>

          <!-- Fixed spacer: guarantees scroll room past the last party card. -->
          <Border Height="320"/>

        </StackPanel>
      </ScrollViewer>
        </Grid>
        <Border IsVisible="{Binding IsLoading}" Background="#A0000000" ZIndex="100">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="260">
            <TextBlock Text="{Binding StatusText}" FontSize="16" HorizontalAlignment="Center" Foreground="White"/>
            <ProgressBar IsIndeterminate="True"/>
          </StackPanel>
        </Border>
        </Panel>
      </DockPanel>
    </TabItem>

    <TabItem Header="Classes">
      <!-- Null until its own view model is set after loading, instead of inheriting the trainer one. -->
      <views:TrainerClassesView x:Name="ClassesTabView" DataContext="{x:Null}"/>
    </TabItem>
  </TabControl>
</Window>
