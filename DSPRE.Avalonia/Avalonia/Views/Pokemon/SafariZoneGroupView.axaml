<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
             x:Class="DSPRE.Avalonia.Views.Pokemon.SafariZoneGroupView"
             x:DataType="vm:SafariZoneGroupViewModel">

  <Grid ColumnDefinitions="*,*" Margin="4">

    <!-- ── Normal encounters (Morning / Day / Night) ─────────────────────────── -->
    <HeaderedContentControl Grid.Column="0" Header="Normal encounters" Margin="0,0,4,0">
      <TabControl>
        <TabItem Header="Morning">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" Spacing="3">
              <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding MorningSpecies}"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Level" VerticalAlignment="Center"/>
                <NumericUpDown Width="110" Minimum="0" Maximum="100" Increment="1" Value="{Binding MorningLevel}"/>
              </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding MorningItems}" SelectedIndex="{Binding MorningIndex}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image Width="32" Height="32" Source="{Binding Converter={x:Static controls:GameIconConverter.PokemonInLabel}}"/>
                  <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
        <TabItem Header="Day">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" Spacing="3">
              <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding DaySpecies}"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Level" VerticalAlignment="Center"/>
                <NumericUpDown Width="110" Minimum="0" Maximum="100" Increment="1" Value="{Binding DayLevel}"/>
              </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding DayItems}" SelectedIndex="{Binding DayIndex}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image Width="32" Height="32" Source="{Binding Converter={x:Static controls:GameIconConverter.PokemonInLabel}}"/>
                  <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
        <TabItem Header="Night">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" Spacing="3">
              <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding NightSpecies}"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Level" VerticalAlignment="Center"/>
                <NumericUpDown Width="110" Minimum="0" Maximum="100" Increment="1" Value="{Binding NightLevel}"/>
              </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding NightItems}" SelectedIndex="{Binding NightIndex}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image Width="32" Height="32" Source="{Binding Converter={x:Static controls:GameIconConverter.PokemonInLabel}}"/>
                  <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </HeaderedContentControl>

    <!-- ── Object encounters (shared slots + requirements) ───────────────────── -->
    <HeaderedContentControl Grid.Column="1" Header="Object encounters" Margin="4,0,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
          <Button Content="Add slot" controls:Icon.Key="addIcon"    Click="AddObject_Click"    IsEnabled="{Binding CanEditObjectSlotCount}"/>
          <Button Content="Remove slot" controls:Icon.Key="deleteIcon" Click="RemoveObject_Click" IsEnabled="{Binding CanEditObjectSlotCount}"/>
          <TextBlock Text="!" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Editor.Warn}"
                     IsVisible="{Binding NoSlotsWarning}" ToolTip.Tip="No bonus slots: surfing and every rod here give level 5 Magikarp"/>
        </StackPanel>
        <ListBox DockPanel.Dock="Top" Height="90"
                 ItemsSource="{Binding ObjectItems}" SelectedIndex="{Binding ObjectIndex}"/>

        <ScrollViewer>
          <StackPanel Spacing="3" Margin="0,6,0,0">
            <TextBlock Text="Morning" FontWeight="Bold"/>
            <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding ObjMorningSpecies}"/>
            <NumericUpDown Minimum="0" Maximum="100" Increment="1" Value="{Binding ObjMorningLevel}"/>
            <TextBlock Text="Day" FontWeight="Bold"/>
            <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding ObjDaySpecies}"/>
            <NumericUpDown Minimum="0" Maximum="100" Increment="1" Value="{Binding ObjDayLevel}"/>
            <TextBlock Text="Night" FontWeight="Bold"/>
            <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch" ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding ObjNightSpecies}"/>
            <NumericUpDown Minimum="0" Maximum="100" Increment="1" Value="{Binding ObjNightLevel}"/>
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
              <TextBlock Text="Requirement" FontWeight="Bold"/>
              <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource Editor.Warn}"
                         IsVisible="{Binding RequirementTypeWarning}" ToolTip.Tip="The game reads type 0 out of bounds"/>
            </StackPanel>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ObjectTypeNames}" SelectedIndex="{Binding ReqType}"/>
            <NumericUpDown Minimum="0" Maximum="255" Increment="1" Value="{Binding ReqPoints}" ToolTip.Tip="Points"/>
            <TextBlock Text="Optional requirement" FontWeight="Bold" Margin="0,4,0,0"/>
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ObjectTypeNames}" SelectedIndex="{Binding OptReqType}"/>
            <NumericUpDown Minimum="0" Maximum="255" Increment="1" Value="{Binding OptReqPoints}" ToolTip.Tip="Points"/>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </HeaderedContentControl>
  </Grid>
</UserControl>
