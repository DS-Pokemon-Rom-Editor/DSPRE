<Window MinWidth="860" MinHeight="520" xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
		x:Class="DSPRE.Avalonia.Views.Pokemon.EggMoveEditorView"
		x:DataType="vm:EggMoveEditorViewModel"
		Title="{Binding Title}"
		Width="900" Height="640"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:EggMoveEditorViewModel/>
  </Design.DataContext>


  <DockPanel LastChildFill="True">
	<Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
			BorderThickness="0,0,0,1" Padding="6,4">
	  <StackPanel Orientation="Horizontal" Spacing="6">
		<Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<controls:UndoRedoButtons/>
		<Button Content="Export CSV…" controls:Icon.Key="export" Click="Export_Click" Margin="12,0,0,0"/>
		<Button Content="Import CSV…" controls:Icon.Key="import" Click="Import_Click"/>
		<TextBlock Text="{Binding MonCountText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
		<TextBlock Text="{Binding ListSizeText}" Foreground="{Binding ListSizeBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
	  </StackPanel>
	</Border>

	<DockPanel Margin="8" LastChildFill="True">

	<!-- Three-column layout -->
	<Grid ColumnDefinitions="220,*,220" ColumnSpacing="8">

	  <!-- LEFT: Pokémon list + search -->
	  <DockPanel x:Name="MonPanel" Grid.Column="0">
		<TextBlock DockPanel.Dock="Top" Text="Pokémon with Egg Moves" FontWeight="SemiBold" Margin="0,0,0,4"/>

		<!-- Search -->
		<StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
		  <Grid ColumnDefinitions="*,Auto">
			<TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search…" KeyDown="Search_KeyDown"/>
			<Button  Grid.Column="1" controls:Icon.Key="lens" Margin="4,0,0,0" Click="Search_Click"/>
		  </Grid>
		  <ListBox ItemsSource="{Binding SearchResults}"
				   SelectedIndex="{Binding SelectedSearchIndex}"
				   MaxHeight="80"
				   DoubleTapped="SearchResult_DoubleTapped"/>
		</StackPanel>

		<StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
		  <TextBlock Text="{Binding EntryIdText}" FontSize="12"/>
		  <Grid ColumnDefinitions="*,*">
			<ComboBox Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding MonNames}"
					  SelectedIndex="{Binding CbMonIndex}" Margin="0,0,0,4"
					  PlaceholderText="Pick a Pokemon for the buttons below"/>
		  </Grid>
		  <TextBlock Text="{Binding MonStatusText}" FontSize="12" TextWrapping="Wrap"/>
		  <StackPanel Orientation="Horizontal" Spacing="4">
			<Button Content="Add" controls:Icon.Key="addIcon"     IsEnabled="{Binding CanAddMon}"     Click="AddMon_Click"/>
			<Button Content="Replace" IsEnabled="{Binding CanReplaceMon}" Click="ReplaceMon_Click"/>
			<Button Content="Delete" controls:Icon.Key="deleteIcon"  IsEnabled="{Binding CanDeleteMon}"  Click="DeleteMon_Click"/>
		  </StackPanel>
		</StackPanel>

		<ListBox ItemsSource="{Binding MonList}"
				 SelectedIndex="{Binding SelectedMonIndex}">
		  <ListBox.ItemTemplate>
			<DataTemplate>
			  <StackPanel Orientation="Horizontal" Spacing="6">
				<Image Width="32" Height="32" Source="{Binding Converter={x:Static controls:GameIconConverter.PokemonInLabel}}"/>
				<TextBlock Text="{Binding}" VerticalAlignment="Center"/>
			  </StackPanel>
			</DataTemplate>
		  </ListBox.ItemTemplate>
		</ListBox>
	  </DockPanel>

	  <!-- MIDDLE: Egg move list for selected Pokémon -->
	  <DockPanel x:Name="MovePanel" Grid.Column="1">
		<TextBlock DockPanel.Dock="Top" Text="Egg Moves" FontWeight="SemiBold" Margin="0,0,0,4"/>

		<StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
		  <StackPanel Orientation="Horizontal" Spacing="12">
			<TextBlock Text="{Binding MoveCountText}" Foreground="{Binding MoveCountBrush}" FontSize="12"/>
			<TextBlock Text="{Binding MoveIdText}"    FontSize="12"/>
		  </StackPanel>
		  <ComboBox ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding CbMoveIndex}"
					PlaceholderText="Pick a move for the buttons below"/>
		  <TextBlock Text="{Binding MoveStatusText}" FontSize="12" TextWrapping="Wrap"/>
		  <StackPanel Orientation="Horizontal" Spacing="4">
			<Button Content="Add" controls:Icon.Key="addIcon"     IsEnabled="{Binding CanAddMove}"     Click="AddMove_Click"/>
			<Button Content="Replace" IsEnabled="{Binding CanReplaceMove}" Click="ReplaceMove_Click"/>
			<Button Content="Delete" controls:Icon.Key="deleteIcon"  IsEnabled="{Binding CanDeleteMove}"  Click="DeleteMove_Click"/>
		  </StackPanel>
		</StackPanel>

		<ListBox ItemsSource="{Binding MoveList}"
				 SelectedIndex="{Binding SelectedMoveIndex}"/>
	  </DockPanel>

	  <!-- RIGHT: Bulk operations -->
	  <StackPanel x:Name="BulkPanel" Grid.Column="2" Spacing="10">
		<TextBlock Text="Bulk Operations" FontWeight="SemiBold"/>

		<Border BorderThickness="1"
				BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="6">
		  <StackPanel Spacing="4">
			<TextBlock Text="Bulk Replace Move" FontWeight="SemiBold" FontSize="12"/>
			<TextBlock Text="Replace:" FontSize="12"/>
			<ComboBox ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding CbReplaceeIndex}"/>
			<TextBlock Text="With:" FontSize="12"/>
			<ComboBox ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding CbReplacerIndex}"/>
			<Button Content="Bulk replace" HorizontalAlignment="Stretch" Click="BulkReplace_Click"/>
		  </StackPanel>
		</Border>

		<Border BorderThickness="1"
				BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="6">
		  <StackPanel Spacing="4">
			<TextBlock Text="Bulk Delete Move" FontWeight="SemiBold" FontSize="12"/>
			<ComboBox ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding CbDeleteAllIndex}"/>
			<Button Content="Bulk delete" HorizontalAlignment="Stretch" Click="BulkDelete_Click"/>
		  </StackPanel>
		</Border>
	  </StackPanel>

	</Grid>
	</DockPanel>
  </DockPanel>
</Window>
