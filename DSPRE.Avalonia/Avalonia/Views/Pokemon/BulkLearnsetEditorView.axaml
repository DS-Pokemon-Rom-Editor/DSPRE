<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
        x:Class="DSPRE.Avalonia.Views.Pokemon.BulkLearnsetEditorView"
        x:DataType="vm:BulkLearnsetEditorViewModel"
        Title="Bulk learnset editor"
        Width="720" Height="640"
        WindowStartupLocation="CenterScreen">

  <Design.DataContext>
    <vm:BulkLearnsetEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <controls:EditorToolbar>
        <TextBlock Text="Filter:" VerticalAlignment="Center"/>
        <ComboBox Width="200" ItemsSource="{Binding SpeciesFilter}" SelectedIndex="{Binding FilterIndex}"/>
        <Button Content="Save all" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <Button Content="Add row" controls:Icon.Key="addIcon"  Click="Add_Click"/>
        <Button Content="Remove" controls:Icon.Key="deleteIcon"   Click="Remove_Click"/>
        <Button Content="Import CSV…" controls:Icon.Key="import" Click="Import_Click"/>
        <Button Content="Export CSV…" controls:Icon.Key="export" Click="Export_Click"/>
    </controls:EditorToolbar>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <DataGrid Margin="4" ItemsSource="{Binding Rows}" SelectedIndex="{Binding SelectedRow}"
              CanUserResizeColumns="True" GridLinesVisibility="Horizontal" IsReadOnly="False">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Species" Width="280">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BulkLearnsetRow">
              <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding SpeciesIndex}" HorizontalAlignment="Stretch" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Level" Width="90">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BulkLearnsetRow">
              <NumericUpDown Minimum="0" Maximum="100" Value="{Binding Level}" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Move" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:BulkLearnsetRow">
              <controls:FusionAutoCompleteBox controls:EditorLink.To="Move" ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding MoveIndex}" HorizontalAlignment="Stretch" Margin="2"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
