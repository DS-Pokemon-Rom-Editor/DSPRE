<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
        x:Class="DSPRE.Avalonia.Views.Pokemon.TrophyGardenEncounterView"
        x:DataType="vm:TrophyGardenEncounterViewModel">

  <Design.DataContext>
    <vm:TrophyGardenEncounterViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <controls:EditorToolbar>
        <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <Button Content="Export…" controls:Icon.Key="export" Click="Export_Click" ToolTip.Tip="Export encounters to an external file."/>
        <Button Content="Import…" controls:Icon.Key="import" Click="Import_Click" ToolTip.Tip="Import encounters from an external file."/>
        <Button Content="Locate" controls:Icon.Key="folder" Click="Locate_Click" ToolTip.Tip="Open the folder containing the encounter files."/>
        <Button Content="?" Click="Help_Click" ToolTip.Tip="Trophy Garden help"/>
    </controls:EditorToolbar>

    <Grid>
      <TextBlock Text="Trophy Garden is only in Diamond, Pearl and Platinum." Margin="16" IsVisible="{Binding !IsAvailable}"/>

      <Grid ColumnDefinitions="240,*" IsVisible="{Binding IsAvailable}">
        <ListBox Grid.Column="0" Margin="4" ItemsSource="{Binding SlotLabels}"
                 SelectedIndex="{Binding SelectedSlotIndex}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image Width="32" Height="32" Source="{Binding Converter={x:Static controls:GameIconConverter.PokemonInLabel}}"/>
                  <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>

        <StackPanel Grid.Column="1" Margin="16" Spacing="8">
          <Border Width="64" Height="64" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                  Background="{DynamicResource Editor.PanelBg}" HorizontalAlignment="Left">
            <Image Source="{Binding PokemonIcon}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="{Binding SlotInfoText}"/>
          <TextBlock Text="Species"/>
          <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding SpeciesIndex}" HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
