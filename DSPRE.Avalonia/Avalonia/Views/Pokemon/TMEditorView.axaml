<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
		xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		x:Class="DSPRE.Avalonia.Views.Pokemon.TMEditorView"
		x:DataType="vm:TMEditorViewModel"
		Title="{Binding Title}"
		Width="620" Height="560" MinWidth="520" MinHeight="420"
		CanResize="True"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:TMEditorViewModel/>
  </Design.DataContext>


	<Window.Styles>
		<Style Selector="StackPanel.detail Button">
			<Setter Property="MinWidth" Value="120"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Label">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Styles>

	<DockPanel>
		<Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
				BorderThickness="0,0,0,1" Padding="6,4">
			<StackPanel Orientation="Horizontal" Spacing="6">
				<Button Content="Save" Click="SaveButton_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
				<Button Content="Discard" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
				<controls:UndoRedoButtons/>
				<Button Content="Export CSV" Click="ExportButton_Click" Margin="12,0,0,0"/>
				<Button Content="Import CSV" Click="ImportButton_Click"/>
			</StackPanel>
		</Border>

		<!-- Two columns: list, detail panel -->
		<Grid Margin="8" ColumnDefinitions="280,*">

			<!-- ── Left column: TM/HM list ─────────────────────────────── -->
			<DockPanel Grid.Column="0" Margin="0,0,8,0">
				<Label DockPanel.Dock="Top" Content="TM / HM List" FontWeight="SemiBold" Margin="0,0,0,4"/>
				<ListBox ItemsSource="{Binding MachineItems}"
						 SelectedIndex="{Binding SelectedMachineIndex}"
						 ScrollViewer.VerticalScrollBarVisibility="Auto">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:TMEditorViewModel+MachineRow">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<Image Width="32" Height="16" RenderOptions.BitmapInterpolationMode="None"
									   Source="{Binding Move, Converter={x:Static controls:GameIconConverter.MoveType}}"/>
								<TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</DockPanel>

			<!-- ── Right column: detail controls ──────────────────────── -->
			<StackPanel x:Name="MachineDetail" Grid.Column="1" Classes="detail"
						Spacing="8" VerticalAlignment="Top" MaxWidth="360" HorizontalAlignment="Left" MinWidth="220">

				<!-- Move selector -->
				<Label Content="Move"/>
				<ComboBox controls:EditorLink.To="Move" ItemsSource="{Binding MoveNames}"
						  SelectedIndex="{Binding SelectedMoveIndex}"
						  HorizontalAlignment="Stretch"/>

				<!-- Auto-Palette (single) -->
				<Button Content="Auto Palette"
						Click="AutoPaletteButton_Click"
						IsEnabled="{Binding PalettesKnown}"
						ToolTip.Tip="Set palette based on the selected move's type."
						HorizontalAlignment="Stretch"/>

				<!-- Type / Palette selector -->
				<Label Content="Palette (Type)"/>
				<ComboBox ItemsSource="{Binding TypeNames}"
						  SelectedIndex="{Binding SelectedTypeIndex}"
						  IsEnabled="{Binding PalettesKnown}"
						  HorizontalAlignment="Stretch"/>

				<!-- Auto-Palette All -->
				<Button Content="Auto Palette All"
						Click="AutoPaletteAllButton_Click"
						IsEnabled="{Binding PalettesKnown}"
						ToolTip.Tip="Apply automatic palette based on move type to all TMs/HMs."
						HorizontalAlignment="Stretch"/>

			</StackPanel>

		</Grid>
	</DockPanel>
</Window>
