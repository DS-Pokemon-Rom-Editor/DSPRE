<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
		x:Class="DSPRE.Avalonia.Views.Pokemon.TMEditorView"
		x:DataType="vm:TMEditorViewModel"
		Title="{Binding Title}"
		Width="470" Height="480" MinWidth="430" MinHeight="380"
		CanResize="True"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:TMEditorViewModel/>
  </Design.DataContext>


	<Window.Styles>
		<Style Selector="Button">
			<Setter Property="MinWidth" Value="120"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="Label">
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</Window.Styles>

	<!-- Root: two columns (list, detail panel) -->
	<Grid Margin="8" ColumnDefinitions="230,*" RowDefinitions="*,Auto">

		<!-- ── Left column: TM/HM list ─────────────────────────────── -->
		<StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
					Margin="0,0,8,0">
			<Label Content="TM / HM List" FontWeight="SemiBold" Margin="0,0,0,4"/>
			<ListBox ItemsSource="{Binding MachineItems}"
					 SelectedIndex="{Binding SelectedMachineIndex}"
					 Height="390"
					 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
		</StackPanel>

		<!-- ── Right column: detail controls ──────────────────────── -->
		<StackPanel Grid.Column="1" Grid.Row="0"
					Spacing="8" VerticalAlignment="Top">

			<!-- Move selector -->
			<Label Content="Move"/>
			<ComboBox ItemsSource="{Binding MoveNames}"
					  SelectedIndex="{Binding SelectedMoveIndex}"
					  HorizontalAlignment="Stretch"/>

			<!-- Auto-Palette (single) -->
			<Button Content="Auto Palette"
					Click="AutoPaletteButton_Click"
					ToolTip.Tip="Set palette based on the selected move's type."
					HorizontalAlignment="Stretch"/>

			<!-- Type / Palette selector -->
			<Label Content="Palette (Type)"/>
			<ComboBox ItemsSource="{Binding TypeNames}"
					  SelectedIndex="{Binding SelectedTypeIndex}"
					  HorizontalAlignment="Stretch"/>

			<!-- Auto-Palette All -->
			<Button Content="Auto Palette All"
					Click="AutoPaletteAllButton_Click"
					ToolTip.Tip="Apply automatic palette based on move type to all TMs/HMs."
					HorizontalAlignment="Stretch"/>

		</StackPanel>

		<!-- ── Right column bottom: save / export / import ─────────── -->
		<StackPanel Grid.Column="1" Grid.Row="1"
					Spacing="6" VerticalAlignment="Bottom">

			<!-- Undo and Redo sit side by side here, so the window has to be wide enough for both
			     labels. At 400 they were cut in half. -->
			<Grid ColumnDefinitions="*,6,*">
				<Button Grid.Column="0" Content="↶ Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
				<Button Grid.Column="2" Content="↷ Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
			</Grid>

			<Button Content="Save"
					Click="SaveButton_Click"
					HorizontalAlignment="Stretch"/>

			<Button Content="Export"
					Click="ExportButton_Click"
					HorizontalAlignment="Stretch"/>

			<Button Content="Import"
					Click="ImportButton_Click"
					HorizontalAlignment="Stretch"/>

		</StackPanel>

	</Grid>
</Window>
