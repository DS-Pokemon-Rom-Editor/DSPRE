<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
        xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Pokemon"
        xmlns:viewsbattle="clr-namespace:DSPRE.Avalonia.Views.Battle"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.Pokemon.PokemonEditorView"
        x:DataType="vm:PokemonEditorViewModel"
        Title="{Binding Title}"
        Width="1080" Height="860" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:PokemonEditorViewModel/>
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="6,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="SaveButton" Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}" IsDefault="True"
                  ToolTip.Tip="Save every tab (Ctrl+S)"/>
          <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
          <controls:UndoRedoButtons/>
        </StackPanel>
        <Grid x:Name="SpeciesBar" Grid.Column="1" ColumnDefinitions="36,8,115,8,*" Margin="12,0,8,0">
          <Border Grid.Column="0" Width="36" Height="36" Background="#E0E0E0" CornerRadius="4">
            <Image Source="{Binding MonIconBitmap}" Stretch="Uniform"/>
          </Border>
          <NumericUpDown Grid.Column="2" Value="{Binding SelectedMonIndex}" Minimum="0" Maximum="{Binding MaxMonIndex}" FormatString="0" Width="115" FontSize="13"
                         VerticalAlignment="Center"/>
          <controls:FusionAutoCompleteBox Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding SelectedMonIndex}" HorizontalAlignment="Stretch" FontSize="13"
                                          VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Content="Cry" controls:Icon.Key="speaker" Click="PlayCry_Click" ToolTip.Tip="Play cry"/>
          <Button Content="Edit cry…" controls:Icon.Key="pencil" Click="EditCry_Click" ToolTip.Tip="Open in the Audio Editor"/>
          <Button Content="Add new…" controls:Icon.Key="addIcon" Click="AddSpecies_Click" IsVisible="{Binding ShowHgEngineBanner}" IsEnabled="{Binding CanAddSpecies}"
                  ToolTip.Tip="Add a new base species. It is created when you save."/>
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Top" Padding="8,3" Background="#2D6A4F" IsVisible="{Binding ShowHgEngineBanner}">
      <TextBlock Text="{Binding HgEngineBanner}" Foreground="White" FontSize="12"/>
    </Border>
    <Border DockPanel.Dock="Top" Padding="8,3" IsVisible="{Binding HasPendingSpecies}">
      <TextBlock Text="{Binding PendingSpeciesBanner}" Foreground="{DynamicResource Editor.Warn}" FontSize="12" FontWeight="SemiBold"/>
    </Border>
    <TabControl x:Name="PokemonTabs" Margin="4,2,4,4" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Personal Data">
        <views:PersonalDataEditorView DataContext="{Binding PersonalVM}"/>
      </TabItem>
      <TabItem Header="Learnset">
        <DockPanel Margin="8" DataContext="{Binding LearnsetVM}">
          <Border DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding EntryCount, StringFormat=Entries: {0}}" VerticalAlignment="Center"/>
              <Button Content="Export CSV…" controls:Icon.Key="export" Click="Learnset_Export_Click"/>
              <Button Content="Bulk edit all…" controls:Icon.Key="tableEditor" Click="Learnset_BulkEdit_Click"/>
              <TextBlock Text="Warning: exceeds vanilla 20-move limit!" IsVisible="{Binding ExceedsVanillaLimit}" Foreground="OrangeRed" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding StatusText}" Foreground="Red" FontStyle="Italic" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="0,6,0,0">
            <Grid ColumnDefinitions="Auto,8,80,8,*,8,Auto,4,Auto,4,Auto,4,Auto">
              <TextBlock Grid.Column="0" Text="Level:" Classes="lbl"/>
              <NumericUpDown Grid.Column="2" Value="{Binding AddLevel}" Minimum="1" Maximum="100" FormatString="0" Width="80"/>
              <ComboBox controls:EditorLink.To="Move" Grid.Column="4" ItemsSource="{Binding MoveNames}" SelectedIndex="{Binding AddMoveIndex}" HorizontalAlignment="Stretch"/>
              <Button Grid.Column="6"  Content="Add" controls:Icon.Key="addIcon"    Click="Learnset_Add_Click"      MinWidth="60" IsEnabled="{Binding CanAdd}"/>
              <Button Grid.Column="8"  Content="Delete" controls:Icon.Key="deleteIcon" Click="Learnset_Delete_Click"   MinWidth="60" IsEnabled="{Binding CanEdit}"/>
              <Button Grid.Column="10" Content="Up" controls:Icon.Key="arrowup"     Click="Learnset_MoveUp_Click"   MinWidth="44" IsEnabled="{Binding CanMoveUp}"/>
              <Button Grid.Column="12" Content="Down" controls:Icon.Key="arrowdown"   Click="Learnset_MoveDown_Click" MinWidth="44" IsEnabled="{Binding CanMoveDown}"/>
            </Grid>
          </Border>
          <ListBox ItemsSource="{Binding Entries}" SelectedIndex="{Binding SelectedEntryIndex}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontFamily="Consolas,monospace" FontSize="12"/></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Evolutions">
        <DockPanel Margin="8" DataContext="{Binding EvolutionsVM}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding AltFormNotice}" IsVisible="{Binding IsAltForm}"
                         TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
              <Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
                <TextBlock Grid.Column="0" Text="Method"         FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="Param"          FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="4" Text="Target Pokemon" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="6" Text="Param Type"     FontWeight="SemiBold" FontSize="12"/>
              </Grid><Separator/>
<Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
  <ComboBox  Grid.Column="0" ItemsSource="{Binding MethodNames}"  SelectedIndex="{Binding EvoRows[0].MethodIndex}"  MinWidth="180"/>
  <NumericUpDown Grid.Column="2" Value="{Binding EvoRows[0].Param}" Minimum="0" Maximum="{Binding EvoRows[0].ParamMaximum}" FormatString="0" Width="90" IsEnabled="{Binding EvoRows[0].IsParamEnabled}"/>
  <ComboBox controls:EditorLink.To="Pokemon"  Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding EvoRows[0].TargetIndex}" IsEnabled="{Binding EvoRows[0].IsTargetEnabled}" MinWidth="180"/>
  <TextBlock Grid.Column="6" Text="{Binding EvoRows[0].ParamLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
</Grid>
<Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
  <ComboBox  Grid.Column="0" ItemsSource="{Binding MethodNames}"  SelectedIndex="{Binding EvoRows[1].MethodIndex}"  MinWidth="180"/>
  <NumericUpDown Grid.Column="2" Value="{Binding EvoRows[1].Param}" Minimum="0" Maximum="{Binding EvoRows[1].ParamMaximum}" FormatString="0" Width="90" IsEnabled="{Binding EvoRows[1].IsParamEnabled}"/>
  <ComboBox controls:EditorLink.To="Pokemon"  Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding EvoRows[1].TargetIndex}" IsEnabled="{Binding EvoRows[1].IsTargetEnabled}" MinWidth="180"/>
  <TextBlock Grid.Column="6" Text="{Binding EvoRows[1].ParamLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
</Grid>
<Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
  <ComboBox  Grid.Column="0" ItemsSource="{Binding MethodNames}"  SelectedIndex="{Binding EvoRows[2].MethodIndex}"  MinWidth="180"/>
  <NumericUpDown Grid.Column="2" Value="{Binding EvoRows[2].Param}" Minimum="0" Maximum="{Binding EvoRows[2].ParamMaximum}" FormatString="0" Width="90" IsEnabled="{Binding EvoRows[2].IsParamEnabled}"/>
  <ComboBox controls:EditorLink.To="Pokemon"  Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding EvoRows[2].TargetIndex}" IsEnabled="{Binding EvoRows[2].IsTargetEnabled}" MinWidth="180"/>
  <TextBlock Grid.Column="6" Text="{Binding EvoRows[2].ParamLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
</Grid>
<Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
  <ComboBox  Grid.Column="0" ItemsSource="{Binding MethodNames}"  SelectedIndex="{Binding EvoRows[3].MethodIndex}"  MinWidth="180"/>
  <NumericUpDown Grid.Column="2" Value="{Binding EvoRows[3].Param}" Minimum="0" Maximum="{Binding EvoRows[3].ParamMaximum}" FormatString="0" Width="90" IsEnabled="{Binding EvoRows[3].IsParamEnabled}"/>
  <ComboBox controls:EditorLink.To="Pokemon"  Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding EvoRows[3].TargetIndex}" IsEnabled="{Binding EvoRows[3].IsTargetEnabled}" MinWidth="180"/>
  <TextBlock Grid.Column="6" Text="{Binding EvoRows[3].ParamLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
</Grid>
<Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
  <ComboBox  Grid.Column="0" ItemsSource="{Binding MethodNames}"  SelectedIndex="{Binding EvoRows[4].MethodIndex}"  MinWidth="180"/>
  <NumericUpDown Grid.Column="2" Value="{Binding EvoRows[4].Param}" Minimum="0" Maximum="{Binding EvoRows[4].ParamMaximum}" FormatString="0" Width="90" IsEnabled="{Binding EvoRows[4].IsParamEnabled}"/>
  <ComboBox controls:EditorLink.To="Pokemon"  Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding EvoRows[4].TargetIndex}" IsEnabled="{Binding EvoRows[4].IsTargetEnabled}" MinWidth="180"/>
  <TextBlock Grid.Column="6" Text="{Binding EvoRows[4].ParamLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
</Grid>
<Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
  <ComboBox  Grid.Column="0" ItemsSource="{Binding MethodNames}"  SelectedIndex="{Binding EvoRows[5].MethodIndex}"  MinWidth="180"/>
  <NumericUpDown Grid.Column="2" Value="{Binding EvoRows[5].Param}" Minimum="0" Maximum="{Binding EvoRows[5].ParamMaximum}" FormatString="0" Width="90" IsEnabled="{Binding EvoRows[5].IsParamEnabled}"/>
  <ComboBox controls:EditorLink.To="Pokemon"  Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding EvoRows[5].TargetIndex}" IsEnabled="{Binding EvoRows[5].IsTargetEnabled}" MinWidth="180"/>
  <TextBlock Grid.Column="6" Text="{Binding EvoRows[5].ParamLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
</Grid>
<Grid ColumnDefinitions="180,8,80,8,180,16,Auto">
  <ComboBox  Grid.Column="0" ItemsSource="{Binding MethodNames}"  SelectedIndex="{Binding EvoRows[6].MethodIndex}"  MinWidth="180"/>
  <NumericUpDown Grid.Column="2" Value="{Binding EvoRows[6].Param}" Minimum="0" Maximum="{Binding EvoRows[6].ParamMaximum}" FormatString="0" Width="90" IsEnabled="{Binding EvoRows[6].IsParamEnabled}"/>
  <ComboBox controls:EditorLink.To="Pokemon"  Grid.Column="4" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding EvoRows[6].TargetIndex}" IsEnabled="{Binding EvoRows[6].IsTargetEnabled}" MinWidth="180"/>
  <TextBlock Grid.Column="6" Text="{Binding EvoRows[6].ParamLabel}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
</Grid>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- ─── Sprites ──────────────────────────────────────────────────── -->
      <TabItem Header="Sprites">
        <views:PokemonSpriteEditorView DataContext="{Binding SpriteVM}"/>
      </TabItem>
      <TabItem Header="Battle Display">
        <viewsbattle:BattleDisplayEditorView DataContext="{Binding BattleDisplayVM}"/>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
