<Window MinWidth="700" MinHeight="460" xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
		x:Class="DSPRE.Avalonia.Views.Pokemon.TradeEditorView"
		x:DataType="vm:TradeEditorViewModel"
		Width="820" Height="520"
		WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:TradeEditorViewModel/>
  </Design.DataContext>


  <DockPanel LastChildFill="True">
	<controls:EditorToolbar>
		<Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<controls:UndoRedoButtons/>
		<TextBlock Text="Trade ID" VerticalAlignment="Center" Margin="12,0,0,0"/>
		<NumericUpDown x:Name="TradePicker" Value="{Binding TradeID}"
					   Minimum="{Binding TradeIDMin}"
					   Maximum="{Binding TradeIDMax}"
					   Width="80"
					   ValueChanged="TradeID_Changed"/>
	</controls:EditorToolbar>

	<DockPanel Margin="10" LastChildFill="True">

	<controls:CappedWidth Cap="1100"><Grid ColumnDefinitions="*,*" ColumnSpacing="10">

	  <Border x:Name="TradeDataPanel" Grid.Column="0" BorderThickness="1"
			  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="8">
		<ScrollViewer>
		  <StackPanel Spacing="6">
			<TextBlock Text="Pokémon" FontWeight="Bold"/>

			<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">

			  <TextBlock Grid.Row="0" Grid.Column="0" Text="Species" VerticalAlignment="Center"/>
			  <DockPanel Grid.Row="0" Grid.Column="1">
			    <Image DockPanel.Dock="Right" Width="32" Height="32" Margin="4,0,0,0" Source="{Binding SelectedSpecies, Converter={x:Static controls:GameIconConverter.Pokemon}}"/>
			    <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding SelectedSpecies}" AllowsNone="False"/>
			  </DockPanel>

			  <TextBlock Grid.Row="1" Grid.Column="0" Text="Requested" VerticalAlignment="Center"/>
			  <DockPanel Grid.Row="1" Grid.Column="1">
			    <Image DockPanel.Dock="Right" Width="32" Height="32" Margin="4,0,0,0" Source="{Binding SelectedRequested, Converter={x:Static controls:GameIconConverter.Pokemon}}"/>
			    <controls:FusionAutoCompleteBox controls:EditorLink.To="Pokemon" ItemsSource="{Binding PokemonNames}" SelectedIndex="{Binding SelectedRequested}" AllowsNone="False"/>
			  </DockPanel>

			  <TextBlock Grid.Row="2" Grid.Column="0" Text="Nickname" VerticalAlignment="Center"/>
			  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Nickname}" MaxLength="10" ToolTip.Tip="Up to 10 characters"/>

			  <TextBlock Grid.Row="3" Grid.Column="0" Text="Held item" VerticalAlignment="Center"/>
			  <DockPanel Grid.Row="3" Grid.Column="1">
			    <Image DockPanel.Dock="Right" Width="32" Height="32" Margin="4,0,0,0" Source="{Binding SelectedHeldItem, Converter={x:Static controls:GameIconConverter.Item}}"/>
			    <controls:FusionAutoCompleteBox controls:EditorLink.To="Item" ItemsSource="{Binding ItemNames}" SelectedIndex="{Binding SelectedHeldItem}" AllowsNone="False"/>
			  </DockPanel>

			  <TextBlock Grid.Row="4" Grid.Column="0" Text="PID" VerticalAlignment="Center"/>
			  <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Pid}" Minimum="0" Maximum="2147483647"/>

			  <TextBlock Grid.Row="5" Grid.Column="0" Text="Nature" VerticalAlignment="Center"/>
			  <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding Natures}" SelectedIndex="{Binding NatureIndex}" HorizontalAlignment="Stretch" ToolTip.Tip="Changes the PID"/>

			  <TextBlock Grid.Row="6" Grid.Column="0" Text="Ability" VerticalAlignment="Center"/>
			  <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding AbilityChoices}" SelectedIndex="{Binding AbilityIndex}" HorizontalAlignment="Stretch"
						 IsEnabled="{Binding CanChooseAbility}" ToolTip.Tip="{Binding AbilityTip}" ToolTip.ShowOnDisabled="True"/>

			  <TextBlock Grid.Row="7" Grid.Column="0" Text="Gender" VerticalAlignment="Center"/>
			  <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding GenderChoices}" SelectedIndex="{Binding GenderIndex}" HorizontalAlignment="Stretch"
						 IsEnabled="{Binding CanChooseGender}" ToolTip.Tip="{Binding GenderTip}" ToolTip.ShowOnDisabled="True"/>

			  <TextBlock Grid.Row="8" Grid.Column="0" Text="Shiny" VerticalAlignment="Center"/>
			  <CheckBox Grid.Row="8" Grid.Column="1" IsChecked="{Binding IsShiny}" IsEnabled="{Binding CanChooseShiny}" ToolTip.Tip="{Binding ShinyTip}" ToolTip.ShowOnDisabled="True"/>
			</Grid>
		  </StackPanel>
		</ScrollViewer>
	  </Border>

	  <Border x:Name="TrainerPanel" Grid.Column="1" BorderThickness="1"
			  BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" Padding="8">
		<ScrollViewer>
		  <StackPanel Spacing="6">
			<TextBlock Text="Original trainer" FontWeight="Bold"/>

			<Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
			  <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center"/>
			  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding OtName}" MaxLength="7" ToolTip.Tip="Up to 7 characters"/>
			  <TextBlock Grid.Row="0" Grid.Column="2" Text="Gender" VerticalAlignment="Center"/>
			  <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding OTGenderNames}" SelectedIndex="{Binding SelectedOTGender}" HorizontalAlignment="Stretch"/>
			  <TextBlock Grid.Row="1" Grid.Column="0" Text="ID" VerticalAlignment="Center"/>
			  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding OtID}" Minimum="0" Maximum="2147483647"/>
			  <TextBlock Grid.Row="1" Grid.Column="2" Text="Language" VerticalAlignment="Center"/>
			  <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding SelectedLanguage}" HorizontalAlignment="Stretch"/>
			</Grid>

			<TextBlock Text="IVs" FontWeight="Bold" Margin="0,6,0,0"/>
			<Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
				<TextBlock Grid.Row="0" Grid.Column="0" Text="HP" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding HpIV}" Minimum="0" Maximum="31"/>
				<TextBlock Grid.Row="0" Grid.Column="2" Text="Attack" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding AtkIV}" Minimum="0" Maximum="31"/>
				<TextBlock Grid.Row="0" Grid.Column="4" Text="Defense" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="0" Grid.Column="5" Value="{Binding DefIV}" Minimum="0" Maximum="31"/>
				<TextBlock Grid.Row="1" Grid.Column="0" Text="Sp. Atk" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SpaIV}" Minimum="0" Maximum="31"/>
				<TextBlock Grid.Row="1" Grid.Column="2" Text="Sp. Def" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding SpdIV}" Minimum="0" Maximum="31"/>
				<TextBlock Grid.Row="1" Grid.Column="4" Text="Speed" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="1" Grid.Column="5" Value="{Binding SpeIV}" Minimum="0" Maximum="31"/>
			</Grid>

			<TextBlock Text="Contest stats" FontWeight="Bold" Margin="0,6,0,0"/>
			<Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="4">
				<TextBlock Grid.Row="0" Grid.Column="0" Text="Cool" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Cool}" Minimum="0" Maximum="255"/>
				<TextBlock Grid.Row="0" Grid.Column="2" Text="Beauty" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding Beauty}" Minimum="0" Maximum="255"/>
				<TextBlock Grid.Row="0" Grid.Column="4" Text="Cute" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="0" Grid.Column="5" Value="{Binding Cute}" Minimum="0" Maximum="255"/>
				<TextBlock Grid.Row="1" Grid.Column="0" Text="Smart" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Smart}" Minimum="0" Maximum="255"/>
				<TextBlock Grid.Row="1" Grid.Column="2" Text="Tough" VerticalAlignment="Center"/>
				<NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding Tough}" Minimum="0" Maximum="255"/>
			</Grid>

			<Expander Header="Advanced" HorizontalAlignment="Stretch">
			  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="4">
				<TextBlock Grid.Row="0" Grid.Column="0" Text="Unused ability" VerticalAlignment="Center" ToolTip.Tip="The game never reads this"/>
				<controls:FusionAutoCompleteBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AbilityNames}" SelectedIndex="{Binding SelectedAbility}" AllowsNone="False" ToolTip.Tip="The game never reads this"/>
				<TextBlock Grid.Row="1" Grid.Column="0" Text="Unused sheen" VerticalAlignment="Center" ToolTip.Tip="The game never reads this"/>
				<NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Sheen}" Minimum="0" Maximum="255" ToolTip.Tip="The game never reads this"/>
				<TextBlock Grid.Row="2" Grid.Column="0" Text="Unknown" VerticalAlignment="Center" IsVisible="{Binding IsHGSS}"/>
				<NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Unknown}" Minimum="0" Maximum="2147483647" IsVisible="{Binding IsHGSS}"/>
			  </Grid>
			</Expander>
		  </StackPanel>
		</ScrollViewer>
	  </Border>

	</Grid></controls:CappedWidth>
	</DockPanel>
  </DockPanel>
</Window>
