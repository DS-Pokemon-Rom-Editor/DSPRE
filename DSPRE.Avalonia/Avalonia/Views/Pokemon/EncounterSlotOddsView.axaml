<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
             xmlns:hge="clr-namespace:DSPRE.HgEngine;assembly=DSPRE.Core"
             x:Class="DSPRE.Avalonia.Views.Pokemon.EncounterSlotOddsView"
             x:DataType="vm:EncounterSlotOddsViewModel">
  <Design.DataContext>
    <vm:EncounterSlotOddsViewModel/>
  </Design.DataContext>

  <DockPanel>
    <controls:EditorToolbar>
        <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
    </controls:EditorToolbar>

    <Border DockPanel.Dock="Top" IsVisible="{Binding HasHookWarning}" Margin="8,4,8,0" Padding="8" CornerRadius="4"
            Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Warn}" BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding HookWarning}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Open in hooks editor" controls:Icon.Key="OpenLink" Click="OpenHooks_Click"/>
          <Button Content="Pull request 1039" Click="HookFix_Click" ToolTip.Tip="{x:Static hge:HgEngineSlotOdds.HookFixUrl}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Margin="8,4"
               Foreground="{DynamicResource Editor.Bad}" TextWrapping="Wrap"/>

    <TabControl ItemsSource="{Binding Methods}" Margin="4">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:EncounterSlotOddsViewModel+MethodViewModel">
          <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Note}"/>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate x:DataType="vm:EncounterSlotOddsViewModel+MethodViewModel">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10" Spacing="4">
            <controls:ProportionBar Parts="{Binding Parts}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Slots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EncounterSlotOddsViewModel+SlotViewModel">
                  <Grid ColumnDefinitions="70,120,*" Margin="0,2">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Percent}" Minimum="0" Maximum="100" FormatString="0'%'"/>
                    <controls:ProportionBar Grid.Column="2" Parts="{Binding Bar}" Height="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Total}" FontWeight="SemiBold" Margin="0,6,0,0" Classes.bad="{Binding IsOff}"/>
          </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </TabControl.ContentTemplate>
      <TabControl.Styles>
        <Style Selector="TextBlock.bad">
          <Setter Property="Foreground" Value="{DynamicResource Editor.Bad}"/>
        </Style>
      </TabControl.Styles>
    </TabControl>
  </DockPanel>
</UserControl>
