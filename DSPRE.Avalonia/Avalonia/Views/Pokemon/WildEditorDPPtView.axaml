<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.Pokemon.WildEditorDPPtView"
        x:DataType="vm:WildEditorDPPtViewModel">
  <Design.DataContext>
    <vm:WildEditorDPPtViewModel/>
  </Design.DataContext>

  <UserControl.Resources>
    <DataTemplate x:Key="PokemonEncounterCellTemplate" x:DataType="vm:WildEncounterRow">
      <Grid ColumnDefinitions="32,*" ColumnSpacing="6">
        <Image Source="{Binding PokemonIcon}" Width="32" Height="32" Stretch="Uniform"/>
        <controls:FusionAutoCompleteBox Grid.Column="1"
                  ItemsSource="{Binding PokemonNames}"
                  SelectedIndex="{Binding PokemonIndex}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.lbl">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="MinWidth" Value="90"/>
      <Setter Property="FormatString" Value="0"/>
      <Setter Property="Increment" Value="1"/>
    </Style>
    <Style Selector="controls|FusionAutoCompleteBox">
      <Setter Property="MinWidth" Value="160"/>
      <Setter Property="MinHeight" Value="32"/>
    </Style>
  </UserControl.Styles>
  <DockPanel LastChildFill="True" Margin="10">
    <Border DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Encounter File:" Classes="lbl" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <controls:FusionAutoCompleteBox ItemsSource="{Binding EncounterNames}" SelectedIndex="{Binding SelectedEncounterIndex}" MinWidth="300"/>
        <Button Content="＋ Add"     Click="AddFile_Click"/>
        <Button Content="🗑 Remove last" Click="RemFile_Click"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <Button Content="📥 Import" Click="ImportFile_Click"/>
        <Button Content="📤 Export" Click="ExportFile_Click"/>
        <Button Content="🛠 Repair all" Click="RepairAll_Click" ToolTip.Tip="Reset corrupted fields in every encounter file to defaults"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="↶ Undo" Click="Undo_Click" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Undo (Ctrl+Z)"/>
        <Button Content="↷ Redo" Click="Redo_Click" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Redo (Ctrl+Y)"/>
        <Button Content="Save" Click="Save_Click" Width="100" IsDefault="True"/>
      </StackPanel>
    </Border>
    <TabControl>
      <!-- Walking -->
      <TabItem Header="Walking">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
            <TextBlock Text="Walk Rate:" Classes="lbl"/>
            <NumericUpDown Value="{Binding WalkingRate}" Minimum="0" Maximum="255" Width="100"/>
          </StackPanel>
          <!-- Form Data (Shellos, Gastrodon, Unown table) -->
          <GroupBox DockPanel.Dock="Bottom" Header="Form Data" Margin="0,8,0,0" Padding="8,4,8,8">
            <Grid ColumnDefinitions="Auto,8,160,24,Auto,8,160,24,Auto,8,200">
              <TextBlock Grid.Column="0" Text="Shellos Form:" Classes="lbl"/>
              <controls:FusionAutoCompleteBox Grid.Column="2" ItemsSource="{Binding ShellosFormNames}" SelectedIndex="{Binding ShellosFormIndex}" MinWidth="140"/>
              <TextBlock Grid.Column="4" Text="Gastrodon Form:" Classes="lbl"/>
              <controls:FusionAutoCompleteBox Grid.Column="6" ItemsSource="{Binding ShellosFormNames}" SelectedIndex="{Binding GastrodonFormIndex}" MinWidth="140"/>
              <TextBlock Grid.Column="8" Text="Unown Table:" Classes="lbl"/>
              <controls:FusionAutoCompleteBox Grid.Column="10" ItemsSource="{Binding UnownTableNames}" SelectedIndex="{Binding UnownTableIndex}" MinWidth="160"/>
            </Grid>
          </GroupBox>
          <DataGrid ItemsSource="{Binding WalkingRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Chance" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
              <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
              <DataGridTemplateColumn Header="Level" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <NumericUpDown Value="{Binding Level}" Minimum="1" Maximum="100"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <!-- Time / Swarm / Radar -->
      <TabItem Header="Time / Special">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="8">
            <GroupBox Header="Day Encounters">
              <DataGrid ItemsSource="{Binding DayRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="Night Encounters">
              <DataGrid ItemsSource="{Binding NightRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="Swarm Encounters">
              <DataGrid ItemsSource="{Binding SwarmRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="PokeRadar">
              <DataGrid ItemsSource="{Binding RadarRows}" AutoGenerateColumns="False" CanUserResizeColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Dual Slot -->
      <TabItem Header="Dual Slot">
        <ScrollViewer>
          <StackPanel Spacing="8" Margin="8">
            <GroupBox Header="Ruby">
              <DataGrid ItemsSource="{Binding RubyRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="Sapphire">
              <DataGrid ItemsSource="{Binding SapphireRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="Emerald">
              <DataGrid ItemsSource="{Binding EmeraldRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="FireRed">
              <DataGrid ItemsSource="{Binding FireRedRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Header="LeafGreen">
              <DataGrid ItemsSource="{Binding LeafGreenRows}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="60" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Water -->
      <TabItem Header="Water">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
            <TextBlock Text="Surf Rate:"      Classes="lbl"/>
            <NumericUpDown Value="{Binding SurfRate}"     Minimum="0" Maximum="255" Width="100"/>
            <TextBlock Text="Old Rod Rate:"   Classes="lbl"/>
            <NumericUpDown Value="{Binding OldRodRate}"   Minimum="0" Maximum="255" Width="100"/>
            <TextBlock Text="Good Rod Rate:"  Classes="lbl"/>
            <NumericUpDown Value="{Binding GoodRodRate}"  Minimum="0" Maximum="255" Width="100"/>
            <TextBlock Text="Super Rod Rate:" Classes="lbl"/>
            <NumericUpDown Value="{Binding SuperRodRate}" Minimum="0" Maximum="255" Width="100"/>
          </StackPanel>
          <ScrollViewer>
            <StackPanel Spacing="8">
              <GroupBox Header="Surf">
                <DataGrid ItemsSource="{Binding SurfRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
              <GroupBox Header="Old Rod">
                <DataGrid ItemsSource="{Binding OldRodRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
              <GroupBox Header="Good Rod">
                <DataGrid ItemsSource="{Binding GoodRodRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
              <GroupBox Header="Super Rod">
                <DataGrid ItemsSource="{Binding SuperRodRows}" AutoGenerateColumns="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Label}" Width="80" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="Pokemon" Width="*" CellTemplate="{StaticResource PokemonEncounterCellTemplate}"/>
                    <DataGridTemplateColumn Header="Min Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MinLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Max Lv" Width="110">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><NumericUpDown Value="{Binding MaxLevel}" Minimum="1" Maximum="100"/></DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
