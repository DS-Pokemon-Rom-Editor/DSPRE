<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
        x:Class="DSPRE.Avalonia.Views.Pokemon.SpriteExportWizardView"
        x:DataType="vm:SpriteExportWizardViewModel"
        Title="Export Wizard"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="18" Spacing="14">

    <TextBlock Text="Pick anything to include, then export it all as one zip." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Select All" Click="SelectAll_Click"/>
      <Button Content="Select None" Click="SelectNone_Click"/>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Individual Sprites" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding IndividualSprites}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" MinWidth="170" Margin="0,2"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="Sprite Sheets" FontWeight="SemiBold"/>
      <ItemsControl ItemsSource="{Binding SpriteSheets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" MinWidth="170" Margin="0,2"/>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <TextBlock Text="{Binding StatusText}" FontStyle="Italic" TextWrapping="Wrap"
               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Close" Click="Close_Click"/>
      <Button Content="Export as ZIP" Click="Run_Click" IsDefault="True" FontWeight="SemiBold"/>
    </StackPanel>
  </StackPanel>
</Window>
