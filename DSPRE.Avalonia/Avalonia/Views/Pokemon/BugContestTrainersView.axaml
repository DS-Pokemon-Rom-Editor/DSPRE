<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             x:Class="DSPRE.Avalonia.Views.Pokemon.BugContestTrainersView"
             x:DataType="vm:BugContestTrainersViewModel">
  <Design.DataContext>
    <vm:BugContestTrainersViewModel/>
  </Design.DataContext>

  <Grid>
    <TextBlock IsVisible="{Binding !IsAvailable}" Text="{Binding Unavailable}" Margin="16" TextWrapping="Wrap"/>

    <DockPanel IsVisible="{Binding IsAvailable}">
      <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="0,0,0,1" Padding="6,4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Save"   Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
          <Button Content="Discard" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
          <Button Content="Locate" Click="Locate_Click"/>
        </StackPanel>
      </Border>

      <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,8" Spacing="4">
        <TextBlock Text="{Binding Problems}" IsVisible="{Binding HasProblems}" Foreground="{DynamicResource Editor.Bad}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Warnings}" IsVisible="{Binding HasWarnings}" Foreground="{DynamicResource Editor.Warn}" TextWrapping="Wrap"/>
      </StackPanel>

      <Grid ColumnDefinitions="140,*" Margin="8">
        <ListBox Grid.Column="0" ItemsSource="{Binding OpponentNames}" SelectedIndex="{Binding SelectedOpponent}" Margin="0,0,8,0"/>

        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="24,170,120,150,90,90,*">
              <TextBlock Grid.Column="1" Text="Pokémon" FontWeight="Bold"/>
              <TextBlock Grid.Column="2" Text="Day" FontWeight="Bold"/>
              <TextBlock Grid.Column="3" Text="Offered" FontWeight="Bold"/>
              <TextBlock Grid.Column="4" Text="Score" FontWeight="Bold"/>
              <TextBlock Grid.Column="5" Text="Variation" FontWeight="Bold"/>
              <TextBlock Grid.Column="6" Text="Scores" FontWeight="Bold" Margin="6,0,0,0"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BugContestTrainersViewModel+RowViewModel">
                  <Grid ColumnDefinitions="24,170,120,150,90,90,*" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center"/>
                    <controls:FusionAutoCompleteBox AllowsNone="False" Grid.Column="1" Margin="0,0,4,0"
                              ItemsSource="{Binding $parent[ItemsControl].((vm:BugContestTrainersViewModel)DataContext).SpeciesNames}"
                              SelectedIndex="{Binding SpeciesIndex}"/>
                    <ComboBox Grid.Column="2" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding $parent[ItemsControl].((vm:BugContestTrainersViewModel)DataContext).DayOptions}"
                              SelectedIndex="{Binding DayIndex}"/>
                    <ComboBox Grid.Column="3" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding $parent[ItemsControl].((vm:BugContestTrainersViewModel)DataContext).DexOptions}"
                              SelectedIndex="{Binding DexIndex}"/>
                    <NumericUpDown Grid.Column="4" Margin="0,0,4,0" Value="{Binding Score}" Minimum="0" Maximum="65535" Increment="10" FormatString="0"/>
                    <NumericUpDown Grid.Column="5" Margin="0,0,4,0" Value="{Binding Variation}" Minimum="0" Maximum="65535" Increment="5" FormatString="0"/>
                    <TextBlock Grid.Column="6" Text="{Binding Range}" VerticalAlignment="Center" Margin="6,0,0,0"
                               Foreground="{DynamicResource Editor.Subtle}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
