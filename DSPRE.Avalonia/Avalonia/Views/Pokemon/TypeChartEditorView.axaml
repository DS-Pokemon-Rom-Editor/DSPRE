<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
             x:Class="DSPRE.Avalonia.Views.Pokemon.TypeChartEditorView"
             x:DataType="vm:TypeChartEditorViewModel">
  <Design.DataContext>
    <vm:TypeChartEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <Button x:Name="MakeRoomButton" Content="Make room…" Click="MakeRoom_Click" IsVisible="{Binding CanMakeRoom}"
                ToolTip.Tip="{Binding MakeRoomTip}"/>
        <TextBlock Text="{Binding Room}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource Editor.Subtle}"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="8,4" Spacing="2">
      <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource Editor.Bad}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" Foreground="{DynamicResource Editor.Warn}" TextWrapping="Wrap"/>
    </StackPanel>

    <DockPanel x:Name="Host" Margin="8">
      <ScrollViewer x:Name="ChartScroll" DockPanel.Dock="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <LayoutTransformControl x:Name="ChartScale" HorizontalAlignment="Left" VerticalAlignment="Top">
          <Grid x:Name="Cells" Focusable="True" RenderOptions.BitmapInterpolationMode="None"/>
        </LayoutTransformControl>
      </ScrollViewer>

      <StackPanel x:Name="EditPanel" Margin="16,0,0,0" Spacing="8" Width="240" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Image Source="{Binding AttackerIcon}" Width="32" Height="16" IsVisible="{Binding AttackerIcon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <controls:IconImage Key="right" IsVisible="{Binding DefenderIcon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <Image Source="{Binding DefenderIcon}" Width="32" Height="16" IsVisible="{Binding DefenderIcon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>
        <TextBlock Text="{Binding SelectedTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <ComboBox ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedChoice}" HorizontalAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCustom}">
          <NumericUpDown Value="{Binding Multiplier}" Minimum="0" Maximum="25.5" Increment="0.1" FormatString="0.0" Width="110"/>
          <TextBlock Text="×" VerticalAlignment="Center"/>
        </StackPanel>
        <CheckBox Content="Foresight and Scrappy let it hit" IsChecked="{Binding Foresight}" IsEnabled="{Binding CanForesight}"/>

        <Border Height="1" Background="{DynamicResource Editor.Border}" Margin="0,6" IsVisible="{Binding HasSummary}"/>
        <ItemsControl ItemsSource="{Binding Summary}" IsVisible="{Binding HasSummary}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TypeChartEditorViewModel+SummaryLine">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1" RenderOptions.BitmapInterpolationMode="None">
                <Image Source="{Binding From}" Width="32" Height="16" IsVisible="{Binding FromHasIcon}" ToolTip.Tip="{Binding FromName}"/>
                <TextBlock Text="{Binding FromName}" IsVisible="{Binding !FromHasIcon}" VerticalAlignment="Center"/>
                <controls:IconImage Key="right"/>
                <Image Source="{Binding To}" Width="32" Height="16" IsVisible="{Binding ToHasIcon}" ToolTip.Tip="{Binding ToName}"/>
                <TextBlock Text="{Binding ToName}" IsVisible="{Binding !ToHasIcon}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Multiplier}" VerticalAlignment="Center" FontWeight="SemiBold"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DockPanel>
  </DockPanel>
</UserControl>
