<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
             x:Class="DSPRE.Avalonia.Views.Pokemon.GreatMarshEncounterView"
             x:DataType="vm:GreatMarshEncounterViewModel">
  <Design.DataContext>
    <vm:GreatMarshEncounterViewModel/>
  </Design.DataContext>

  <Grid>
    <TextBlock IsVisible="{Binding IsNotAvailable}" Margin="16"
               TextWrapping="Wrap"
               Text="Great Marsh encounters are not available for this ROM version."/>

    <DockPanel IsVisible="{Binding IsAvailable}">
      <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="0,0,0,1" Padding="6,4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Save"    Click="Save_Click"   IsEnabled="{Binding HasUnsavedChanges}"/>
          <Button Content="Export…" Click="Export_Click"/>
          <Button Content="Import…" Click="Import_Click"/>
          <Button Content="Locate"  Click="Locate_Click"/>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,220" Margin="8">
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock Text="Encounter List" FontWeight="Bold"/>
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding GroupNames}"
                      SelectedIndex="{Binding SelectedGroupIndex}"/>
            <TextBlock Text="{Binding GroupDescription}" Foreground="{DynamicResource Editor.Subtle}"
                       TextWrapping="Wrap" Margin="0,2,0,4"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding EncounterSlots}"
                   SelectedIndex="{Binding SelectedSlotIndex}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Image Width="32" Height="32" Source="{Binding Converter={x:Static controls:GameIconConverter.PokemonInLabel}}"/>
                  <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Species" FontWeight="Bold"/>
          <ComboBox controls:EditorLink.To="Pokemon" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SpeciesNames}"
                    SelectedIndex="{Binding SelectedSpeciesIndex}"/>
          <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                  Height="80" Width="80" HorizontalAlignment="Left">
            <Image Source="{Binding PokemonIcon}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="{Binding SlotInfoText}" Foreground="{DynamicResource Editor.Subtle}"/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
