<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
        x:Class="DSPRE.Avalonia.Views.Pokemon.DVCalcView"
        x:DataType="vm:DVCalcViewModel"
        Title="DV Calculator"
        Width="720" Height="500"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:DVCalcViewModel/>
  </Design.DataContext>

  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
      <TextBlock Text="{Binding TrainerLabel}" FontWeight="Bold"/>
      <TextBlock Text="{Binding ClassLabel}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
        <TextBlock Text="Trainer gender (for calc):" VerticalAlignment="Center"/>
        <RadioButton Content="Male"   GroupName="trg" IsChecked="{Binding MaleTrainer}"/>
        <RadioButton Content="Female" GroupName="trg" IsChecked="{Binding FemaleTrainer}"/>
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,8,0,0">
      <Button Content="Apply" Click="Apply_Click" IsDefault="True"/>
      <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
    </StackPanel>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Slots}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DVCalcSlotViewModel">
            <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,4" Background="{DynamicResource Editor.PanelBg}">
              <Grid ColumnDefinitions="180,110,110,80,60,*,Auto,Auto" >
                <TextBlock Grid.Column="0" Text="{Binding PokeLabel}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Margin="2" ItemsSource="{Binding GenderOptions}"  SelectedIndex="{Binding GenderIndex}"  IsEnabled="{Binding FlagsEditable}"/>
                <ComboBox Grid.Column="2" Margin="2" ItemsSource="{Binding AbilityOptions}" SelectedIndex="{Binding AbilityIndex}" IsEnabled="{Binding FlagsEditable}"/>
                <NumericUpDown Grid.Column="3" Margin="2" Minimum="0" Maximum="255" Increment="1" Value="{Binding DV}"/>
                <TextBlock Grid.Column="4" Text="{Binding IV}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding Nature}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <Button Grid.Column="6" Content="Change"   Click="Change_Click"  Margin="2"/>
                <Button Grid.Column="7" Content="Show All" Click="ShowAll_Click" Margin="2"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
