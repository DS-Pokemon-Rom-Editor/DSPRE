<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
             x:Class="DSPRE.Avalonia.Views.Pokemon.HoneyTreeEncounterView"
             x:DataType="vm:HoneyTreeEncounterViewModel">
  <Design.DataContext>
    <vm:HoneyTreeEncounterViewModel/>
  </Design.DataContext>

  <Grid>
    <!-- Not available message -->
    <TextBlock IsVisible="{Binding IsNotAvailable}" Margin="16"
               TextWrapping="Wrap"
               Text="Honey Tree encounters are not available for this ROM version."/>

    <!-- Main panel -->
    <DockPanel IsVisible="{Binding IsAvailable}">
      <!-- Toolbar -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="0,0,0,1" Padding="6,4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Save"    Click="Save_Click"   IsEnabled="{Binding HasUnsavedChanges}"/>
          <Button Content="Export…" Click="Export_Click"/>
          <Button Content="Import…" Click="Import_Click"/>
          <Button Content="Locate"  Click="Locate_Click"/>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,220" Margin="8">
        <!-- Left: group + slots -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock Text="Encounter Group" FontWeight="Bold"/>
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding GroupNames}"
                      SelectedIndex="{Binding SelectedGroupIndex}"/>
            <TextBlock Text="{Binding GroupDescription}" Foreground="{DynamicResource Editor.Subtle}"
                       TextWrapping="Wrap" Margin="0,2,0,4"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding EncounterSlots}"
                   SelectedIndex="{Binding SelectedSlotIndex}"/>
        </DockPanel>

        <!-- Right: species + icon -->
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Species" FontWeight="Bold"/>
          <ComboBox HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SpeciesNames}"
                    SelectedIndex="{Binding SelectedSpeciesIndex}"/>
          <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
                  Height="80" Width="80" HorizontalAlignment="Left">
            <Image Source="{Binding PokemonIcon}" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="{Binding EncounterRateText}" Foreground="{DynamicResource Editor.Subtle}"/>
        </StackPanel>
      </Grid>
    </DockPanel>
  </Grid>
</UserControl>
