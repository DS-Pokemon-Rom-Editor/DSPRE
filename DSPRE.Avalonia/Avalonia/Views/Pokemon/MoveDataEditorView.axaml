<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
		xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		x:Class="DSPRE.Avalonia.Views.Pokemon.MoveDataEditorView"
		x:DataType="vm:MoveDataEditorViewModel"
		Title="{Binding Title}"
		Width="820" Height="620"
		MinWidth="700" MinHeight="520"
		WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:MoveDataEditorViewModel/>
  </Design.DataContext>


  <Window.Styles>
	<Style Selector="TextBlock.label">
	  <Setter Property="VerticalAlignment" Value="Center"/>
	  <Setter Property="Margin" Value="0,0,6,0"/>
	</Style>
	<Style Selector="ComboBox">
	  <Setter Property="MinWidth" Value="160"/>
	</Style>
	<Style Selector="NumericUpDown">
	  <Setter Property="MinWidth" Value="90"/>
	</Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">
	<Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
			BorderThickness="0,0,0,1" Padding="6,4">
	  <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
		<Button Content="Save" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}" IsDefault="True"/>
		<Button Content="Discard" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<controls:UndoRedoButtons/>
		<TextBlock Text="Move:" VerticalAlignment="Center" Margin="12,0,0,0"/>
		<controls:FusionAutoCompleteBox x:Name="MovePicker" ItemsSource="{Binding MoveNames}"
					  SelectedIndex="{Binding SelectedMoveIndex}"
					  MinWidth="260"/>
		<Button x:Name="EditMoveScriptButton" Content="Edit move script" controls:Icon.Key="pencil" Click="EditMoveScript_Click"
				ToolTip.Tip="Open this move's battle script. Platinum and HGSS only."/>
		<Button Content="Export CSV" Click="Export_Click" Margin="12,0,0,0"/>
		<Button Content="Import CSV" Click="Import_Click"/>
		<Button Content="Add New Move…" controls:Icon.Key="addIcon" Click="AddMove_Click" IsVisible="{Binding ShowHgEngineBanner}"
				ToolTip.Tip="Add a new move to the hg-engine checkout"/>
	  </WrapPanel>
	</Border>

	<DockPanel LastChildFill="True" Margin="10">

	<Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,8" Background="#2D6A4F" IsVisible="{Binding ShowHgEngineBanner}">
	  <TextBlock Text="{Binding HgEngineBanner}" Foreground="White" FontSize="12"/>
	</Border>
	<Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,8" Background="#9B2226" IsVisible="{Binding HasSourceLoadError}">
	  <TextBlock Text="{Binding SourceLoadError, StringFormat='Saving is off: {0}'}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
	</Border>

	<TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
			   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

	<!-- Main editing area -->
	<Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,8,Auto,8,Auto,*">

	  <!-- ── Left column ── -->

	  <!-- Type / Split / Range -->
	  <GroupBox x:Name="PropertiesBox" Grid.Row="0" Grid.Column="0" Header="Move Properties">
		<Grid RowDefinitions="Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:"   Classes="label"/>
		  <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TypeNames}"
					 SelectedIndex="{Binding TypeIndex}"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Split:"  Classes="label"/>
		  <ComboBox  Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SplitNames}"
					 SelectedIndex="{Binding SplitIndex}"/>

		  <TextBlock Grid.Row="4" Grid.Column="0" Text="Range:"  Classes="label"/>
		  <ComboBox  Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RangeItems}"
					 SelectedIndex="{Binding RangeIndex}" MinWidth="220"/>
		</Grid>
	  </GroupBox>

	  <!-- Battle sequence -->
	  <GroupBox x:Name="EffectBox" Grid.Row="2" Grid.Column="0" Header="Battle Sequence (Effect)">
		<ComboBox ItemsSource="{Binding BattleSeqItems}"
				  SelectedIndex="{Binding BattleSeqIndex}"
				  HorizontalAlignment="Stretch" MinWidth="0"/>
	  </GroupBox>

	  <!-- Description -->
	  <GroupBox x:Name="DescriptionBox" Grid.Row="4" Grid.Column="0" Header="Description">
		<TextBox Text="{Binding Description}" IsReadOnly="True"
				 TextWrapping="Wrap" MinHeight="70" AcceptsReturn="True"/>
	  </GroupBox>

	  <!-- ── Right column ── -->

	  <!-- Numeric stats -->
	  <GroupBox x:Name="StatsBox" Grid.Row="0" Grid.Column="2" Header="Stats">
		<Grid RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Power:"           Classes="label"/>
		  <NumericUpDown Grid.Row="0" Grid.Column="1"
						 Value="{Binding Power}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Accuracy:"        Classes="label"/>
		  <NumericUpDown Grid.Row="2" Grid.Column="1"
						 Value="{Binding Accuracy}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="4" Grid.Column="0" Text="PP:"              Classes="label"/>
		  <NumericUpDown Grid.Row="4" Grid.Column="1"
						 Value="{Binding PP}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="6" Grid.Column="0" Text="Priority:"        Classes="label"/>
		  <NumericUpDown Grid.Row="6" Grid.Column="1"
						 Value="{Binding Priority}" Minimum="-128" Maximum="127" Increment="1"/>

		  <TextBlock Grid.Row="8" Grid.Column="0" Text="Effect %:"        Classes="label"/>
		  <NumericUpDown Grid.Row="8" Grid.Column="1"
						 Value="{Binding SideEffectPct}" Minimum="0" Maximum="255" Increment="1"/>
		</Grid>
	  </GroupBox>

	  <!-- Contest -->
	  <GroupBox x:Name="ContestBox" Grid.Row="2" Grid.Column="2" Header="Contest">
		<Grid RowDefinitions="Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Condition:" Classes="label"/>
		  <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ContestNames}"
					 SelectedIndex="{Binding ContestIndex}"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Appeal:"    Classes="label"/>
		  <NumericUpDown Grid.Row="2" Grid.Column="1"
						 Value="{Binding ContestAppeal}" Minimum="0" Maximum="255" Increment="1"/>
		</Grid>
	  </GroupBox>

	  <!-- Flags -->
	  <GroupBox x:Name="FlagsBox" Grid.Row="4" Grid.Column="2" Grid.RowSpan="2" Header="Flags">
		<ScrollViewer>
		  <ItemsControl ItemsSource="{Binding Flags}">
			<ItemsControl.ItemTemplate>
			  <DataTemplate>
				<CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet}" Margin="2"/>
			  </DataTemplate>
			</ItemsControl.ItemTemplate>
		  </ItemsControl>
		</ScrollViewer>
	  </GroupBox>

	</Grid>
	</DockPanel>
  </DockPanel>
</Window>
