<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Pokemon"
		xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
		x:Class="DSPRE.Avalonia.Views.Pokemon.MoveDataEditorView"
		x:DataType="vm:MoveDataEditorViewModel"
		Title="{Binding Title}"
		Width="980" Height="820"
		MinWidth="700" MinHeight="520"
		WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:MoveDataEditorViewModel/>
  </Design.DataContext>


  <Window.Styles>
	<Style Selector="TextBlock.label">
	  <Setter Property="VerticalAlignment" Value="Center"/>
	  <Setter Property="Margin" Value="0,0,6,0"/>
	</Style>
	<Style Selector="ComboBox">
	  <Setter Property="MinWidth" Value="160"/>
	</Style>
	<Style Selector="NumericUpDown">
	  <Setter Property="MinWidth" Value="90"/>
	</Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">
	<controls:EditorToolbar>
		<Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}" IsDefault="True"/>
		<Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
		<controls:UndoRedoButtons/>
		<TextBlock Text="Move:" VerticalAlignment="Center"/>
		<controls:IdNameSelector x:Name="MovePicker" Value="{Binding SelectedMoveIndex}" Maximum="{Binding MaxMoveIndex}" Names="{Binding MoveNames}" Width="380"/>
		<Button x:Name="EditMoveScriptButton" Content="Edit move script" controls:Icon.Key="pencil" Click="EditMoveScript_Click"
				ToolTip.Tip="Open this move's battle script. Platinum and HGSS only."/>
		<Button Content="Export CSV…" controls:Icon.Key="export" Click="Export_Click" Margin="12,0,0,0"/>
		<Button Content="Import CSV…" controls:Icon.Key="import" Click="Import_Click"/>
		<Button Content="Add new move…" controls:Icon.Key="addIcon" Click="AddMove_Click" IsVisible="{Binding ShowHgEngineBanner}"
				ToolTip.Tip="Add a new move to the hg-engine checkout"/>
	</controls:EditorToolbar>

	<DockPanel LastChildFill="True" Margin="10">

	<Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,8" Background="#2D6A4F" IsVisible="{Binding ShowHgEngineBanner}">
	  <TextBlock Text="{Binding HgEngineBanner}" Foreground="White" FontSize="12"/>
	</Border>
	<Border DockPanel.Dock="Top" Padding="8,3" Margin="0,0,0,8" Background="#9B2226" IsVisible="{Binding HasSourceLoadError}">
	  <TextBlock Text="{Binding SourceLoadError, StringFormat='Saving is off: {0}'}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
	</Border>

	<TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
			   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

	<!-- Main editing area -->
	<Grid ColumnDefinitions="*,10,*" RowDefinitions="Auto,8,Auto,8,*,8,Auto">

	  <!-- ── Left column ── -->

	  <!-- Type / Split / Range -->
	  <GroupBox x:Name="PropertiesBox" Grid.Row="0" Grid.Column="0" Header="Move properties">
		<Grid RowDefinitions="Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Type:"   Classes="label"/>
		  <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TypeNames}"
					 SelectedIndex="{Binding TypeIndex}"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Split:"  Classes="label"/>
		  <ComboBox  Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SplitNames}"
					 SelectedIndex="{Binding SplitIndex}"/>

		  <TextBlock Grid.Row="4" Grid.Column="0" Text="Range:"  Classes="label"/>
		  <ComboBox  Grid.Row="4" Grid.Column="1" ItemsSource="{Binding RangeItems}"
					 SelectedIndex="{Binding RangeIndex}" MinWidth="220"/>
		</Grid>
	  </GroupBox>

	  <!-- Battle sequence -->
	  <GroupBox x:Name="EffectBox" Grid.Row="2" Grid.Column="0" Header="Battle sequence (effect)">
		<ComboBox ItemsSource="{Binding BattleSeqItems}"
				  SelectedIndex="{Binding BattleSeqIndex}"
				  HorizontalAlignment="Stretch" VerticalAlignment="Top" MinWidth="0">
		  <!-- Realized all at once, so the open list is as wide as its longest entry instead of growing while scrolling. -->
		  <ComboBox.ItemsPanel>
			<ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
		  </ComboBox.ItemsPanel>
		</ComboBox>
	  </GroupBox>

	  <!-- Description -->
	  <GroupBox x:Name="DescriptionBox" Grid.Row="4" Grid.Column="0" Grid.RowSpan="3" Header="Description">
		<DockPanel>
		  <TabStrip DockPanel.Dock="Top" SelectedIndex="{Binding PreviewTab}">
			<TabStripItem Content="Summary"/>
			<TabStripItem Content="Battle"/>
			<TabStripItem Content="Relearner"/>
			<TabStripItem Content="{Binding BagLabel}" IsVisible="{Binding HasBag}"/>
		  </TabStrip>
		  <TextBlock DockPanel.Dock="Bottom" Text="{Binding DescriptionWarning}" IsVisible="{Binding HasDescriptionWarning}"
					 Foreground="{DynamicResource Editor.Warn}" FontSize="12" Margin="0,4,0,0"/>
		  <TextBlock DockPanel.Dock="Bottom" Text="{Binding BagWarning}" IsVisible="{Binding HasBagWarning}"
					 Foreground="{DynamicResource Editor.Warn}" FontSize="12" Margin="0,4,0,0"/>
		  <Panel DockPanel.Dock="Bottom" Margin="0,6,0,0">
			<TextBox Text="{Binding Description}" IsReadOnly="{Binding DescriptionReadOnly}" IsVisible="{Binding !IsBagTab}"
					 ToolTip.Tip="{Binding DescriptionReadOnlyReason}"
					 AcceptsReturn="True" TextWrapping="NoWrap" Height="96"/>
			<TextBox Text="{Binding BagText}" IsReadOnly="{Binding BagReadOnly}" IsVisible="{Binding IsBagTab}"
					 AcceptsReturn="True" TextWrapping="NoWrap" Height="64"/>
		  </Panel>
		  <Viewbox Stretch="Uniform" MaxHeight="288" Margin="0,6,0,0">
			<Image Source="{Binding Preview}" Width="256" Height="192" RenderOptions.BitmapInterpolationMode="None"/>
		  </Viewbox>
		</DockPanel>
	  </GroupBox>

	  <!-- ── Right column ── -->

	  <!-- Numeric stats -->
	  <GroupBox x:Name="StatsBox" Grid.Row="0" Grid.Column="2" Header="Stats">
		<Grid RowDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Power:"           Classes="label"/>
		  <NumericUpDown Grid.Row="0" Grid.Column="1"
						 Value="{Binding Power}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Accuracy:"        Classes="label"/>
		  <NumericUpDown Grid.Row="2" Grid.Column="1"
						 Value="{Binding Accuracy}" Minimum="0" Maximum="{Binding AccuracyMax}" Increment="1"/>

		  <TextBlock Grid.Row="4" Grid.Column="0" Text="PP:"              Classes="label"/>
		  <NumericUpDown Grid.Row="4" Grid.Column="1"
						 Value="{Binding PP}" Minimum="0" Maximum="255" Increment="1"/>

		  <TextBlock Grid.Row="6" Grid.Column="0" Text="Priority:"        Classes="label"/>
		  <NumericUpDown Grid.Row="6" Grid.Column="1"
						 Value="{Binding Priority}" Minimum="{Binding PriorityMin}" Maximum="{Binding PriorityMax}" Increment="1"/>

		  <TextBlock Grid.Row="8" Grid.Column="0" Text="Effect %:"        Classes="label"/>
		  <NumericUpDown Grid.Row="8" Grid.Column="1"
						 Value="{Binding SideEffectPct}" Minimum="0" Maximum="{Binding SideEffectMax}" Increment="1"/>
		</Grid>
	  </GroupBox>

	  <!-- Contest -->
	  <GroupBox x:Name="ContestBox" Grid.Row="2" Grid.Column="2" Header="Contest">
		<Grid RowDefinitions="Auto,8,Auto,8,Auto" ColumnDefinitions="Auto,*">

		  <TextBlock Grid.Row="0" Grid.Column="0" Text="Condition:" Classes="label"/>
		  <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding ContestNames}"
					 SelectedIndex="{Binding ContestIndex}"/>

		  <TextBlock Grid.Row="2" Grid.Column="0" Text="Effect:"    Classes="label" IsVisible="{Binding HasContestEffects}"/>
		  <ComboBox  Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ContestEffectNames}"
					 SelectedIndex="{Binding ContestAppeal}" HorizontalAlignment="Stretch" IsVisible="{Binding HasContestEffects}"/>

		  <TextBlock Grid.Row="4" Grid.Column="0" Text="Hearts:"    Classes="label" IsVisible="{Binding HasContestEffects}"/>
		  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ContestHearts}" VerticalAlignment="Center" IsVisible="{Binding HasContestEffects}"/>
		</Grid>
	  </GroupBox>

	  <!-- Lists the battle code keeps per ability -->
	  <GroupBox x:Name="AbilityBox" Grid.Row="6" Grid.Column="2" Header="Ability based">
		<StackPanel Spacing="2">
		  <StackPanel.Styles>
			<Style Selector="Button.link">
			  <Setter Property="Background" Value="Transparent"/>
			  <Setter Property="BorderThickness" Value="0"/>
			  <Setter Property="Padding" Value="0"/>
			  <Setter Property="FontSize" Value="11"/>
			  <Setter Property="Cursor" Value="Hand"/>
			  <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
			</Style>
			<Style Selector="Button.manage">
			  <Setter Property="Padding" Value="6,1"/>
			  <Setter Property="FontSize" Value="11"/>
			  <Setter Property="VerticalAlignment" Value="Center"/>
			</Style>
		  </StackPanel.Styles>
		  <DockPanel>
			<Button DockPanel.Dock="Right" Classes="manage" Content="Manage" Tag="Punching" Click="ManageList_Click" IsEnabled="{Binding HasPunchingList}"
					ToolTip.Tip="Every move on the punching list"/>
			<CheckBox Content="Punching (Iron Fist)" IsChecked="{Binding IsPunching}" IsEnabled="{Binding HasPunchingList}" Margin="2,0"/>
		  </DockPanel>
		  <TextBlock Text="{Binding PunchingNote}" IsVisible="{Binding HasPunchingList}" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,0"
					 Foreground="{DynamicResource Editor.Subtle}"/>
		  <Button Classes="link" Content="Guide on the DS Pokémon Hacking wiki" Tag="Punching" Click="Guide_Click" IsVisible="{Binding HasPunchingList}" Margin="26,0,0,4"/>
		  <DockPanel>
			<Button DockPanel.Dock="Right" Classes="manage" Content="Manage" Tag="Sound" Click="ManageList_Click" IsEnabled="{Binding HasSoundList}"
					ToolTip.Tip="Every move on the sound list"/>
			<CheckBox Content="Sound (Soundproof)" IsChecked="{Binding IsSound}" IsEnabled="{Binding HasSoundList}" Margin="2,0"/>
		  </DockPanel>
		  <TextBlock Text="{Binding SoundNote}" IsVisible="{Binding HasSoundList}" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,0"
					 Foreground="{DynamicResource Editor.Subtle}"/>
		  <Button Classes="link" Content="Guide on the DS Pokémon Hacking wiki" Tag="Sound" Click="Guide_Click" IsVisible="{Binding HasSoundList}" Margin="26,0,0,0"/>
		  <TextBlock Text="{Binding AbilityWhyNot}" IsVisible="{Binding HasAbilityWhyNot}" FontSize="11" TextWrapping="Wrap" Margin="2,0"
					 Foreground="{DynamicResource Editor.Subtle}"/>
		</StackPanel>
	  </GroupBox>

	  <!-- Flags -->
	  <GroupBox x:Name="FlagsBox" Grid.Row="4" Grid.Column="2" Header="Flags">
		<ScrollViewer>
		  <ItemsControl ItemsSource="{Binding Flags}">
			<ItemsControl.ItemTemplate>
			  <DataTemplate>
				<CheckBox Content="{Binding Name}" IsChecked="{Binding IsSet}" Margin="2"/>
			  </DataTemplate>
			</ItemsControl.ItemTemplate>
		  </ItemsControl>
		</ScrollViewer>
	  </GroupBox>

	</Grid>
	</DockPanel>
  </DockPanel>
</Window>
