<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Battle"
             xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Battle"
             x:Class="DSPRE.Avalonia.Views.Battle.BattleDisplayEditorView"
             x:DataType="vm:BattleDisplayEditorViewModel">
  <Design.DataContext>
    <vm:BattleDisplayEditorViewModel/>
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBlock.frame-note"><Setter Property="Foreground" Value="#C9A227"/></Style>
    <Style Selector="TextBlock.frame-note.severe"><Setter Property="Foreground" Value="#DC2626"/></Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="14" Spacing="12" HorizontalAlignment="Left">

      <!-- Shown only when the loaded ROM isn't a supported version. -->
      <Border IsVisible="{Binding !IsAvailable}" Padding="10" CornerRadius="4"
              Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
        <TextBlock Text="{Binding UnavailableText}" TextWrapping="Wrap" Foreground="OrangeRed"/>
      </Border>

      <Grid IsEnabled="{Binding IsAvailable}" IsVisible="{Binding IsAvailable}" ColumnDefinitions="Auto,24,*">

        <!-- LEFT COLUMN: live battle preview (this Pokémon vs itself; enemy = front, player = back). -->
        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Top">
          <TextBlock Text="Battle preview (this Pokémon vs itself)" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <CheckBox Content="Show both genders" IsChecked="{Binding UnifiedDisplay}" IsVisible="{Binding HasGenderChoice}"
                      ToolTip.Tip="Show Male and Female battle scenes side by side."/>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !UnifiedDisplay}">
              <TextBlock Text="Gender" VerticalAlignment="Center" IsVisible="{Binding HasGenderChoice}"/>
              <ComboBox ItemsSource="{Binding Genders}" SelectedIndex="{Binding GenderIndex}" Width="100"
                        IsVisible="{Binding HasGenderChoice}"
                        ToolTip.Tip="Which gender's sprites to show."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Frame rate" VerticalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedIndex="{Binding FrameRateIndex}" Width="100"
                        ToolTip.Tip="Battles run at 30 fps. Preview only."/>
            </StackPanel>
          </StackPanel>

          <!-- hg-engine form picker: forms get their own full SpriteOffsets.c entry (Positioning/Frames/
               Animation only); graphics stay keyed to the base species, shown above. -->
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasForms}">
            <TextBlock Text="Form (hg-engine)" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding FormOptions}" SelectedIndex="{Binding SelectedFormIndex}" Width="200"
                      ToolTip.Tip="Which form's Positioning/Frames/Animation data (data/SpriteOffsets.c) to view and edit.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BattleDisplayEditorViewModel+FormOption">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Arena type" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding ArenaTypeNames}" SelectedIndex="{Binding ArenaTypeIndex}" Width="110"
                      ToolTip.Tip="Swaps the preview's backdrop and ground platforms for the real in-game terrain (falls back to placeholder art if unavailable)."/>
          </StackPanel>

          <!-- Separate display: one scene of the selected gender. -->
          <StackPanel Spacing="2" IsVisible="{Binding !UnifiedDisplay}">
            <views:BattleSceneControl Width="512" Height="384" HorizontalAlignment="Left"
                                      Enemy="{Binding EnemySprite}" Player="{Binding PlayerSprite}"
                                      EnemyY="{Binding EnemyTop}" PlayerY="{Binding PlayerTop}"/>
            <TextBlock Classes="frame-note" IsVisible="{Binding EnemyFrameWarning}" Classes.severe="{Binding EnemyFrameWarningSevere}" FontSize="10" TextWrapping="Wrap"
                       Text="{Binding EnemyFrameWarningText, StringFormat='Enemy: {0}'}"/>
            <TextBlock Classes="frame-note" IsVisible="{Binding PlayerFrameWarning}" Classes.severe="{Binding PlayerFrameWarningSevere}" FontSize="10" TextWrapping="Wrap"
                       Text="{Binding PlayerFrameWarningText, StringFormat='Player: {0}'}"/>
          </StackPanel>

          <!-- Unified display: Male + Female scenes side by side. -->
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding UnifiedDisplay}">
            <StackPanel Spacing="2">
              <TextBlock Text="Male" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" HorizontalAlignment="Center"/>
              <views:BattleSceneControl Width="256" Height="192" Enemy="{Binding EnemySpriteM}" Player="{Binding PlayerSpriteM}"
                                        EnemyY="{Binding EnemyTopM}" PlayerY="{Binding PlayerTopM}"/>
              <TextBlock Classes="frame-note" IsVisible="{Binding EnemyFrameWarningM}" Classes.severe="{Binding EnemyFrameWarningSevereM}" FontSize="9" TextWrapping="Wrap"
                         Text="{Binding EnemyFrameWarningTextM, StringFormat='Enemy: {0}'}"/>
              <TextBlock Classes="frame-note" IsVisible="{Binding PlayerFrameWarningM}" Classes.severe="{Binding PlayerFrameWarningSevereM}" FontSize="9" TextWrapping="Wrap"
                         Text="{Binding PlayerFrameWarningTextM, StringFormat='Player: {0}'}"/>
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock Text="Female" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" HorizontalAlignment="Center"/>
              <views:BattleSceneControl Width="256" Height="192" Enemy="{Binding EnemySpriteF}" Player="{Binding PlayerSpriteF}"
                                        EnemyY="{Binding EnemyTopF}" PlayerY="{Binding PlayerTopF}"/>
              <TextBlock Classes="frame-note" IsVisible="{Binding EnemyFrameWarningF}" Classes.severe="{Binding EnemyFrameWarningSevereF}" FontSize="9" TextWrapping="Wrap"
                         Text="{Binding EnemyFrameWarningTextF, StringFormat='Enemy: {0}'}"/>
              <TextBlock Classes="frame-note" IsVisible="{Binding PlayerFrameWarningF}" Classes.severe="{Binding PlayerFrameWarningSevereF}" FontSize="9" TextWrapping="Wrap"
                         Text="{Binding PlayerFrameWarningTextF, StringFormat='Player: {0}'}"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="Battle-scene assets: PokEditor (turtleisaac)."
                     FontSize="12" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap" MaxWidth="540"/>
        </StackPanel>

        <!-- RIGHT COLUMN: the editable fields. -->
        <StackPanel Grid.Column="2" Spacing="14" VerticalAlignment="Top" MinWidth="320">

          <!-- Party icon palette + graphic -->
          <StackPanel Spacing="4">
            <TextBlock Text="Party Icon" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <ComboBox ItemsSource="{Binding PartyPalettes}" SelectedIndex="{Binding PartyPaletteIndex}" Width="160" VerticalAlignment="Center"
                        ToolTip.Tip="Which of the 3 icon palettes the party icon uses."/>
              <StackPanel Spacing="4" VerticalAlignment="Center">
                <Border Width="68" Height="68" Background="#E0E0E0" CornerRadius="4" Padding="2"
                        ToolTip.Tip="Live preview with the selected palette (before saving)">
                  <Image Source="{Binding IconPreview}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/>
                </Border>
                <ComboBox SelectedIndex="{Binding IconFrame}" Width="86" FontSize="11"
                          HorizontalAlignment="Center" IsVisible="{Binding ShowIconFrames}"
                          ToolTip.Tip="Which of the icon's animation frames to preview">
                  <ComboBoxItem Content="Frame 1"/>
                  <ComboBoxItem Content="Frame 2"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="6" VerticalAlignment="Center">
                <Button Content="Import PNG…" Click="ImportIcon_Click" Width="110"
                        ToolTip.Tip="Replace the icon graphic. Must match the icon's exact pixel size; colors are matched to the palette selected above (pixels below 50% alpha become transparent)."/>
                <Button Content="Export PNG…" Click="ExportIcon_Click" Width="110"/>
                <CheckBox Content="Full palette" IsChecked="{Binding FullPaletteExport}"
                          ToolTip.Tip="Export as a real indexed PNG with the icon's 16-color palette embedded, instead of flattening it to plain RGBA"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Separator/>

          <!-- Battle sprite & shadow data -->
          <StackPanel Spacing="6">
            <TextBlock Text="Battle Sprite &amp; Shadow" FontWeight="SemiBold"/>
            <TextBlock Text="This Pokémon has no battle-sprite record." IsVisible="{Binding !HasSpriteData}"
                       FontSize="12" FontStyle="Italic" Foreground="{DynamicResource Editor.Subtle}"/>

            <!-- Send-out preview controls. -->
            <StackPanel Spacing="6" IsVisible="{Binding HasSpriteData}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding SendOutButtonText}" Click="PlaySendOut_Click" IsEnabled="{Binding CanPlay}" MinWidth="112"
                        ToolTip.Tip="Plays the start of the battle on the game's timing."/>
                <ComboBox ItemsSource="{Binding SendOutKindOptions}" SelectedIndex="{Binding SendOutKindIndex}" Width="112"/>
                <ComboBox ItemsSource="{Binding SideOptions}" SelectedIndex="{Binding SideIndex}" Width="112"
                          ToolTip.Tip="Whose Pokémon comes out."/>
                <ToggleButton Content="Advanced options" IsChecked="{Binding AdvancedOpen}"/>
              </StackPanel>

              <Border IsVisible="{Binding AdvancedOpen}" Padding="10" CornerRadius="4"
                      BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,10,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Trainer" VerticalAlignment="Center" IsEnabled="{Binding CanChooseTrainer}"/>
                  <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding TrainerOptions}" SelectedIndex="{Binding TrainerIndex}"
                            IsEnabled="{Binding CanChooseTrainer}" HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                            ToolTip.Tip="Sets the sprite and the name in messages."/>

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Ball" VerticalAlignment="Center" IsEnabled="{Binding BallMatters}"/>
                  <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding BallOptions}" SelectedIndex="{Binding BallIndex}"
                            IsEnabled="{Binding BallMatters}" HorizontalAlignment="Stretch"
                            ToolTip.Tip="Sets the burst and the colour the Pokémon comes out in."/>

                  <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Content="Play the trainer intro" IsChecked="{Binding PlayTrainerIntro}"
                            IsEnabled="{Binding CanChooseIntro}"
                            ToolTip.Tip="Off plays a mid-battle send-out."/>
                  <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Content="Their Pokémon slides in like a wild one" IsChecked="{Binding TrainerSlideIn}"
                            IsEnabled="{Binding CanSlideIn}"/>
                  <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                    <CheckBox Content="Party balls" IsChecked="{Binding ShowPartyBalls}" IsEnabled="{Binding CanShowPartyBalls}" VerticalAlignment="Center"
                              ToolTip.Tip="Trainer battles only."/>
                    <NumericUpDown Value="{Binding PartyBallCount}" Minimum="1" Maximum="6" Increment="1" FormatString="0" Width="110"
                                   IsEnabled="{Binding CanCountPartyBalls}"
                                   ToolTip.Tip="Filled slots; the rest show empty."/>
                  </StackPanel>
                  <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Content="Shiny" IsChecked="{Binding IsShiny}"
                            ToolTip.Tip="Shiny colours and sparkle."/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="Text speed" VerticalAlignment="Center"/>
                  <ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding TextSpeedOptions}" SelectedIndex="{Binding TextSpeedIndex}" Width="140" HorizontalAlignment="Left"
                            ToolTip.Tip="The in-game text speed option."/>
                  <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="12">
                    <CheckBox Content="Battle music" IsChecked="{Binding PlayBattleMusic}" VerticalAlignment="Center"
                              ToolTip.Tip="Its class or species theme, else the standard one."/>
                    <CheckBox Content="In Kanto" IsChecked="{Binding KantoMusic}" IsVisible="{Binding ShowKantoMusic}" IsEnabled="{Binding PlayBattleMusic}"
                              VerticalAlignment="Center" ToolTip.Tip="The standard themes play their Kanto versions."/>
                    <TextBlock Text="{Binding BattleMusicText}" IsVisible="{Binding PlayBattleMusic}" VerticalAlignment="Center" Opacity="0.7"/>
                  </StackPanel>
                  <TextBlock Grid.Row="8" Grid.Column="0" Text="Nature" VerticalAlignment="Center" IsVisible="{Binding CanPickNature}"/>
                  <ComboBox Grid.Row="8" Grid.Column="2" ItemsSource="{Binding NatureOptions}" SelectedIndex="{Binding NatureIndex}" Width="140" HorizontalAlignment="Left"
                            IsVisible="{Binding CanPickNature}" MaxDropDownHeight="360"
                            ToolTip.Tip="Picks the back animation."/>
                </Grid>
              </Border>
            </StackPanel>

            <TabControl IsVisible="{Binding HasSpriteData}">

              <!-- ── Positioning ─────────────────────────────────────────────────────────── -->
              <TabItem Header="Positioning">
                <StackPanel Spacing="6" Margin="0,8,0,0">
                  <Grid ColumnDefinitions="160,10,150">
                    <TextBlock Grid.Column="0" Text="Front Y offset" VerticalAlignment="Center"
                               ToolTip.Tip="Signed nudge to the front sprite (positive = up, negative = down). −128…127."/>
                    <NumericUpDown Grid.Column="2" Value="{Binding SpriteY}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                  </Grid>

                  <!-- Per-gender sprite heights (DP / Platinum, height.narc). Signed. Hidden while viewing a form. -->
                  <StackPanel IsVisible="{Binding ShowBaseHeights}" Spacing="6">
                    <CheckBox Content="Edit both genders together" IsChecked="{Binding UnifiedEdit}"
                              ToolTip.Tip="One field per axis writes both ♂ and ♀. Off edits each gender separately."/>

                    <!-- Unified edit: one field per axis, writes both genders. -->
                    <StackPanel IsVisible="{Binding UnifiedEdit}" Spacing="6">
                      <Grid ColumnDefinitions="160,10,150">
                        <TextBlock Grid.Column="0" Text="Front height" VerticalAlignment="Center"
                                   ToolTip.Tip="Front-sprite height (both genders). ½ the distance from the sprite's bottom to the image's bottom. Signed −128…127."/>
                        <NumericUpDown Grid.Column="2" Value="{Binding FrontHeightUnified}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                      </Grid>
                      <Grid ColumnDefinitions="160,10,150">
                        <TextBlock Grid.Column="0" Text="Back height" VerticalAlignment="Center"
                                   ToolTip.Tip="Back-sprite height (both genders). Signed −128…127."/>
                        <NumericUpDown Grid.Column="2" Value="{Binding BackHeightUnified}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                      </Grid>
                    </StackPanel>

                    <!-- Separate edit: the 4 per-gender fields. -->
                    <StackPanel IsVisible="{Binding !UnifiedEdit}" Spacing="6">
                      <Grid ColumnDefinitions="160,10,150">
                        <TextBlock Grid.Column="0" Text="Front height ♂" VerticalAlignment="Center"
                                   ToolTip.Tip="Front-sprite height (male). ½ the distance from the sprite's bottom to the image's bottom. Signed −128…127."/>
                        <NumericUpDown Grid.Column="2" Value="{Binding FrontHeightM}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                      </Grid>
                      <Grid ColumnDefinitions="160,10,150">
                        <TextBlock Grid.Column="0" Text="Front height ♀" VerticalAlignment="Center"
                                   ToolTip.Tip="Front-sprite height (female). Signed −128…127."/>
                        <NumericUpDown Grid.Column="2" Value="{Binding FrontHeightF}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                      </Grid>
                      <Grid ColumnDefinitions="160,10,150">
                        <TextBlock Grid.Column="0" Text="Back height ♂" VerticalAlignment="Center"
                                   ToolTip.Tip="Back-sprite height (male). Signed −128…127."/>
                        <NumericUpDown Grid.Column="2" Value="{Binding BackHeightM}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                      </Grid>
                      <Grid ColumnDefinitions="160,10,150">
                        <TextBlock Grid.Column="0" Text="Back height ♀" VerticalAlignment="Center"
                                   ToolTip.Tip="Back-sprite height (female). Signed −128…127."/>
                        <NumericUpDown Grid.Column="2" Value="{Binding BackHeightF}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                      </Grid>
                    </StackPanel>
                  </StackPanel>

                  <!-- Alternate-form sprite heights (height_o.narc; DP/Plat vanilla-only, unrelated to the hg-engine
                       form picker above), shown while a form is selected in the Sprites tab. -->
                  <StackPanel IsVisible="{Binding HasFormHeights}" Spacing="6">
                    <TextBlock Text="Alternate-form sprite height" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="160,10,150">
                      <TextBlock Grid.Column="0" Text="Front height" VerticalAlignment="Center"
                                 ToolTip.Tip="Front-sprite height for the alternate form selected in the Sprites tab (both genders). Signed −128…127."/>
                      <NumericUpDown Grid.Column="2" Value="{Binding FormFrontHeight}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                    </Grid>
                    <Grid ColumnDefinitions="160,10,150">
                      <TextBlock Grid.Column="0" Text="Back height" VerticalAlignment="Center"
                                 ToolTip.Tip="Back-sprite height for the alternate form (both genders). Signed −128…127."/>
                      <NumericUpDown Grid.Column="2" Value="{Binding FormBackHeight}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                    </Grid>
                    <TextBlock Text="From height_o.narc, for the form chosen in the Sprites tab. Both genders share these."
                               FontSize="12" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="160,10,150">
                    <TextBlock Grid.Column="0" Text="Shadow X position" VerticalAlignment="Center"
                               ToolTip.Tip="Moves the shadow right (positive) or left (negative). Signed −128…127."/>
                    <NumericUpDown Grid.Column="2" Value="{Binding ShadowX}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                  </Grid>

                  <Grid ColumnDefinitions="160,10,150">
                    <TextBlock Grid.Column="0" Text="Shadow size" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ShadowSizes}" SelectedIndex="{Binding ShadowSize}" HorizontalAlignment="Stretch"/>
                  </Grid>

                </StackPanel>
              </TabItem>

              <!-- ── Frames ──────────────────────────────────────────────────────────────── -->
              <TabItem Header="Frames">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding FramesButtonText}" Click="PlayFrames_Click" IsEnabled="{Binding CanPlay}" MinWidth="130"
                            ToolTip.Tip="Plays the frame runs once."/>
                    <ComboBox ItemsSource="{Binding SideOptions}" SelectedIndex="{Binding SideIndex}" Width="130"/>
                  </StackPanel>

                  <!-- Platinum, HGSS and hg-engine: 10 fixed slots each. -->
                  <StackPanel IsVisible="{Binding HasFrameRuns}" Spacing="8">
                    <TextBlock Text="Front frames" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding FrontFrameEntries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpriteFrameEntry">
                          <Grid ColumnDefinitions="Auto,60,Auto,50,Auto,60,Auto,60" Margin="0,0,0,4" ColumnSpacing="4">
                            <TextBlock Grid.Column="0" Text="Frame" VerticalAlignment="Center" ToolTip.Tip="Sprite frame to show. -1 ends the run; below -1 repeats an earlier slot."/>
                            <NumericUpDown Grid.Column="1" Value="{Binding FrameNo}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                            <TextBlock Grid.Column="2" Text="Dur" VerticalAlignment="Center" ToolTip.Tip="Ticks to hold, plus one. On a repeat slot, how many times to repeat."/>
                            <NumericUpDown Grid.Column="3" Value="{Binding Duration}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                            <TextBlock Grid.Column="4" Text="H-shift" VerticalAlignment="Center" ToolTip.Tip="Pixels to move the sprite sideways."/>
                            <NumericUpDown Grid.Column="5" Value="{Binding HorizontalShift}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                            <TextBlock Grid.Column="6" Text="V-shift" VerticalAlignment="Center" ToolTip.Tip="Stored but not used by the game."/>
                            <NumericUpDown Grid.Column="7" Value="{Binding VerticalShift}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator/>
                    <TextBlock Text="Back frames" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding BackFrameEntries}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpriteFrameEntry">
                          <Grid ColumnDefinitions="Auto,60,Auto,50,Auto,60,Auto,60" Margin="0,0,0,4" ColumnSpacing="4">
                            <TextBlock Grid.Column="0" Text="Frame" VerticalAlignment="Center" ToolTip.Tip="Sprite frame to show. -1 ends the run; below -1 repeats an earlier slot."/>
                            <NumericUpDown Grid.Column="1" Value="{Binding FrameNo}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                            <TextBlock Grid.Column="2" Text="Dur" VerticalAlignment="Center" ToolTip.Tip="Ticks to hold, plus one. On a repeat slot, how many times to repeat."/>
                            <NumericUpDown Grid.Column="3" Value="{Binding Duration}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                            <TextBlock Grid.Column="4" Text="H-shift" VerticalAlignment="Center" ToolTip.Tip="Pixels to move the sprite sideways."/>
                            <NumericUpDown Grid.Column="5" Value="{Binding HorizontalShift}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                            <TextBlock Grid.Column="6" Text="V-shift" VerticalAlignment="Center" ToolTip.Tip="Stored but not used by the game."/>
                            <NumericUpDown Grid.Column="7" Value="{Binding VerticalShift}" Minimum="-128" Maximum="127" FormatString="0" Increment="1"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Diamond/Pearl: the pokeanm pattern steps, shared by both sprites. -->
                  <StackPanel IsVisible="{Binding !HasFrameRuns}" Spacing="4">
                    <TextBlock Text="This Pokémon has no animation record." IsVisible="{Binding !HasAnimData}"
                               FontSize="12" FontStyle="Italic" Foreground="{DynamicResource Editor.Subtle}"/>
                    <StackPanel IsVisible="{Binding HasAnimData}" Spacing="4">
                      <TextBlock Text="Pattern steps" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"
                                 ToolTip.Tip="Sprite frame (0 or 1) and ticks to show it."/>
                      <ItemsControl ItemsSource="{Binding AnimSteps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AnimPatternStep">
                            <Grid ColumnDefinitions="Auto,76,Auto,76,Auto" Margin="0,0,0,4" ColumnSpacing="6">
                              <TextBlock Grid.Column="0" Text="Frame" VerticalAlignment="Center"/>
                              <NumericUpDown Grid.Column="1" Value="{Binding Frame}" Minimum="0" Maximum="{Binding $parent[ItemsControl].((vm:BattleDisplayEditorViewModel)DataContext).MaxFrameIndex}" FormatString="0" Increment="1"/>
                              <TextBlock Grid.Column="2" Text="Wait" VerticalAlignment="Center"/>
                              <NumericUpDown Grid.Column="3" Value="{Binding Wait}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                              <Button Grid.Column="4" Content="🗑" Click="RemoveAnimStep_Click" ToolTip.Tip="Remove this step" VerticalAlignment="Center"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="＋ Add step" Click="AddAnimStep_Click" IsEnabled="{Binding CanAddAnimStep}" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </TabItem>

              <!-- ── Animation ───────────────────────────────────────────────────────────── -->
              <TabItem Header="Animation">
                <StackPanel IsVisible="{Binding HasAnimData}" Spacing="6" Margin="0,8,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding AnimationButtonText}" Click="Play_Click" IsEnabled="{Binding CanPlay}" MinWidth="130"
                            ToolTip.Tip="Plays the animations once."/>
                    <ComboBox ItemsSource="{Binding SideOptions}" SelectedIndex="{Binding SideIndex}" Width="130"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="160,10,150">
                    <TextBlock Grid.Column="0" Text="Front animation #" VerticalAlignment="Center"
                               ToolTip.Tip="Movement script played when sent out."/>
                    <NumericUpDown Grid.Column="2" Value="{Binding AnimFrontProgNum}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                  </Grid>
                  <Grid ColumnDefinitions="160,10,150">
                    <TextBlock Grid.Column="0" Text="Front start delay" VerticalAlignment="Center"
                               ToolTip.Tip="Ticks before the front movement script starts."/>
                    <NumericUpDown Grid.Column="2" Value="{Binding AnimFrontWait}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                  </Grid>
                  <Grid ColumnDefinitions="160,10,150" IsVisible="{Binding HasFrameRuns}">
                    <TextBlock Grid.Column="0" Text="Front cry delay" VerticalAlignment="Center"
                               ToolTip.Tip="Ticks after the animation starts."/>
                    <NumericUpDown Grid.Column="2" Value="{Binding AnimFrontCryDelay}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                  </Grid>

                  <TextBlock Text="{Binding AnimBackLabel}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
                  <ItemsControl ItemsSource="{Binding AnimBack}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:AnimProgStep">
                        <Grid ColumnDefinitions="Auto,76,Auto,76" Margin="0,0,0,4" ColumnSpacing="6">
                          <TextBlock Grid.Column="0" Text="#" VerticalAlignment="Center"/>
                          <NumericUpDown Grid.Column="1" Value="{Binding Number}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                          <TextBlock Grid.Column="2" Text="Wait" VerticalAlignment="Center"/>
                          <NumericUpDown Grid.Column="3" Value="{Binding Wait}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="160,10,150" IsVisible="{Binding HasFrameRuns}">
                    <TextBlock Grid.Column="0" Text="Back cry delay" VerticalAlignment="Center"
                               ToolTip.Tip="Ticks after the animation starts."/>
                    <NumericUpDown Grid.Column="2" Value="{Binding AnimBackCryDelay}" Minimum="0" Maximum="255" FormatString="0" Increment="1"/>
                  </Grid>

                  <!-- Script editor: editable PAST command list for the front program animation. Unchanged on
                       hg-engine ROMs too (edits the compiled pokeAnimDefs NARC; the real hg-engine script source
                       is out of scope here). -->
                  <Separator/>
                  <TextBlock Text="{Binding ProgramScriptHeader}" FontWeight="SemiBold"/>
                  <TextBlock Text="Shared by every Pokémon that uses this animation."
                             FontSize="12" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="＋ Add command" Click="AddProgramCmd_Click"/>
                    <Button Content="💾 Save script" Click="SaveProgramScript_Click" IsEnabled="{Binding ScriptDirty}"/>
                  </StackPanel>
                  <Border IsVisible="{Binding HasProgramScript}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="3" MaxHeight="260">
                    <ScrollViewer>
                      <ItemsControl ItemsSource="{Binding ProgramRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProgramCmdRow">
                            <Grid ColumnDefinitions="186,*,Auto,Auto,Auto" Margin="2" ColumnSpacing="4">
                              <ComboBox Grid.Column="0" ItemsSource="{Binding Ops}" SelectedItem="{Binding Op}" HorizontalAlignment="Stretch"/>
                              <TextBox Grid.Column="1" Text="{Binding ArgsText}" PlaceholderText="{Binding ArgHint}" FontFamily="Consolas,monospace"/>
                              <Button Grid.Column="2" Content="↑" Click="ProgramCmdUp_Click" ToolTip.Tip="Move up"/>
                              <Button Grid.Column="3" Content="↓" Click="ProgramCmdDown_Click" ToolTip.Tip="Move down"/>
                              <Button Grid.Column="4" Content="🗑" Click="ProgramCmdRemove_Click" ToolTip.Tip="Remove"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Border>
                </StackPanel>
              </TabItem>
            </TabControl>
          </StackPanel>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
