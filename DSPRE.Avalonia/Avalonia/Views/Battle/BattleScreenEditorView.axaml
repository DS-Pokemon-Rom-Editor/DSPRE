<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Battle"
        xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Controls"
        x:Class="DSPRE.Avalonia.Views.Battle.BattleScreenEditorView"
        x:DataType="vm:BattleScreenEditorViewModel">

  <Design.DataContext>
    <vm:BattleScreenEditorViewModel/>
  </Design.DataContext>

  <UserControl.Styles>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Editor.Subtle}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}"
            BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" Classes="hint" VerticalAlignment="Center"/>
    </Border>

    <!-- What the screens are showing -->
    <controls:EditorToolbar>
        <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
          <TextBlock Text="Ground" Classes="label"/>
          <ComboBox Width="110" ItemsSource="{Binding TerrainNames}" SelectedIndex="{Binding TerrainIndex}"
                    ToolTip.Tip="Which terrain the Pokémon stand on, which picks the platforms and their colours"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
          <TextBlock Text="Time" Classes="label"/>
          <ComboBox Width="100" ItemsSource="{Binding TimeNames}" SelectedIndex="{Binding TimeIndex}"
                    ToolTip.Tip="The games keep a set of colours for each time of day"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
          <TextBlock Text="Text box" Classes="label"/>
          <ComboBox Width="150" ItemsSource="{Binding WindowStyleNames}" SelectedIndex="{Binding WindowStyleIndex}"
                    ToolTip.Tip="The player picks this in the options, and the same choice is used on the field"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4">
          <TextBlock Text="Backdrop" Classes="label"/>
          <ComboBox Width="160" ItemsSource="{Binding BackdropNames}" SelectedIndex="{Binding BackdropIndex}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
          <TextBlock Text="Menu" Classes="label"/>
          <ComboBox Width="120" ItemsSource="{Binding MenuNames}" SelectedIndex="{Binding MenuIndex}"/>
        </StackPanel>
    </controls:EditorToolbar>

    <!-- The piece list -->
    <Border DockPanel.Dock="Left" Classes="screenList" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
          <TextBlock Text="Pieces" FontWeight="SemiBold"/>
          <controls:HelpTip Text="Click one here, or click it on either screen."/>
        </StackPanel>
        <ListBox x:Name="PieceList" ItemsSource="{Binding Pieces}" SelectedIndex="{Binding SelectedIndex}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Name}"/>
                <TextBlock Text="{Binding Where}" FontSize="11"
                           Foreground="{DynamicResource Editor.Subtle}"/>
                <TextBlock Text="{Binding Trouble}" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding IsMissing}"
                           Foreground="{DynamicResource Editor.Bad}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- What is picked -->
    <Border x:Name="PieceDetails" DockPanel.Dock="Right" Classes="screenPanel" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="1,0,0,0">
      <ScrollViewer>
        <StackPanel Margin="8" Spacing="8">
          <TextBlock Text="{Binding SelectedName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedWhat}" Classes="hint"/>

          <Border IsVisible="{Binding SelectedIsShared}" Padding="8"
                  Background="{DynamicResource Editor.PanelBg}"
                  BorderBrush="{DynamicResource Editor.Warn}" BorderThickness="1,1,1,1" CornerRadius="4">
            <TextBlock Text="{Binding SelectedShared}" Classes="hint"/>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Paint this" controls:Icon.Key="brush" Click="Paint_Click" IsEnabled="{Binding CanPaint}"/>
            <Button Content="Export…" controls:Icon.Key="export" Click="Export_Click" IsEnabled="{Binding CanPaint}" ToolTip.Tip="PNG image"/>
          </StackPanel>
          <Button Content="Import…" controls:Icon.Key="import" Click="Import_Click" IsEnabled="{Binding CanPaint}"
                  HorizontalAlignment="Stretch" ToolTip.Tip="PNG image"/>
          <TextBlock Text="{Binding CannotPaintBecause}" Classes="hint"
                     IsVisible="{Binding CannotPaintBecause, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <Button Content="Open in Graphics" controls:Icon.Key="OpenLink" Click="HandOver_Click" IsEnabled="{Binding CanHandOver}"
                  HorizontalAlignment="Stretch" ToolTip.Tip="{Binding HandOverWhat}"/>

          <StackPanel x:Name="BarPiecesSection" Spacing="6" IsVisible="{Binding ShowsBarPieces}">
            <Separator Margin="0,4"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Bar pieces" FontWeight="SemiBold"/>
              <controls:HelpTip Text="Copied over every bar as the battle runs: fill, status, gender and Lv, caught ball."/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding BarPieceGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BarPieceGroupRow">
                  <StackPanel Margin="0,0,0,8" Spacing="2">
                    <TextBlock Text="{Binding Name}" Classes="hint"/>
                    <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" HorizontalAlignment="Left"
                            Background="{DynamicResource Editor.PanelBg}">
                      <Image Source="{Binding Picture}" Width="{Binding Width}" Height="{Binding Height}"
                             Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Export…" controls:Icon.Key="export" Click="ExportBarPieces_Click"
                      IsEnabled="{Binding HasBarPieces}" ToolTip.Tip="PNG image"/>
              <Button Content="Import…" controls:Icon.Key="import" Click="ImportBarPieces_Click"
                      IsEnabled="{Binding HasBarPieces}" ToolTip.Tip="PNG image in the HP bar colours"/>
            </StackPanel>
            <Button Content="Layout" controls:Icon.Key="OpenLink" Click="BarLayout_Click" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Where the name, level, HP and gauges sit on each bar"/>
            <Button Content="Open in ROM patch toolbox" controls:Icon.Key="OpenLink" Click="TextBackgroundPatch_Click" HorizontalAlignment="Stretch"
                    IsVisible="{Binding CanClearTextBackground}" ToolTip.Tip="{Binding ClearTextBackgroundHelp}"/>
            <TextBlock Text="{Binding BarPiecesNote}" Classes="hint"
                       IsVisible="{Binding BarPiecesNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>

          <Separator Margin="0,4"/>

          <StackPanel x:Name="SampleSection" Orientation="Horizontal">
            <TextBlock Text="Sample" FontWeight="SemiBold"/>
            <controls:HelpTip Text="Preview only, nothing is saved."/>
          </StackPanel>
          <TextBlock Text="Battle type" Classes="hint" IsVisible="{Binding GaugeTextIsReal}"/>
          <ComboBox SelectedIndex="{Binding BattleSizeChoice}" HorizontalAlignment="Stretch"
                    IsVisible="{Binding GaugeTextIsReal}">
            <ComboBoxItem>Single battle</ComboBoxItem>
            <ComboBoxItem>Double battle</ComboBoxItem>
          </ComboBox>

          <CheckBox Content="HP numbers"
                    IsChecked="{Binding NumbersInsteadOfBar}" IsVisible="{Binding IsDoubles}"/>

          <TextBlock Text="Pokémon name" Classes="hint"/>
          <TextBox Text="{Binding SampleName}"/>
          <TextBlock Text="Level" Classes="hint"/>
          <NumericUpDown Value="{Binding SampleLevel}" Minimum="1" Maximum="100" FormatString="0"/>

          <TextBlock Text="Gender" Classes="hint" IsVisible="{Binding GaugeTextIsReal}"/>
          <ComboBox SelectedIndex="{Binding GenderChoice}" HorizontalAlignment="Stretch"
                    IsVisible="{Binding GaugeTextIsReal}">
            <ComboBoxItem>Female</ComboBoxItem>
            <ComboBoxItem>Male</ComboBoxItem>
            <ComboBoxItem>No gender</ComboBoxItem>
          </ComboBox>

          <TextBlock Text="Status condition" Classes="hint" IsVisible="{Binding GaugeTextIsReal}"/>
          <ComboBox SelectedIndex="{Binding StatusChoice}" HorizontalAlignment="Stretch"
                    IsVisible="{Binding GaugeTextIsReal}">
            <ComboBoxItem>Nothing</ComboBoxItem>
            <ComboBoxItem>Paralysed</ComboBoxItem>
            <ComboBoxItem>Frozen</ComboBoxItem>
            <ComboBoxItem>Asleep</ComboBoxItem>
            <ComboBoxItem>Poisoned</ComboBoxItem>
            <ComboBoxItem>Burned</ComboBoxItem>
          </ComboBox>

          <TextBlock Text="{Binding GaugeTextNote}" Classes="hint" TextWrapping="Wrap"
                     IsVisible="{Binding HasGaugeTextNote}"/>
          <TextBlock Text="Health left" Classes="hint"/>
          <Slider Value="{Binding HpLeft}" Minimum="0" Maximum="1" TickFrequency="0.05"/>
          <TextBlock Text="Message" Classes="hint"/>
          <TextBox Text="{Binding SampleMessage}" AcceptsReturn="True" Height="56" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The two screens, stacked the way a DS has them -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="BothScreens" Spacing="10" Margin="12" HorizontalAlignment="Center">

        <TextBlock Text="Top screen" Classes="screenCaption"/>
        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Background="Black">
          <Panel Width="512" Height="384">
            <Image Source="{Binding TopScreen}" Width="512" Height="384" Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="None"
                   PointerPressed="TopScreen_Pressed"/>
            <!-- The screens are drawn at twice size; scaling from the corner keeps the outline over
                 the piece rather than pushing it off toward the middle. -->
            <Canvas IsHitTestVisible="False" RenderTransformOrigin="0,0">
              <Canvas.RenderTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Canvas.RenderTransform>
              <!-- The name, level, gender and status are written into each bar's own picture now,
                   the way a battle writes them, so nothing is drawn over the screens here. Diamond
                   and Pearl, whose letters cannot be read, keep the old written sample. -->
              <views:RomTextBlock Canvas.Left="3"   Canvas.Top="24"  Text="{Binding SampleName}"
                                  IsVisible="{Binding !GaugeTextIsReal}"/>
              <views:RomTextBlock Canvas.Left="78"  Canvas.Top="24"  Text="{Binding SampleLevelText}"
                                  IsVisible="{Binding !GaugeTextIsReal}"/>
              <views:RomTextBlock Canvas.Left="149" Canvas.Top="102" Text="{Binding SampleName}"
                                  IsVisible="{Binding !GaugeTextIsReal}"/>
              <views:RomTextBlock Canvas.Left="210" Canvas.Top="102" Text="{Binding SampleLevelText}"
                                  IsVisible="{Binding !GaugeTextIsReal}"/>

              <!-- A plain fill when the slot tables are not found. -->
              <Rectangle Canvas.Left="50" Canvas.Top="42" Height="4" Fill="#38C838"
                         Width="{Binding HpBarWidth}" IsVisible="{Binding ShowsPlainFill}"/>
              <Rectangle Canvas.Left="200" Canvas.Top="118" Height="4" Fill="#38C838"
                         Width="{Binding HpBarWidth}" IsVisible="{Binding ShowsPlainFill}"/>
              <views:RomTextBlock Canvas.Left="16"  Canvas.Top="152" Text="{Binding SampleMessage}" Ink="#515159" Shadow="#A2A2AA"/>

              <Rectangle IsVisible="{Binding HighlightOnTop}"
                         Canvas.Left="{Binding HighlightLeft}" Canvas.Top="{Binding HighlightTop}"
                         Width="{Binding HighlightWidth}" Height="{Binding HighlightHeight}"
                         Stroke="{DynamicResource Editor.Warn}" StrokeThickness="1"
                         StrokeDashArray="3,2" Fill="Transparent"/>
            </Canvas>
          </Panel>
        </Border>

        <TextBlock Text="Bottom screen" Classes="screenCaption"/>
        <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Background="Black">
          <Panel Width="512" Height="384">
            <Image Source="{Binding TouchScreen}" Width="512" Height="384" Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="None"
                   PointerPressed="TouchScreen_Pressed"/>
            <!-- The screens are drawn at twice size; scaling from the corner keeps the outline over
                 the piece rather than pushing it off toward the middle. -->
            <Canvas IsHitTestVisible="False" RenderTransformOrigin="0,0">
              <Canvas.RenderTransform><ScaleTransform ScaleX="2" ScaleY="2"/></Canvas.RenderTransform>
              <Rectangle IsVisible="{Binding HighlightOnTouch}"
                         Canvas.Left="{Binding HighlightLeft}" Canvas.Top="{Binding HighlightTop}"
                         Width="{Binding HighlightWidth}" Height="{Binding HighlightHeight}"
                         Stroke="{DynamicResource Editor.Warn}" StrokeThickness="1"
                         StrokeDashArray="3,2" Fill="Transparent"/>
            </Canvas>
          </Panel>
        </Border>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>
</UserControl>
