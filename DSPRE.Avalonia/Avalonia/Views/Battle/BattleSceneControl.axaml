<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Battle"
             xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Battle"
             x:Class="DSPRE.Avalonia.Views.Battle.BattleSceneControl"
             x:DataType="vm:BattleDisplayEditorViewModel"
             Name="SceneRoot">
  <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="4" Background="Black">
    <Viewbox Stretch="Uniform">
      <Canvas Width="256" Height="192" ClipToBounds="True">
        <!-- Real battle-scene backdrop + terrain platforms (Arena Type selector: DSUtils.BattleGroundRenderer /
             BattleBgRenderer, same real-ROM-data renderers the Battle Script Editor uses), falling back to the
             bundled placeholder art if the ROM/NARC is unavailable or decoding fails. -->
        <Image Source="{Binding ArenaBackdrop}" Canvas.Left="0" Canvas.Top="0" Width="256" Height="192" Stretch="Fill" IsVisible="{Binding HasArenaGraphics}"/>
        <Image Source="{x:Static views:BattleSceneControl.BackgroundAsset}" Canvas.Left="0" Canvas.Top="0" Width="256" Height="192" Stretch="Fill" IsVisible="{Binding !HasArenaGraphics}"/>

        <Image Source="{Binding ArenaGroundEnemy}" Canvas.Left="{Binding ArenaGroundEnemyLeft}" Canvas.Top="{Binding ArenaGroundEnemyTop}" IsVisible="{Binding HasArenaGraphics}"/>
        <Image Source="{Binding ArenaGroundMine}"  Canvas.Left="{Binding ArenaGroundMineLeft}"  Canvas.Top="{Binding ArenaGroundMineTop}"  IsVisible="{Binding HasArenaGraphics}"/>
        <Image Source="{x:Static views:BattleSceneControl.PlatformOpponentAsset}" Canvas.Left="129" Canvas.Top="72" IsVisible="{Binding !HasArenaGraphics}"/>
        <Image Source="{x:Static views:BattleSceneControl.PlatformYouAsset}" Canvas.Left="-42" Canvas.Top="122" IsVisible="{Binding !HasArenaGraphics}"/>

        <!-- Enemy shadow (one visible per size) -->
        <Image Source="{x:Static views:BattleSceneControl.ShadowSmallAsset}"  Canvas.Top="83" Canvas.Left="{Binding ShadowSmallLeft}"  IsVisible="{Binding ShadowSmallVisible}"/>
        <Image Source="{x:Static views:BattleSceneControl.ShadowMediumAsset}" Canvas.Top="83" Canvas.Left="{Binding ShadowMediumLeft}" IsVisible="{Binding ShadowMediumVisible}"/>
        <Image Source="{x:Static views:BattleSceneControl.ShadowLargeAsset}"  Canvas.Top="82" Canvas.Left="{Binding ShadowLargeLeft}"  IsVisible="{Binding ShadowLargeVisible}"/>

        <!-- Enemy (front) + player (back) sprites; passed in per scene. Each sprite and its palette-fade tint share
             one program-animation transform, and the tint is masked to the sprite's own alpha so the transparent
             (palette index 0) pixels are never coloured. -->
        <Grid Canvas.Left="{Binding EnemyLeft}" Canvas.Top="{Binding #SceneRoot.EnemyY}" Width="80" Height="80"
               RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="{Binding AnimScaleX}" ScaleY="{Binding AnimScaleY}"/>
              <RotateTransform Angle="{Binding AnimRotation}"/>
              <TranslateTransform X="{Binding AnimOffsetX}" Y="{Binding AnimOffsetY}"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Image Source="{Binding #SceneRoot.Enemy}" Stretch="None" RenderOptions.BitmapInterpolationMode="None"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
          <Rectangle Fill="{Binding AnimFadeBrush}" Opacity="{Binding AnimFadeOpacity}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
              <ImageBrush Source="{Binding #SceneRoot.Enemy}" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
            </Rectangle.OpacityMask>
          </Rectangle>
        </Grid>

        <Grid Canvas.Left="{Binding PlayerLeft}" Canvas.Top="{Binding #SceneRoot.PlayerY}" Width="80" Height="80"
               RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="{Binding AnimBackScaleX}" ScaleY="{Binding AnimBackScaleY}"/>
              <RotateTransform Angle="{Binding AnimBackRotation}"/>
              <TranslateTransform X="{Binding AnimBackOffsetX}" Y="{Binding AnimBackOffsetY}"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Image Source="{Binding #SceneRoot.Player}" Stretch="None" RenderOptions.BitmapInterpolationMode="None"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
          <Rectangle Fill="{Binding AnimBackFadeBrush}" Opacity="{Binding AnimBackFadeOpacity}" IsHitTestVisible="False">
            <Rectangle.OpacityMask>
              <ImageBrush Source="{Binding #SceneRoot.Player}" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
            </Rectangle.OpacityMask>
          </Rectangle>
        </Grid>

        <!-- Battle UI chrome: the real pl_batt_obj gauge frames so an edited gauge graphic shows here,
             falling back to the bundled placeholders when the NARC can't be decoded. -->
        <Image Source="{Binding GaugeEnemyImage}"  Canvas.Left="-70" Canvas.Top="-92" Width="256" Height="256"
               IsVisible="{Binding HasRealGauges}" RenderOptions.BitmapInterpolationMode="None"/>
        <Image Source="{Binding GaugePlayerImage}" Canvas.Left="64"  Canvas.Top="-12" Width="256" Height="256"
               IsVisible="{Binding HasRealGauges}" RenderOptions.BitmapInterpolationMode="None"/>
        <Image Source="{x:Static views:BattleSceneControl.HealthOpponentAsset}" Canvas.Left="0"   Canvas.Top="18"
               IsVisible="{Binding PlaceholderGaugesVisible}"/>
        <Image Source="{x:Static views:BattleSceneControl.HealthYouAsset}"      Canvas.Left="129" Canvas.Top="95"
               IsVisible="{Binding PlaceholderGaugesVisible}"/>

        <!-- Name / level / HP readout. Positions measured off real battles; the frame graphic already
             carries the "HP" label and the empty bar, so only the fill and the text go on top. -->
        <Canvas IsVisible="{Binding HasRealGauges}">
          <TextBlock Canvas.Left="3"   Canvas.Top="24"  Text="{Binding GaugeNameText}"  FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}"/>
          <TextBlock Canvas.Left="78"  Canvas.Top="24"  Text="{Binding GaugeLevelText}" FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}"/>
          <Rectangle Canvas.Left="50"  Canvas.Top="42"  Width="48" Height="4" Fill="#38C838"/>
          <TextBlock Canvas.Left="149" Canvas.Top="102" Text="{Binding GaugeNameText}"  FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}"/>
          <TextBlock Canvas.Left="210" Canvas.Top="102" Text="{Binding GaugeLevelText}" FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}"/>
          <Rectangle Canvas.Left="200" Canvas.Top="118" Width="48" Height="4" Fill="#38C838"/>
        </Canvas>

        <!-- The battle text box covers the bottom 48px of the top screen. -->
        <Canvas Canvas.Left="0" Canvas.Top="144">
          <Rectangle Width="256" Height="48" Fill="#494141"/>
          <Rectangle Canvas.Left="2" Canvas.Top="2" Width="252" Height="43" Fill="#FBFBFB"/>
          <Rectangle Canvas.Left="2" Canvas.Top="3" Width="252" Height="1"  Fill="#FBDB69"/>
          <Rectangle Canvas.Left="2" Canvas.Top="44" Width="252" Height="1" Fill="#EBA238"/>
          <Rectangle Width="256" Height="1" Fill="#202020"/>
          <Rectangle Canvas.Top="47" Width="256" Height="1" Fill="#202020"/>
          <TextBlock Canvas.Left="8" Canvas.Top="8" Width="242" FontSize="8" Foreground="#3C3C3C" TextWrapping="Wrap"
                     Text="This message box is here to show how much of the battle screen it covers, so the preview matches what you see in game."/>
        </Canvas>
      </Canvas>
    </Viewbox>
  </Border>
</UserControl>
