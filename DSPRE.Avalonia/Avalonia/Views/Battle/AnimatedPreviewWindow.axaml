<Window xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Controls"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Battle"
        xmlns:gl="clr-namespace:DSPRE.Avalonia.Gl"
        x:Class="DSPRE.Avalonia.Views.Battle.AnimatedPreviewWindow"
        x:DataType="vm:AnimatedPreviewViewModel"
        Title="Animated preview" Width="1000" Height="720"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:AnimatedPreviewViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding PlayPauseText}" Click="PlayPause_Click" Width="70"/>
        <Button Content="Restart" Click="Restart_Click"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <TextBlock Text="Speed:" VerticalAlignment="Center"/>
        <ComboBox Width="80" ItemsSource="{Binding SpeedNames}" SelectedIndex="{Binding SpeedIndex}"
                  ToolTip.Tip="Slow the preview down to see what a fast animation is doing."/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <CheckBox Content="Scenery" IsChecked="{Binding AnimateTerrain}"
                  ToolTip.Tip="Play the moving water and the buildings that animate."/>
        <CheckBox Content="People" IsChecked="{Binding ShowPeople}"
                  ToolTip.Tip="Show the map's overworld events moving the way their movement code says."/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <CheckBox Content="Step in" IsChecked="{Binding StepInto}" IsEnabled="{Binding CanStepInto}"
                  ToolTip.Tip="Walk the map yourself with the arrow keys, and press Enter to talk to somebody."/>
        <CheckBox Content="Sound" IsChecked="{Binding PlaySounds}"
                  ToolTip.Tip="Play the sounds and fanfares a script asks for, from the ROM's own sound archive."/>
        <CheckBox Content="Map music" IsChecked="{Binding PlayMapMusic}" IsEnabled="{Binding PlaySounds}"
                  ToolTip.Tip="Play this header's own music. Which of its two tracks depends on the time of day."/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <TextBlock Text="Border:" VerticalAlignment="Center"/>
        <ComboBox Width="110" ItemsSource="{Binding BorderNames}" SelectedIndex="{Binding BorderIndex}"
                  ToolTip.Tip="Which message box border to draw with. The games let the player pick between twenty in Options."/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <TextBlock Text="Start:" VerticalAlignment="Center"/>
        <ComboBox Width="200" ItemsSource="{Binding StartBesideNames}" SelectedIndex="{Binding StartBesideIndex}"
                  ToolTip.Tip="Where the walk begins. Picking an event stands you next to it, facing it, so Enter talks or the trigger goes off straight away."/>
        <ToggleButton Content="Place" IsChecked="{Binding PlacingStart}"
                      ToolTip.Tip="Drag anywhere on the map to say where the walk starts."/>
        <TextBlock Text="{Binding StartTileText}" VerticalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource Editor.Subtle}"/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <CheckBox Content="Flags" IsChecked="{Binding ShowFlags}" IsEnabled="{Binding HasEventFlags}"
                  ToolTip.Tip="Some people are only on the map while a flag is clear. Turn a flag on here to take them away."/>
        <CheckBox Content="Level scripts" IsChecked="{Binding ShowLevelScripts}" IsEnabled="{Binding HasLevelScripts}"
                  ToolTip.Tip="What the map runs by itself: as you arrive, and on every step once a variable holds the value it waits for."/>
        <CheckBox Content="Words" IsChecked="{Binding ShowStringVars}" IsEnabled="{Binding HasStringVars}"
                  ToolTip.Tip="Messages leave gaps the game fills in, like the player's name. Set what goes in each gap so the box reads like the real thing."/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <TextBlock Text="Time:" VerticalAlignment="Center"/>
        <ComboBox Width="180" ItemsSource="{Binding TimesOfDay}" SelectedIndex="{Binding TimeOfDayIndex}"
                  ToolTip.Tip="Buildings that change through the day show the animation for this time. Starts at your computer's clock."/>
        <Rectangle Width="1" Fill="{DynamicResource Editor.Separator}" Margin="3,1"/>
        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" MinWidth="50"
                   Foreground="{DynamicResource Editor.Subtle}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
      <Panel Grid.Column="0">
        <Border x:Name="GlHost" Background="Transparent" Margin="4">
          <gl:NsbmdGlControl x:Name="GlView"/>
        </Border>
        <views:FieldMessageBoxView x:Name="MessageBox" Margin="4"
                                   Text="{Binding MessageText}" HasMore="{Binding MessageHasMore}"/>
      </Panel>

      <!-- What the script would do. Only shown while stepping in. -->
      <Border Grid.Column="1" Width="230" Margin="0,4,4,4" IsVisible="{Binding ShowFlags}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Who is on the map"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource Editor.Subtle}" FontSize="12"
                     Text="The games only put a person on the map while their flag is clear. Tick a flag to see the map without them."/>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12"
                     Foreground="{DynamicResource Editor.Subtle}"
                     Text="{Binding HiddenSummary}"/>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding EventFlags}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSet}" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The words messages leave gaps for. -->
      <Border Grid.Column="4" Width="290" Margin="0,4,4,4" IsVisible="{Binding ShowStringVars}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Words the game fills in"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource Editor.Subtle}" FontSize="12"
                     Text="A message can leave a gap for a name, an item and so on. Type what should go in each one and the message box shows it straight away."/>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12"
                     Foreground="{DynamicResource Editor.Subtle}"
                     Text="{Binding StringVarSummary}"/>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding StringVars}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Editor.Subtle}"/>
                    <TextBox Text="{Binding Value}" Margin="0,2,0,0" FontSize="13"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- What the map runs on its own, out of its level script file. -->
      <Border Grid.Column="3" Width="270" Margin="0,4,4,4" IsVisible="{Binding ShowLevelScripts}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="What the map runs by itself"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource Editor.Subtle}" FontSize="12"
                     Text="The ones at the top run as you step onto the map. The ones below wait for a variable, and are checked on every step you take."/>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12"
                     Foreground="{DynamicResource Editor.Subtle}"
                     Text="{Binding LevelScriptSummary}"/>
          <ScrollViewer>
            <StackPanel>
              <ItemsControl ItemsSource="{Binding LevelScriptArrivals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding LevelScriptWatchers}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,3">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/>
                      <NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="65535"
                                     FormatString="0" Margin="0,2,0,0"
                                     ToolTip.Tip="Set the variable to the value this one waits for and its script starts."/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Width="360" Margin="0,4,4,4" IsVisible="{Binding StepInto}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding CameraDescription}" FontSize="12"
                     TextWrapping="Wrap" Margin="0,0,0,6"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding ScriptProgressText}" FontSize="12"
                     IsVisible="{Binding ScriptRunning}" Margin="0,0,0,4"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MessageWaitText}" FontSize="12"
                     IsVisible="{Binding MessageVisible}" TextWrapping="Wrap" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MessageFontNote}" FontSize="12"
                     IsVisible="{Binding HasMessageFontNote}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MessageWarning}" FontSize="12"
                     IsVisible="{Binding HasMessageWarning}" TextWrapping="Wrap" Margin="0,0,0,6"
                     Foreground="#D08A00"/>
          <TextBlock DockPanel.Dock="Top" Text="Arrow keys walk, Enter talks to whoever you face."
                     FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                     Foreground="{DynamicResource Editor.Subtle}"/>

          <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasQuestion}" Margin="0,8,0,0"
                  BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding QuestionPrompt}" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding AnswerOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding}" Click="Answer_Click"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding AcceptsTypedAnswer}">
                <TextBox Width="110" Text="{Binding TypedAnswer}" Watermark="any number"/>
                <Button Content="Use this" Click="AnswerTyped_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ScriptLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
