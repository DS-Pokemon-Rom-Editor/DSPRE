<Window xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Controls"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Battle"
        xmlns:gl="clr-namespace:DSPRE.Avalonia.Gl"
        x:Class="DSPRE.Avalonia.Views.Battle.AnimatedPreviewWindow"
        x:DataType="vm:AnimatedPreviewViewModel"
        Title="Animated preview" Width="1180" Height="860"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:AnimatedPreviewViewModel/>
  </Design.DataContext>

  <Window.Styles>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="6,4">
      <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
        <Button Content="{Binding PlayPauseText}" Click="PlayPause_Click" Width="70"/>
        <Button Content="Restart" Click="Restart_Click"/>
        <ComboBox Width="80" ItemsSource="{Binding SpeedNames}" SelectedIndex="{Binding SpeedIndex}"
                  ToolTip.Tip="Slow the preview down to see what a fast animation is doing."/>
        <CheckBox Content="Scenery" IsChecked="{Binding AnimateTerrain}"
                  ToolTip.Tip="Play the water and the buildings that animate."/>
        <CheckBox Content="People" IsChecked="{Binding ShowPeople}"
                  ToolTip.Tip="Show the people moving as their movement code says."/>
        <CheckBox Content="Step in" IsChecked="{Binding StepInto}" IsEnabled="{Binding CanStepInto}"
                  ToolTip.Tip="Walk the map yourself with the arrow keys."/>
        <CheckBox Content="Sound" IsChecked="{Binding PlaySounds}"
                  ToolTip.Tip="Play the sounds and fanfares a script asks for."/>
        <CheckBox Content="Map music" IsChecked="{Binding PlayMapMusic}" IsEnabled="{Binding PlaySounds}"
                  ToolTip.Tip="Play this header's music. The time of day picks which of its two tracks."/>
        <ComboBox Width="110" ItemsSource="{Binding TextSpeedNames}" SelectedIndex="{Binding TextSpeedIndex}"
                  ToolTip.Tip="The text speed from the game's Options menu."/>
        <ComboBox Width="110" ItemsSource="{Binding BorderNames}" SelectedIndex="{Binding BorderIndex}"
                  ToolTip.Tip="Which message box border to draw with."/>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Start:" VerticalAlignment="Center"/>
          <ComboBox Width="200" ItemsSource="{Binding StartBesideNames}" SelectedIndex="{Binding StartBesideIndex}"
                    ToolTip.Tip="Where the walk begins. Picking an event puts you beside it, facing it."/>
          <ToggleButton Content="Place" IsChecked="{Binding PlacingStart}"
                        ToolTip.Tip="Drag anywhere on the map to say where the walk starts."/>
        </StackPanel>
        <CheckBox Content="Pokétch" IsChecked="{Binding HasPoketch}" IsVisible="{Binding IsPlatinum}"/>
        <CheckBox Content="Flags" IsChecked="{Binding ShowFlags}" IsEnabled="{Binding HasEventFlags}"
                  ToolTip.Tip="Hide people by setting their flag."/>
        <CheckBox Content="Level scripts" IsChecked="{Binding ShowLevelScripts}" IsEnabled="{Binding HasLevelScripts}"
                  ToolTip.Tip="Scripts the map runs on arrival and on every step."/>
        <CheckBox Content="Words" IsChecked="{Binding ShowStringVars}" IsEnabled="{Binding HasStringVars}"
                  ToolTip.Tip="Set what goes in the gaps a message leaves, like the player's name."/>
        <ComboBox Width="180" ItemsSource="{Binding TimesOfDay}" SelectedIndex="{Binding TimeOfDayIndex}"
                  ToolTip.Tip="Buildings that change through the day use this time. Starts at your clock."/>
        <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" MinWidth="50"
                   Foreground="{DynamicResource Editor.Subtle}"/>
      </WrapPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
      <views:DsScreenPanel Grid.Column="0" Margin="4" Letterbox="{Binding StepInto}" ShowBottom="{Binding ShowTouchScreen}">
        <!-- The top screen: the field, and everything the games draw over it. -->
        <Panel ClipToBounds="True">
          <Border x:Name="GlHost" Background="Transparent">
            <gl:NsbmdGlControl x:Name="GlView"/>
          </Border>
          <views:FieldMessageBoxView x:Name="MessageBox"
                                     Text="{Binding MessageText}" IsOpen="{Binding MessageVisible}"
                                     HasMore="{Binding MessageHasMore}" ArrowOffset="{Binding MessageArrowOffset}"
                                     ScrollPixels="{Binding MessageScrollPixels}"/>
          <views:FieldMenuWindowView IsVisible="{Binding HasChoiceWindow}"
                                     Items="{Binding ChoiceItems}" WidthItems="{Binding ChoiceAllItems}"
                                     Cursor="{Binding ChoiceCursorRow}"
                                     TileLeft="{Binding ChoiceLeft}" TileTop="{Binding ChoiceTop}"
                                     TilesWide="{Binding ChoiceWidthTiles}" TilesHigh="{Binding ChoiceHeightTiles}"
                                     Indent="{Binding ChoiceIndent}" CursorX="{Binding ChoiceCursorX}"
                                     RowOffset="{Binding ChoiceRowOffset}"/>

          <!-- Something only the person watching can say, because the preview has no save to read. -->
          <Panel IsVisible="{Binding HasStatePrompt}">
            <Border Background="#8C000000"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" MaxWidth="440"
                    Padding="18,14" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
                    BoxShadow="0 8 28 0 #99000000">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding QuestionTitle}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding QuestionPrompt}" TextWrapping="Wrap"/>
                <ItemsControl x:Name="PromptOptions" ItemsSource="{Binding AnswerOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" MinWidth="90" HorizontalContentAlignment="Center" Click="Answer_Click"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding AcceptsTypedAnswer}">
                  <TextBox x:Name="TypedAnswerBox" Width="120" Text="{Binding TypedAnswer}" Watermark="any number"/>
                  <Button Content="Use this" Click="AnswerTyped_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Panel>
        </Panel>

        <!-- The bottom screen: the Pokétch in Platinum, the touch menu in HeartGold and SoulSilver. -->
        <Panel ClipToBounds="True">
          <views:PoketchView x:Name="Poketch" AutomationProperties.Name="Pokétch" IsVisible="{Binding IsPlatinum}" Owned="{Binding HasPoketch}"
                             Female="{Binding PlayerIsFemale}" ScriptRunning="{Binding ScriptRunning}"/>
          <views:HgssTouchScreenView x:Name="TouchMenu" AutomationProperties.Name="Touch screen" IsVisible="{Binding IsHeartGold}"
                                     ShowsChoices="{Binding TouchScreenShowsChoices}" Brightness="{Binding TouchScreenBrightness}"
                                     Dimmed="{Binding ScriptRunning}" ALabel="{Binding TouchALabel}"
                                     Choices="{Binding TouchChoiceItems}" YesNo="{Binding TouchChoiceIsYesNo}"
                                     Cursor="{Binding ChoiceCursor}" CursorShown="{Binding TouchCursorShown}"/>
        </Panel>
      </views:DsScreenPanel>

      <!-- Who is on the map. -->
      <Border Grid.Column="1" Width="230" Margin="0,4,4,4" IsVisible="{Binding ShowFlags}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Who is on the map"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource Editor.Subtle}" FontSize="12"
                     Text="A person is on the map only while their flag is clear. Tick a flag to take them away."/>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12"
                     Foreground="{DynamicResource Editor.Subtle}"
                     Text="{Binding HiddenSummary}"/>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding EventFlags}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSet}" Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The words messages leave gaps for. -->
      <Border Grid.Column="4" Width="290" Margin="0,4,4,4" IsVisible="{Binding ShowStringVars}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Words the game fills in"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource Editor.Subtle}" FontSize="12"
                     Text="A message can leave a gap for a name, an item and so on. Type what goes in each."/>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12"
                     Foreground="{DynamicResource Editor.Subtle}"
                     Text="{Binding StringVarSummary}"/>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding StringVars}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource Editor.Subtle}"/>
                    <TextBox Text="{Binding Value}" Margin="0,2,0,0" FontSize="13"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- What the map runs on its own, out of its level script file. -->
      <Border Grid.Column="3" Width="270" Margin="0,4,4,4" IsVisible="{Binding ShowLevelScripts}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="What the map runs by itself"
                     FontWeight="SemiBold" Margin="0,0,0,4"/>
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                     Foreground="{DynamicResource Editor.Subtle}" FontSize="12"
                     Text="The top ones run as you arrive. The rest wait for a variable, checked on every step."/>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12"
                     Foreground="{DynamicResource Editor.Subtle}"
                     Text="{Binding LevelScriptSummary}"/>
          <ScrollViewer>
            <StackPanel>
              <ItemsControl ItemsSource="{Binding LevelScriptArrivals}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding LevelScriptWatchers}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,3">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12"/>
                      <NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="65535"
                                     FormatString="0" Margin="0,2,0,0"
                                     ToolTip.Tip="Set it to the value this one waits for and its script starts."/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The script as it plays, and what the preview has been told. Only shown while stepping in. -->
      <Border Grid.Column="2" Width="360" Margin="0,4,4,4" IsVisible="{Binding StepInto}"
              Background="{DynamicResource Editor.ToolbarBg}" BorderBrush="{DynamicResource Editor.Border}"
              BorderThickness="1" Padding="8">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Text="{Binding ScriptStatusText}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"
                       ToolTip.Tip="Esc stops a running script. Space and Z also act as A, Backspace as B."/>
            <Button Grid.Column="1" Content="Stop" Click="StopScript_Click" IsVisible="{Binding ScriptRunning}"
                    ToolTip.Tip="Stop the script where it is. Esc does the same."/>
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MessageWaitText}" FontSize="12" TextWrapping="Wrap"
                     Margin="0,0,0,4" Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MessageWarning}" FontSize="12"
                     IsVisible="{Binding HasMessageWarning}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="#D08A00"/>
          <TextBlock DockPanel.Dock="Top" Text="{Binding MessageFontNote}" FontSize="12"
                     IsVisible="{Binding HasMessageFontNote}" TextWrapping="Wrap" Margin="0,0,0,4"
                     Foreground="{DynamicResource Editor.Subtle}"/>

          <TextBlock DockPanel.Dock="Bottom" Text="{Binding CameraDescription}" FontSize="11"
                     TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Editor.Subtle}"/>

          <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasGameState}" Margin="0,8,0,0"
                  BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Text="What the preview knows" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Forget all" Click="ForgetAll_Click" FontSize="11" Padding="6,1"
                        ToolTip.Tip="Forget every answer, so the next script asks again."/>
              </Grid>
              <ScrollViewer MaxHeight="220">
                <ItemsControl ItemsSource="{Binding GameStateEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnimatedPreviewViewModel+GameStateEntry">
                      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSet}" IsVisible="{Binding IsFlag}"/>
                        <TextBlock Text="{Binding Label}" IsVisible="{Binding IsVariable}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBox Grid.Column="1" Width="80" Text="{Binding Value}" IsVisible="{Binding IsVariable}"
                                 Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Content="✕" Padding="6,0" Margin="6,0,0,0" FontSize="11"
                                Click="ForgetState_Click" ToolTip.Tip="Forget this, so a script asks again."/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <ListBox x:Name="ScriptLog" ItemsSource="{Binding ScriptLines}" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
