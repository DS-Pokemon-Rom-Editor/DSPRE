<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Battle"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        x:Class="DSPRE.Avalonia.Views.Battle.BattleMessageEditorView"
        x:DataType="vm:BattleMessageEditorViewModel"
        Title="Trainer battle messages"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:BattleMessageEditorViewModel/>
  </Design.DataContext>

  <DockPanel>
    <controls:EditorToolbar>
        <TextBlock Text="Trainer:" VerticalAlignment="Center"/>
        <controls:FusionAutoCompleteBox Width="320" ItemsSource="{Binding Trainers}" SelectedIndex="{Binding SelectedTrainerIndex}"/>
        <Button Content="Save all" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
    </controls:EditorToolbar>

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <Grid ColumnDefinitions="*,300" Margin="6">
      <!-- Entries -->
      <DockPanel Grid.Column="0" Margin="0,0,6,0">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
          <Button Content="Add" controls:Icon.Key="addIcon"    Click="Add_Click"/>
          <Button Content="Delete" controls:Icon.Key="deleteIcon" Click="Delete_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding InfoText}" Foreground="{Binding InfoColor}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <ListBox ItemsSource="{Binding Entries}" SelectedIndex="{Binding SelectedEntryIndex}"/>
      </DockPanel>

      <!-- Editor + sprite -->
      <DockPanel Grid.Column="1">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <Border Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Width="96" Height="96" HorizontalAlignment="Left">
            <Image Source="{Binding ClassImage}" Stretch="Uniform"/>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSprite}">
            <TextBlock Text="Frame" VerticalAlignment="Center"/>
            <NumericUpDown Width="90" Minimum="0" Maximum="{Binding FrameMax}" Increment="1" Value="{Binding Frame}"/>
          </StackPanel>
          <TextBlock Text="Trigger type" FontWeight="Bold"/>
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding TriggerTypes}" SelectedIndex="{Binding SelectedTriggerIndex}"/>
          <TextBlock Text="Message" FontWeight="Bold"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
          <Button Content="Edit trigger" controls:Icon.Key="pencil" Click="EditTrigger_Click"/>
          <Button Content="Save message" controls:Icon.Key="saveButton" Click="SaveMessage_Click"/>
        </StackPanel>
        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding MessageText}" Margin="0,4,0,0"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
