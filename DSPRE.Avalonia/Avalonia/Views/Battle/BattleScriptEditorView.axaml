<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Battle"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:views="clr-namespace:DSPRE.Avalonia.Views.Battle"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             x:Class="DSPRE.Avalonia.Views.Battle.BattleScriptEditorView"
             x:DataType="vm:BattleScriptEditorViewModel">
  <Design.DataContext>
    <vm:BattleScriptEditorViewModel/>
  </Design.DataContext>

  <Grid Margin="12" RowDefinitions="Auto,Auto,*">

    <!-- Unsupported game banner -->
    <Border Grid.Row="0" IsVisible="{Binding !IsAvailable}" Padding="10" CornerRadius="4"
            Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1">
      <TextBlock Text="{Binding UnavailableText}" TextWrapping="Wrap" Foreground="OrangeRed"/>
    </Border>

    <!-- Selectors -->
    <StackPanel Grid.Row="1" IsVisible="{Binding IsAvailable}" Spacing="8" Margin="0,0,0,8">
      <Grid ColumnDefinitions="120,10,260,40,90,10,*">
        <TextBlock Grid.Column="0" Text="Archive" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="2" ItemsSource="{Binding ArchiveOptions}" SelectedIndex="{Binding ArchiveIndex}" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Column="4" Text="Entry" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
        <controls:FusionAutoCompleteBox Grid.Column="6" ItemsSource="{Binding FileItems}" SelectedIndex="{Binding SelectedFileIndex}" HorizontalAlignment="Stretch" MaxDropDownHeight="420"/>
      </Grid>
      <TextBlock IsVisible="{Binding ArchiveNotAvailable}" Text="{Binding ArchiveUnavailableText}"
                 FontSize="12" Foreground="OrangeRed" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding EntryHeader}" FontWeight="SemiBold"/>
      <TextBlock IsVisible="{Binding ShowTextHelp}" Text="One command per line, written like a command: 'CommandName label=value label=value' (for example 'AddParticles slot=0 data=482 behavior=3'). Values are decimal or 0x-hex; settings with named options use the option word (like target=Attacker). Labels can be given in any order; unlabeled values just fill whichever slots are left, in order. Lines starting with // are comments. The raw 'OPCODE 1 2 3' form is still accepted. Edits are shared with the cards and repacked into the ROM on save."
                 FontSize="12" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="＋ Add command" Click="AddCommand_Click"/>
        <Button Content="💾 Save" Click="Save_Click" IsEnabled="{Binding Dirty}"
                ToolTip.Tip="{Binding SaveHint}" ToolTip.ShowOnDisabled="True"/>
        <Button Content="❓ Command guide" Click="CommandGuide_Click"/>
      </StackPanel>
    </StackPanel>

    <!-- Command list + (WEST) storyboard. 50/50 split so the command-arg column can't expand and crowd out the
         preview-side controls (background selector etc.); each half scrolls independently. -->
    <!-- The command list needs the room: its lines are wide and clipping them is what makes a script
         unreadable. The preview keeps a sensible minimum and the splitter lets either side win. -->
    <Grid Grid.Row="2" IsVisible="{Binding IsAvailable}" ColumnDefinitions="*,6,440">
      <Grid Grid.Column="0" RowDefinitions="*,Auto">
        <TabControl x:Name="EditorTabs" Grid.Row="0" Padding="0" SelectionChanged="EditorTabs_SelectionChanged">
          <!-- Three ways of reading the same commands. Nothing here writes a command out as a sentence:
               these are instruction streams with timing in them, so what makes them readable is folding
               the shorthands back up, naming the numbers, lining the columns up and indenting the loops. -->
          <TabItem Header="Read">
            <Panel>
            <!-- The three reading views only exist for the move animations. On the other archives this tab
                 used to be an empty box with nothing to say why, so it now says where to go instead. -->
            <TextBlock IsVisible="{Binding !IsWest}" Margin="16" TextWrapping="Wrap"
                       VerticalAlignment="Top" Foreground="{DynamicResource Editor.Subtle}"
                       Text="The three reading views are for the move animations. Pick &quot;Move animation (WEST)&quot; in the Archive list above to use them. This archive is edited in the Cards and Text tabs."/>
            <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsWest}">
              <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="4,4,4,2">
                <TextBlock Text="Show as:" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox SelectedIndex="{Binding ViewMode}" MinWidth="150" VerticalAlignment="Center"
                          ToolTip.Tip="Three ways of reading the same commands. Switching never changes them.">
                  <ComboBoxItem Content="Guided"/>
                  <ComboBoxItem Content="Script"/>
                  <ComboBoxItem Content="Raw"/>
                </ComboBox>
                <TextBlock Text="{Binding ViewSummary}" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Editor.Subtle}"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{Binding ViewNote}" TextWrapping="Wrap" Margin="4,0,4,4"
                         FontSize="11" Foreground="{DynamicResource Editor.Subtle}"/>
              <Border Grid.Row="2" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="3">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                  <ListBox ItemsSource="{Binding ViewLines}" SelectedItem="{Binding PickedLine}"
                           Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Display}" FontFamily="Consolas,monospace" FontSize="12"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
              </Border>
              <Border Grid.Row="3" Margin="4,4,4,0" Padding="6,4" IsVisible="{Binding HasPickedDetail}"
                      Background="{DynamicResource Editor.StatusBg}" CornerRadius="3">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding PickedDetail}" TextWrapping="Wrap" FontSize="12"/>
                  <TextBlock Text="{Binding PickedSource}" FontSize="11" FontStyle="Italic"
                             Foreground="{DynamicResource Editor.Subtle}"/>
                </StackPanel>
              </Border>
            </Grid>
            </Panel>
          </TabItem>
          <!-- Card view: each command as a collapsible container -->
          <TabItem Header="Cards">
            <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="3">
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScriptCmdRow">
                <!-- Each command is a collapsible card: collapsed → one-line summary; expanded → opcode picker +
                     a labelled editor per argument (+ a raw-args box for adding/removing variable payload). -->
                <Expander IsExpanded="{Binding IsExpanded}" Margin="0,1" Padding="6,2"
                          HorizontalAlignment="Stretch" Background="{DynamicResource Editor.StatusBg}">
                  <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2" HorizontalAlignment="Stretch">
                      <TextBlock Grid.Column="0" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                                 FontFamily="Consolas,monospace" FontSize="12" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="↑" Click="Up_Click" ToolTip.Tip="Move up" Padding="6,0" FontSize="12"/>
                      <Button Grid.Column="2" Content="↓" Click="Down_Click" ToolTip.Tip="Move down" Padding="6,0" FontSize="12"/>
                      <Button Grid.Column="3" Content="🗑" Click="Remove_Click" ToolTip.Tip="Remove" Padding="6,0" FontSize="12"/>
                    </Grid>
                  </Expander.Header>
                  <StackPanel Spacing="3" Margin="0,4,0,2">
                    <Grid ColumnDefinitions="86,*" ColumnSpacing="6">
                      <TextBlock Grid.Column="0" Text="Opcode" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="420"
                                ItemsSource="{Binding $parent[ItemsControl].((vm:BattleScriptEditorViewModel)DataContext).OpcodeDisplayNames}"
                                SelectedIndex="{Binding OpId}"/>
                    </Grid>
                    <TextBlock Text="{Binding OpDoc}" IsVisible="{Binding HasDoc}" TextWrapping="Wrap" FontSize="11"
                               FontStyle="Italic" Margin="92,0,0,2" Foreground="{DynamicResource Editor.Subtle}"/>
                    <ItemsControl ItemsSource="{Binding Params}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParamVM">
                          <Grid ColumnDefinitions="86,*,Auto" ColumnSpacing="6" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource Editor.Subtle}"/>
                            <!-- enum param → dropdown; otherwise → numeric entry -->
                            <ComboBox Grid.Column="1" IsVisible="{Binding IsEnum}" HorizontalAlignment="Stretch" MaxDropDownHeight="420"
                                      ItemsSource="{Binding EnumItems}" SelectedIndex="{Binding SelectedEnumIndex}"/>
                            <NumericUpDown Grid.Column="1" IsVisible="{Binding IsInt}" Value="{Binding ValueDec}"
                                           FormatString="0" Increment="1" HorizontalAlignment="Stretch"/>
                            <!-- Sound arguments (WEST_SE and friends): show the real sound name + a preview button. -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsSound}" VerticalAlignment="Center">
                              <TextBlock Text="{Binding SoundName}" FontSize="11" VerticalAlignment="Center"
                                         Foreground="{DynamicResource Editor.Subtle}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                              <Button Content="🔊" Padding="6,2" Click="PreviewSound_Click" ToolTip.Tip="Play this sound"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="86,*" ColumnSpacing="6">
                      <TextBlock Grid.Column="0" Text="Raw args" VerticalAlignment="Center" FontSize="12"
                                 Foreground="{DynamicResource Editor.Subtle}"
                                 ToolTip.Tip="The raw argument words (read-only). Edit values above."/>
                      <TextBox Grid.Column="1" Text="{Binding RawArgs, Mode=OneWay}" IsReadOnly="True"
                               FontFamily="Consolas,monospace" FontSize="12" Background="Transparent"/>
                    </Grid>
                  </StackPanel>
                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </TabItem>
          <!-- Text view: the same commands as editable "OPCODE_NAME arg arg" lines with live red-squiggle validation.
               Whatever is here IS the card list and vice-versa (no explicit save); switching to Cards is blocked while
               the text has errors. -->
          <TabItem Header="Text">
            <ae:TextEditor x:Name="CommandsTextEditor" ShowLineNumbers="True" WordWrap="False"
                           FontFamily="Consolas,monospace" FontSize="12"
                           BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"/>
          </TabItem>
        </TabControl>
        <!-- parse-error banner (shown only while the text has errors) -->
        <Border Grid.Row="1" IsVisible="{Binding HasTextErrors}" Background="#3A1414" CornerRadius="3" Margin="0,4,0,0" Padding="8,4">
          <TextBlock Text="{Binding TextErrorSummary}" Foreground="#FF8888" FontSize="12" TextWrapping="Wrap"/>
        </Border>
      </Grid>

      <!-- WEST side panel: cell-animation preview (Phase 2) + readable storyboard timeline -->
      <!-- The preview, its controls and the storyboard together are taller than a short window, and without
           this the bottom of them was simply cut off with nothing to say so. -->
      <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns"
                    HorizontalAlignment="Stretch"/>
      <ScrollViewer Grid.Column="2" IsVisible="{Binding ShowStoryboard}" Margin="10,0,0,0"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid MinHeight="420" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="1" Margin="0,0,0,4" IsVisible="{Binding HasPreview}">
          <TextBlock Text="Animation preview" FontWeight="SemiBold"/>
          <TextBlock Text="Reproduces the vanilla-game routines (particles, Pokémon move/rotate/scale/flash, shake, fade). Effects redefined in custom C code may differ."
                     FontSize="10" Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Height="225" CornerRadius="4"
                BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" IsVisible="{Binding HasPreview}">
          <Viewbox Stretch="Uniform">
            <!-- Move animation plays over the battle scene, Shuckle vs Shuckle 🐢 (RenderTransform = screen shake) -->
            <Canvas Width="256" Height="192" ClipToBounds="True" Background="Black" RenderTransformOrigin="0.5,0.5">
              <Canvas.RenderTransform>
                <TranslateTransform X="{Binding ShakeX}" Y="{Binding ShakeY}"/>
              </Canvas.RenderTransform>
              <!-- Software-composited scene: backdrop + platforms + the two mons (WEST transforms) + the effect BG,
                   blended with the real NDS G2_SetBlendAlpha. Replaces the old stacked image layers. -->
              <!-- SceneComposite already includes the HAIKEI_PAL_FADE background darken/flash (applied BG-only inside the
                   compositor, so the mons stay lit); no full-screen overlay rectangle here any more. -->
              <Image Source="{Binding SceneComposite}" Canvas.Left="0" Canvas.Top="0" Width="256" Height="192" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
              <!-- cell-anim (CATS) + particle glow (SPA) overlays. WE_057 (Surf) scales/fades the wave sprite. -->
              <Image Source="{Binding CellPreview}" Canvas.Left="0" Canvas.Top="0" Width="256" Height="192" Stretch="Fill"
                     RenderOptions.BitmapInterpolationMode="None" Opacity="{Binding CellOpacity}" RenderTransformOrigin="{Binding CellOrigin}">
                <Image.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleX="{Binding CellScaleX}" ScaleY="{Binding CellScaleY}"/>
                    <TranslateTransform X="{Binding CellOffsetX}" Y="{Binding CellOffsetY}"/>
                  </TransformGroup>
                </Image.RenderTransform>
              </Image>
              <Image Source="{Binding ParticlePreview}" Canvas.Left="0" Canvas.Top="0" Width="256" Height="192" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
              <!-- chrome: real HP gauges (pl_batt_obj frames, placed so the cell origin lands on the game's gauge
                   position) with fallback to the bundled placeholders; both hide during a move per the WazaData flag -->
              <Image Source="{Binding GaugeEnemyImage}"  Canvas.Left="-70" Canvas.Top="-92" Width="256" Height="256"
                     IsVisible="{Binding RealGaugesVisible}" RenderOptions.BitmapInterpolationMode="None"/>
              <Image Source="{Binding GaugePlayerImage}" Canvas.Left="64"  Canvas.Top="-12" Width="256" Height="256"
                     IsVisible="{Binding RealGaugesVisible}" RenderOptions.BitmapInterpolationMode="None"/>
              <Image Source="{x:Static views:BattleSceneControl.HealthOpponentAsset}" Canvas.Left="0"   Canvas.Top="18"  IsVisible="{Binding PlaceholderGaugesVisible}"/>
              <Image Source="{x:Static views:BattleSceneControl.HealthYouAsset}"      Canvas.Left="129" Canvas.Top="95"  IsVisible="{Binding PlaceholderGaugesVisible}"/>
              <!-- gauge readout overlay (name / level / HP bar) from the gauge config popup. Positioned inside the real
                   gauge boxes: enemy ≈ x[-6..122] y[4..68] (center 58,36); player ≈ x[128..256] y[84..148] (center 192,116).
                   Values from gauge.c's gage_parts tile layout; pixel coords are TUNABLE. -->
              <Canvas IsVisible="{Binding GaugesVisible}">
                <!-- Positions measured off real battles; the frame graphic already carries the "HP" label and
                     the empty bar groove, so only the fill and the text go on top. The groove is drawn here
                     rather than left to the frame: measured off a Platinum capture with a half-empty bar, it
                     is a white row, two rows that are green where full and black where empty, another white
                     row, then a black one. Painting a four-row bar covered the white rows and the empty
                     part, and leaving the last row out let the frame's brown show where the game is black.
                     Rows checked one at a time over 705 frames of real battles, both gauges. -->
                <!-- enemy (upper-left) -->
                <TextBlock Canvas.Left="3"  Canvas.Top="24" Text="{Binding GaugeNameText}"  FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}" IsVisible="{Binding !GaugeTextIsReal}"/>
                <TextBlock Canvas.Left="78" Canvas.Top="24" Text="{Binding GaugeLevelText}" FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}" IsVisible="{Binding !GaugeTextIsReal}"/>
                <Rectangle Canvas.Left="50" Canvas.Top="42" Width="48" Height="1" Fill="#FBFBFB"/>
                <Rectangle Canvas.Left="50" Canvas.Top="43" Width="48" Height="2" Fill="#000000"/>
                <Rectangle Canvas.Left="50" Canvas.Top="43" Width="{Binding GaugeHpBarWidth}" Height="2" Fill="{Binding GaugeHpBrush}"/>
                <Rectangle Canvas.Left="50" Canvas.Top="45" Width="48" Height="1" Fill="#FBFBFB"/>
                <Rectangle Canvas.Left="50" Canvas.Top="46" Width="48" Height="1" Fill="#000000"/>
                <!-- player (lower-right) -->
                <TextBlock Canvas.Left="149" Canvas.Top="102" Text="{Binding GaugeNameText}"  FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}" IsVisible="{Binding !GaugeTextIsReal}"/>
                <TextBlock Canvas.Left="210" Canvas.Top="102" Text="{Binding GaugeLevelText}" FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}" IsVisible="{Binding !GaugeTextIsReal}"/>
                <Rectangle Canvas.Left="200" Canvas.Top="118" Width="48" Height="1" Fill="#FBFBFB"/>
                <Rectangle Canvas.Left="200" Canvas.Top="119" Width="48" Height="2" Fill="#000000"/>
                <Rectangle Canvas.Left="200" Canvas.Top="119" Width="{Binding GaugeHpBarWidth}" Height="2" Fill="{Binding GaugeHpBrush}"/>
                <Rectangle Canvas.Left="200" Canvas.Top="121" Width="48" Height="1" Fill="#FBFBFB"/>
                <Rectangle Canvas.Left="200" Canvas.Top="122" Width="48" Height="1" Fill="#000000"/>
                <!-- player HP numbers (cur/max) below the bar; the foe's gauge shows no numbers in-game.
                     The game puts these glyphs on rows 125-131 and they were landing on 130-135, running
                     over the bottom of the frame. Measured off a Platinum capture. -->
                <TextBlock Canvas.Left="210" Canvas.Top="121" Text="{Binding GaugeHpText}" FontSize="9" FontWeight="Bold" Foreground="{Binding GaugeTextBrush}"/>
              </Canvas>
              <Image Source="{x:Static views:BattleSceneControl.TextBarAsset}"        Canvas.Left="0"   Canvas.Top="144"/>
            </Canvas>
          </Viewbox>
        </Border>
        <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,4">
          <Button Content="{Binding CellPlayButtonText}" Click="PlayCell_Click" IsVisible="{Binding HasPreview}" Margin="0,2,6,2"/>
          <CheckBox Content="Performed by enemy" IsChecked="{Binding AttackerIsEnemy}"
                    IsVisible="{Binding HasPreview}" VerticalAlignment="Center" Margin="0,2,6,2"
                    ToolTip.Tip="Preview the move cast from the enemy (top) side: flips SIDE_JP branches, attacker-anchored emitters and lunges."/>
          <CheckBox Content="Second animation" IsChecked="{Binding SecondTurnVariant}"
                    IsVisible="{Binding HasTurnCheck}" VerticalAlignment="Center" Margin="0,2,6,2"
                    ToolTip.Tip="This move holds two animations and the game alternates them by the battle's turn count. Tick this to watch the second one."/>
          <TextBlock Text="Backdrop:" VerticalAlignment="Center" IsVisible="{Binding HasPreview}" FontSize="12" Margin="0,2,4,2"/>
          <ComboBox ItemsSource="{Binding BackgroundOptions}" SelectedIndex="{Binding BackgroundIndex}"
                    IsVisible="{Binding HasPreview}" VerticalAlignment="Center" MinWidth="150" MaxDropDownHeight="360" Margin="0,2,6,2"
                    ToolTip.Tip="The real battle-scene backdrop (scenery behind the platforms) from pl_batt_bg.narc, not a move effect."/>
          <Button Content="HP gauges…" IsVisible="{Binding HasPreview}" VerticalAlignment="Center" Margin="0,2,6,2"
                  ToolTip.Tip="Configure the gauge readout (species, level, HP %).">
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="6" Width="190">
                  <TextBlock Text="Gauge readout" FontWeight="SemiBold"/>
                  <TextBlock Text="Pokémon to display" FontSize="12"/>
                  <ComboBox ItemsSource="{Binding SpeciesNames}" SelectedIndex="{Binding GaugeSpeciesIndex}"
                            HorizontalAlignment="Stretch" MaxDropDownHeight="360"
                            ToolTip.Tip="Loads this species' front/back battle sprites into the preview and names the gauge."/>
                  <TextBlock Text="Level" FontSize="12"/>
                  <NumericUpDown Value="{Binding GaugeLevel}" Minimum="1" Maximum="100" Increment="1" FormatString="0"/>
                  <TextBlock Text="Max HP" FontSize="12"/>
                  <NumericUpDown Value="{Binding GaugeMaxHp}" Minimum="1" Maximum="999" Increment="1" FormatString="0"/>
                  <TextBlock Text="HP %" FontSize="12"/>
                  <Slider Value="{Binding GaugeHpPercent}" Minimum="0" Maximum="100"/>
                  <TextBlock Text="{Binding GaugeHpText, StringFormat='{}{0} HP'}" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <TextBlock Text="Terrain:" VerticalAlignment="Center" IsVisible="{Binding HasPreview}" FontSize="12" Margin="0,2,4,2"/>
          <ComboBox ItemsSource="{Binding TerrainOptions}" SelectedIndex="{Binding TerrainIndex}"
                    IsVisible="{Binding HasPreview}" VerticalAlignment="Center" MinWidth="130" MaxDropDownHeight="360" Margin="0,2,6,2"
                    ToolTip.Tip="Render the real in-game ground/terrain platforms (pl_batt_obj.narc) the Pokémon stand on: the tray some move animations interact with."/>
          <TextBlock Text="{Binding CellAnimNote}" VerticalAlignment="Center" TextWrapping="Wrap"
                     FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
          <TextBlock Text="{Binding PreviewNotes}" IsVisible="{Binding HasPreviewNotes}"
                     VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="8,2,0,2"
                     Foreground="{DynamicResource Editor.Subtle}"
                     ToolTip.Tip="Parts of this move the preview cannot draw. The move itself is unchanged."/>
        </WrapPanel>

        <TextBlock Grid.Row="3" Text="{Binding StoryboardTitle}" FontWeight="SemiBold" Margin="0,6,0,4"/>
        <Border Grid.Row="4" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" CornerRadius="3">
          <ScrollViewer>
            <TextBox Text="{Binding Storyboard}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="{Binding StoryboardWrap}" VerticalAlignment="Top"
                     FontFamily="Consolas,monospace" FontSize="12" BorderThickness="0" Background="Transparent"/>
          </ScrollViewer>
        </Border>
      </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
