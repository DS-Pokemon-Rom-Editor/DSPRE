<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels"
        x:Class="DSPRE.Avalonia.Views.BtxEditorView"
        x:DataType="vm:BtxEditorViewModel"
        Title="Overworld Editor"
        Width="820" Height="480"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:BtxEditorViewModel/>
  </Design.DataContext>

  <Grid ColumnDefinitions="160,8,260,8,*" Margin="8">
    <!-- Left: entry list -->
    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Text="OW Entries" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <ListBox ItemsSource="{Binding OwEntries}"
               SelectedIndex="{Binding SelectedIndex}"
               ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </DockPanel>

    <!-- Middle: texture preview + save controls -->
    <DockPanel Grid.Column="2">
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
        <CheckBox Content="Shiny palette" IsChecked="{Binding IsShiny}"/>
        <Grid ColumnDefinitions="*,8,*">
          <Button Grid.Column="0" Content="Import PNG" Click="Import_Click"
                  IsEnabled="{Binding HasSelectedEntry}" HorizontalAlignment="Stretch"/>
          <Button Grid.Column="2" Content="Export PNG" Click="Export_Click"
                  IsEnabled="{Binding HasSelectedEntry}" HorizontalAlignment="Stretch"/>
        </Grid>
        <Grid ColumnDefinitions="*,8,*">
          <Button Grid.Column="0" Content="Save Selected" Click="SaveSelected_Click"
                  IsEnabled="{Binding HasUnsavedChanges}" HorizontalAlignment="Stretch"/>
          <Button Grid.Column="2" Content="Save All"      Click="SaveAll_Click"
                  IsEnabled="{Binding HasUnsavedChanges}" HorizontalAlignment="Stretch"/>
        </Grid>
        <Grid ColumnDefinitions="*,8,*">
          <Button Grid.Column="0" Content="Show File" Click="ShowFile_Click"
                  IsEnabled="{Binding HasSelectedEntry}" HorizontalAlignment="Stretch"/>
          <TextBlock Grid.Column="2" Text="{Binding ModifiedCount}"
                     VerticalAlignment="Center" Foreground="OrangeRed" FontSize="12"/>
        </Grid>
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Border BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1" Background="{DynamicResource Editor.PanelBg}">
        <Image Source="{Binding CurrentImage}"
               Stretch="None"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </DockPanel>

    <!-- Right: Platinum overworld properties (render state + expansion-patch add/delete) -->
    <Grid Grid.Column="4" RowDefinitions="Auto,*" IsVisible="{Binding IsPlatinum}">
      <TextBlock Grid.Row="0" Text="Overworld properties (Platinum)" FontWeight="SemiBold" Margin="0,0,0,4"/>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <Border Padding="8" CornerRadius="4" Background="{DynamicResource Editor.PanelBg}">
            <TextBlock Text="{Binding ExpansionStatusText}" TextWrapping="Wrap" FontSize="12"/>
          </Border>

          <StackPanel Spacing="4" IsVisible="{Binding HasRenderState}">
            <TextBlock Text="Render state" FontWeight="SemiBold"/>
            <TextBlock Text="Draw type" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
            <ComboBox ItemsSource="{Binding DrawTypeOptions}" SelectedIndex="{Binding DrawTypeIndex}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="How this overworld is rendered: not drawn, a camera-facing billboard sprite, or a real 3D model."/>
            <TextBlock Text="Shadow" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
            <ComboBox ItemsSource="{Binding ShadowTypeOptions}" SelectedIndex="{Binding ShadowTypeIndex}" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Footmark" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
            <ComboBox ItemsSource="{Binding FootmarkTypeOptions}" SelectedIndex="{Binding FootmarkTypeIndex}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Footprint trail left behind while walking/cycling over sand-like terrain."/>
            <TextBlock Text="Reflection" FontSize="12" Foreground="{DynamicResource Editor.Subtle}"/>
            <ComboBox ItemsSource="{Binding ReflectTypeOptions}" SelectedIndex="{Binding ReflectTypeIndex}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Whether this overworld shows a water reflection."/>
          </StackPanel>
          <TextBlock Text="No render-state entry found for this overworld." FontSize="12" FontStyle="Italic"
                     Foreground="{DynamicResource Editor.Subtle}" TextWrapping="Wrap"
                     IsVisible="{Binding !HasRenderState}"/>

          <StackPanel Spacing="4" IsVisible="{Binding IsExpansionApplied}">
            <TextBlock Text="Renderer / animation (read-only)" FontWeight="SemiBold"
                       ToolTip.Tip="Opaque resource IDs and code pointers cloned from another entry, not safe to hand-edit, shown for reference when picking a clone source below."/>
            <TextBlock Text="{Binding RendererInfoText, StringFormat='Renderer row: {0}'}" FontSize="11" FontFamily="Consolas,Cascadia Mono,monospace" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding AnimationInfoText, StringFormat='Animation row: {0}'}" FontSize="11" FontFamily="Consolas,Cascadia Mono,monospace" TextWrapping="Wrap"/>
          </StackPanel>

          <Separator/>

          <StackPanel Spacing="4">
            <Button Content="Add Custom Entry…" Click="AddEntry_Click" IsEnabled="{Binding CanAddEntry}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Requires the hzla PlatPatches overworld-sprites expansion patch, with a free custom slot."/>
            <Button Content="Delete Selected Entry" Click="DeleteEntry_Click" IsEnabled="{Binding CanDeleteSelected}" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Only available for custom entries the expansion patch added. Original entries can't be removed."/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Column="4" IsVisible="{Binding !IsPlatinum}"
               Text="Overworld render-state properties and custom-entry Add/Delete are Platinum-only. This ROM only has the texture browser on the left."
               TextWrapping="Wrap" Foreground="{DynamicResource Editor.Subtle}" FontSize="12"/>
  </Grid>
</Window>
