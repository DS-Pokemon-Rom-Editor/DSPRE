<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
             xmlns:vm="using:DSPRE.Avalonia.ViewModels.Shell"
             x:Class="DSPRE.Avalonia.Views.Shell.StartPanel"
             x:DataType="vm:RecentProjectsViewModel">

  <Design.DataContext>
    <vm:RecentProjectsViewModel/>
  </Design.DataContext>

  <UserControl.Resources>
    <!-- Name on top, folder below; the folder keeps its end, where similar paths differ. -->
    <DataTemplate x:Key="RecentRow" x:DataType="vm:RecentProjectsViewModel+RecentEntry">
      <StackPanel Spacing="1" ToolTip.Tip="{Binding Path}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Foreground="{DynamicResource Editor.Subtle}" Text="{Binding Where}" FontSize="11" TextTrimming="PrefixCharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <Button Content="Open ROM (.nds)…" controls:Icon.Key="open_rom" HorizontalAlignment="Stretch" Click="OpenRom_Click"/>
      <Button Content="Open extracted folder…" controls:Icon.Key="open_file" HorizontalAlignment="Stretch" Click="OpenFolder_Click"/>
      <Button Content="Open hg-engine folder…" controls:Icon.Key="open_file" HorizontalAlignment="Stretch" Click="OpenHgEngineFolder_Click"/>
      <TextBlock Foreground="{DynamicResource Editor.Subtle}" Text="Or drop a .nds or project folder here." FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="Recent projects" FontWeight="Bold" Margin="0,14,0,6"/>
    <Panel>
      <ScrollViewer IsVisible="{Binding HasRecents}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="4">
          <TextBlock Text="Project folders" Classes="subtle" IsVisible="{Binding HasRecentFolders}"/>
          <ListBox ItemsSource="{Binding RecentFolders}" IsVisible="{Binding HasRecentFolders}"
                   DoubleTapped="Recent_DoubleTapped" ItemTemplate="{StaticResource RecentRow}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="RecentList_Loaded"/>
          <TextBlock Text="ROM files" Classes="subtle" Margin="0,6,0,0" IsVisible="{Binding HasRecentRoms}"/>
          <ListBox ItemsSource="{Binding RecentRoms}" IsVisible="{Binding HasRecentRoms}"
                   DoubleTapped="Recent_DoubleTapped" ItemTemplate="{StaticResource RecentRow}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="RecentList_Loaded"/>
        </StackPanel>
      </ScrollViewer>
      <TextBlock Foreground="{DynamicResource Editor.Subtle}" Text="No recent projects." IsVisible="{Binding !HasRecents}" TextWrapping="Wrap"/>
    </Panel>
  </DockPanel>
</UserControl>
