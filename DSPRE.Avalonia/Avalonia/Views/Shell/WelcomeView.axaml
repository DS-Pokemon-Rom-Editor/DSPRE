<Window xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DSPRE.Avalonia.ViewModels.Shell"
        xmlns:local="using:DSPRE.Avalonia.Views.Shell"
        x:Class="DSPRE.Avalonia.Views.Shell.WelcomeView"
        x:DataType="vm:WelcomeViewModel"
        Title="{Binding WindowTitle}"
        Width="720" Height="480" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:WelcomeViewModel/>
  </Design.DataContext>

  <DockPanel Margin="14">

    <!-- Footer: startup toggle + close -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close" MinWidth="90" Click="Close_Click"/>
      <CheckBox Content="Show this window at startup" IsChecked="{Binding ShowAtStartup}"/>
    </DockPanel>

    <Grid ColumnDefinitions="290,14,*">

      <!-- Left: quick actions + recents -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Get started" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <local:StartPanel DataContext="{Binding Recents}" Opening="Start_Opening"/>
      </DockPanel>

      <!-- Right: paged tutorial -->
      <Border Grid.Column="2" Background="{DynamicResource Editor.PanelBg}"
              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
              CornerRadius="6" Padding="16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Back" controls:Icon.Key="arrowleft" MinWidth="80" Click="Back_Click"
                    IsEnabled="{Binding CanGoBack}"/>
            <Button DockPanel.Dock="Right" Content="Next" controls:Icon.Key="arrowright" controls:Icon.After="True" MinWidth="80" Click="Next_Click"
                    IsEnabled="{Binding CanGoNext}"/>
            <TextBlock Foreground="{DynamicResource Editor.Subtle}" Text="{Binding PageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding PageTitle}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
          <ScrollViewer>
            <TextBlock Text="{Binding PageBody}" TextWrapping="Wrap" LineHeight="22"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
