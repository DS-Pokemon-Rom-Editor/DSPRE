<Window xmlns="https://github.com/avaloniaui"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DSPRE.Avalonia.ViewModels.Shell"
        x:Class="DSPRE.Avalonia.Views.Shell.WelcomeView"
        x:DataType="vm:WelcomeViewModel"
        Title="{Binding WindowTitle}"
        Width="720" Height="480" CanResize="False"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:WelcomeViewModel/>
  </Design.DataContext>

  <Window.Resources>
    <!-- The name first, the folder it sits in underneath; the folder keeps its end, where look-alike paths differ. -->
    <DataTemplate x:Key="RecentRow" x:DataType="vm:WelcomeViewModel+RecentEntry">
      <StackPanel Spacing="1" ToolTip.Tip="{Binding Path}">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Where}" FontSize="11" Opacity="0.65" TextTrimming="PrefixCharacterEllipsis"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="14">

    <!-- Footer: startup toggle + close -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close" MinWidth="90" Click="Close_Click"/>
      <CheckBox Content="Show this window at startup" IsChecked="{Binding ShowAtStartup}"/>
    </DockPanel>

    <Grid ColumnDefinitions="290,14,*">

      <!-- Left: quick actions + recents -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Get started" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <Button Content="Open ROM (.nds)…" controls:Icon.Key="open_rom" HorizontalAlignment="Stretch" Click="OpenRom_Click"/>
          <Button Content="Open extracted folder…" controls:Icon.Key="open_file" HorizontalAlignment="Stretch" Click="OpenFolder_Click"/>
          <Button Content="Open hg-engine folder…" controls:Icon.Key="open_file" HorizontalAlignment="Stretch" Click="OpenHgEngineFolder_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Recent projects" FontWeight="Bold" Margin="0,14,0,6"/>
        <Panel>
          <ScrollViewer IsVisible="{Binding HasRecents}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="4">
              <TextBlock Text="Project folders" Classes="subtle" IsVisible="{Binding HasRecentFolders}"/>
              <ListBox ItemsSource="{Binding RecentFolders}" IsVisible="{Binding HasRecentFolders}"
                       DoubleTapped="Recent_DoubleTapped" ItemTemplate="{StaticResource RecentRow}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="RecentList_Loaded"/>
              <TextBlock Text="ROM files" Classes="subtle" Margin="0,6,0,0" IsVisible="{Binding HasRecentRoms}"/>
              <ListBox ItemsSource="{Binding RecentRoms}" IsVisible="{Binding HasRecentRoms}"
                       DoubleTapped="Recent_DoubleTapped" ItemTemplate="{StaticResource RecentRow}"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" Loaded="RecentList_Loaded"/>
            </StackPanel>
          </ScrollViewer>
          <TextBlock Text="Nothing here yet. Projects you open will show up here for quick access."
                     IsVisible="{Binding !HasRecents}" Opacity="0.7" TextWrapping="Wrap"/>
        </Panel>
      </DockPanel>

      <!-- Right: paged tutorial -->
      <Border Grid.Column="2" Background="{DynamicResource Editor.PanelBg}"
              BorderBrush="{DynamicResource Editor.Border}" BorderThickness="1"
              CornerRadius="6" Padding="16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Back" controls:Icon.Key="arrowleft" MinWidth="80" Click="Back_Click"
                    IsEnabled="{Binding CanGoBack}"/>
            <Button DockPanel.Dock="Right" Content="Next" controls:Icon.Key="arrowright" controls:Icon.After="True" MinWidth="80" Click="Next_Click"
                    IsEnabled="{Binding CanGoNext}"/>
            <TextBlock Text="{Binding PageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding PageTitle}" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
          <ScrollViewer>
            <TextBlock Text="{Binding PageBody}" TextWrapping="Wrap" LineHeight="22"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
