<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DSPRE.Avalonia.Controls"
        xmlns:vm="clr-namespace:DSPRE.Avalonia.ViewModels.Shell"
        x:Class="DSPRE.Avalonia.Views.Shell.HgEnginePatchesView"
        x:DataType="vm:HgEnginePatchesViewModel">

  <Design.DataContext>
    <vm:HgEnginePatchesViewModel/>
  </Design.DataContext>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Editor.StatusBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Editor.Subtle}" VerticalAlignment="Center"/>
    </Border>

    <controls:EditorToolbar>
        <Button Content="Save" controls:Icon.Key="saveButton" Click="Save_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <Button Content="Discard" controls:Icon.Key="resetIcon" Click="Discard_Click" IsEnabled="{Binding HasUnsavedChanges}"/>
        <controls:UndoRedoButtons/>
        <TextBlock Text="Show" VerticalAlignment="Center" Margin="12,0,0,0"/>
        <ComboBox Width="160" ItemsSource="{Binding Binaries}" SelectedIndex="{Binding BinaryFilter}"/>
        <CheckBox Content="Built only" IsChecked="{Binding BuiltOnly}" Margin="8,0,0,0"
                  ToolTip.Tip="Hide lines your config's #ifdefs leave out"/>
        <Button Content="Reload" controls:Icon.Key="reload" Click="Reload_Click"/>
    </controls:EditorToolbar>

    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Editor.Border}" BorderThickness="0,0,0,1" Padding="8,5">
      <controls:HelpTip HorizontalAlignment="Left"
                        Text="Offset is where each patch lands in the file; #ifdef lines are checked against your config"/>
    </Border>

    <!-- Adding one -->
    <Border x:Name="AddPatchPanel" DockPanel.Dock="Bottom" Background="{DynamicResource Editor.PanelBg}" BorderBrush="{DynamicResource Editor.Border}"
            BorderThickness="0,1,0,0" Padding="8">
      <StackPanel Spacing="6">
        <WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4">
            <TextBlock Text="List" VerticalAlignment="Center"/>
            <ComboBox Width="150" ItemsSource="{Binding NewListChoices}" SelectedIndex="{Binding NewList}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4">
            <TextBlock Text="Binary" VerticalAlignment="Center"/>
            <TextBox Width="80" Text="{Binding NewBinary}" ToolTip.Tip="arm9, or an overlay number like 0012"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4"
                      IsVisible="{Binding !NewNeedsBytes}">
            <TextBlock Text="Routine" VerticalAlignment="Center"/>
            <TextBox Width="200" Text="{Binding NewSymbol}" ToolTip.Tip="The symbol in your own code to branch to"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4">
            <TextBlock Text="Address" VerticalAlignment="Center"/>
            <TextBox Width="110" Text="{Binding NewAddress}" ToolTip.Tip="Hex, like 02078384"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4"
                      IsVisible="{Binding !NewNeedsBytes}">
            <TextBlock Text="Register" VerticalAlignment="Center"/>
            <TextBox Width="50" Text="{Binding NewRegister}" ToolTip.Tip="Leave empty to replace the whole routine"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,10,4"
                      IsVisible="{Binding NewNeedsBytes}">
            <TextBlock Text="Bytes" VerticalAlignment="Center"/>
            <TextBox Width="220" Text="{Binding NewBytes}" ToolTip.Tip="Hex bytes, like 60 B4 C0 46"/>
          </StackPanel>
          <Button Content="Add" controls:Icon.Key="addIcon" Click="Add_Click" Margin="0,0,6,4"/>
          <Button Content="Change selected" Click="Change_Click" IsEnabled="{Binding HasSelection}" Margin="0,0,6,4"/>
          <Button Content="Delete selected" Click="Delete_Click" IsEnabled="{Binding HasSelection}" Margin="0,0,0,4"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
              GridLinesVisibility="Horizontal" CanUserResizeColumns="True" CanUserSortColumns="True">
      <DataGrid.Styles>
        <Style Selector="DataGridRow">
          <Setter Property="Opacity" Value="{Binding RowOpacity, x:DataType=vm:PatchRow}"/>
          <Setter Property="ToolTip.Tip" Value="{Binding BuiltNote, x:DataType=vm:PatchRow}"/>
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Binary"  Binding="{Binding Binary}"  Width="100"/>
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="110"/>
        <DataGridTextColumn Header="Offset"  Binding="{Binding Offset}"  Width="90"/>
        <DataGridTextColumn Header="Bytes"   Binding="{Binding Size}"    Width="60"/>
        <DataGridTextColumn Header="Description" Binding="{Binding Does}" Width="*" MinWidth="280"/>
        <DataGridTextColumn Header="From"    Binding="{Binding List}"    Width="130"/>
        <DataGridTextColumn Header="Built"   Binding="{Binding Built}"   Width="80"/>
        <DataGridTextColumn Header="When"    Binding="{Binding Condition}" Width="160"/>
        <DataGridTextColumn Header="Runs into" Binding="{Binding Clash}" Width="200"/>
        <DataGridTemplateColumn Header="Problem" Width="240">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PatchRow">
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,0" VerticalAlignment="Center"
                          IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" ToolTip.Tip="{Binding Problem}">
                <controls:IconImage Key="warning" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Problem}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
