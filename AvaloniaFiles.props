<Project>

  <!-- Single source of truth for the Avalonia UI layer: DSPRE.Avalonia.csproj COMPILES these
       items; DS_Map\DSPRE.csproj REMOVES the same set (it gets the UI from the project reference).
       Files physically stay under DS_Map\Avalonia\ for now — move them under DSPRE.Avalonia\
       over time. Nothing in this set may reference WinForms. -->

  <PropertyGroup>
    <DsMapDirAv>$(MSBuildThisFileDirectory)DS_Map\</DsMapDirAv>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaLayerCompile Include="$(DsMapDirAv)Avalonia\**\*.cs" />
    <AvaloniaLayerXaml Include="$(DsMapDirAv)Avalonia\**\*.axaml" />
    <!-- Embedded UI assets. Link keeps the avares:// paths identical to the on-disk layout.
         NOTE: LinkBase alone does NOT work here — MSBuild's AssignLinkMetadata target only
         auto-generates Link for well-known item types (Compile/Content/None/...), not custom
         ones like this. Without an explicit Link, Avalonia embeds each asset under its full
         absolute disk path and every avares://DSPRE.Avalonia/Avalonia/Assets/... lookup
         silently fails (broke all battle-scene placeholder art). -->
    <AvaloniaLayerAsset Include="$(DsMapDirAv)Avalonia\Assets\**">
      <Link>Avalonia\Assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AvaloniaLayerAsset>
    <AvaloniaLayerAsset Include="$(DsMapDirAv)Resources\Graphics\**">
      <Link>Resources\Graphics\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </AvaloniaLayerAsset>
  </ItemGroup>

</Project>
